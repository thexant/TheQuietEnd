			border-color: rgba(0, 0, 0, 0.12);
			color: rgba(0, 0, 0, 0.35);
		}

		/* Light-theme break error styling */
		:root[data-theme="lightblue"] .break-error,
		:root[data-theme="lightred"] .break-error,
