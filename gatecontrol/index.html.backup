      multiplayer: {
        enabled: false,
        shouldReconnect: true,
        wasConnectedBefore: false,
        ws: null,
        playerId: null,
        players: [],
        playerCount: 0,
        lastPlayerCount: 0,
        pingMatrix: {},
        serverUrl: "ws://localhost:8080",
        reconnectAttempts: 0,
        reconnectTimer: null,
        heartbeatTimer: null,
        dnd: {
          msg: false,
          ping: false,
          all: false
        },
        pendingPings: new Map(),
        gateStates: new Map(), // Tracks connection state, pings, etc. for each player gate
        gateNetworkPage: 0, // Current page for gate network pagination
        gateNetworkFilter: "", // Filter string for gate network
        coop: {
          enabled: false,
          role: null, // "host" or "invited"
          sessionId: null,
          participants: [],
          locked: false,
          activeVote: null // VoteObject when vote is in progress
        }
      },
      inlineDetailId: null,
      inlineGateDetailId: null,
      fontScale: 1.0,
      collapsedPanels: {
        // Main panels
        traffic: false,
        systems: false,
        terminal: false,
        // TRAFFIC sub-sections
        'traffic-inbound': false,
        'traffic-outbound': false,
        // SYSTEMS sub-sections
        'systems-gate': false,
        'systems-corridor': false,
        'systems-facility': false,
        'systems-resources': false,
        'systems-concourse': false,
        'systems-relays': false,
        'systems-gatenetwork': true,
        'systems-maintenance': false,
        // TERMINAL sub-sections
        'terminal-console': false
      },
      breakState: {
        active: false,
        endTime: null,
        timer: null,
        pausedShiftTime: 0,
        pausedTickTimer: null,
        pausedUiTimer: null
      }
    };

    // ---------------------------
    // Gamepad Navigation State
    // ---------------------------
    const gamepadNav = {
      isActive: false,
      isConsoleLocked: false,
      isSelectLocked: false,
      isVirtualKeyboardVisible: false,
      isHeaderMode: false,
      currentIndex: 0,
      currentLevel: 'root',
      currentElements: [],
      navigationStack: [],
      currentPanelContext: null,
      currentSubsectionContext: null,
      connectedGamepads: [],
      lastPollTimestamp: 0,
      buttonStates: {},
      stickDeadzone: 0.3,
      scrollIndex: 0
    };

    // ---------------------------
    // Maintenance cooldowns
    // ---------------------------
    const MAINT_COOLDOWNS_MS = Object.freeze({
      scan: 10_000,
      reset: 10_000,
      realign: 10_000,
      purge: 10_000,
      stresstest: 120_000
    });

    function getMaintLastAt(g, kind) {
      if (!g) return 0;
      if (kind === "scan") return (typeof g.lastScanAt === "number") ? g.lastScanAt : 0;
      if (kind === "realign") return (typeof g.lastRealignAt === "number") ? g.lastRealignAt : 0;
      if (kind === "reset") return (typeof g.lastResetAt === "number") ? g.lastResetAt : 0;
      if (kind === "purge") return (typeof g.lastPurgeAt === "number") ? g.lastPurgeAt : 0;
      if (kind === "stresstest") return (typeof g.lastStressTestAt === "number") ? g.lastStressTestAt : 0;
      return 0;
    }

    function maintCooldownRemainingMs(g, kind) {
      const cd = MAINT_COOLDOWNS_MS[kind] || 0;
      if (!cd) return 0;
      const last = getMaintLastAt(g, kind);
      const now = Date.now();
      const elapsed = now - last;
      if (elapsed >= cd) return 0;
      return cd - Math.max(0, elapsed);
    }

    function updateOperatorLabel() {
      if (!ui.operatorLabel) return;
      const trimmed = String(runtime.operatorCallsign || "").trim();
      ui.operatorLabel.textContent = "";
      if (!trimmed) {
        ui.operatorLabel.textContent = "Operator";
        ui.operatorSlot?.classList.remove("has-callsign");
      } else {
        ui.operatorLabel.append("Operator:");
        const callsignNode = document.createElement("span");
        callsignNode.className = "operator-callsign";
        callsignNode.textContent = trimmed;
        ui.operatorLabel.append(callsignNode);
        ui.operatorSlot?.classList.add("has-callsign");
      }
      if (ui.operatorInput && !ui.operatorSlot?.classList.contains("editing")) {
        ui.operatorInput.value = runtime.operatorCallsign || "";
      }
    }

    function setOperatorCallsign(value) {
      runtime.operatorCallsign = String(value || "").trim().slice(0, 24);
      const gateId = runtime.activeGateId || getStoredGateId();
      saveOperatorCallsignForGate(gateId, runtime.operatorCallsign);
      if (runtime.operatorCallsign) {
        safeStorageSet(LS.operatorCallsign, runtime.operatorCallsign);
      } else {
        try { localStorage.removeItem(LS.operatorCallsign); } catch (_) {}
      }
      updateOperatorLabel();

      // Push updated callsign to the multiplayer server immediately (used for ACTIVE/PING/MSG display)
      if (runtime.multiplayer.ws && runtime.multiplayer.ws.readyState === WebSocket.OPEN && runtime.activeGateId) {
        sendHeartbeat();
      }
    }

    function startOperatorEdit() {
      if (!ui.operatorSlot || !ui.operatorInput) return;
      ui.operatorSlot.classList.add("editing");
      ui.operatorInput.value = runtime.operatorCallsign || "";
      ui.operatorInput.focus();
      ui.operatorInput.select();
    }

    function finishOperatorEdit(save) {
      if (!ui.operatorSlot || !ui.operatorInput) return;
      if (save) {
        setOperatorCallsign(ui.operatorInput.value);
      } else {
        ui.operatorInput.value = runtime.operatorCallsign || "";
      }
      ui.operatorSlot.classList.remove("editing");
    }

    // ---------------------------
    // Start Screen Name
    // ---------------------------
    function updateStartNameLabel() {
      if (!ui.startNameLabel) return;
      const trimmed = String(runtime.operatorCallsign || "").trim();
      if (!trimmed) {
        ui.startNameLabel.textContent = "USER";
      } else {
        // Check if there's save data beyond just the operator name
        const hasOtherSaveData = hasSavedData();
        if (hasOtherSaveData) {
          ui.startNameLabel.textContent = "WELCOME BACK: " + trimmed;
        } else {
          ui.startNameLabel.textContent = "BEGIN SHIFT: " + trimmed;
        }
      }
      if (ui.startNameInput && !ui.startNameSlot?.classList.contains("editing")) {
        ui.startNameInput.value = runtime.operatorCallsign || "";
      }
    }

    function startStartNameEdit() {
      if (!ui.startNameSlot || !ui.startNameInput) return;
      ui.startNameSlot.classList.add("editing");
      ui.startNameInput.value = runtime.operatorCallsign || "";
      ui.startNameInput.focus();
      ui.startNameInput.select();
    }

    function finishStartNameEdit(save) {
      if (!ui.startNameSlot || !ui.startNameInput) return;
      if (save) {
        setOperatorCallsign(ui.startNameInput.value);
        updateStartNameLabel();
      } else {
        ui.startNameInput.value = runtime.operatorCallsign || "";
      }
      ui.startNameSlot.classList.remove("editing");
    }

    // ---------------------------
    // Audio
    // ---------------------------
    function loadStoredBool(key, fallback) {
      try {
        const raw = localStorage.getItem(key);
        if (raw === "true") return true;
        if (raw === "false") return false;
      } catch (_) {}
      return fallback;
    }

    function loadStoredNumber(key, fallback) {
      try {
        const raw = localStorage.getItem(key);
        if (raw !== null) {
          const num = parseFloat(raw);
          if (!isNaN(num)) return num;
        }
      } catch (_) {}
      return fallback;
    }

    function storeBool(key, value) {
      try { localStorage.setItem(key, value ? "true" : "false"); } catch (_) {}
    }

    function storeNumber(key, value) {
      try { localStorage.setItem(key, String(value)); } catch (_) {}
    }

    function makeAudioPool(src, count, volume = 0.8) {
      const pool = Array.from({ length: count }, () => {
        const audio = new Audio(src);
        audio.preload = "auto";
        audio.volume = volume;
        return audio;
      });
      return { pool, index: 0 };
    }

    function makeLoopAudio(src, volume = 0.8) {
      const audio = new Audio(src);
      audio.preload = "auto";
      audio.loop = true;
      audio.volume = volume;
      return audio;
    }

		function playAudioPool(group) {
			if (!group?.pool?.length) return;

			const audioEl = group.pool[group.index];
			group.index = (group.index + 1) % group.pool.length;

			// --- pitch variation (optional per group) ---
			if (group.pitch) {
				const min = typeof group.pitch.min === "number" ? group.pitch.min : 1;
				const max = typeof group.pitch.max === "number" ? group.pitch.max : 1;
				const rate = min + Math.random() * (max - min);

				// ensure rate change actually changes pitch (some browsers try to preserve it)
				if ("preservesPitch" in audioEl) audioEl.preservesPitch = false;
				if ("mozPreservesPitch" in audioEl) audioEl.mozPreservesPitch = false;
				if ("webkitPreservesPitch" in audioEl) audioEl.webkitPreservesPitch = false;

				audioEl.playbackRate = rate;
			} else {
				audioEl.playbackRate = 1;
			}

			audioEl.currentTime = 0;
			const promise = audioEl.play();
			if (promise?.catch) promise.catch(() => {});
		}

    const audioState = {
      sfxEnabled: loadStoredBool(LS.sfxEnabled, true),
      sfxVolume: loadStoredNumber(LS.sfxVolume, 0.8),
      keyboardEnabled: loadStoredBool(LS.keyboardEnabled, true),
      keyboardVolume: loadStoredNumber(LS.keyboardVolume, 0.8),
      musicEnabled: loadStoredBool(LS.musicEnabled, true),
      musicVolume: loadStoredNumber(LS.musicVolume, 0.8),
      unlocked: false,
      pendingStartup: false,
      ackAlarmOn: false,
      klaxonOn: false,
      processingOn: false
    };

    const vfxState = {
      enabled: loadStoredBool(LS.vfxEnabled, true)
    };

    const fullscreenState = {
      isEnabled: loadStoredBool(LS.fullscreenEnabled, false)
    };

      const audio = {
        click: makeAudioPool("/gatecontrol/click.ogg", 5, 0.35),
				clack: makeAudioPool("/gatecontrol/clack.ogg", 6, 0.28),
        beep: makeAudioPool("/gatecontrol/beep.ogg", 4, 0.55),
        blip: makeAudioPool("/gatecontrol/blip.ogg", 4, 0.4),
        msg: makeAudioPool("/gatecontrol/msg.ogg", 3, 0.6),
        ping: makeAudioPool("/gatecontrol/ping.ogg", 3, 0.6),
        pingplayer: makeAudioPool("/gatecontrol/pingplayer.ogg", 3, 0.6),
        restore: makeAudioPool("/gatecontrol/restore.ogg", 3, 0.5),
        startup: makeAudioPool("/gatecontrol/startup.ogg", 1, 0.65),
        offline: makeAudioPool("/gatecontrol/offline.ogg", 2, 0.65),
        warn: makeAudioPool("/gatecontrol/warn.ogg", 2, 0.65),
        danger: makeAudioPool("/gatecontrol/danger.ogg", 2, 0.65),
        error: makeAudioPool("/gatecontrol/error.ogg", 2, 0.6),
        alert: makeAudioPool("/gatecontrol/alert.ogg", 6, 0.65),
        charged: makeAudioPool("/gatecontrol/charged.ogg", 2, 0.55),
        spend: makeAudioPool("/gatecontrol/spend.ogg", 3, 0.6),
        deduction: makeAudioPool("/gatecontrol/deduction.ogg", 3, 0.65),
        severed: makeAudioPool("/gatecontrol/severed.ogg", 1, 0.7),
        shiftcomplete: makeAudioPool("/gatecontrol/shiftcomplete.ogg", 1, 0.7),
        showhide: makeAudioPool("/gatecontrol/showhide.ogg", 3, 0.45),
        purge: makeLoopAudio("/gatecontrol/purge.ogg", 0.75),
        reset: makeLoopAudio("/gatecontrol/reset.ogg", 0.65),
        scan: makeLoopAudio("/gatecontrol/scan.ogg", 1),
      processing: makeLoopAudio("/gatecontrol/processing.ogg", 0.65),
      qrying: makeLoopAudio("/gatecontrol/qrying.ogg", 0.65),
      ackalarm: makeLoopAudio("/gatecontrol/ackalarm.ogg", 0.65),
      klaxon: makeLoopAudio("/gatecontrol/klaxon.ogg", 0.7),
      music: makeLoopAudio("/gatecontrol/bgaudio.ogg", 0.32),
      // Rare ambient sounds (tied to music volume/toggle)
      amb1: makeAudioPool("/gatecontrol/amb1.ogg", 1, 1),
      amb2: makeAudioPool("/gatecontrol/amb2.ogg", 1, 1),
      amb3: makeAudioPool("/gatecontrol/amb3.ogg", 1, 1),
      amb4: makeAudioPool("/gatecontrol/amb4.ogg", 1, 1),
      amb5: makeAudioPool("/gatecontrol/amb5.ogg", 1, 1),
      amb6: makeAudioPool("/gatecontrol/amb6.ogg", 1, 1)
    };

    const loopAudioKeys = [
      "purge",
      "reset",
      "scan",
      "processing",
      "qrying",
      "ackalarm",
      "klaxon",
    ];

    function primeAudioElement(audioEl) {
      if (!audioEl) return;
      const priorMuted = audioEl.muted;
      const priorVolume = audioEl.volume;
      audioEl.muted = true;
      audioEl.volume = 0;
      const promise = audioEl.play();
      if (promise?.then) {
        promise.then(() => {
          audioEl.pause();
          audioEl.currentTime = 0;
          audioEl.muted = priorMuted;
          audioEl.volume = priorVolume;
        }).catch(() => {
          audioEl.muted = priorMuted;
          audioEl.volume = priorVolume;
        });
      } else {
        try {
          audioEl.pause();
          audioEl.currentTime = 0;
        } catch (_) {}
        audioEl.muted = priorMuted;
        audioEl.volume = priorVolume;
      }
    }

    function primeLoopedAudio() {
      loopAudioKeys.forEach((key) => primeAudioElement(audio[key]));
    }
		
		audio.clack.pitch = { min: 0.8, max: 1.20 }; // try 0.98–1.02 if you want it *very* subtle
		
    function updateAudioButtons() {
      if (ui.btnSfx) {
        ui.btnSfx.textContent = `SFX: ${audioState.sfxEnabled ? "ON" : "OFF"}`;
        ui.btnSfx.setAttribute("aria-pressed", audioState.sfxEnabled ? "true" : "false");
      }
      if (ui.btnKeyboard) {
        ui.btnKeyboard.textContent = `KEYBOARD: ${audioState.keyboardEnabled ? "ON" : "OFF"}`;
        ui.btnKeyboard.setAttribute("aria-pressed", audioState.keyboardEnabled ? "true" : "false");
      }
      if (ui.btnMusic) {
        ui.btnMusic.textContent = `MUSIC: ${audioState.musicEnabled ? "ON" : "OFF"}`;
        ui.btnMusic.setAttribute("aria-pressed", audioState.musicEnabled ? "true" : "false");
      }
      if (ui.btnVfx) {
        ui.btnVfx.textContent = `VFX: ${vfxState.enabled ? "REG" : "LOW"}`;
        ui.btnVfx.setAttribute("aria-pressed", vfxState.enabled ? "true" : "false");
      }
    }

    function updateVolumeControls() {
      const sfxPercent = Math.round(audioState.sfxVolume * 100);
      const keyboardPercent = Math.round(audioState.keyboardVolume * 100);
      const musicPercent = Math.round(audioState.musicVolume * 100);

      if (ui.sfxVolumeSlider) ui.sfxVolumeSlider.value = sfxPercent;
      if (ui.sfxVolumeValue) ui.sfxVolumeValue.textContent = `${sfxPercent}%`;
      if (ui.sfxVolumeCurrentMarker) ui.sfxVolumeCurrentMarker.style.left = `${sfxPercent}%`;

      if (ui.keyboardVolumeSlider) ui.keyboardVolumeSlider.value = keyboardPercent;
      if (ui.keyboardVolumeValue) ui.keyboardVolumeValue.textContent = `${keyboardPercent}%`;
      if (ui.keyboardVolumeCurrentMarker) ui.keyboardVolumeCurrentMarker.style.left = `${keyboardPercent}%`;

      if (ui.musicVolumeSlider) ui.musicVolumeSlider.value = musicPercent;
      if (ui.musicVolumeValue) ui.musicVolumeValue.textContent = `${musicPercent}%`;
      if (ui.musicVolumeCurrentMarker) ui.musicVolumeCurrentMarker.style.left = `${musicPercent}%`;
    }

    function applySfxVolume() {
      const vol = audioState.sfxVolume;
      // Update all SFX audio pools (excluding clack, which is controlled by keyboard volume)
      if (audio.click?.pool) audio.click.pool.forEach(a => a.volume = 0.35 * vol);
      if (audio.beep?.pool) audio.beep.pool.forEach(a => a.volume = 0.55 * vol);
      if (audio.blip?.pool) audio.blip.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.msg?.pool) audio.msg.pool.forEach(a => a.volume = 0.6 * vol);
      if (audio.ping?.pool) audio.ping.pool.forEach(a => a.volume = 0.6 * vol);
      if (audio.restore?.pool) audio.restore.pool.forEach(a => a.volume = 0.5 * vol);
      if (audio.startup?.pool) audio.startup.pool.forEach(a => a.volume = 0.65 * vol);
      if (audio.offline?.pool) audio.offline.pool.forEach(a => a.volume = 0.65 * vol);
      if (audio.warn?.pool) audio.warn.pool.forEach(a => a.volume = 0.65 * vol);
      if (audio.danger?.pool) audio.danger.pool.forEach(a => a.volume = 0.65 * vol);
      if (audio.error?.pool) audio.error.pool.forEach(a => a.volume = 0.6 * vol);
      if (audio.charged?.pool) audio.charged.pool.forEach(a => a.volume = 0.55 * vol);
      if (audio.spend?.pool) audio.spend.pool.forEach(a => a.volume = 0.6 * vol);
      if (audio.deduction?.pool) audio.deduction.pool.forEach(a => a.volume = 0.65 * vol);
      if (audio.severed?.pool) audio.severed.pool.forEach(a => a.volume = 0.7 * vol);
      if (audio.shiftcomplete?.pool) audio.shiftcomplete.pool.forEach(a => a.volume = 0.7 * vol);
      if (audio.showhide?.pool) audio.showhide.pool.forEach(a => a.volume = 0.45 * vol);
      // Update loop SFX
      if (audio.purge) audio.purge.volume = 0.75 * vol;
      if (audio.reset) audio.reset.volume = 0.65 * vol;
      if (audio.scan) audio.scan.volume = 1 * vol;
      if (audio.processing) audio.processing.volume = 0.65 * vol;
      if (audio.qrying) audio.qrying.volume = 0.65 * vol;
      if (audio.ackalarm) audio.ackalarm.volume = 0.65 * vol;
      if (audio.klaxon) audio.klaxon.volume = 0.7 * vol;
    }

    function applyMusicVolume() {
      if (audio.music) audio.music.volume = 0.32 * audioState.musicVolume;
      // Update ambient sounds volume
      const vol = audioState.musicVolume;
      if (audio.amb1?.pool) audio.amb1.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.amb2?.pool) audio.amb2.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.amb3?.pool) audio.amb3.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.amb4?.pool) audio.amb4.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.amb5?.pool) audio.amb5.pool.forEach(a => a.volume = 0.4 * vol);
      if (audio.amb6?.pool) audio.amb6.pool.forEach(a => a.volume = 0.4 * vol);
    }

    function applyKeyboardVolume() {
      const vol = audioState.keyboardVolume;
      if (audio.clack?.pool) audio.clack.pool.forEach(a => a.volume = 0.28 * vol);
    }

    function setSfxVolume(volume) {
      audioState.sfxVolume = Math.max(0, Math.min(1, volume));
      storeNumber(LS.sfxVolume, audioState.sfxVolume);
      applySfxVolume();
      updateVolumeControls();
    }

    function setMusicVolume(volume) {
      audioState.musicVolume = Math.max(0, Math.min(1, volume));
      storeNumber(LS.musicVolume, audioState.musicVolume);
      applyMusicVolume();
      updateVolumeControls();
    }

    function setKeyboardVolume(volume) {
      audioState.keyboardVolume = Math.max(0, Math.min(1, volume));
      storeNumber(LS.keyboardVolume, audioState.keyboardVolume);
      applyKeyboardVolume();
      updateVolumeControls();
    }

    function setKeyboardEnabled(enabled) {
      audioState.keyboardEnabled = !!enabled;
      storeBool(LS.keyboardEnabled, audioState.keyboardEnabled);
      updateAudioButtons();
    }

    const coopLocalOnlySounds = new Set(["click", "clack", "showhide"]);

    function shouldSyncCoopSound(name) {
      return !!name && !coopLocalOnlySounds.has(name);
    }

    function playSfx(name, broadcast = true) {
      // Sync sound to co-op players FIRST (regardless of local audio settings)
      if (broadcast && runtime.multiplayer.coop.enabled && shouldSyncCoopSound(name)) {
        syncSoundToCoopPlayers(name);
      }

      // Then play locally if audio is enabled
      const isEnabled = (name === "clack") ? audioState.keyboardEnabled : audioState.sfxEnabled;
      if (!isEnabled || !audioState.unlocked) return;
      const group = audio[name];
      if (!group) return;
      if (group.pool) {
        playAudioPool(group);
      } else {
        if (group.currentTime !== undefined) group.currentTime = 0;
        const promise = group.play?.();
        if (promise?.catch) promise.catch(() => {});
      }
    }

    function syncSoundToCoopPlayers(sfxName) {
      if (!runtime.multiplayer?.coop?.enabled) {
        console.log("[SOUND SYNC] Skipped - coop not enabled", sfxName);
        return;
      }
      if (!sfxName) return;

      console.log("[SOUND SYNC]", sfxName, "role:", runtime.multiplayer.coop.role);

      try {
        if (runtime.multiplayer.coop.role === "host") {
          // Host broadcasts sound to all invited players
          if (typeof sendCoopEvent === "function") {
            console.log("[SOUND SYNC] Host sending sound event:", sfxName);
            sendCoopEvent("sound", { sfx: sfxName });
          } else {
            console.error("[SOUND SYNC] sendCoopEvent not defined!");
          }
        } else if (runtime.multiplayer.coop.role === "invited") {
          // Invited player sends sound to host, who will rebroadcast to everyone
          if (typeof sendCoopAction === "function") {
            console.log("[SOUND SYNC] Invited sending sound action:", sfxName);
            sendCoopAction("sound", { sfx: sfxName });
          } else {
            console.error("[SOUND SYNC] sendCoopAction not defined!");
          }
        }
      } catch (err) {
        console.error("Failed to sync sound to co-op players:", err);
      }
    }

    function syncSoundStopToCoopPlayers(sfxName) {
      if (!runtime.multiplayer?.coop?.enabled) {
        console.log("[SOUND SYNC] Skipped stop - coop not enabled", sfxName);
        return;
      }
      if (!sfxName) return;

      console.log("[SOUND SYNC] stop", sfxName, "role:", runtime.multiplayer.coop.role);

      try {
        if (runtime.multiplayer.coop.role === "host") {
          if (typeof sendCoopEvent === "function") {
            console.log("[SOUND SYNC] Host sending sound stop:", sfxName);
            sendCoopEvent("sound_stop", { sfx: sfxName });
          } else {
            console.error("[SOUND SYNC] sendCoopEvent not defined!");
          }
        } else if (runtime.multiplayer.coop.role === "invited") {
          if (typeof sendCoopAction === "function") {
            console.log("[SOUND SYNC] Invited sending sound stop:", sfxName);
            sendCoopAction("sound_stop", { sfx: sfxName });
          } else {
            console.error("[SOUND SYNC] sendCoopAction not defined!");
          }
        }
      } catch (err) {
        console.error("Failed to sync sound stop to co-op players:", err);
      }
    }

    function stopSfx(name, broadcast = true) {
      const group = audio[name];
      if (!group || group.pool) return;
      group.pause?.();
      if (group.currentTime !== undefined) group.currentTime = 0;

      if (broadcast && runtime.multiplayer?.coop?.enabled && shouldSyncCoopSound(name)) {
        if (runtime.multiplayer.coop.role === "host") {
          syncSoundStopToCoopPlayers(name);
        }
      }
    }

    function stopMaintenanceSfx() {
      stopSfx("purge");
      stopSfx("reset");
      stopSfx("scan");
    }

    function updateMusicState() {
      if (!audioState.musicEnabled || !audioState.unlocked) {
        audio.music.pause();
        return;
      }
      const promise = audio.music.play();
      if (promise?.catch) promise.catch(() => {});
    }

    function updateProcessingSound() {
      if (!audio.processing) return;
      const shouldBroadcast = runtime.processingCount > 0;
      const wasBroadcasting = audioState.processingOn;
      audioState.processingOn = shouldBroadcast;

      const shouldPlayLocal = audioState.sfxEnabled && audioState.unlocked && runtime.processingCount > 0;
      if (shouldPlayLocal) {
        const promise = audio.processing.play();
        if (promise?.catch) promise.catch(() => {});
      } else {
        audio.processing.pause();
        audio.processing.currentTime = 0;
      }

      if (!runtime.multiplayer?.coop?.enabled || !shouldSyncCoopSound("processing")) return;
      if (wasBroadcasting === shouldBroadcast) return;
      if (runtime.multiplayer.coop.role !== "host") return;

      if (shouldBroadcast) {
        sendCoopEvent("sound", { sfx: "processing" });
      } else {
        sendCoopEvent("sound_stop", { sfx: "processing" });
      }
    }

    function bumpProcessingSound(delta) {
      runtime.processingCount = Math.max(0, (runtime.processingCount || 0) + delta);
      updateProcessingSound();
    }

    function setAckAlarm(active, broadcast = true) {
      const wasOn = audioState.ackAlarmOn;
      audioState.ackAlarmOn = active;

      // Broadcast alarm state only if coop is enabled and host state changed.
      if (broadcast && wasOn !== active && runtime.multiplayer?.coop?.enabled && runtime.multiplayer.coop.role === "host") {
        console.log("[SOUND SYNC] Broadcasting ack_alarm:", active);
        sendCoopEvent("ack_alarm", { active: active });
      }

      // Respect this player's own sound settings
      if (!audioState.sfxEnabled || !audioState.unlocked) {
        audio.ackalarm.pause();
        audio.ackalarm.currentTime = 0;
        return;
      }
      if (active) {
        const promise = audio.ackalarm.play();
        if (promise?.catch) promise.catch(() => {});
      } else {
        audio.ackalarm.pause();
        audio.ackalarm.currentTime = 0;
      }
    }

    function setKlaxon(active, broadcast = true) {
      const wasOn = audioState.klaxonOn;
      audioState.klaxonOn = active;

      // Broadcast alarm state only if coop is enabled and host state changed.
      if (broadcast && wasOn !== active && runtime.multiplayer?.coop?.enabled && runtime.multiplayer.coop.role === "host") {
        console.log("[SOUND SYNC] Broadcasting klaxon:", active);
        sendCoopEvent("klaxon", { active: active });
      }

      // Respect this player's own sound settings
      if (!audioState.sfxEnabled || !audioState.unlocked) {
        audio.klaxon.pause();
        audio.klaxon.currentTime = 0;
        return;
      }
      if (active) {
        const promise = audio.klaxon.play();
        if (promise?.catch) promise.catch(() => {});
      } else {
        audio.klaxon.pause();
        audio.klaxon.currentTime = 0;
      }
    }

    function updateAckAlarm() {
      const g = activeGate();
      const sourceGateId = g.id;
      const hasAck = (g.relays || []).some(r => r.awaitingAck && !r.offline);
      setAckAlarm(hasAck);
    }

    function updateKlaxon() {
      const g = activeGate();
      const now = Date.now();
      // Check if any docked ship has critical exposure (<=20s)
      const hasCriticalExposure = (g.dockSlots || []).some(slot => {
        if (!slot.shipId) return false;
        const ship = findShipById(g, slot.shipId);
        if (!ship || ship.state !== "WAITING DECON" || !ship.exposureDeadline) return false;
        const left = Math.max(0, Math.ceil((ship.exposureDeadline - now) / 1000));
        return left <= 20 && left > 0;
      });
      const gateAlertRemainingMs = gateSystemsSeverRemainingMs(g, now);
      const hasGateSystemKlaxon = gateSystemsCritical(g)
        && gateAlertRemainingMs > 0
        && gateAlertRemainingMs <= GATE_SYSTEMS_KLAXON_MS;
      setKlaxon(hasCriticalExposure || hasGateSystemKlaxon);
    }

    function setSfxEnabled(enabled) {
      audioState.sfxEnabled = !!enabled;
      storeBool(LS.sfxEnabled, audioState.sfxEnabled);
      if (!audioState.sfxEnabled) {
        setAckAlarm(false);
        setKlaxon(false);
        stopMaintenanceSfx();
      } else {
        updateAckAlarm();
        updateKlaxon();
      }
      updateAudioButtons();
      updateProcessingSound();
    }

    function setMusicEnabled(enabled) {
      audioState.musicEnabled = !!enabled;
      storeBool(LS.musicEnabled, audioState.musicEnabled);
      updateAudioButtons();
      updateMusicState();
    }

    function setVfxEnabled(enabled) {
      vfxState.enabled = !!enabled;
      storeBool(LS.vfxEnabled, vfxState.enabled);
      updateAudioButtons();
      applyVfxMode();
    }

    function applyVfxMode() {
      if (vfxState.enabled) {
        document.body.classList.remove("vfx-low");
      } else {
        document.body.classList.add("vfx-low");
      }
    }

    function requestStartupSound() {
      if (audioState.unlocked && audioState.sfxEnabled) {
        playSfx("startup");
      } else {
        audioState.pendingStartup = true;
      }
    }

    function unlockAudio() {
      if (audioState.unlocked) return;
      audioState.unlocked = true;
      primeLoopedAudio();
      updateMusicState();
      if (audioState.pendingStartup) {
        audioState.pendingStartup = false;
        playSfx("startup");
      }
      if (audioState.ackAlarmOn) {
        setAckAlarm(true);
      }
      updateProcessingSound();
    }

    // Rare ambient sound system
    function checkAmbientSound() {
      // Only play if music is enabled, audio is unlocked, and game is not severed
      if (!audioState.musicEnabled || !audioState.unlocked || runtime.severed) return;

      // Very low chance: 1.5% per check (with checks every 60 seconds)
      // This means roughly 1-2 ambient sounds per hour on average
      if (Math.random() < 0.015) {
        // Randomly select one of the 6 ambient sounds
        const ambientSounds = ['amb1', 'amb2', 'amb3', 'amb4', 'amb5', 'amb6'];
        const randomSound = ambientSounds[Math.floor(Math.random() * ambientSounds.length)];
        playAudioPool(audio[randomSound]);
      }
    }

    function isUiInteractionTarget(target) {
      if (!(target instanceof Element)) return false;
      return !!target.closest("#game-container, #severed-overlay, #confirm-reset-overlay, #confirm-clearance-overlay, #help-panel");
    }

    function getGate(gateId) {
      if (!runtime.gate || runtime.gate.id !== gateId) {
        runtime.gate = loadGateState(gateId) || makeGateState(gateId);
      }
      return runtime.gate;
    }

    function activeGate() { return runtime.gate || getGate(runtime.activeGateId); }

    function corruptMessageText(text, combinedScore) {
      // Map combined score to corruption rate
      // Still strong, but scales more gradually so single-relay issues remain readable.
      let corruptionRate;
      if (combinedScore === 0) {
        corruptionRate = 0;
      } else if (combinedScore <= 2) {
        corruptionRate = 0.22;  // One relay degraded/offline - noticeable but readable
      } else if (combinedScore <= 3) {
        corruptionRate = 0.32;  // One side critical, other healthy
      } else if (combinedScore <= 4) {
        corruptionRate = 0.42;  // Both degraded or one severing
      } else if (combinedScore <= 5) {
        corruptionRate = 0.58;  // Mixed critical/degraded
      } else if (combinedScore <= 6) {
        corruptionRate = 0.70;  // Both critical
      } else if (combinedScore <= 7) {
        corruptionRate = 0.80;  // Critical + severing
      } else {
        corruptionRate = 0.90;  // Severe network failure - near total corruption
      }

      if (corruptionRate === 0) return text;

      const symbols = ['#', '$', '!', '@', '%', '^', '&', '*'];
      const chars = text.split('');

      for (let i = 0; i < chars.length; i++) {
        if (Math.random() < corruptionRate) {
          if (Math.random() < 0.80) {
            // 80% replace with symbol
            chars[i] = symbols[Math.floor(Math.random() * symbols.length)];
          } else {
            // 20% delete
            chars[i] = '';
          }
        }
      }

      return chars.join('');
    }

    function calculateMessageDelayMs(basePingMs, senderScore, receiverScore) {
      let additionalDelay = 0;

      // Sender degradation delay
      if (senderScore === 2) {
        additionalDelay += 1000 + Math.random() * 1000; // +1-2s
      } else if (senderScore === 3) {
        additionalDelay += 2000 + Math.random() * 2000; // +2-4s
      } else if (senderScore === 4) {
        additionalDelay += 3000 + Math.random() * 3000; // +3-6s
      }

      // Receiver degradation delay
      if (receiverScore === 2) {
        additionalDelay += 1000 + Math.random() * 1000; // +1-2s
      } else if (receiverScore === 3) {
        additionalDelay += 2000 + Math.random() * 2000; // +2-4s
      } else if (receiverScore === 4) {
        additionalDelay += 3000 + Math.random() * 3000; // +3-6s
      }

      return Math.round(basePingMs + additionalDelay);
    }

    function ensureGateStats(g) {
        if (!g.stats || typeof g.stats !== "object") {
          g.stats = {
            approved: 0,
            denied: 0,
            deniedCorrect: 0,
            deniedIncorrect: 0,
            deconStarts: 0,
            workOrdersIssued: 0,
            workOrdersCompleted: 0,
            relayRepairs: 0,
            relayAcks: 0,
            maintenanceOps: 0,
            resourceOrders: 0,
            resourceOrderSpend: 0,
            purchaseSpend: 0,
            breakSpend: 0,
            deadlinesMet: 0,
            deadlinesMissed: 0,
            criticalMisses: 0,
            urgentMisses: 0,
            inboundTimeouts: 0
          };
        }
        if (typeof g.stats.approved !== "number") g.stats.approved = 0;
        if (typeof g.stats.denied !== "number") g.stats.denied = 0;
        if (typeof g.stats.deniedCorrect !== "number") g.stats.deniedCorrect = 0;
        if (typeof g.stats.deniedIncorrect !== "number") g.stats.deniedIncorrect = 0;
        if (typeof g.stats.deconStarts !== "number") g.stats.deconStarts = 0;
      if (typeof g.stats.workOrdersIssued !== "number") g.stats.workOrdersIssued = 0;
      if (typeof g.stats.workOrdersCompleted !== "number") g.stats.workOrdersCompleted = 0;
      if (typeof g.stats.relayRepairs !== "number") g.stats.relayRepairs = 0;
      if (typeof g.stats.relayAcks !== "number") g.stats.relayAcks = 0;
      if (typeof g.stats.maintenanceOps !== "number") g.stats.maintenanceOps = 0;
      if (typeof g.stats.resourceOrders !== "number") g.stats.resourceOrders = 0;
      if (typeof g.stats.resourceOrderSpend !== "number") g.stats.resourceOrderSpend = 0;
      if (typeof g.stats.purchaseSpend !== "number") g.stats.purchaseSpend = 0;
      if (typeof g.stats.breakSpend !== "number") g.stats.breakSpend = 0;
      if (typeof g.stats.contrabandDenied !== "number") g.stats.contrabandDenied = 0;
      if (typeof g.stats.illegalApprovals !== "number") g.stats.illegalApprovals = 0;
      if (typeof g.stats.deadlinesMet !== "number") g.stats.deadlinesMet = 0;
      if (typeof g.stats.deadlinesMissed !== "number") g.stats.deadlinesMissed = 0;
      if (typeof g.stats.criticalMisses !== "number") g.stats.criticalMisses = 0;
      if (typeof g.stats.urgentMisses !== "number") g.stats.urgentMisses = 0;
      if (typeof g.stats.inboundTimeouts !== "number") g.stats.inboundTimeouts = 0;
      return g.stats;
    }

    const DEDUCTION_STATS = new Set([
      "deniedIncorrect",
      "illegalApprovals",
      "deadlinesMissed",
      "criticalMisses",
      "urgentMisses",
      "operatorErrors",
      "inboundTimeouts"
    ]);

    function bumpStat(g, key, amount = 1) {
      const stats = ensureGateStats(g);
      stats[key] = (stats[key] || 0) + amount;

      if (amount > 0 && DEDUCTION_STATS.has(key) && g.id === runtime.activeGateId) {
        const now = Date.now();
        if (!runtime.lastWageDeductionAt || (now - runtime.lastWageDeductionAt) > 300) {
          runtime.lastWageDeductionAt = now;
          playSfx("deduction");
        }
      }

      // Real-time lifetime stat tracking for maintenance operations
      if (key === "maintenanceOps") {
        const lifetimeStats = loadLifetimeStats();
        lifetimeStats.totalMaintenanceOps += amount;
        saveLifetimeStats(lifetimeStats);
      }
    }

    function computeBaseWage(stats, shiftMs) {
      const minutes = Math.floor(shiftMs / 60000);
      const base = 8;
      const safe = stats || {};
          const credits = base
            + (minutes * 1.0)
            + ((safe.approved || 0) * 4)
            + ((safe.deniedCorrect || 0) * 3)
            - ((safe.deniedIncorrect || 0) * 15)
            + ((safe.deconStarts || 0) * 2)
            + ((safe.contrabandDenied || 0) * 8)
            - ((safe.illegalApprovals || 0) * 20)
            - ((safe.workOrdersIssued || 0) * 10)
        + ((safe.workOrdersCompleted || 0) * 5)
        + ((safe.relayRepairs || 0) * 3)
        + ((safe.relayAcks || 0) * 1)
        + ((safe.maintenanceOps || 0) * 1)
        + ((safe.resourceOrders || 0) * 1)
        - ((safe.resourceOrderSpend || 0))
        - ((safe.purchaseSpend || 0))
        - ((safe.breakSpend || 0))
        + ((safe.deadlinesMet || 0) * 2)
        - ((safe.deadlinesMissed || 0) * 10)
        - ((safe.criticalMisses || 0) * 5)
        - ((safe.urgentMisses || 0) * 2)
        - ((safe.operatorErrors || 0) * 5)
        - ((safe.inboundTimeouts || 0) * 10);
        return Math.max(0, Math.floor(credits));
      }

    function computeWage(stats, shiftMs) {
      const baseWage = computeBaseWage(stats, shiftMs);
      // Shift length no longer scales wage; only event/timer pacing scales with shift duration.
      return Math.max(0, Math.floor(baseWage));
    }

    // ===== SCORE CALCULATION FUNCTIONS =====

    function computeScore(stats, shiftMs, wage, mode) {
      mode = mode || loadShiftMode() || "normal";
      const shiftDurationMs = loadShiftDuration();

      if (mode === "endurance") {
        return computeEnduranceModeScore(stats, shiftMs, wage);
      } else if (mode === "unlimited" || shiftDurationMs === -1) {
        return computeUnlimitedModeScore(stats, shiftMs, wage);
      } else {
        return computeNormalModeScore(stats, shiftMs, wage);
      }
    }

    function computeNormalModeScore(stats, shiftMs, wage) {
      const safe = stats || {};
      const shiftMinutes = shiftMs / 60000;
      const shiftHours = shiftMs / 3600000;
      const tenMinBlocks = Math.max(1, shiftMinutes / 10);

      // Efficiency metrics (per hour rates)
      const approvalRate = (safe.approved || 0) / Math.max(0.1, shiftHours);
      const deniedCorrectRate = (safe.deniedCorrect || 0) / Math.max(0.1, shiftHours);
      const deniedIncorrectRate = (safe.deniedIncorrect || 0) / Math.max(0.1, shiftHours);
      const accuracyBonus = deniedCorrectRate - deniedIncorrectRate;
      const maintenanceEfficiency = ((safe.workOrdersCompleted || 0) + (safe.relayRepairs || 0)) / Math.max(0.1, shiftHours);

      // Performance quality multipliers
      const totalDenials = (safe.deniedCorrect || 0) + (safe.deniedIncorrect || 0);
      const accuracyRatio = totalDenials > 0 ? (safe.deniedCorrect || 0) / totalDenials : 1;
      const qualityMultiplier = 1 + (accuracyRatio * 0.5);

      // Critical performance penalties (normalized per 10-min block)
      const errorPenalty = ((safe.criticalMisses || 0) * 50 +
                          (safe.urgentMisses || 0) * 20 +
                          (safe.operatorErrors || 0) * 15 +
                          (safe.deadlinesMissed || 0) * 10) / tenMinBlocks;

      // Wage efficiency (credits per minute)
      // Add back spend to get neutral wage (not penalized for breaks, fuel, supplies, relays, docks)
      const neutralWage = wage + (safe.resourceOrderSpend || 0) + (safe.purchaseSpend || 0) + (safe.breakSpend || 0);
      const wagePerMinute = neutralWage / Math.max(1, shiftMinutes);

      // Final normalized score (per 10-minute block)
      const baseScore = (approvalRate * 10) +
                        (accuracyBonus * 8) +
                        (maintenanceEfficiency * 12) +
                        (wagePerMinute * 5);

      const score = Math.max(0, Math.floor((baseScore * qualityMultiplier) - errorPenalty));

      return score;
    }

    function computeUnlimitedModeScore(stats, shiftMs, wage) {
      const safe = stats || {};
      const shiftMinutes = shiftMs / 60000;
      const shiftHours = shiftMs / 3600000;
      const tenMinBlocks = Math.max(1, shiftMinutes / 10);

      // Endurance bonus grows logarithmically (diminishing returns)
      const enduranceBonus = Math.floor(Math.log(Math.max(1, shiftHours)) * 50);

      // Total throughput (raw performance)
      const throughput = (safe.approved || 0) * 4 +
                        (safe.deniedCorrect || 0) * 3 +
                        (safe.workOrdersCompleted || 0) * 3 +
                        (safe.relayAcks || 0) * 1;

      // Survival penalty (errors hurt more in unlimited mode)
      const errorPenalty = (safe.criticalMisses || 0) * 100 +
                          (safe.urgentMisses || 0) * 40 +
                          (safe.operatorErrors || 0) * 25 +
                          (safe.deniedIncorrect || 0) * 5;

      // Wage contribution
      // Add back spend to get neutral wage (not penalized for breaks, fuel, supplies, relays, docks)
      const neutralWage = wage + (safe.resourceOrderSpend || 0) + (safe.purchaseSpend || 0) + (safe.breakSpend || 0);
      const wageBonus = Math.floor(neutralWage * 0.5);

      // Scale by 10-minute blocks (for relative comparison within unlimited mode only)
      const rawScore = throughput + enduranceBonus + wageBonus - errorPenalty;
      const score = Math.max(0, Math.floor(rawScore / tenMinBlocks));

      return score;
    }

    function computeEnduranceModeScore(stats, shiftMs, wage) {
      const safe = stats || {};
      const shiftMinutes = shiftMs / 60000;
      const tenMinBlocks = Math.max(1, shiftMinutes / 10);

      // Survival time is the primary metric (2 points per minute)
      const survivalScore = Math.floor(shiftMinutes * 2);

      // Perfect performance bonus (one-time 200 point bonus)
      const perfectBonus = ((safe.criticalMisses || 0) === 0 &&
                            (safe.urgentMisses || 0) === 0 &&
                            (safe.deadlinesMissed || 0) === 0) ? 200 : 0;

      // Maintenance mastery (keeping systems running under pressure)
      const maintenanceScore = (safe.relayAcks || 0) * 2 +
                              (safe.relayRepairs || 0) * 5 +
                              (safe.workOrdersCompleted || 0) * 4;

      // Harsh penalties for errors (endurance is about perfection)
      const errorPenalty = (safe.criticalMisses || 0) * 150 +
                          (safe.urgentMisses || 0) * 60 +
                          (safe.operatorErrors || 0) * 40;

      // Scale by 10-minute blocks (for relative comparison within endurance mode only)
      const rawScore = survivalScore + perfectBonus + maintenanceScore - errorPenalty;
      const score = Math.max(0, Math.floor(rawScore / tenMinBlocks));

      return score;
    }

    function updateSeveredOverlay(summary) {
      if (!summary) return;

      const shiftMode = loadShiftMode() || "normal";
      const shiftDurationMs = loadShiftDuration();
      const score = computeScore(summary.stats || ensureGateStats(activeGate()), summary.shiftMs, summary.wage, shiftMode);

      ui.severedGate.textContent = summary.gateId;
      ui.severedTime.textContent = formatClock(summary.time);
      ui.severedCause.textContent = summary.cause;
      ui.severedShift.textContent = formatHMS(summary.shiftMs);
      ui.severedApproved.textContent = String(summary.approved);
      ui.severedDenied.textContent = String(summary.denied);
      ui.severedWage.textContent = `${summary.wage} credits`;

      // Add score display
      if (ui.severedScore) {
        ui.severedScore.textContent = String(score);
      }

      // Show mode if not normal
      if (ui.severedModeDisplay && ui.severedMode) {
        if (shiftMode === "unlimited" || shiftDurationMs === -1) {
          ui.severedModeDisplay.style.display = "grid";
          ui.severedMode.textContent = "UNLIMITED MODE";
        } else if (shiftMode === "endurance") {
          ui.severedModeDisplay.style.display = "grid";
          ui.severedMode.textContent = "ENDURANCE MODE";
        } else {
          ui.severedModeDisplay.style.display = "none";
        }
      }

      // Display newly unlocked achievements
      const achievementsContainer = document.getElementById("severed-achievements-container");
      if (achievementsContainer) {
        if (summary.newAchievements && summary.newAchievements.length > 0) {
          achievementsContainer.innerHTML = "";
          achievementsContainer.style.display = "block";
          achievementsContainer.className = "shiftcomplete-achievements";

          const title = document.createElement("div");
          title.className = "shiftcomplete-achievement-title";
          title.textContent = summary.newAchievements.length === 1 ? "ACHIEVEMENT UNLOCKED" : `${summary.newAchievements.length} ACHIEVEMENTS UNLOCKED`;
          achievementsContainer.appendChild(title);

          for (const achievement of summary.newAchievements) {
            const item = document.createElement("div");
            item.className = "shiftcomplete-achievement-item";

            const icon = document.createElement("div");
            icon.className = "shiftcomplete-achievement-icon";
            icon.textContent = achievement.icon;

            const nameDiv = document.createElement("div");
            nameDiv.className = "shiftcomplete-achievement-name";
            nameDiv.textContent = achievement.name;

            item.appendChild(icon);
            item.appendChild(nameDiv);
            achievementsContainer.appendChild(item);
          }
        } else {
          achievementsContainer.style.display = "none";
        }
      }
    }

    function updateShiftcompleteOverlay(summary) {
      if (!summary) return;

      const shiftMode = loadShiftMode() || "normal";
      const shiftDurationMs = loadShiftDuration();
      const score = computeScore(summary.stats || ensureGateStats(activeGate()), summary.shiftMs, summary.wage, shiftMode);

      ui.shiftcompleteGate.textContent = summary.gateId;
      ui.shiftcompleteTime.textContent = formatClock(summary.time);
      ui.shiftcompleteShift.textContent = formatHMS(summary.shiftMs);
      ui.shiftcompleteHealth.textContent = summary.health;
      ui.shiftcompleteApproved.textContent = String(summary.approved);
      ui.shiftcompleteDenied.textContent = String(summary.denied);
      ui.shiftcompleteWage.textContent = `${summary.wage} credits`;

      // Add score display
      if (ui.shiftcompleteScore) {
        ui.shiftcompleteScore.textContent = String(score);
      }

      // Show mode if not normal
      if (ui.shiftcompleteModeDisplay && ui.shiftcompleteMode) {
        if (shiftMode === "unlimited" || shiftDurationMs === -1) {
          ui.shiftcompleteModeDisplay.style.display = "grid";
          ui.shiftcompleteMode.textContent = "UNLIMITED MODE";
        } else if (shiftMode === "endurance") {
          ui.shiftcompleteModeDisplay.style.display = "grid";
          ui.shiftcompleteMode.textContent = "ENDURANCE MODE";
        } else {
          ui.shiftcompleteModeDisplay.style.display = "none";
        }
      }

      // Show theme unlock if a theme was unlocked
      if (ui.shiftcompleteThemeUnlock && ui.shiftcompleteThemeName) {
        if (summary.unlockedTheme && summary.unlockedThemeName) {
          ui.shiftcompleteThemeUnlock.style.display = "block";
          ui.shiftcompleteThemeName.textContent = summary.unlockedThemeName;
        } else {
          ui.shiftcompleteThemeUnlock.style.display = "none";
        }
      }

      // Display newly unlocked achievements
      const achievementsContainer = document.getElementById("shiftcomplete-achievements-container");
      if (achievementsContainer) {
        if (summary.newAchievements && summary.newAchievements.length > 0) {
          achievementsContainer.innerHTML = "";
          achievementsContainer.style.display = "block";
          achievementsContainer.className = "shiftcomplete-achievements";

          const title = document.createElement("div");
          title.className = "shiftcomplete-achievement-title";
          title.textContent = summary.newAchievements.length === 1 ? "ACHIEVEMENT UNLOCKED" : `${summary.newAchievements.length} ACHIEVEMENTS UNLOCKED`;
          achievementsContainer.appendChild(title);

          for (const achievement of summary.newAchievements) {
            const item = document.createElement("div");
            item.className = "shiftcomplete-achievement-item";

            const icon = document.createElement("div");
            icon.className = "shiftcomplete-achievement-icon";
            icon.textContent = achievement.icon;

            const nameDiv = document.createElement("div");
            nameDiv.className = "shiftcomplete-achievement-name";
            nameDiv.textContent = achievement.name;

            item.appendChild(icon);
            item.appendChild(nameDiv);
            achievementsContainer.appendChild(item);
          }
        } else {
          achievementsContainer.style.display = "none";
        }
      }
    }

    function updateScorePanel() {
      const g = activeGate();
      if (!g) return;

      const stats = ensureGateStats(g);
      const shiftMs = getShiftMs();
      const wage = computeWage(stats, shiftMs);
      const shiftMode = loadShiftMode() || "normal";
      const shiftDurationMs = loadShiftDuration();
      const score = computeScore(stats, shiftMs, wage, shiftMode);

      // Update score display
      if (ui.currentScoreDisplay) {
        ui.currentScoreDisplay.textContent = String(score);
      }

      // Update mode display
      if (ui.scoreModeDisplay) {
        const modeLabel = shiftMode === "endurance" ? "ENDURANCE MODE" :
                          shiftMode === "unlimited" || shiftDurationMs === -1 ? "UNLIMITED MODE" : "Normal Mode";
        ui.scoreModeDisplay.textContent = modeLabel;
      }

      // Update session details
      if (ui.scoreGateId) ui.scoreGateId.textContent = g.id || "GATE-00";
      if (ui.scoreOperator) ui.scoreOperator.textContent = runtime.operatorCallsign || "UNASSIGNED";
      if (ui.scoreShiftLength) {
        if (shiftMode === "unlimited" || shiftDurationMs === -1) {
          ui.scoreShiftLength.textContent = "UNLIMITED";
        } else {
          ui.scoreShiftLength.textContent = formatHMS(shiftDurationMs);
        }
      }
      if (ui.scoreTimeElapsed) ui.scoreTimeElapsed.textContent = formatHMS(shiftMs);
      if (ui.scoreProgress) {
        if (shiftMode === "unlimited" || shiftDurationMs === -1) {
          ui.scoreProgress.textContent = "N/A";
        } else {
          const percentage = Math.min(100, Math.floor((shiftMs / shiftDurationMs) * 100));
          ui.scoreProgress.textContent = `${percentage}%`;
        }
      }

      // Update traffic stats
      if (ui.scoreApproved) ui.scoreApproved.textContent = String(stats.approved || 0);
      if (ui.scoreDenied) ui.scoreDenied.textContent = String(stats.denied || 0);
      if (ui.scoreDeniedCorrect) ui.scoreDeniedCorrect.textContent = String(stats.deniedCorrect || 0);
      if (ui.scoreDeniedIncorrect) ui.scoreDeniedIncorrect.textContent = String(stats.deniedIncorrect || 0);
      if (ui.scoreDecon) ui.scoreDecon.textContent = String(stats.deconStarts || 0);

      // Update maintenance stats
      if (ui.scoreWoIssued) ui.scoreWoIssued.textContent = String(stats.workOrdersIssued || 0);
      if (ui.scoreWoCompleted) ui.scoreWoCompleted.textContent = String(stats.workOrdersCompleted || 0);
      if (ui.scoreRelayRepairs) ui.scoreRelayRepairs.textContent = String(stats.relayRepairs || 0);
      if (ui.scoreRelayAcks) ui.scoreRelayAcks.textContent = String(stats.relayAcks || 0);
      if (ui.scoreMaintenance) ui.scoreMaintenance.textContent = String(stats.maintenanceOps || 0);

      // Update performance stats
      if (ui.scoreDeadlinesMet) ui.scoreDeadlinesMet.textContent = String(stats.deadlinesMet || 0);
      if (ui.scoreDeadlinesMissed) ui.scoreDeadlinesMissed.textContent = String(stats.deadlinesMissed || 0);
      if (ui.scoreCriticalMisses) ui.scoreCriticalMisses.textContent = String(stats.criticalMisses || 0);
      if (ui.scoreUrgentMisses) ui.scoreUrgentMisses.textContent = String(stats.urgentMisses || 0);
      if (ui.scoreOperatorErrors) ui.scoreOperatorErrors.textContent = String(stats.operatorErrors || 0);
      if (ui.scoreInboundTimeouts) ui.scoreInboundTimeouts.textContent = String(stats.inboundTimeouts || 0);

      // Update financial stats
      if (ui.scoreWageEarned) ui.scoreWageEarned.textContent = `${wage} credits`;
      if (ui.scoreResourceOrders) ui.scoreResourceOrders.textContent = String(stats.resourceOrders || 0);
      if (ui.scoreResourceSpend) ui.scoreResourceSpend.textContent = `${stats.resourceOrderSpend || 0} credits`;

      // Update calculation note based on mode
      if (ui.scoreCalculationNote) {
        if (shiftMode === "endurance") {
          ui.scoreCalculationNote.textContent = "Score = 2 pts/min survival + perfect execution bonus. Extreme penalties for errors.";
        } else if (shiftMode === "unlimited" || shiftDurationMs === -1) {
          ui.scoreCalculationNote.textContent = "Score = throughput + endurance bonus (grows with time) + wage. Higher error penalties.";
        } else {
          ui.scoreCalculationNote.textContent = "Score measures efficiency and performance density (normalized per 10 min)";
        }
      }
    }

    function setScorePanelOpen(open) {
      if (!ui.scorePanel) return;
      ui.scorePanel.classList.toggle("open", open);
      ui.scorePanel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ui.btnScore) {
        ui.btnScore.setAttribute("aria-expanded", open ? "true" : "false");
      }
      if (open) {
        updateScorePanel();
      }
    }

    function clearLog(el) {
      if (!el) return;
      // Keep the sticky header and subsection-content wrapper
      const head = el.querySelector(".loghead");
      const content = el.querySelector(".subsection-content");
      el.innerHTML = "";
      if (head) el.appendChild(head);
      if (content) {
        content.innerHTML = "";
        el.appendChild(content);
      }
    }

    // Track recent messages for deduplication (max 5 entries)
    const recentMessages = [];

    function logLine(el, text, cls = "dim", opts = {}) {
      const now = Date.now();

      if (!opts.allowDuplicate) {
        // Clean old entries (>3 seconds)
        while (recentMessages.length > 0 && now - recentMessages[0].timestamp > 3000) {
          recentMessages.shift();
        }

        // Check for duplicates within last 2 seconds
        const isDuplicate = recentMessages.some(msg =>
          msg.text === text && (now - msg.timestamp) < 2000
        );

        if (isDuplicate) {
          return; // Skip duplicate message
        }

        // Add message to recent list
        recentMessages.push({ text, timestamp: now });
        if (recentMessages.length > 5) {
          recentMessages.shift(); // Keep only last 5
        }
      }

      // Check if user is at the bottom before adding new content (with small threshold for rounding)
      const scrollBottom = el.scrollHeight - el.scrollTop;
      const isAtBottom = scrollBottom <= el.clientHeight + 5;

      const div = document.createElement("div");
      div.className = `terminal-line ${cls}`;
      div.innerHTML = escapeText(text);
      // Append to subsection-content if it exists, otherwise directly to el
      const target = el.querySelector(".subsection-content") || el;
      target.appendChild(div);

      // Only auto-scroll if user was already at the bottom
      if (isAtBottom) {
        el.scrollTop = el.scrollHeight;
      }
    }

    function logProgressLine(el, text, cls = "dim") {
      // Check if user is at the bottom before adding new content (with small threshold for rounding)
      const scrollBottom = el.scrollHeight - el.scrollTop;
      const isAtBottom = scrollBottom <= el.clientHeight + 5;

      const div = document.createElement("div");
      div.className = `terminal-line ${cls}`;
      div.textContent = text;
      // Append to subsection-content if it exists, otherwise directly to el
      const target = el.querySelector(".subsection-content") || el;
      target.appendChild(div);

      // Only auto-scroll if user was already at the bottom
      if (isAtBottom) {
        el.scrollTop = el.scrollHeight;
      }
      return div;
    }

    function consoleLine(text, cls = "dim", opts = {}) {
      logLine(ui.console, text, cls, opts);
      // Broadcast console messages to co-op participants if host
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("console_message", { text, cls });
      }
    }
    function eventLine(text, cls = "dim") { consoleLine(text, cls); }

    function calculateGateStatus(g) {
      // Start with base health
      let status = 100;

      // Beacon modifiers
      if (g.beacon === "FAULT") status -= 10;
      else if (g.beacon === "OFFLINE") status -= 20;

      // Sync modifiers
      if (g.sync === "ASYNC") status -= 5;
      else if (g.sync === "FAULT") status -= 15;

      // Alignment modifiers
      if (g.alignment === "DRIFTING") status -= 5;
      else if (g.alignment === "OUT OF TOLERANCE") status -= 10;

      // Corridor links modifiers
      for (const c of g.corridors || []) {
        if (c.status === "DEGRADED") status -= 3;
        else if (c.status === "INTERMITTENT") status -= 5;
        else if (c.status === "OFFLINE") status -= 8;
      }

      // Facility systems modifiers
      for (const f of g.facility || []) {
        if (f.status === "CONGESTED") status -= 2;
        else if (f.status === "DEGRADED") status -= 4;
        else if (f.status === "OFFLINE") status -= 5;
      }

      // Relay network modifiers (average across all relays)
      const relays = g.relays || [];
      if (relays.length > 0) {
        let relayPenalty = 0;
        for (const r of relays) {
          const displayStatus = relayDisplayStatus(r);
          if (displayStatus === "WEAK") relayPenalty += 2;
          else if (displayStatus === "FAULT") relayPenalty += 5;
          else if (displayStatus === "CRITICAL") relayPenalty += 8;
          else if (displayStatus === "OFFLINE") relayPenalty += 10;
        }
        status -= Math.round(relayPenalty / relays.length);
      }

      // Clamp between 0 and 100
      return Math.max(0, Math.min(100, Math.round(status)));
    }

    function consoleLineDelayed(lines) {
      // lines is an array of {text, cls} objects
      return new Promise((resolve) => {
        let index = 0;

        function printNext() {
          if (index >= lines.length) {
            resolve();
            return;
          }

          const line = lines[index];
          consoleLine(line.text, line.cls, { allowDuplicate: true });
          index++;

          // Delay between lines (150-200ms for smooth animation)
          setTimeout(printNext, 180);
        }

        printNext();
      });
    }

    function flashErrorButton(btn) {
      if (!btn) return;
      btn.classList.remove("btn-error");
      void btn.offsetWidth;
      btn.classList.add("btn-error");
      setTimeout(() => btn.classList.remove("btn-error"), 500);
    }

    const THEME_OPTIONS = ["RANDOM", "green", "red", "blue", "purple", "amber", "cyan", "orange", "pinkblack", "browngold", "black", "lightblue", "lightred", "lightgreen", "paper"];
    const UNLOCKABLE_THEMES = [];

    function isEasterSunday(date) {
      // Anonymous Gregorian algorithm for Easter Sunday.
      const year = date.getFullYear();
      const a = year % 19;
      const b = Math.floor(year / 100);
      const c = year % 100;
      const d = Math.floor(b / 4);
      const e = b % 4;
      const f = Math.floor((b + 8) / 25);
      const g = Math.floor((b - f + 1) / 3);
      const h = (19 * a + b - d - g + 15) % 30;
      const i = Math.floor(c / 4);
      const k = c % 4;
      const l = (32 + 2 * e + 2 * i - h - k) % 7;
      const m = Math.floor((a + 11 * h + 22 * l) / 451);
      const month = Math.floor((h + l - 7 * m + 114) / 31); // 3 = March, 4 = April
      const day = ((h + l - 7 * m + 114) % 31) + 1;
      return date.getMonth() === month - 1 && date.getDate() === day;
    }

    function pickRandomTheme(exclude) {
      const lightThemes = ["lightblue", "lightred", "lightgreen", "paper"];
      // Get all unlocked themes (default + code-unlocked + holiday-unlocked + currently available holidays)
      const allAvailable = getAllAvailableThemes();
      const options = allAvailable.filter((t) => t !== exclude && t !== "RANDOM" && !lightThemes.includes(t));
      const pool = options.length ? options : allAvailable.filter((t) => t !== "RANDOM");
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function setTheme(theme, silent = false, saveToStorage = true) {
      // If RANDOM is selected, pick a random theme but save RANDOM as the preference
      if (theme === "RANDOM") {
        const randomTheme = pickRandomTheme();
        document.documentElement.dataset.theme = randomTheme;
        if (saveToStorage) {
          safeStorageSet(LS.themePreference, "RANDOM");
          safeStorageSet(LS.theme, randomTheme);
        }
        // Keep dropdown showing RANDOM
        if (ui.themeSelect) ui.themeSelect.value = "RANDOM";
        if (ui.startThemeSelect) ui.startThemeSelect.value = "RANDOM";
        if (!silent) consoleLine(`DISPLAY SET: RANDOM (${getThemeDisplayName(randomTheme)})`, "dim");
      } else {
        document.documentElement.dataset.theme = theme;
        if (ui.themeSelect) ui.themeSelect.value = theme;
        if (ui.startThemeSelect) ui.startThemeSelect.value = theme;
        if (saveToStorage) {
          safeStorageSet(LS.themePreference, theme);
          safeStorageSet(LS.theme, theme);
        }
        if (!silent) consoleLine(`DISPLAY SET: ${getThemeDisplayName(theme)}`, "dim");
      }
    }

    function randomizeTheme(silent = false, saveToStorage = true) {
      const current = document.documentElement.dataset.theme || safeStorageGet(LS.theme);
      const next = pickRandomTheme(current);
      setTheme(next, silent, saveToStorage);
      return next;
    }

    function loadTheme() {
      const preference = safeStorageGet(LS.themePreference);

      // If preference is RANDOM, pick a new random theme for this session
      if (preference === "RANDOM") {
        const randomTheme = pickRandomTheme();
        document.documentElement.dataset.theme = randomTheme;
        if (ui.themeSelect) ui.themeSelect.value = "RANDOM";
        if (ui.startThemeSelect) ui.startThemeSelect.value = "RANDOM";
        // Update the actual theme in storage (but keep RANDOM preference)
        safeStorageSet(LS.theme, randomTheme);
        return;
      }

      const stored = safeStorageGet(LS.theme);

      if (stored && isThemeUnlocked(stored)) {
        // If there's a stored theme, use it
        document.documentElement.dataset.theme = stored;
        if (ui.themeSelect) ui.themeSelect.value = stored;
        if (ui.startThemeSelect) ui.startThemeSelect.value = stored;
        return;
      }

      if (stored) {
        try { localStorage.removeItem(LS.theme); } catch (_) {}
      }

      // If no stored theme/preference (new user), set RANDOM as default
      if (!preference && !stored) {
        setTheme("RANDOM", true, true);
        return;
      }

      // If no stored theme (or it's no longer available), randomize without saving
      const initial = pickRandomTheme();
      setTheme(initial, true, false);
    }

    function getUnlockedThemes() {
      const raw = safeStorageGet(LS.unlockedThemes);
      if (!raw) return [];
      try {
        return JSON.parse(raw);
      } catch (_) {
        return [];
      }
    }

    function getHolidayThemeIds() {
      return ["christmas", "halloween", "fireworks", "verdant", "easter"];
    }

    function getHolidayUnlockedThemes() {
      const raw = safeStorageGet(LS.holidayUnlockedThemes);
      if (!raw) return [];
      try {
        return JSON.parse(raw);
      } catch (_) {
        return [];
      }
    }

    function unlockTheme(themeId) {
      const unlocked = getUnlockedThemes();
      if (unlocked.includes(themeId)) return false;
      unlocked.push(themeId);
      safeStorageSet(LS.unlockedThemes, JSON.stringify(unlocked));
      return true;
    }

    function unlockHolidayTheme(themeId) {
      if (!getHolidayThemeIds().includes(themeId)) return false;
      const unlocked = getHolidayUnlockedThemes();
      if (unlocked.includes(themeId)) return false;
      unlocked.push(themeId);
      safeStorageSet(LS.holidayUnlockedThemes, JSON.stringify(unlocked));
      return true;
    }

    function isHolidayThemeAvailableNow(themeId, now = new Date()) {
      const month = now.getMonth();
      const day = now.getDate();

      if (themeId === "christmas") {
        return month === 11 && (day === 24 || day === 25);
      }

      if (themeId === "halloween") {
        return month === 9 && day === 31;
      }

      if (themeId === "fireworks") {
        return (month === 11 && day === 31) || (month === 0 && day === 1);
      }

      if (themeId === "verdant") {
        return month === 2 && day === 17;
      }

      if (themeId === "easter") {
        return isEasterSunday(now);
      }

      return false;
    }

    function maybeUnlockHolidayTheme(themeId) {
      if (!themeId) return null;
      if (!getHolidayThemeIds().includes(themeId)) return null;
      if (!isHolidayThemeAvailableNow(themeId)) return null;
      if (!unlockHolidayTheme(themeId)) return null;
      populateThemeDropdown();
      return themeId;
    }

    function getUnlockableThemeIds() {
      return [
        "soviet", "synthwave", "superearth", "speranza", "sunset", "medical",
        "gamer", "aperture", "netrunner", "tron", "helldiver", "dos",
        "deepspace", "saints", "aurora", "rustbelt", "oceanic", "obsidian",
        "desertradar", "herbal"
      ];
    }

    function getThemeDisplayName(themeId) {
      const themeNames = {
        "green": "GREEN",
        "red": "RED",
        "blue": "BLUE",
        "purple": "PURPLE",
        "amber": "AMBER",
        "cyan": "CYAN",
        "orange": "ORANGE",
        "pinkblack": "PINK",
        "browngold": "YELLOW",
        "black": "BLACK",
        "lightblue": "LIGHT - BLUE",
        "lightred": "LIGHT - RED",
        "lightgreen": "LIGHT - GREEN",
        "paper": "PAPER",
        "soviet": "WORKERS",
        "synthwave": "NOSTALGIA",
        "superearth": "EARTH",
        "speranza": "RAIDER",
        "sunset": "SUNSET",
        "medical": "MEDICAL",
        "gamer": "GAMER",
        "aperture": "TESTING",
        "netrunner": "HACKER",
        "tron": "GRID",
        "helldiver": "HAZARD",
        "dos": "VINTAGE",
        "deepspace": "DEEP SPACE",
        "saints": "ROYAL",
        "aurora": "AURORA",
        "rustbelt": "RUSTBELT",
        "oceanic": "OCEANIC",
        "obsidian": "OBSIDIAN",
        "desertradar": "MILTERM",
        "herbal": "HERBAL",
        "christmas": "CHRISTMAS",
        "halloween": "HALLOWEEN",
        "fireworks": "FIREWORKS",
        "verdant": "VERDANT",
        "easter": "EASTER",
        "RANDOM": "RANDOM"
      };

      return themeNames[themeId] || String(themeId || "").toUpperCase();
    }

    function resolveThemeId(input) {
      const raw = String(input || "").trim();
      if (!raw) return "";
      const key = raw.replace(/[\s_-]+/g, "").toUpperCase();
      const map = new Map();

      for (const id of getAllAvailableThemes()) {
        const display = getThemeDisplayName(id);
        const displayKey = display.replace(/[\s_-]+/g, "").toUpperCase();
        map.set(displayKey, id);

        const idKey = String(id).replace(/[\s_-]+/g, "").toUpperCase();
        if (idKey === displayKey) {
          map.set(idKey, id);
        }
      }

      return map.get(key) || "";
    }

    function getRandomUnlockedableTheme() {
      // CODE unlock themes (excluding holiday themes)
      const codeUnlockThemes = getUnlockableThemeIds();
      const unlocked = getUnlockedThemes();
      const availableToUnlock = codeUnlockThemes.filter(theme => !unlocked.includes(theme));

      if (availableToUnlock.length === 0) return null;

      const randomIndex = Math.floor(Math.random() * availableToUnlock.length);
      return availableToUnlock[randomIndex];
    }

    function unlockThemesForLongShift(shiftMs) {
      const HOUR_MS = 60 * 60 * 1000;
      const EXTRA_HOUR_CHANCE = 0.5;
      const fullHours = Math.floor(shiftMs / HOUR_MS);
      if (fullHours < 1) return [];

      const newlyUnlocked = [];
      const firstTheme = getRandomUnlockedableTheme();
      if (firstTheme && unlockTheme(firstTheme)) {
        newlyUnlocked.push(firstTheme);
      }

      for (let i = 1; i < fullHours; i++) {
        const hourChance = EXTRA_HOUR_CHANCE ** i;
        if (Math.random() >= hourChance) continue;
        const extraTheme = getRandomUnlockedableTheme();
        if (!extraTheme) break;
        if (unlockTheme(extraTheme)) {
          newlyUnlocked.push(extraTheme);
        }
      }

      if (newlyUnlocked.length > 0) {
        populateThemeDropdown();
      }

      return newlyUnlocked;
    }

    function isThemeUnlocked(themeId) {
      if (THEME_OPTIONS.includes(themeId)) return true;
      if (isHolidayThemeAvailableNow(themeId)) return true;
      if (getHolidayUnlockedThemes().includes(themeId)) return true;
      return getUnlockedThemes().includes(themeId);
    }

    function getAllAvailableThemes() {
      const themes = new Set([...THEME_OPTIONS, ...getUnlockedThemes(), ...getHolidayUnlockedThemes()]);
      const now = new Date();
      for (const themeId of getHolidayThemeIds()) {
        if (isHolidayThemeAvailableNow(themeId, now)) {
          themes.add(themeId);
        }
      }

      return Array.from(themes);
    }

    function populateThemeDropdown() {
      const available = getAllAvailableThemes();
      const optionsHTML = available
        .map(id => `<option value="${id}">${getThemeDisplayName(id)}</option>`)
        .join("");
      // Check preference first - if it's RANDOM, show RANDOM in dropdown
      const preference = safeStorageGet(LS.themePreference);
      const current = preference === "RANDOM" ? "RANDOM" : (document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green");

      // Populate both theme selectors
      if (ui.themeSelect) {
        ui.themeSelect.innerHTML = optionsHTML;
        ui.themeSelect.value = current;
      }
      if (ui.startThemeSelect) {
        ui.startThemeSelect.innerHTML = optionsHTML;
        ui.startThemeSelect.value = current;
      }
    }

    // ---------------------------
    // Lifetime Stats & Achievements
    // ---------------------------

    function createDefaultLifetimeStats() {
      return {
        totalShiftsCompleted: 0,
        totalShiftsSevered: 0,
        totalShiftTimeMs: 0,
        longestShiftMs: 0,
        shortestCompletedShiftMs: 0,
        totalBreakMs: 0,
        totalShipsApproved: 0,
        totalShipsApprovedAchv: 0,
        totalShipsDenied: 0,
        totalShipsDeniedAchv: 0,
        totalDenialsCorrect: 0,
        totalDenialsCorrectAchv: 0,
        totalDenialsIncorrect: 0,
        totalDeconOps: 0,
        totalDeconOpsAchv: 0,
        totalInboundTimeouts: 0,
        totalWorkOrdersIssued: 0,
        totalWorkOrdersCompleted: 0,
        totalWorkOrdersCompletedAchv: 0,
        totalRelayRepairs: 0,
        totalRelayRepairsAchv: 0,
        totalRelayAcks: 0,
        totalMaintenanceOps: 0,
        totalMaintenanceOpsAchv: 0,
        totalRepairAttempts: 0,
        totalRepairSuccesses: 0,
        totalRepairFailures: 0,
        totalWageEarned: 0,
        totalWageEarnedAchv: 0,
        totalResourceOrders: 0,
        totalResourceSpending: 0,
        highestSingleShiftWage: 0,
        highestSingleShiftWageAchv: 0,
        totalRelaysPurchased: 0,
        totalDocksPurchased: 0,
        totalThemesUnlocked: 0,
        firstShiftDate: null,
        lastShiftDate: null,
        perfectShifts: 0
      };
    }

    function loadLifetimeStats() {
      const stored = safeStorageGet(LS.lifetimeStats);
      if (!stored) return createDefaultLifetimeStats();
      try {
        const parsed = JSON.parse(stored);
        const stats = { ...createDefaultLifetimeStats(), ...parsed };
        // Backfill achievement-normalized stats for legacy saves
        if (!("totalShipsApprovedAchv" in parsed)) stats.totalShipsApprovedAchv = stats.totalShipsApproved;
        if (!("totalShipsDeniedAchv" in parsed)) stats.totalShipsDeniedAchv = stats.totalShipsDenied;
        if (!("totalDenialsCorrectAchv" in parsed)) stats.totalDenialsCorrectAchv = stats.totalDenialsCorrect;
        if (!("totalDeconOpsAchv" in parsed)) stats.totalDeconOpsAchv = stats.totalDeconOps;
        if (!("totalWorkOrdersCompletedAchv" in parsed)) stats.totalWorkOrdersCompletedAchv = stats.totalWorkOrdersCompleted;
        if (!("totalRelayRepairsAchv" in parsed)) stats.totalRelayRepairsAchv = stats.totalRelayRepairs;
        if (!("totalMaintenanceOpsAchv" in parsed)) stats.totalMaintenanceOpsAchv = stats.totalMaintenanceOps;
        if (!("totalWageEarnedAchv" in parsed)) stats.totalWageEarnedAchv = stats.totalWageEarned;
        if (!("highestSingleShiftWageAchv" in parsed)) stats.highestSingleShiftWageAchv = stats.highestSingleShiftWage;
        return stats;
      } catch (_) {
        return createDefaultLifetimeStats();
      }
    }

    function saveLifetimeStats(stats) {
      safeStorageSet(LS.lifetimeStats, JSON.stringify(stats));
    }

    function loadAchievements() {
      const stored = safeStorageGet(LS.achievements);
      if (!stored) return { version: 1, unlocked: [], progress: {}, unlockedAt: {} };
      try {
        return JSON.parse(stored);
      } catch (_) {
        return { version: 1, unlocked: [], progress: {}, unlockedAt: {} };
      }
    }

    function saveAchievements(achievements) {
      safeStorageSet(LS.achievements, JSON.stringify(achievements));
    }

    function normalizeAchievementCount(value, paceScale) {
      const safeValue = Number(value) || 0;
      const scale = paceScale > 1 ? paceScale : 1;
      return Math.max(0, Math.round(safeValue / scale));
    }

    function normalizeShiftStatsForAchievements(stats) {
      const safe = stats || {};
      const paceScale = getShiftPaceScale();
      const costScale = getShiftCostScale();
      return {
        approved: normalizeAchievementCount(safe.approved, paceScale),
        denied: normalizeAchievementCount(safe.denied, paceScale),
        deniedCorrect: normalizeAchievementCount(safe.deniedCorrect, paceScale),
        deniedIncorrect: normalizeAchievementCount(safe.deniedIncorrect, paceScale),
        deconStarts: normalizeAchievementCount(safe.deconStarts, paceScale),
        contrabandDenied: normalizeAchievementCount(safe.contrabandDenied, paceScale),
        illegalApprovals: normalizeAchievementCount(safe.illegalApprovals, paceScale),
        workOrdersIssued: normalizeAchievementCount(safe.workOrdersIssued, paceScale),
        workOrdersCompleted: normalizeAchievementCount(safe.workOrdersCompleted, paceScale),
        relayRepairs: normalizeAchievementCount(safe.relayRepairs, paceScale),
        relayAcks: normalizeAchievementCount(safe.relayAcks, paceScale),
        maintenanceOps: normalizeAchievementCount(safe.maintenanceOps, paceScale),
        resourceOrders: normalizeAchievementCount(safe.resourceOrders, paceScale),
        resourceOrderSpend: Number(safe.resourceOrderSpend) || 0,
        purchaseSpend: costScale < 1 ? Math.round((Number(safe.purchaseSpend) || 0) / costScale) : (Number(safe.purchaseSpend) || 0),
        breakSpend: Number(safe.breakSpend) || 0,
        deadlinesMet: normalizeAchievementCount(safe.deadlinesMet, paceScale),
        deadlinesMissed: normalizeAchievementCount(safe.deadlinesMissed, paceScale),
        criticalMisses: normalizeAchievementCount(safe.criticalMisses, paceScale),
        urgentMisses: normalizeAchievementCount(safe.urgentMisses, paceScale),
        operatorErrors: normalizeAchievementCount(safe.operatorErrors, paceScale),
        inboundTimeouts: normalizeAchievementCount(safe.inboundTimeouts, paceScale)
      };
    }

    function getClearanceLevel() {
      const raw = safeStorageGet(LS.clearanceLevel);
      const parsed = parseInt(raw, 10);
      return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
    }

    function setClearanceLevel(level) {
      const normalized = Math.max(0, Math.floor(Number(level) || 0));
      if (normalized > 0) {
        safeStorageSet(LS.clearanceLevel, String(normalized));
      } else {
        try { localStorage.removeItem(LS.clearanceLevel); } catch (_) {}
      }
    }

    function checkAchievementCondition(achievement, lifetimeStats, shiftStats, shiftMs) {
      const cond = achievement.condition;

      switch (cond.type) {
        case "shiftsCompleted":
          return lifetimeStats.totalShiftsCompleted >= cond.value;

        case "shiftsSevered":
          return lifetimeStats.totalShiftsSevered >= cond.value;

        case "singleShiftMs":
          return shiftMs >= cond.value;

        case "totalShiftTimeMs":
          return lifetimeStats.totalShiftTimeMs >= cond.value;

        case "totalBreakMs":
          return lifetimeStats.totalBreakMs >= cond.value;

        case "shipsProcessed":
          const total = (lifetimeStats.totalShipsApprovedAchv || 0) + (lifetimeStats.totalShipsDeniedAchv || 0);
          return total >= cond.value;

        case "perfectShift":
          const isPerfect = (shiftStats.deniedIncorrect === 0 && shiftStats.inboundTimeouts === 0);
          return isPerfect;

        case "perfectShifts":
          return lifetimeStats.perfectShifts >= cond.value;

        case "denialsCorrect":
          return (lifetimeStats.totalDenialsCorrectAchv || 0) >= cond.value;

        case "maintenanceOps":
          return (lifetimeStats.totalMaintenanceOpsAchv || 0) >= cond.value;

        case "relayRepairs":
          return (lifetimeStats.totalRelayRepairsAchv || 0) >= cond.value;

        case "workOrdersCompleted":
          return (lifetimeStats.totalWorkOrdersCompletedAchv || 0) >= cond.value;

        case "totalWageEarned":
          return (lifetimeStats.totalWageEarnedAchv || 0) >= cond.value;

        case "singleShiftWage":
          return (lifetimeStats.highestSingleShiftWageAchv || 0) >= cond.value;

        case "deconOps":
          return (lifetimeStats.totalDeconOpsAchv || 0) >= cond.value;

        case "expansions":
          return lifetimeStats.totalRelaysPurchased >= cond.value.relays &&
                 lifetimeStats.totalDocksPurchased >= cond.value.docks;

        case "themesUnlocked":
          return lifetimeStats.totalThemesUnlocked >= cond.value;

        case "timeWindow":
          const now = new Date();
          const hour = now.getHours();
          return hour >= cond.value.start && hour < cond.value.end;

        default:
          return false;
      }
    }

    function getAchievementProgress(achievement, lifetimeStats, shiftStats, shiftMs) {
      const cond = achievement.condition;

        switch (cond.type) {
          case "shiftsCompleted":
            return { current: lifetimeStats.totalShiftsCompleted, target: cond.value };
        case "shiftsSevered":
          return { current: lifetimeStats.totalShiftsSevered, target: cond.value };
        case "totalShiftTimeMs":
          return { current: lifetimeStats.totalShiftTimeMs, target: cond.value };
        case "totalBreakMs":
          return { current: lifetimeStats.totalBreakMs, target: cond.value };
        case "shipsProcessed":
          return {
            current: (lifetimeStats.totalShipsApprovedAchv || 0) + (lifetimeStats.totalShipsDeniedAchv || 0),
            target: cond.value
          };
        case "perfectShifts":
          return { current: lifetimeStats.perfectShifts, target: cond.value };
        case "denialsCorrect":
          return { current: lifetimeStats.totalDenialsCorrectAchv || 0, target: cond.value };
        case "maintenanceOps":
          return { current: lifetimeStats.totalMaintenanceOpsAchv || 0, target: cond.value };
        case "relayRepairs":
          return { current: lifetimeStats.totalRelayRepairsAchv || 0, target: cond.value };
        case "workOrdersCompleted":
          return { current: lifetimeStats.totalWorkOrdersCompletedAchv || 0, target: cond.value };
        case "totalWageEarned":
          return { current: lifetimeStats.totalWageEarnedAchv || 0, target: cond.value };
        case "deconOps":
            return { current: lifetimeStats.totalDeconOpsAchv || 0, target: cond.value };
          case "expansions":
            return {
              segments: [
                { label: "RELAYS", current: lifetimeStats.totalRelaysPurchased, target: cond.value.relays },
                { label: "DOCKS", current: lifetimeStats.totalDocksPurchased, target: cond.value.docks }
              ]
            };
          case "themesUnlocked":
            return { current: lifetimeStats.totalThemesUnlocked, target: cond.value };
          default:
            return null;
        }
    }

    function checkAndUnlockAchievements(shiftStats, shiftMs, wage, options = {}) {
      const lifetimeStats = loadLifetimeStats();
      const achievements = loadAchievements();
      const newlyUnlocked = [];
      const allowShiftCompleteAchievements = options.allowShiftCompleteAchievements !== false;

      for (const achievement of ACHIEVEMENTS) {
        if (achievements.unlocked.includes(achievement.id)) continue;
        if (!allowShiftCompleteAchievements) {
          const type = achievement.condition?.type;
          if (type === "shiftsCompleted" || type === "perfectShift" ||
              type === "perfectShifts" || type === "timeWindow") {
            continue;
          }
        }

        if (checkAchievementCondition(achievement, lifetimeStats, shiftStats, shiftMs)) {
          achievements.unlocked.push(achievement.id);
          achievements.unlockedAt[achievement.id] = Date.now();
          newlyUnlocked.push(achievement);
        }
      }

      if (newlyUnlocked.length > 0) {
        saveAchievements(achievements);
      }

      return newlyUnlocked;
    }

    function updateZoomDisplay() {
      const percent = Math.round(runtime.fontScale * 100);
      if (ui.zoomDisplay) {
        ui.zoomDisplay.textContent = `${percent}%`;
      }
    }

    function applyFontScale(scale, silent = false) {
      // Clamp scale between 0.5 and 2.0
      scale = Math.max(0.5, Math.min(2.0, scale));
      // Round to 1 decimal place to avoid floating point precision issues
      scale = Math.round(scale * 10) / 10;
      runtime.fontScale = scale;

      // Apply font-size to html root element so it cascades naturally
      document.documentElement.style.fontSize = `${scale * 100}%`;

      safeStorageSet(LS.fontScale, String(scale));
      updateZoomDisplay();
      if (!silent) {
        const percent = Math.round(scale * 100);
        consoleLine(`ZOOM: ${percent}%`, "dim");
      }
    }

    function loadFontScale() {
      const stored = safeStorageGet(LS.fontScale);
      if (stored) {
        const scale = parseFloat(stored);
        if (!isNaN(scale)) {
          applyFontScale(scale, true);
        }
      }
    }

    function cmdFontUp() {
      // Round to avoid floating point precision issues
      const newScale = Math.round((runtime.fontScale + 0.1) * 10) / 10;
      if (newScale > 2.0) {
        consoleLine("ZOOM: MAX (200%)", "warn");
        playSfx("error");
        return;
      }
      applyFontScale(newScale);
    }

    function cmdFontDown() {
      // Round to avoid floating point precision issues
      const newScale = Math.round((runtime.fontScale - 0.1) * 10) / 10;
      if (newScale < 0.5) {
        consoleLine("ZOOM: MIN (50%)", "warn");
        playSfx("error");
        return;
      }
      applyFontScale(newScale);
    }

    function cmdFontReset() {
      applyFontScale(1.0);
    }

    function cmdFontSet(percent) {
      const scale = percent / 100;
      if (scale < 0.5 || scale > 2.0) {
        consoleLine("ZOOM: RANGE 50%-200%", "warn");
        playSfx("error");
        return;
      }
      applyFontScale(scale);
    }

    function setGateById(gateId, silent = false) {
      runtime.activeGateId = runtime.catalog;
      if (ui.gateDisplay) {
        ui.gateDisplay.textContent = runtime.activeGateId;
      }
      safeStorageSet(LS.gateCurrent, runtime.activeGateId);

      ui.ps1.textContent = `${runtime.activeGateId}>`;
      const storedCallsign = loadOperatorCallsignForGate(runtime.activeGateId);
      runtime.operatorCallsign = storedCallsign;
      if (!applyDefaultCallsignIfNeeded(runtime.activeGateId)) {
        updateOperatorLabel();
        updateStartNameLabel();
      }

      // Reset console only; keep events for context when switching
      clearLog(ui.console);
      if (!silent) consoleLine(`SWITCHED NODE: ${runtime.activeGateId}`, "good");

      consoleLine(`GATE TERMINAL MONITORING`, "dim");
      consoleLine(`NODE: ${runtime.activeGateId}`, "dim");
      consoleLine(`AUTH: CONFIRMED`, "dim");
      consoleLine(`TYPE HELP FOR COMMANDS`, "dim");
      consoleLine("", "dim");

      renderAll();
    }

    function severGate(reason) {
      if (runtime.severed) return;
      if (runtime.multiplayer?.coop?.role === "invited") return;

      const activeTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";

      // Stop all looping audio
      audio.music.pause();
      audio.music.currentTime = 0;
      audio.processing.pause();
      audio.processing.currentTime = 0;
      audio.qrying.pause();
      audio.qrying.currentTime = 0;
      audio.ackalarm.pause();
      audio.ackalarm.currentTime = 0;
      audio.purge.pause();
      audio.purge.currentTime = 0;
      audio.reset.pause();
      audio.reset.currentTime = 0;
      audio.scan.pause();
      audio.scan.currentTime = 0;
      audio.klaxon.pause();
      audio.klaxon.currentTime = 0;

      // Play severed sound effect
      playSfx("severed");

      // If RANDOM theme is selected, pick a new random theme on sever
      const themePreference = safeStorageGet(LS.themePreference);
      if (themePreference === "RANDOM") {
        const randomTheme = pickRandomTheme();
        document.documentElement.dataset.theme = randomTheme;
        safeStorageSet(LS.theme, randomTheme);
      }
      const g = activeGate();
      const stats = ensureGateStats(g);
      const shiftMs = Date.now() - runtime.shiftStart;
      maybeUnlockHolidayTheme(activeTheme);
      const shiftMode = loadShiftMode();
      if (shiftMode === "unlimited" || shiftMode === "endurance") {
        unlockThemesForLongShift(shiftMs);
      }
      const summary = {
        gateId: g.id,
        time: Date.now(),
        cause: reason,
        approved: stats.approved,
        denied: stats.denied,
        shiftMs,
        wage: computeWage(stats, shiftMs),
        stats: stats
      };
      runtime.lastSevered = summary;
      const achvStats = normalizeShiftStatsForAchievements(stats);
      const achvWage = computeBaseWage(achvStats, shiftMs);

      // Update lifetime stats even for severed shifts
      const lifetimeStats = loadLifetimeStats();
      lifetimeStats.totalShiftsSevered++;

      // Update shift time even for severed shifts
      lifetimeStats.totalShiftTimeMs += shiftMs;
      if (!lifetimeStats.firstShiftDate) {
        lifetimeStats.firstShiftDate = Date.now();
      }
      lifetimeStats.lastShiftDate = Date.now();

      // Update stats from the gate (partial shift)
      lifetimeStats.totalShipsApproved += stats.approved || 0;
      lifetimeStats.totalShipsDenied += stats.denied || 0;
      lifetimeStats.totalDenialsCorrect += stats.deniedCorrect || 0;
      lifetimeStats.totalDenialsIncorrect += stats.deniedIncorrect || 0;
      lifetimeStats.totalDeconOps += stats.deconStarts || 0;
      lifetimeStats.totalInboundTimeouts += stats.inboundTimeouts || 0;
      lifetimeStats.totalWorkOrdersIssued += stats.workOrdersIssued || 0;
      lifetimeStats.totalWorkOrdersCompleted += stats.workOrdersCompleted || 0;
      lifetimeStats.totalRelayRepairs += stats.relayRepairs || 0;
      lifetimeStats.totalRelayAcks += stats.relayAcks || 0;
      lifetimeStats.totalMaintenanceOps += stats.maintenanceOps || 0;
      lifetimeStats.totalRepairAttempts += stats.repairAttempts || 0;
      lifetimeStats.totalRepairSuccesses += stats.repairSuccesses || 0;
      lifetimeStats.totalRepairFailures += stats.repairFailures || 0;
      lifetimeStats.totalResourceOrders += stats.resourceOrders || 0;
      lifetimeStats.totalResourceSpending += stats.resourceOrderSpend || 0;

      lifetimeStats.totalShipsApprovedAchv += achvStats.approved || 0;
      lifetimeStats.totalShipsDeniedAchv += achvStats.denied || 0;
      lifetimeStats.totalDenialsCorrectAchv += achvStats.deniedCorrect || 0;
      lifetimeStats.totalDeconOpsAchv += achvStats.deconStarts || 0;
      lifetimeStats.totalWorkOrdersCompletedAchv += achvStats.workOrdersCompleted || 0;
      lifetimeStats.totalRelayRepairsAchv += achvStats.relayRepairs || 0;
      lifetimeStats.totalMaintenanceOpsAchv += achvStats.maintenanceOps || 0;

      const wage = summary.wage;
      lifetimeStats.totalWageEarned += wage;
      lifetimeStats.totalWageEarnedAchv += achvWage;
      lifetimeStats.totalThemesUnlocked = getUnlockedThemes().length;

      saveLifetimeStats(lifetimeStats);

      // Check for achievements (excluding shift-complete-only achievements)
      const newAchievements = checkAndUnlockAchievements(stats, shiftMs, wage, {
        allowShiftCompleteAchievements: false
      });
      summary.newAchievements = newAchievements;

      updateOperatorLabel();
      updateStartNameLabel();
      updateSeveredOverlay(summary);
      runtime.severed = true;

      // Clear gate progress from localStorage to prevent resume (preserve profile data)
      try {
        for (let i = localStorage.length - 1; i >= 0; i--) {
          const key = localStorage.key(i);
          if (key && key.startsWith(LS.gateStatePrefix)) {
            localStorage.removeItem(key);
          }
        }
        localStorage.removeItem(LS.gateCurrent);
        localStorage.removeItem(LS.shiftMs);
        localStorage.removeItem(LS.shiftCompleteShown);
        localStorage.removeItem(LS.shiftDurationMs);
        localStorage.removeItem(LS.shiftMode);
        localStorage.removeItem(LS.severed);
        localStorage.removeItem(LS.lastSevered);
      } catch (_) {}

      document.body.classList.add("severed");
      const oldId = runtime.activeGateId;
      if (oldId && oldId === runtime.activeGateId) {
        eventLine(`GATE SEVERED: ${reason}`, "bad");
      }

      // Notify multiplayer that this operator is now offline
      sendGameStateChange(false, "severed");
    }

    function triggerShiftComplete() {
      if (runtime.severed || runtime.shiftCompleteShown) return;
      if (runtime.multiplayer?.coop?.role === "invited") return;

      const g = activeGate();
      const stats = ensureGateStats(g);
      const shiftMs = getShiftMs();
      const activeTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";
      const holidayUnlockedTheme = maybeUnlockHolidayTheme(activeTheme);

      let unlockedTheme = null;
      let unlockedThemeName = null;
      const unlockedThemes = unlockThemesForLongShift(shiftMs);
      if (unlockedThemes.length > 0) {
        unlockedTheme = unlockedThemes[0];
        unlockedThemeName = getThemeDisplayName(unlockedTheme);
      }
      if (!unlockedTheme && holidayUnlockedTheme) {
        unlockedTheme = holidayUnlockedTheme;
        unlockedThemeName = getThemeDisplayName(holidayUnlockedTheme);
      }

      const summary = {
        gateId: g.id,
        time: Date.now(),
        shiftMs,
        health: g.health || "OPERATIONAL",
        approved: stats.approved,
        denied: stats.denied,
        wage: computeWage(stats, shiftMs),
        stats: stats,
        unlockedTheme: unlockedTheme,
        unlockedThemeName: unlockedThemeName
      };
      runtime.lastShiftComplete = summary;
      const achvStats = normalizeShiftStatsForAchievements(stats);
      const achvWage = computeBaseWage(achvStats, shiftMs);

      // Update lifetime statistics
      const lifetimeStats = loadLifetimeStats();
      const now = Date.now();

      // Set first shift date
      if (!lifetimeStats.firstShiftDate) {
        lifetimeStats.firstShiftDate = now;
      }
      lifetimeStats.lastShiftDate = now;

      // Increment shift counter
      lifetimeStats.totalShiftsCompleted++;

      // Update shift duration records
      lifetimeStats.totalShiftTimeMs += shiftMs;
      if (shiftMs > lifetimeStats.longestShiftMs) {
        lifetimeStats.longestShiftMs = shiftMs;
      }
      if (lifetimeStats.shortestCompletedShiftMs === 0 || shiftMs < lifetimeStats.shortestCompletedShiftMs) {
        lifetimeStats.shortestCompletedShiftMs = shiftMs;
      }

      // Update traffic stats
      lifetimeStats.totalShipsApproved += stats.approved || 0;
      lifetimeStats.totalShipsDenied += stats.denied || 0;
      lifetimeStats.totalDenialsCorrect += stats.deniedCorrect || 0;
      lifetimeStats.totalDenialsIncorrect += stats.deniedIncorrect || 0;
      lifetimeStats.totalDeconOps += stats.deconStarts || 0;
      lifetimeStats.totalInboundTimeouts += stats.inboundTimeouts || 0;

      // Update maintenance stats
      lifetimeStats.totalWorkOrdersIssued += stats.workOrdersIssued || 0;
      lifetimeStats.totalWorkOrdersCompleted += stats.workOrdersCompleted || 0;
      lifetimeStats.totalRelayRepairs += stats.relayRepairs || 0;
      lifetimeStats.totalRelayAcks += stats.relayAcks || 0;
      lifetimeStats.totalMaintenanceOps += stats.maintenanceOps || 0;
      lifetimeStats.totalRepairAttempts += stats.repairAttempts || 0;
      lifetimeStats.totalRepairSuccesses += stats.repairSuccesses || 0;
      lifetimeStats.totalRepairFailures += stats.repairFailures || 0;

      // Update financial stats
      lifetimeStats.totalWageEarned += summary.wage;
      lifetimeStats.totalResourceOrders += stats.resourceOrders || 0;
      lifetimeStats.totalResourceSpending += stats.resourceOrderSpend || 0;
      if (summary.wage > lifetimeStats.highestSingleShiftWage) {
        lifetimeStats.highestSingleShiftWage = summary.wage;
      }

      lifetimeStats.totalShipsApprovedAchv += achvStats.approved || 0;
      lifetimeStats.totalShipsDeniedAchv += achvStats.denied || 0;
      lifetimeStats.totalDenialsCorrectAchv += achvStats.deniedCorrect || 0;
      lifetimeStats.totalDeconOpsAchv += achvStats.deconStarts || 0;
      lifetimeStats.totalWorkOrdersCompletedAchv += achvStats.workOrdersCompleted || 0;
      lifetimeStats.totalRelayRepairsAchv += achvStats.relayRepairs || 0;
      lifetimeStats.totalMaintenanceOpsAchv += achvStats.maintenanceOps || 0;
      lifetimeStats.totalWageEarnedAchv += achvWage;
      if (achvWage > lifetimeStats.highestSingleShiftWageAchv) {
        lifetimeStats.highestSingleShiftWageAchv = achvWage;
      }

      // Update theme unlock count
      lifetimeStats.totalThemesUnlocked = getUnlockedThemes().length;

      // Check for perfect shift
      const isPerfectShift = (stats.deniedIncorrect === 0 && stats.inboundTimeouts === 0);
      if (isPerfectShift) {
        lifetimeStats.perfectShifts++;
      }

      saveLifetimeStats(lifetimeStats);

      // Check for achievements
      const newAchievements = checkAndUnlockAchievements(stats, shiftMs, summary.wage);
      summary.newAchievements = newAchievements;

      updateShiftcompleteOverlay(summary);
      runtime.shiftCompleteShown = true;
      storeBool(LS.shiftCompleteShown, true);

      // DO NOT stop music (key difference from severGate)
      // DO NOT change theme (key difference from severGate)
      // Pause game loops so the gate does not decay while the summary is open
      pauseGame();

      playSfx("shiftcomplete");
      document.body.classList.add("shiftcomplete");
      eventLine("SHIFT COMPLETE: 8 HOUR MARK REACHED", "good");

      // Notify multiplayer that this operator is now offline
      sendGameStateChange(false, "shift_complete");
    }

    function continueAfterShiftComplete() {
      document.body.classList.remove("shiftcomplete");
      consoleLine("CONTINUING EXTENDED SHIFT", "good");
      // Shift complete flag remains true - don't show again
      resumeGame();

      // Re-prime looped audio elements to ensure they can play after shift complete
      // This is critical for audio to work properly after pausing/stopping
      primeLoopedAudio();

      // Notify multiplayer that this operator is now online again
      sendGameStateChange(true);
    }

    function restartGate() {
      // Log disconnection message before reset
      eventLine("OPERATOR DISCONNECTED: CONNECTION RESET", "warn");

      // Notify multiplayer that this operator is going offline with reset reason
      sendGameStateChange(false, "reset");

      // Stop all game timers
      if (runtime.tickTimer) {
        clearInterval(runtime.tickTimer);
        runtime.tickTimer = null;
      }
      if (runtime.uiTimer) {
        clearInterval(runtime.uiTimer);
        runtime.uiTimer = null;
      }
      if (runtime.ambientSoundTimer) {
        clearInterval(runtime.ambientSoundTimer);
        runtime.ambientSoundTimer = null;
      }

      // Clear all maintenance timers
      for (const kind in runtime.maintenance) {
        const maint = runtime.maintenance[kind];
        if (maint.timer) clearTimeout(maint.timer);
        if (maint.tick) clearInterval(maint.tick);
        if (maint.progressTick) clearInterval(maint.progressTick);
      }
      runtime.maintenance = {};

      // Stop all sound effects
      stopMaintenanceSfx();
      runtime.processingCount = 0;
      updateProcessingSound();
      setAckAlarm(false);
      if (audio.music) {
        audio.music.pause();
        audio.music.currentTime = 0;
      }

      // Clean up multiplayer connection
      cleanupMultiplayer("reset");

      // Clear current gate progress only
      clearCurrentGateData();

      // If RANDOM theme is selected, pick a new random theme on reset
      const themePreference = safeStorageGet(LS.themePreference);
      if (themePreference === "RANDOM") {
        const randomTheme = pickRandomTheme();
        document.documentElement.dataset.theme = randomTheme;
        safeStorageSet(LS.theme, randomTheme);
      }

      // Reset runtime state
      runtime.gate = null;
      runtime.severed = false;
      runtime.lastSevered = null;
      runtime.shiftCompleteShown = false;

      // Update start screen state
      updateStartNameLabel();
      updateDataResetButtonVisibility();
      updateShiftTimeButtonVisibility();

      // Reset to start screen
      didBoot = false;
      startInProgress = false;
      document.body.classList.remove("started");
      document.body.classList.remove("severed");
      document.body.classList.remove("shiftcomplete");
      ui.startOverlay?.setAttribute("aria-hidden", "false");
      ui.btnStart?.removeAttribute("disabled");
      ui.btnStart?.focus();
    }

    function pillForHealth(health) {
      if (health.includes("MAINTENANCE")) return { text: "MAINT", cls: "bad" };
      if (health.includes("DEGRADED")) return { text: "DEGRADED", cls: "warn" };
      return { text: "OK", cls: "ok" };
    }

    function pillForState(list, value) {
      return list.find(x => x.key === value) || { key: value, cls: "warn" };
    }

    function concourseBand(level) {
      if (level >= 75) return { text: "CROWDED", cls: "warn" };
      if (level >= 50) return { text: "ACTIVE", cls: "warn" };
      if (level >= 25) return { text: "LOW", cls: "ok" };
      return { text: "QUIET", cls: "ok" };
    }

    function concourseStress(level) {
      return clamp((level - 20) / 60, 0, 1);
    }

    // Convert relay health percentage to status string
    function relayHealthToStatus(health) {
      if (health >= 75) return "ONLINE";
      if (health >= 50) return "WEAK";
      if (health >= 25) return "FAULT";
      if (health > 0) return "CRITICAL";
      return "OFFLINE";
    }

    function relayDisplayStatus(r) {
      if (r.offline && !r.hiddenOffline) return "OFFLINE";
      return relayHealthToStatus(r.health);
    }

    function relayHeartbeatAgeSec(r, now) {
      if (!r.lastHeartbeatAt) return null;
      return Math.max(0, Math.floor((now - r.lastHeartbeatAt) / 1000));
    }

    function relayHeartbeatBand(relay, ageSec) {
      if (typeof ageSec !== "number") return { cls: "hb-bad", stale: true };

      // For offline relays, always show bad (red) as heartbeat extends
      if (relay.offline || relay.health === 0) {
        return { cls: "hb-bad", stale: true };
      }

      // Color based on expected heartbeat range based on health percentage
      // EARLY WARNING SCALING: Compressed into 70-100 health range
      // Health 93-100% (PRISTINE): 0-2s expected
      if (relay.health >= 93) {
        if (ageSec >= RELAY_HEARTBEAT_ONLINE_CRIT_SEC) return { cls: "hb-bad", stale: true };
        if (ageSec >= RELAY_HEARTBEAT_ONLINE_WARN_SEC) return { cls: "hb-warn", stale: false };
        return { cls: "hb-ok", stale: false };
      }
      // Health 85-92% (EARLY DEGRADATION): 2-4s expected
      else if (relay.health >= 85) {
        if (ageSec >= RELAY_HEARTBEAT_WEAK_CRIT_SEC) return { cls: "hb-bad", stale: true };
        if (ageSec >= RELAY_HEARTBEAT_WEAK_WARN_SEC) return { cls: "hb-warn", stale: false };
        return { cls: "hb-ok", stale: false };
      }
      // Health 75-84% (DEGRADING): 4-6s expected
      else if (relay.health >= 75) {
        if (ageSec >= RELAY_HEARTBEAT_FAULT_CRIT_SEC) return { cls: "hb-bad", stale: true };
        if (ageSec >= RELAY_HEARTBEAT_FAULT_WARN_SEC) return { cls: "hb-warn", stale: false };
        return { cls: "hb-ok", stale: false };
      }
      // Health <75% (HEAVILY DEGRADED): 6-8s expected (max slowness)
      else if (relay.health > 0) {
        if (ageSec >= RELAY_HEARTBEAT_CRITICAL_CRIT_SEC) return { cls: "hb-bad", stale: true };
        if (ageSec >= RELAY_HEARTBEAT_CRITICAL_WARN_SEC) return { cls: "hb-warn", stale: false };
        return { cls: "hb-ok", stale: false };
      }

      // Fallback
      if (ageSec >= RELAY_HEARTBEAT_STALE_CRIT_SEC) return { cls: "hb-bad", stale: true };
      if (ageSec >= RELAY_HEARTBEAT_STALE_WARN_SEC) return { cls: "hb-warn", stale: true };
      return { cls: "hb-ok", stale: false };
    }

    function scheduleRelayHeartbeat(relay, now) {
      relay.lastHeartbeatAt = now;

      // Don't schedule next heartbeat for offline relays - let counter extend
      if (relay.offline || relay.health === 0) {
        return;
      }

      // Set heartbeat interval based on relay health percentage
      // EARLY WARNING: Heartbeat slowing compressed into 70-100 range so slowdown precedes visual degradation
      let minMs, maxMs;
      if (relay.health >= 93) {
        // PRISTINE: 0-2s (barely any delay)
        minMs = RELAY_HEARTBEAT_ONLINE_MIN_MS;
        maxMs = RELAY_HEARTBEAT_ONLINE_MAX_MS;
      } else if (relay.health >= 85) {
        // EARLY DEGRADATION: 2-4s (starting to slow - first warning sign)
        minMs = RELAY_HEARTBEAT_WEAK_MIN_MS;
        maxMs = RELAY_HEARTBEAT_WEAK_MAX_MS;
      } else if (relay.health >= 75) {
        // DEGRADING: 4-6s (noticeably slow, relay showing as degraded)
        minMs = RELAY_HEARTBEAT_FAULT_MIN_MS;
        maxMs = RELAY_HEARTBEAT_FAULT_MAX_MS;
      } else {
        // <=75% health: max slowness (6-8s) - heavily degraded heartbeat
        minMs = RELAY_HEARTBEAT_CRITICAL_MIN_MS;
        maxMs = RELAY_HEARTBEAT_CRITICAL_MAX_MS;
      }

      relay.nextHeartbeatAt = now + randRange(minMs, maxMs);
    }

    function computeHealth(g) {
      const criticalOffline =
        g.beacon === "OFFLINE" ||
        g.sync === "FAULT" ||
        (g.corridors || []).some(c => c.status === "OFFLINE") ||
        (g.facility || []).some(f => f.status === "OFFLINE") ||
        (g.relays || []).some(r => relayDisplayStatus(r) === "OFFLINE");

      if (criticalOffline) return "MAINTENANCE";

      const degraded =
        g.beacon === "FAULT" ||
        g.sync === "ASYNC" ||
        g.alignment !== "WITHIN TOLERANCE" ||
        (g.corridors || []).some(c => c.status !== "STABLE") ||
        (g.facility || []).some(f => f.status === "DEGRADED") ||
        (g.relays || []).some(r => ["WEAK", "FAULT"].includes(relayDisplayStatus(r)));

      return degraded ? "OPERATIONAL (DEGRADED)" : "OPERATIONAL";
    }

    function recomputeHealth(g) {
      g.health = computeHealth(g);
      return g.health;
    }

    function workOrderClass(state) {
      if (state === "COMPLETE") return "ok";
      if (state === "REPAIRING") return "warn";
      return "warn";
    }

    function computeAlerts(g) {
      const alerts = [];
      if (g.beacon === "OFFLINE" || g.beacon === "FAULT") alerts.push("BEACON ARRAY FAULT");
      if (g.alignment === "OUT OF TOLERANCE") alerts.push("ALIGNMENT OUT OF TOLERANCE");
      if (g.sync === "FAULT") alerts.push("SYNC FAULT");
      for (const c of g.corridors) if (c.status === "OFFLINE") alerts.push(`LINK ${c.link} OFFLINE`);
      for (const f of g.facility || []) if (f.status === "OFFLINE") alerts.push(`${f.name} OFFLINE`);
        const resources = ensureResources(g);
        if (resources.FUEL?.level <= RESOURCE_ORDER_THRESHOLD) alerts.push("FUEL LOW");
        if (resources.SUPPLY?.level <= RESOURCE_ORDER_THRESHOLD) alerts.push("SUPPLY LOW");
        const transponderIssues = [...g.inbound, ...g.outbound].filter(s => s.transponder !== "VALID" && s.state !== "DENIED");
        if (transponderIssues.length >= 2) alerts.push("TRANSPONDER ANOMALIES");
        const stuckInbound = g.inbound.filter(s => s.state === "HOLD").length;
        if (stuckInbound >= 2) alerts.push("INBOUND HOLDS STACKING");
      g.alerts = alerts;
      return alerts;
    }

    function computeOverallSystemsStatus(g) {
      let severity = 0; // 0 ok, 1 warn, 2 bad
      const issues = [];
      const mark = (level, text) => {
        severity = Math.max(severity, level);
        if (text) issues.push(text);
      };

      // NODE status is a reflection of other issues, so don't count it separately
      // if (g.health.includes("MAINTENANCE")) mark(2, "GATE MAINTENANCE");
      // else if (g.health.includes("DEGRADED")) mark(1, "GATE DEGRADED");

      if (g.beacon === "OFFLINE") mark(2, "BEACON OFFLINE");
      else if (g.beacon === "FAULT") mark(1, "BEACON FAULT");

      if (g.alignment === "OUT OF TOLERANCE") mark(2, "ALIGN OUT OF TOLERANCE");
      else if (g.alignment === "DRIFTING") mark(1, "ALIGNMENT DRIFTING");

      if (g.sync === "FAULT") mark(2, "SYNC FAULT");

      for (const c of g.corridors || []) {
        if (c.status === "OFFLINE") mark(2, `LINK ${c.link} OFFLINE`);
        else if (c.status !== "STABLE") mark(1, `LINK ${c.link} ${c.status}`);
      }

      for (const f of g.facility || []) {
        if (f.status === "OFFLINE") mark(2, `${f.name} OFFLINE`);
        else if (f.status === "DEGRADED") mark(1, `${f.name} DEGRADED`);
      }

      for (const r of g.relays || []) {
        const displayStatus = relayDisplayStatus(r);
        if (displayStatus === "OFFLINE") mark(2, `${r.id} OFFLINE`);
        else if (displayStatus === "FAULT") mark(1, `${r.id} FAULT`);
      }

      if (severity === 0) return { text: "ALL SYSTEMS NOMINAL", cls: "ok", detail: "NO ACTIVE ISSUES" };
      if (severity === 1) {
        const text = issues.length >= 3 ? "ELEVATED" : "DEGRADED";
        return { text, cls: "warn", detail: `${issues.length} ACTIVE ISSUE${issues.length === 1 ? "" : "S"}` };
      }

      if (issues.length <= 2) {
        return { text: "ELEVATED", cls: "warn", detail: `${issues.length} ACTIVE ISSUE${issues.length === 1 ? "" : "S"}` };
      }
      if (issues.length <= 4) {
        return { text: "SEVERE", cls: "bad", detail: `${issues.length} ACTIVE ISSUE${issues.length === 1 ? "" : "S"}` };
      }
      return { text: "CRITICAL", cls: "bad", detail: `${issues.length} ACTIVE ISSUE${issues.length === 1 ? "" : "S"}` };
    }

    function allCorridorsOffline(g) {
      return (g.corridors || []).length > 0 && g.corridors.every(c => c.status === "OFFLINE");
    }

    function allFacilityOffline(g) {
      const facility = g.facility || [];
      return facility.length >= FACILITY_SYSTEMS.length && facility.every(f => f.status === "OFFLINE");
    }

    function hasActiveWorkOrders(g) {
      return (g.workOrders || []).some(w => w.state !== "COMPLETE");
    }

    function hasActiveRelayWorkOrders(g) {
      return (g.relays || []).some(r => hasActiveWorkOrder(g, r.id));
    }

    function relayIsDown(r) {
      return !!r.offline;
    }

    function computeRelayHealthState(g) {
      const relays = g.relays || [];
      if (relays.length < 2) return { state: "HEALTHY", reason: null, score: 0 };

      // Count relays by state (using health-based status)
      const offline = relays.filter(r => relayIsDown(r)).length;
      const critical = relays.filter(r => !relayIsDown(r) && relayHealthToStatus(r.health) === "CRITICAL").length;
      const fault = relays.filter(r => !relayIsDown(r) && relayHealthToStatus(r.health) === "FAULT").length;
      const weak = relays.filter(r => !relayIsDown(r) && relayHealthToStatus(r.health) === "WEAK").length;
      const healthy = relays.filter(r => !relayIsDown(r) && relayHealthToStatus(r.health) === "ONLINE").length;

      // Check for unacked PINGs
      const unackedPings = relays.filter(r => r.awaitingAck && !r.offline).length;

      // 2-relay configuration
      if (relays.length === 2) {
        // SEVERING: Both relays offline
        if (offline === 2) {
          return { state: "SEVERING", reason: "ALL_RELAYS_OFFLINE", score: 4 };
        }
        // CRITICAL: One offline + one degraded, OR both severely degraded (FAULT/CRITICAL)
        if ((offline === 1 && (critical + fault + weak >= 1)) || (critical + fault) >= 2) {
          return { state: "CRITICAL", reason: "IMMINENT_FAILURE", score: 3 };
        }
        // DEGRADED: One offline OR one FAULT/CRITICAL OR 2+ unacked PINGs
        if (offline === 1 || critical >= 1 || fault >= 1 || unackedPings >= 2) {
          return { state: "DEGRADED", reason: "REDUCED_REDUNDANCY", score: 2 };
        }
      }

      // 3+ relay configuration (handles 3-8 relays)
      if (relays.length >= 3) {
        const onlineRelays = relays.length - offline;

        // SEVERING: ALL relays offline (only condition for SEVER)
        if (offline === relays.length) {
          return { state: "SEVERING", reason: "ALL_RELAYS_OFFLINE", score: 4 };
        }

        // CRITICAL: Only 1 relay remaining online
        if (onlineRelays === 1) {
          return { state: "CRITICAL", reason: "IMMINENT_FAILURE", score: 3 };
        }

        // DEGRADED: Multiple relays down but 2+ still online, OR significant degradation
        if (offline >= 1 || (critical + fault) >= 2 || unackedPings >= 3) {
          return { state: "DEGRADED", reason: "REDUCED_REDUNDANCY", score: 2 };
        }
      }

      return { state: "HEALTHY", reason: null, score: 0 };
    }

    // Calculate the ratio of healthy relays (0.0 to 1.0)
    // Returns the proportion of relays that are ONLINE or WEAK
    function getRelayHealthRatio(g) {
      const relays = g.relays || [];
      if (relays.length < 2) return 0;

      const healthyCount = relays.filter(r => {
        const status = relayDisplayStatus(r);
        return status === "ONLINE" || status === "WEAK";
      }).length;

      return healthyCount / relays.length;
    }

    // Legacy function for backwards compatibility
    // Returns true only if ALL relays are functional
    function relaysFunctional(g) {
      return getRelayHealthRatio(g) === 1.0;
    }

    function allRelaysDown(g) {
      return (g.relays || []).length >= 2 && (g.relays || []).every(relayIsDown);
    }

    function isGateSystemsFailed(g) {
      const relaysFailed = (g.relays || []).length > 0 && g.relays.every(r => {
        const status = relayHealthToStatus(r.health);
        return status === "FAULT" || status === "CRITICAL";
      });
      return g.health.includes("MAINTENANCE")
        && g.beacon === "OFFLINE"
        && g.alignment === "OUT OF TOLERANCE"
        && g.sync === "FAULT"
        && allCorridorsOffline(g)
        && allFacilityOffline(g)
        && relaysFailed;
    }

    function gateSystemsCritical(g) {
      return g.alignment === "OUT OF TOLERANCE" || g.sync === "FAULT";
    }

    function gateSystemsAlertLabel(g) {
      const alignmentBad = g.alignment === "OUT OF TOLERANCE";
      const syncBad = g.sync === "FAULT";
      if (alignmentBad && syncBad) return "ALIGNMENT + SYNC FAULT";
      if (alignmentBad) return "ALIGNMENT OUT OF TOLERANCE";
      if (syncBad) return "SYNC FAULT";
      return "STANDBY";
    }

    function gateSystemsSeverCause(g) {
      if (g.alignment === "OUT OF TOLERANCE") return "GATE ALIGNMENT LOST";
      if (g.sync === "FAULT") return "GATE SYNC LOST";
      return null;
    }

    function syncGateSystemsFailureTimer(g, now = Date.now()) {
      if (gateSystemsCritical(g)) {
        if (!g.gateSystemsFailureSince) g.gateSystemsFailureSince = now;
      } else {
        g.gateSystemsFailureSince = 0;
      }
    }

    function gateSystemsSeverRemainingMs(g, now = Date.now()) {
      if (!gateSystemsCritical(g) || !g.gateSystemsFailureSince) return 0;
      const elapsed = now - g.gateSystemsFailureSince;
      return Math.max(0, GATE_SYSTEMS_SEVER_GRACE_MS - elapsed);
    }

    function gateSeverReason(g) {
      const fuelLevel = ensureResources(g).FUEL?.level ?? 100;
      if (fuelLevel <= 0) return "Gate Power Loss";

      // Check if operator has entered debt
      const wageCredits = availableWageCredits(g);
      if (wageCredits <= 0) return "OPERATOR ENTERED DEBT";

      // Check for dock traffic congestion
      const waitingToDock = (g.inbound || []).filter(s => s.state === "WAITING TO DOCK");
      const waitingToDockCount = waitingToDock.length;
      const criticalWaitingCount = waitingToDock.filter(s => s.priority === true).length;

      // SEVER if more than 1 CRITICAL/PRIORITY ship is waiting (they're more important)
      if (criticalWaitingCount > 1) return "CRITICAL SHIP QUEUE BACKLOG";

      // SEVER if more than 3 regular ships waiting to dock
      if (waitingToDockCount > 3) return "DOCK TRAFFIC CONGESTION";

      if (g.relayFailureSince) {
        const elapsed = Date.now() - g.relayFailureSince;
        const broadcastExtension = g.broadcastTimeAdded || 0;
        const totalTimeAllowed = RELAY_SEVER_GRACE_MS + broadcastExtension;

        if (elapsed >= totalTimeAllowed) {
          const healthState = computeRelayHealthState(g);
          if (healthState.state === "SEVERING") {
            return "Gate Relay Disconnected";
          }
        }
      }
      const gateSystemsCause = gateSystemsSeverCause(g);
      if (gateSystemsCause && g.gateSystemsFailureSince) {
        const elapsed = Date.now() - g.gateSystemsFailureSince;
        if (elapsed >= GATE_SYSTEMS_SEVER_GRACE_MS) {
          return gateSystemsCause;
        }
      }
      if (allCorridorsOffline(g)) return "Losing Connection to the Corridor Network";
      if (allFacilityOffline(g)) return "Gate System Failure";
      if (isGateSystemsFailed(g)) return "Gate Systems Failures";
      return null;
    }

    function shipStatusPill(s) {
      const st = String(s.state).toUpperCase();
      if (st.includes("WAITING TO DOCK")) return ["WAITING TO DOCK", "warn"];
      if (st.includes("WAITING DECON")) return ["WAITING DECON", "warn"];
      if (st === "DECON") return ["DECON", "warn"];
      if (st.includes("SERVICING")) {
        // Show warning if servicing is blocked due to FUEL MANIFOLD being offline
        if (s.servicingBlocked) return ["CANNOT REFUEL", "warn"];
        return ["SERVICING", "ok"];
      }
      if (st.includes("CLEARING")) return ["CLEARING", "warn"];
      if (st.includes("COMPLETE")) return ["COMPLETE - DEPARTING GATE", "ok"];
      if (st.includes("DEN")) return ["DENIED", "bad"];
      if (st.includes("HOLD")) return ["HOLD", "warn"];
      if (st.includes("ARRIV")) return ["ARRIVED", "ok"];
      if (st.includes("DEPART")) return ["DEPARTED", "ok"];
      if (st.includes("CLEAR")) return ["CLEARED", "ok"];
      return ["PENDING", "warn"];
    }

    function deconCountdown(s) {
      if (!s || s.state !== "DECON" || !s.deconEndsAt) return "";

      const g = activeGate();
      g.repairAttempts ||= [];
      const deconFacility = getFacility(g, "DECON");

      if (deconFacility && deconFacility.status === "OFFLINE") {
        return "SUSPENDED";
      }

      const remaining = Math.max(0, Math.ceil((s.deconEndsAt - Date.now()) / 1000));
      const timeStr = formatMMSS(remaining);

      if (deconFacility && deconFacility.status === "DEGRADED") {
        return timeStr + " (REDUCED)";
      }

      return timeStr;
    }

    function serviceCountdown(s) {
      if (!s || s.state !== "SERVICING" || !s.serviceEndsAt) return "";

      const g = activeGate();
      const fuelFacility = getFacility(g, "FUEL");

      if (fuelFacility && fuelFacility.status === "OFFLINE") {
        return "SUSPENDED";
      }

      const remaining = Math.max(0, Math.ceil((s.serviceEndsAt - Date.now()) / 1000));
      const timeStr = formatMMSS(remaining);

      if (fuelFacility && fuelFacility.status === "DEGRADED") {
        return timeStr + " (REDUCED)";
      }

      return timeStr;
    }

    function isDeadlineUrgent(s) {
      return !!s.deadlineUrgent || s.deadlineType === "URGENT";
    }

    function formatDeadlinePriority(s) {
      const base = s.deadlineType || "STANDARD";
      if (isDeadlineUrgent(s) && base !== "URGENT") return `${base} + URGENT`;
      return base;
    }

    function getDeadlinePrefix(s) {
      const urgent = isDeadlineUrgent(s);
      const critical = s.deadlineType === "CRITICAL";
      if (!urgent && !critical) return "";
      let prefix = "";
      if (critical) prefix += "!";
      if (urgent) prefix += "*";
      return prefix;
    }

    function departureDeadlineCountdown(s) {
      if (!s || s.dir !== "OUT" || !s.departureDeadline || s.state === "DEPARTED" || s.state === "DENIED" || s.state === "CLEARED") return "";

      const now = Date.now();
      const remaining = Math.max(0, Math.ceil((s.departureDeadline - now) / 1000));

      if (remaining === 0) return "EXPIRED";

      const prefix = getDeadlinePrefix(s);

      return prefix ? `${prefix} ${formatMMSS(remaining)}` : formatMMSS(remaining);
    }

    function getUrgencyClass(s) {
      if (s.dir !== "OUT" || !s.departureDeadline) return "";
      if (s.state === "DEPARTED" || s.state === "DENIED" || s.state === "CLEARED") return "";

      const now = Date.now();
      const remaining = s.departureDeadline - now;
      const total = s.departureDeadline - (s.departureDeadline - ((s.eta + 30) * 1000)); // Approximate
      const pct = remaining / total;

      if (s.deadlineType === "CRITICAL" && pct < 0.25) return "urgency-critical";
      if (pct < 0.15) return "urgency-high";
      if (pct < 0.3) return "urgency-medium";

      return "";
    }

    function getDeadlineSymbol(s) {
      if (s.dir !== "OUT" || !s.departureDeadline) return "";
      if (s.state === "DEPARTED" || s.state === "DENIED" || s.state === "CLEARED") return "";

      const prefix = getDeadlinePrefix(s);
      return prefix ? ` ${prefix}` : "";
    }

    function getDeadlineColorClass(s) {
      if (!s || s.dir !== "OUT" || !s.departureDeadline) return "deadline-dim";
      if (s.state === "DEPARTED" || s.state === "DENIED" || s.state === "CLEARED") return "deadline-dim";

      const now = Date.now();
      const remaining = Math.max(0, Math.ceil((s.departureDeadline - now) / 1000));

      // CRITICAL ships have strict thresholds
      if (s.deadlineType === "CRITICAL") {
        if (remaining <= 20) return "deadline-bad";     // Last 20 seconds
        if (remaining <= 60) return "deadline-warn";    // Last 60 seconds
        return "deadline-dim";                          // More than 60 seconds
      }

      // URGENT ships
      if (isDeadlineUrgent(s)) {
        if (remaining <= 10) return "deadline-bad";
        if (remaining <= 30) return "deadline-warn";
        return "deadline-dim";
      }

      // STANDARD and others
      if (remaining <= 10) return "deadline-warn";
      return "deadline-dim";
    }

    function formatDeadlineDetail(s) {
      if (!s.departureDeadline) return "--";

      const now = Date.now();
      const remaining = Math.max(0, Math.ceil((s.departureDeadline - now) / 1000));

      if (remaining === 0) return "EXPIRED";
      if (s.missedDeadline) return `MISSED (${formatMMSS(Math.abs((s.departureDeadline - now) / 1000))})`;

      return formatMMSS(remaining);
    }


    // Inline ship detail helpers (DTL / DETAIL)
    function getCrewDisplay(s) {
      // Backwards compatibility: if ship doesn't have crew property, return placeholder
      if (!s.crew) {
        return "—";
      }

      if (s.obscured && s.infoMasked && s.crew.length > 0) {
        return s.crew.map(c => `${maskCrewName(c.name)} (${maskCrewName(c.role || "Unknown")})`).join(", ");
      }

      // PIRATE/RAIDER ships always show as UNKNOWN and cannot be revealed
      const isPirateRaider = s.crew && s.crew.length > 0 && s.crew[0].name === "UNKNOWN";

      if (isPirateRaider) {
        return "UNKNOWN";
      }

      // If crew is unknown and not revealed yet, show question marks
      if (s.crewUnknown && !s.crewRevealed) {
        return "????";
      }

      // If crew is revealed, show names with formatting
      if (s.crew && s.crew.length > 0) {
        // Check if ship has unrevealed Vacuum Bloom hazard
        const hasUnrevealedVacuumBloom = (s.effects || []).some(e =>
          e.name === "VACUUM BLOOM" && e.hidden && !e.revealed
        );

        const crewNames = s.crew.map(c => {
          let name = c.name;

          // Apply transponder mismatch corruption if needed
          if (s.transponder === "MISMATCH" && !isPirateRaider) {
            const match = typeof s.transponderMatch === "number" ? s.transponderMatch : 0;
            const minCorruption = 0.25 - (0.15 * match);
            const maxCorruption = 0.45 - (0.25 * match);
            const corruptionRate = minCorruption + Math.random() * (maxCorruption - minCorruption);
            name = corruptCrewName(name, corruptionRate);
          }

          // Mark deceased crew in red, but only if Vacuum Bloom hazard is revealed
          // (otherwise showing deceased crew gives away the hazard before it's discovered)
          if (c.deceased && !hasUnrevealedVacuumBloom) {
            return `${name} (DECEASED)`;
          }
          return name;
        });

        return crewNames.join(", ");
      }

      return "—";
    }

    function shipDetailKVHtml(s) {
      const deconTime = deconCountdown(s);
      const serviceTime = serviceCountdown(s);
      const etaFrozen = ["DENIED","ARRIVED","DEPARTED","WAITING TO DOCK","WAITING DECON","DECON","SERVICING","CLEARING","COMPLETE"].includes(s.state);
      const eta = etaFrozen ? "--:--" : (s.etaUnknown ? "??:??" : formatMMSS(s.eta));
      const displayTransponder = shipDisplayTransponder(s);
      const visibleEffects = (s.effects || []).filter(e => !e.hidden || e.revealed).map(e => e.name);
      const effectLine = visibleEffects.length ? visibleEffects.join(" / ") : "NONE";
      const prioDisplay = shipDisplayPriority(s);
      const prioText = prioDisplay === null ? "???" : (prioDisplay ? "YES" : "NO");
      const crewDisplay = getCrewDisplay(s);

      const rows = (s.obscured && s.infoMasked) ? [
        ["DIR", s.dir],
        ["STATE", s.state],
        ["CARGO", shipDisplayCargo(s)],
        ...(deconTime ? [["DECON REMAIN", deconTime]] : []),
        ...(serviceTime ? [["SERVICE REMAIN", serviceTime]] : []),
        ["ETA", eta],
        ...(s.dir === "OUT" && s.departureDeadline ? [
          ["DEADLINE", formatDeadlineDetail(s)],
          ["PRIORITY", formatDeadlinePriority(s)]
        ] : []),
        ["SLOT", s.slotId || "--"],
        ["DOCK", s.dockState || "--"],
        ["TRANSPONDER", displayTransponder],
        ["CREW", crewDisplay]
      ] : [
        ["DIR", s.dir],
        ["TYPE", shipDisplayType(s)],
        ["REQUEST", shipDisplayRequest(s)],
        ["CARGO", shipDisplayCargo(s)],
        ["STATE", s.state],
        ...(deconTime ? [["DECON REMAIN", deconTime]] : []),
        ...(serviceTime ? [["SERVICE REMAIN", serviceTime]] : []),
        ["ETA", eta],
        ...(s.dir === "OUT" && s.departureDeadline ? [
          ["DEADLINE", formatDeadlineDetail(s)],
          ["PRIORITY", formatDeadlinePriority(s)]
        ] : []),
        ["SLOT", s.slotId || "--"],
        ["DOCK", s.dockState || "--"],
        ["TRANSPONDER", displayTransponder],
        ["PRIORITY", prioText],
        ["REASON", s.reason || "—"],
        ["EFFECTS", effectLine],
        ["CREW", crewDisplay],
        ["NOTES", s.notes ? s.notes : "—"]
      ];

      return rows.map(([k, v]) => {
        // Special handling for CREW to allow HTML formatting for deceased markers
        if (k === "CREW" && v.includes("(DECEASED)")) {
          // Split by comma, format each crew member
          const crewFormatted = v.split(", ").map(name => {
            if (name.includes("(DECEASED)")) {
              const cleanName = name.replace(" (DECEASED)", "");
              return `<span class="crew-deceased">${escapeText(cleanName)} (DECEASED)</span>`;
            }
            return escapeText(name);
          }).join(", ");
          return `<div class="k">${escapeText(k)}</div><div class="v">${crewFormatted}</div>`;
        }
        if (k === "CARGO" && shipCargoIsIllegalVisible(s)) {
          return `<div class="k">${escapeText(k)}</div><div class="v"><span class="cargo-illegal">${escapeText(String(v))}</span></div>`;
        }
        return `<div class="k">${escapeText(k)}</div><div class="v">${escapeText(String(v))}</div>`;
      }).join("");
    }

    function shipInlineDetailPanel(s, opts = {}) {
      const note = (s.obscured && s.infoMasked) ? `<div class="inline-detail-sub">SIGNAL MASKED / IDENTITY UNVERIFIED</div>` : "";
      const context = opts.context || "queue";
      return `
        <div class="inline-detail ${opts.compact ? "inline-detail-compact" : ""}">
          <div class="inline-detail-head">
            <div>
              <div class="inline-detail-title">DETAIL: ${escapeText(s.id)}</div>
              ${note}
            </div>
            <button class="btn-mini hold" data-action="detail" data-id="${escapeText(s.id)}" data-context="${escapeText(context)}">CLOSE</button>
          </div>
          <div class="kv">${shipDetailKVHtml(s)}</div>
        </div>
      `;
    }

    function shipDetailTableRow(s, context) {
      return `
        <tr class="detail-row">
          <td colspan="6">
            ${shipInlineDetailPanel(s, { context })}
          </td>
        </tr>
      `;
    }

    function shipDetailDockRow(s) {
      return `<div class="dock-inline-detail">${shipInlineDetailPanel(s, { compact: true, context: "dock" })}</div>`;
    }

    function renderHoldButton(s, isFinalized = false) {
      // If HOLD has been used and ship is no longer on HOLD, hide button
      if (s.holdUsed && s.state !== "HOLD") {
        return "";
      }

      // If currently on HOLD with active timer, show countdown
      if (s.state === "HOLD" && s.holdStartTime > 0 && s.holdDuration > 0) {
        const elapsed = Date.now() - s.holdStartTime;
        const remaining = Math.max(0, s.holdDuration - elapsed);
        const remainingSec = Math.ceil(remaining / 1000);
        return `<button class="btn-mini hold" disabled>${remainingSec}s</button>`;
      }

      // If HOLD has been used but not currently on HOLD (shouldn't happen), hide
      if (s.holdUsed) {
        return "";
      }

      // Normal HOLD button
      const disabledClass = isFinalized ? "disabled" : "";
      return `<button class="btn-mini hold ${disabledClass}" data-action="hold" data-id="${escapeText(s.id)}">HOLD</button>`;
    }

    function getShipHazardHighlight(s) {
      // Ships with revealed hazards should have danger highlight (red)
      // Only highlight when hazards are revealed (not masked)
      if (!shipInfoMasked(s) && shipIsHazardous(s)) {
        return " ship-hazard-danger";
      }

      // UNKNOWN ships (regardless of revealed status) should have warning highlight (yellow)
      const displayType = shipDisplayType(s);
      if (displayType === "UNKNOWN") {
        return " ship-unknown-warning";
      }

      // Transponder mismatches should have warning highlight (yellow)
      const displayTransponder = shipDisplayTransponder(s);
      if (displayTransponder === "MISMATCH") {
        return " ship-unknown-warning";
      }

      return "";
    }

    function shipRow(s, context) {
      const g = activeGate();
      const [pText, pCls] = shipStatusPill(s);
      const deconTime = deconCountdown(s);
      const deadlineTime = departureDeadlineCountdown(s);
      const stEta = String(s.state || "").toUpperCase();
			const etaFrozen =
				["DENIED","ARRIVED","DEPARTED","WAITING TO DOCK","WAITING DECON","DECON","SERVICING","CLEARING","COMPLETE"].includes(s.state) ||
				stEta.includes("DEPART") || stEta.includes("ARRIV") || stEta.includes("COMPLETE");

			const eta = etaFrozen ? "—" : (s.etaUnknown ? "??:??" : formatMMSS(s.eta));
      const prioDisplay = shipDisplayPriority(s);

      // Build compact indicator symbols without duplication
      let indicators = "";
      if (prioDisplay === null) indicators += "?";
      else if (prioDisplay) indicators += "★";

      // Combine transponder and deadline warnings (avoid duplicate "!")
      const hasTransponderWarning = shipDisplayTransponder(s) !== "VALID";
      const deadlinePrefix = getDeadlinePrefix(s); // "!", "*", "!*", or ""
      const hasCriticalDeadline = deadlinePrefix.includes("!");
      const hasUrgentDeadline = deadlinePrefix.includes("*");

      if (hasTransponderWarning || hasCriticalDeadline) indicators += "!";
      if (hasUrgentDeadline) indicators += "*";
      if (s.obscured) indicators += "X";

      // Add space before indicators if any exist
      const statusSymbols = indicators ? ` ${indicators}` : "";

        const urgency = getUrgencyClass(s);
        const hazardHighlight = getShipHazardHighlight(s);
        const canQuery = (s.typeUnknown || s.priorityUnknown || s.etaUnknown || s.infoMasked || s.transponder !== "VALID" || s.cargoUnknown || (s.crewUnknown && !s.crewRevealed)) && !s.queryPending;
        const deconOnline = getFacility(g, "DECON")?.status === "ONLINE";
        const canDecon = s.dir === "IN" && s.state === "WAITING DECON" && deconOnline && !shipHasEffect(s, "VACUUM BLOOM");
        const contextualId = `${context}:${s.id}`;
        const isDetailOpen = runtime.inlineDetailId === contextualId;
        const isFinalized = isShipFinalized(s);
        const alignmentBlocked = g.alignment === "OUT OF TOLERANCE";
        const disabledClass = isFinalized ? "disabled" : "";
        const approveDisabledClass = (isFinalized || alignmentBlocked) ? "disabled" : "";
        const st = String(s.state || "").toUpperCase();
				const canDecide = !(st.includes("DEPART") || st.includes("ARRIV") || st.includes("COMPLETE") || st.includes("WAITING TO DOCK"));
        const cargoDisplay = shipDisplayCargo(s);
        const cargoCls = shipCargoIsIllegalVisible(s) ? "cargo-illegal" : "";
        let pulseClass = "";
        if (s.justFlagged) pulseClass = " ship-flagged-pulse";
        if (s.scanRequiredPulse) pulseClass = " ship-scan-required-pulse";
        if (s.hazardDetected) pulseClass = " ship-hazard-detected-pulse";
        if (s.signalMaskedPulse) pulseClass = " ship-signal-masked-pulse";
        if (s.qryFailedPulse) pulseClass = " ship-qry-failed-pulse";
        if (s.qrySuccessPulse) pulseClass = " ship-qry-success-pulse";

        // Add deadline pulse for CRITICAL ships in last 10 seconds
        if (s.dir === "OUT" && s.departureDeadline && s.deadlineType === "CRITICAL" && s.state !== "DEPARTED" && s.state !== "DENIED" && s.state !== "CLEARED") {
          const remainingSec = Math.max(0, Math.ceil((s.departureDeadline - Date.now()) / 1000));
          if (remainingSec > 0 && remainingSec <= 10) {
            pulseClass = " ship-deadline-critical-pulse";
          }
        }

        return `
          <tr class="${urgency}${hazardHighlight}${pulseClass}">
            <td class="code" data-label="Id" title="${escapeText(shipDisplayRequest(s))} / ${escapeText(shipDisplayTransponder(s))}">${escapeText(s.id)}${statusSymbols}</td>
            <td data-label="Eta">${escapeText(eta)}</td>
            <td data-label="Type" title="${escapeText(shipDisplayRequest(s))}">${escapeText(shipDisplayType(s))}</td>
            <td data-label="Cargo" class="${cargoCls}">${escapeText(cargoDisplay)}</td>
            <td data-label="Status">
              <span class="pill ${pCls}">${escapeText(pText)}</span>
              ${deconTime ? `<div class="status-meta">T-${escapeText(deconTime)}</div>` : ""}
              ${deadlineTime ? `<div class="status-meta ${getDeadlineColorClass(s)}">${deadlineTime}</div>` : ""}
            </td>
            <td data-label="Action" class="action-cell" style="text-align:right;">
              <div class="row-actions">
                <button class="btn-mini ${isDetailOpen ? "detail-open" : ""}" data-action="detail" data-id="${escapeText(s.id)}" data-context="${escapeText(context)}">DTL</button>
                ${canQuery ? `<button class="btn-mini hold" data-action="query" data-id="${escapeText(s.id)}">QRY</button>` : ""}
                ${canDecon ? `<button class="btn-mini approve" data-action="decon" data-id="${escapeText(s.id)}">DECON</button>` : ""}
                ${canDecide ? `<button class="btn-mini approve ${approveDisabledClass}" data-action="approve" data-id="${escapeText(s.id)}">APP</button>` : ""}
                ${canDecide ? renderHoldButton(s, isFinalized) : ""}
                ${canDecide ? `<button class="btn-mini deny ${disabledClass}" data-action="deny" data-id="${escapeText(s.id)}">DENY</button>` : ""}
              </div>
            </td>
          </tr>
          ${isDetailOpen ? shipDetailTableRow(s, context) : ""}
        `;
    }

    function renderQueues() {
      const g = activeGate();
      const inboundVisible = g.inbound.filter(s => !s.slotId && !s.dockState);
      ui.inboundMeta.textContent = `${inboundVisible.length} CONTACTS`;
      ui.outboundMeta.textContent = `${g.outbound.length} CONTACTS`;

      ui.inboundBody.innerHTML = inboundVisible.map(s => shipRow(s, "inbound")).join("");
      ui.outboundBody.innerHTML = g.outbound.map(s => shipRow(s, "outbound")).join("");

      // bind buttons per render (small tables)
      ui.inboundBody.querySelectorAll("[data-action]").forEach(btn => {
        btn.addEventListener("click", () => handleAction(btn.getAttribute("data-action"), btn.getAttribute("data-id"), btn.getAttribute("data-context")));
      });
      ui.outboundBody.querySelectorAll("[data-action]").forEach(btn => {
        btn.addEventListener("click", () => handleAction(btn.getAttribute("data-action"), btn.getAttribute("data-id"), btn.getAttribute("data-context")));
      });
    }

    function renderSystems() {
      const g = activeGate();
      const now = Date.now();
      const overall = computeOverallSystemsStatus(g);
      ui.overallSystemsPill.className = `pill ${overall.cls}`;
      ui.overallSystemsPill.textContent = overall.text;
      ui.overallSystemsDetail.textContent = overall.detail;

      const p = pillForHealth(g.health);
      ui.gateHealthPill.className = `pill ${p.cls}`;
      ui.gateHealthPill.textContent = p.text;

      ui.kvNode.textContent = g.health;
      ui.kvBeacon.textContent = g.beacon;
      ui.kvAlign.textContent = g.alignment;
      ui.kvSync.textContent = g.sync;

      syncGateSystemsFailureTimer(g, now);
      if (ui.gateAlertTimer) {
        const gateAlertActive = gateSystemsCritical(g) && g.gateSystemsFailureSince;
        if (gateAlertActive && !g.gateSystemsAlerted) {
          playSfx("danger");
          g.gateSystemsAlerted = true;
        } else if (!gateAlertActive) {
          g.gateSystemsAlerted = false;
        }
        if (gateAlertActive) {
          const remainingMs = gateSystemsSeverRemainingMs(g, now);
          const remainingSec = Math.ceil(remainingMs / 1000);
          const remainingText = formatMMSS(remainingSec);
          ui.gateAlertTimer.textContent = `${gateSystemsAlertLabel(g)} T-${remainingText}`;
          ui.gateAlertTimer.className = "v gate-alert-timer gate-alert-pulse";
          ui.gateAlertTimer.style.display = "";
          if (ui.gateAlertLabel) ui.gateAlertLabel.style.display = "";
        } else {
          ui.gateAlertTimer.textContent = "";
          ui.gateAlertTimer.className = "v gate-alert-timer dim";
          ui.gateAlertTimer.style.display = "none";
          if (ui.gateAlertLabel) ui.gateAlertLabel.style.display = "none";
        }
      }

      // Apply color coding to GATE SYSTEMS based on state
      // Beacon Array coloring
      if (g.beacon === "ONLINE") {
        ui.kvBeacon.className = "v good";
      } else if (g.beacon === "FAULT") {
        ui.kvBeacon.className = "v warn";
      } else {
        ui.kvBeacon.className = "v bad";
      }

      // Alignment coloring
      if (g.alignment === "WITHIN TOLERANCE") {
        ui.kvAlign.className = "v good";
      } else if (g.alignment === "DRIFTING") {
        ui.kvAlign.className = "v warn";
      } else {
        ui.kvAlign.className = "v bad";
      }

      // Sync State coloring
      if (g.sync === "SYNC") {
        ui.kvSync.className = "v good";
      } else if (g.sync === "ASYNC") {
        ui.kvSync.className = "v warn";
      } else {
        ui.kvSync.className = "v bad";
      }

      const beaconState = g.beacon === "ONLINE"
        ? { text: "BEACON ONLINE", cls: "ok", state: "online" }
        : (g.beacon === "FAULT")
          ? { text: "BEACON FAULT", cls: "warn", state: "fault" }
          : { text: "BEACON OFFLINE", cls: "bad", state: "offline" };
      ui.beaconPill.className = `pill ${beaconState.cls} beacon-pill ${beaconState.state}`;
      ui.beaconPill.textContent = beaconState.text;

      const cActive = g.corridors.filter(c => c.status === "STABLE").length;
      const cDegraded = g.corridors.filter(c => c.status === "DEGRADED").length;
      const cIntermittent = g.corridors.filter(c => c.status === "INTERMITTENT").length;
      const cOffline = g.corridors.filter(c => c.status === "OFFLINE").length;
      ui.corridorMeta.textContent = `${cActive} ACTIVE / ${cDegraded} DEG / ${cIntermittent} INTER / ${cOffline} OFF`;
      ui.corridorList.innerHTML = g.corridors.map(c => `
        <div class="k">LINK ${escapeText(c.link)}</div>
        <div class="v"><span class="pill ${c.cls}">${escapeText(c.status)}</span></div>
      `).join("");

      const facility = g.facility || [];
      const fOffline = facility.filter(f => f.status === "OFFLINE").length;
      const fDegraded = facility.filter(f => f.status === "DEGRADED").length;
      ui.facilityMeta.textContent = `${facility.length} SYSTEMS / ${fDegraded} DEG / ${fOffline} OFF`;

      // Count ships waiting to dock for CONGESTED status
      const waitingToDockCount = (g.inbound || []).filter(s => s.state === "WAITING TO DOCK").length;

      ui.facilityList.innerHTML = facility.map(f => {
        // Override status for DOCK facility when exactly 3 ships are waiting
        let displayStatus = f.status;
        if (f.id === "DOCK" && waitingToDockCount === 3 && f.status === "ONLINE") {
          displayStatus = "CONGESTED";
        }

        const pf = pillForState(FACILITY_STATES, displayStatus);
        const isDegraded = f.status === "DEGRADED";
        const isOffline = f.status === "OFFLINE";
        const isCongested = displayStatus === "CONGESTED";
        const hasRepair = hasActiveRepair(g, f.id);
        const hasWO = hasActiveWorkOrder(g, f.id);
        const cooldownRemaining = Math.max(0, REPAIR_COOLDOWN_MS - (now - (f.lastRepairAttemptAt || 0)));
        const onCooldown = cooldownRemaining > 0;

        const needsRepair = isDegraded && !hasRepair && !onCooldown;
        const needsWO = isOffline && !hasWO;
        const showCooldown = isDegraded && onCooldown;

        return `
          <div class="status-row${isCongested ? " congested-pulse" : ""}">
            <div class="status-name">${escapeText(f.name)}</div>
            <div class="status-right">
              <span class="pill ${pf.cls}">${escapeText(displayStatus)}</span>
              ${needsRepair ? `<button class="btn-mini attn" data-action="repair" data-system="${escapeText(f.id)}">REPAIR</button>` : ""}
              ${needsWO ? `<button class="btn-mini hold" data-action="workorder" data-system="${escapeText(f.id)}">WO</button>` : ""}
              ${showCooldown ? `<span class="status-meta">${Math.ceil(cooldownRemaining / 1000)}s</span>` : ""}
            </div>
          </div>
        `;
      }).join("");

      ui.workorderList.innerHTML = (g.workOrders && g.workOrders.length)
        ? g.workOrders.map(w => `
            <div class="status-row">
              <div class="status-name">${escapeText(w.systemName)}</div>
              <div class="status-right">
                <span class="pill ${workOrderClass(w.state)}">${escapeText(w.state)}</span>
                <span class="status-meta">${escapeText(formatMMSS((w.phaseEndsAt - Date.now()) / 1000))}</span>
              </div>
            </div>
          `).join("")
        : `<div class="status-row"><div class="status-name">NONE</div><div class="status-meta">STANDBY</div></div>`;

      const repairMeta = (g.repairAttempts || []).filter(r => r.state === "REPAIRING").length;
      ui.repairMeta.textContent = repairMeta > 0 ? `${repairMeta} ACTIVE` : "STANDBY";

      ui.repairList.innerHTML = (g.repairAttempts && g.repairAttempts.length)
        ? g.repairAttempts
            .filter(r => r.state === "REPAIRING")
            .map(r => `
              <div class="status-row">
                <div class="status-name">${escapeText(r.systemName)}</div>
                <div class="status-right">
                  <span class="pill warn">REPAIRING</span>
                  <span class="status-meta">${escapeText(formatMMSS((r.completesAt - now) / 1000))}</span>
                </div>
              </div>
            `).join("")
        : `<div class="status-row"><div class="status-name">NONE</div><div class="status-meta">STANDBY</div></div>`;

      const resources = ensureResources(g);
      const upgrades = ensureUpgrades(g);
      const activeOrderInput = ui.resourceList.contains(document.activeElement)
        && document.activeElement?.getAttribute("data-action") === "order-amount";
      const shouldRenderResources = !activeOrderInput;
      ui.resourceMeta.textContent = `${RESOURCE_TYPES.length} TRACKS`;
      if (shouldRenderResources) {
        ui.resourceList.innerHTML = RESOURCE_TYPES.map(r => {
        const res = resources[r.id];
        const level = clamp(res.level, 0, 100);
        const pct = Math.round(level);
        const isCritical = level <= RESOURCE_CRITICAL_THRESHOLD;
        const isLow = level <= RESOURCE_ORDER_THRESHOLD;
        const fillCls = isCritical ? "bad" : (isLow ? "warn" : "");
        let statusText = `${pct}%`;
        if (res.order) {
          const amountTag = res.order.amount ? ` / AMT ${res.order.amount}` : "";
          if (res.order.stage === "DELIVERED") {
            statusText = `DELIVERED${amountTag}`;
          } else if (res.order.stage === "INBOUND") {
            const ship = findShipById(g, res.order.shipmentId || "");
            const eta = ship ? ` / ETA ${formatMMSS(ship.eta)}` : "";
            statusText = `INBOUND: ${res.order.shipmentId || "SHIP"} / SHIPMENT${amountTag}${eta}`;
          } else {
            const remaining = res.order.stageEndsAt ? formatMMSS((res.order.stageEndsAt - Date.now()) / 1000) : "--:--";
            statusText = `${res.order.stage} (${remaining})${amountTag}`;
          }
        } else if (isLow) {
          statusText = "LOW - ORDER AVAILABLE";
        } else {
          statusText = "ORDER AVAILABLE";
        }
        const orderAmount = normalizeOrderAmount(res.orderAmount);
        const canOrder = resourceOrderAllowed(res);

        // Determine upgrade button state
        let upgradeButton = "";
        if (r.id === "FUEL") {
          if (upgrades.reactorUpgraded) {
            upgradeButton = `<button class="btn-mini" disabled style="opacity: 0.4;">UPGRADED</button>`;
          } else if (upgrades.reactorUpgrading) {
            const remaining = Math.max(0, upgrades.reactorUpgradeCompletesAt - Date.now());
            upgradeButton = `<button class="btn-mini" disabled style="opacity: 0.7;">UPGRADING ${formatMMSS(remaining / 1000)}</button>`;
          } else {
            upgradeButton = `<button class="btn-mini hold" data-action="upgrade" data-upgrade-type="REACTOR" style="opacity: 0.7;">UPGRADE REACTORS</button>`;
          }
        } else if (r.id === "SUPPLY") {
          if (upgrades.maintenanceUpgraded) {
            upgradeButton = `<button class="btn-mini" disabled style="opacity: 0.4;">UPGRADED</button>`;
          } else if (upgrades.maintenanceUpgrading) {
            const remaining = Math.max(0, upgrades.maintenanceUpgradeCompletesAt - Date.now());
            upgradeButton = `<button class="btn-mini" disabled style="opacity: 0.7;">UPGRADING ${formatMMSS(remaining / 1000)}</button>`;
          } else {
            upgradeButton = `<button class="btn-mini hold" data-action="upgrade" data-upgrade-type="MAINTENANCE" style="opacity: 0.7;">UPGRADE MAINTENANCE</button>`;
          }
        }

        return `
          <div class="resource-row">
            <div class="resource-head">
              <div class="resource-title">${escapeText(r.name)}</div>
              <div class="resource-meta">${pct}%</div>
            </div>
            <div class="resource-bar">
              <div class="resource-fill ${fillCls}" style="width:${pct}%;"></div>
            </div>
            <div class="resource-actions">
              <div class="resource-meta">${escapeText(statusText)}</div>
              <div class="resource-order">
                <button class="btn-mini order-step" data-action="order-dec" data-resource="${escapeText(r.id)}" ${canOrder ? "" : "disabled"}>-</button>
                <input class="resource-amount" data-action="order-amount" data-resource="${escapeText(r.id)}" value="${orderAmount}" maxlength="2" inputmode="numeric" pattern="[0-9]*" autocomplete="off" autocapitalize="off" spellcheck="false" ${canOrder ? "" : "disabled"} />
                <button class="btn-mini order-step" data-action="order-inc" data-resource="${escapeText(r.id)}" ${canOrder ? "" : "disabled"}>+</button>
                <button class="btn-mini approve" data-action="order" data-resource="${escapeText(r.id)}" ${canOrder ? "" : "disabled"}>ORDER</button>
              </div>
            </div>
            ${upgradeButton ? `<div style="margin-top: 6px; text-align: right;">${upgradeButton}</div>` : ""}
          </div>
        `;
        }).join("");
      }

      const concourse = concourseBand(g.concourseLevel || 0);
      ui.concoursePill.className = `pill ${concourse.cls}`;
      ui.concoursePill.textContent = concourse.text;
      ui.concourseStatus.textContent = `${concourse.text} (${Math.round(g.concourseLevel || 0)})`;

		ui.dockList.innerHTML = (g.dockSlots || []).map(slot => {
        // Check if slot is assembling
        if (slot.assembling && slot.assemblyCompletesAt) {
          const assemblyRemaining = Math.max(0, Math.ceil((slot.assemblyCompletesAt - now) / 1000));
          return `
            <div class="status-row">
              <div class="status-name">${escapeText(slot.id)} <span class="status-meta">ASSEMBLING</span></div>
              <div class="status-right">
                <span class="pill warn">ASSEMBLING</span>
                <span class="status-meta">${formatMMSS(assemblyRemaining)}</span>
              </div>
            </div>
          `;
        }

        const ship = slot.shipId ? findShipById(g, slot.shipId) : null;
        const shipName = ship ? ship.id : "--";
        let dockState = ship?.dockState || slot.state;
        // If ship is blocked in servicing, show special message
        if (ship?.servicingBlocked && dockState === "SERVICING") {
          dockState = "CANNOT REFUEL - FUEL MANIFOLD OFFLINE";
        }
        const deconTime = deconCountdown(ship);
        const serviceTime = serviceCountdown(ship);

        // NEW: Calculate exposure countdown
        let exposureHtml = "";
        let exposureCritical = false;
        if (ship && ship.state === "WAITING DECON" && ship.exposureDeadline) {
           const left = Math.max(0, Math.ceil((ship.exposureDeadline - Date.now()) / 1000));
           exposureHtml = ` <span style="color: var(--alert); font-weight: bold;">EXPOSURE ${formatMMSS(left)}</span>`;
           exposureCritical = left <= 20;
        }

        // Add meta info to the display string (without exposure - that's added separately)
        const dockMeta = `${shipName} / ${dockState}${deconTime ? ` / T-${deconTime}` : ""}${serviceTime ? ` / T-${serviceTime}` : ""}`;

        const canDecon = ship && ship.state === "WAITING DECON" && getFacility(g, "DECON")?.status === "ONLINE" && !shipHasEffect(ship, "VACUUM BLOOM");
        const contextualId = ship ? `dock:${ship.id}` : null;
        const isDetailOpen = !!ship && runtime.inlineDetailId === contextualId;

        // Return statement with exposure countdown styled in critical color
        return `
          <div class="status-row${exposureCritical ? " exposure-critical" : ""}">
            <div class="status-name">${escapeText(slot.id)} <span class="status-meta">${escapeText(dockMeta)}</span>${exposureHtml}</div>
            <div class="status-right">
              ${ship ? `<button class="btn-mini ${isDetailOpen ? "detail-open" : ""}" data-action="detail" data-id="${escapeText(ship.id)}" data-context="dock">DTL</button>` : ""}
              ${canDecon ? `<button class="btn-mini approve" data-action="decon" data-id="${escapeText(ship.id)}">DECON</button>` : ""}
            </div>
          </div>
          ${isDetailOpen ? shipDetailDockRow(ship) : ""}
        `;
      }).join("");

        // Add relay health banner before relay list
        const healthState = computeRelayHealthState(g);
        let healthBanner = "";
        if (healthState.state !== "HEALTHY") {
          const healthCls = healthState.state === "CRITICAL" || healthState.state === "SEVERING" ? "bad" : "warn";

          // SEVERING state: show BROADCAST button and sever timer
          if (healthState.state === "SEVERING" && g.relayFailureSince) {
            const elapsed = now - g.relayFailureSince;
            const baseRemaining = RELAY_SEVER_GRACE_MS - elapsed;
            const broadcastExtension = g.broadcastTimeAdded || 0;
            const totalRemaining = baseRemaining + broadcastExtension;
            const remainingSec = Math.max(0, Math.ceil(totalRemaining / 1000));

            healthBanner = `
              <div class="status-row health-warning ${healthCls} broadcast-critical">
                <div class="status-name">NETWORK DISCONNECTED</div>
                <div class="status-right">
                  <span class="pill ${healthCls}">SEVERING IN ${remainingSec}s</span>
                  <button class="btn-mini attn broadcast-pulse" data-action="broadcast">BROADCAST</button>
                </div>
              </div>
            `;
          } else {
            healthBanner = `
              <div class="status-row health-warning ${healthCls}">
                <div class="status-name">RELAY NETWORK HEALTH</div>
                <div class="status-right">
                  <span class="pill ${healthCls}">${healthState.state}</span>
                </div>
              </div>
            `;
          }
        }

        ui.relayList.innerHTML = healthBanner + (g.relays || []).map(r => {
          // Check if relay is assembling
          if (r.assembling && r.assemblyCompletesAt) {
            const assemblyRemaining = Math.max(0, Math.ceil((r.assemblyCompletesAt - now) / 1000));
            return `
              <div class="status-row relay-row">
                <div class="status-name">${escapeText(r.id)}
                  <span class="status-meta">ASSEMBLING</span>
                </div>
                <div class="status-right">
                  <span class="pill warn">ASSEMBLING</span>
                  <span class="status-meta">${formatMMSS(assemblyRemaining)}</span>
                </div>
              </div>
            `;
          }

          const displayStatus = relayDisplayStatus(r);
          const pr = pillForState(RELAY_STATES, displayStatus);
          const ackMeta = r.awaitingAck ? `<span class="status-meta">ACK REQUIRED</span>` : "";
          const ackClass = r.awaitingAck ? "attn" : "";
          const canRestore = ["FAULT", "WEAK", "CRITICAL"].includes(displayStatus);
          const canStabilize = ["ONLINE", "WEAK"].includes(displayStatus) && r.health < 85;
          const needsRelayWO = relayIsDown(r) && !r.hiddenOffline && !hasActiveWorkOrder(g, r.id);
          const pingPulse = r.pingPulseUntil && r.pingPulseUntil > now;
          const hbAgeSec = relayHeartbeatAgeSec(r, now);
          const hbBand = relayHeartbeatBand(r, hbAgeSec);
          const hbValue = (typeof hbAgeSec === "number") ? `${hbAgeSec}s` : "--";
          const healthBlink = r.healthBlinkUntil && r.healthBlinkUntil > now;
          const healthBlinkClass = healthBlink ? `health-blink-${r.healthBlinkType}` : "";
          const blinkStyle = healthBlink ? `style="--blink-count: ${r.healthBlinkCount};"` : "";
          return `
            <div class="status-row relay-row${pingPulse ? " relay-ping" : ""}">
              <div class="status-name">${escapeText(r.id)}
                <span class="relay-hb">
                  <span class="hb-indicator ${hbBand.cls} ${healthBlinkClass}" ${blinkStyle} aria-hidden="true"></span>
                  <span>HB:</span>
                  <span>${escapeText(hbValue)}</span>
                </span>
              </div>
              <div class="status-right">
                <span class="pill ${pr.cls}">${escapeText(displayStatus)}</span>
                ${ackMeta}
                <button class="btn-mini approve" data-action="ping-relay" data-relay="${escapeText(r.id)}">PING</button>
                <button class="btn-mini hold ${ackClass}" data-action="ack-relay" data-relay="${escapeText(r.id)}">ACK</button>
                ${canStabilize ? `<button class="btn-mini approve" data-action="stabilize-relay" data-relay="${escapeText(r.id)}">STABILIZE</button>` : ""}
                ${canRestore ? `<button class="btn-mini attn" data-action="restore-relay" data-relay="${escapeText(r.id)}">RESTORE</button>` : ""}
                ${needsRelayWO ? `<button class="btn-mini hold" data-action="workorder" data-system="${escapeText(r.id)}">WO</button>` : ""}
              </div>
            </div>
          `;
        }).join("");

      ui.facilityList.querySelectorAll("[data-action='workorder']").forEach(btn => {
        btn.addEventListener("click", () => issueWorkOrder(btn.getAttribute("data-system")));
      });
      ui.facilityList.querySelectorAll("[data-action='repair']").forEach(btn => {
        btn.addEventListener("click", () => initiateRepair(btn.getAttribute("data-system")));
      });
      ui.relayList.querySelectorAll("[data-action='workorder']").forEach(btn => {
        btn.addEventListener("click", () => issueWorkOrder(btn.getAttribute("data-system")));
      });

        ui.relayList.querySelectorAll("[data-action='ping-relay']").forEach(btn => {
          btn.addEventListener("click", () => cmdPingRelay(btn.getAttribute("data-relay")));
        });
        ui.relayList.querySelectorAll("[data-action='ack-relay']").forEach(btn => {
          btn.addEventListener("click", () => cmdAckRelay(btn.getAttribute("data-relay")));
        });
        ui.relayList.querySelectorAll("[data-action='restore-relay']").forEach(btn => {
          btn.addEventListener("click", () => cmdRestoreRelay(btn.getAttribute("data-relay")));
        });
        ui.relayList.querySelectorAll("[data-action='stabilize-relay']").forEach(btn => {
          btn.addEventListener("click", () => cmdStabilizeRelay(btn.getAttribute("data-relay")));
        });
        ui.relayList.querySelectorAll("[data-action='broadcast']").forEach(btn => {
          btn.addEventListener("click", () => cmdBroadcast());
        });

      if (shouldRenderResources) {
        ui.resourceList.querySelectorAll("[data-action='order']").forEach(btn => {
          btn.addEventListener("click", () => {
            const resId = btn.getAttribute("data-resource");
            const res = g.resources[resId];
            if (!res || !resourceOrderAllowed(res)) {
              consoleLine(`ORDER REFUSED: ${resId}`, "warn");
              playSfx("error");
              return;
            }
            const amount = normalizeOrderAmount(res.orderAmount);
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
              sendCoopAction("command", { command: `ORDER ${resId} ${amount}` });
              consoleLine(`> ORDER ${resId} ${amount}`, "dim");
              playSfx("click");
              return;
            }
            const cost = resourceOrderCost(resId, amount);
            const credits = availableWageCredits(g);
            if (credits < cost) {
              consoleLine(`ORDER REFUSED: ${resId} INSUFFICIENT WAGE (${cost} CR)`, "warn");
              playSfx("error");
              return;
            }
            if (!startResourceOrder(g, resId, amount)) {
              consoleLine(`ORDER REFUSED: ${resId}`, "warn");
              playSfx("error");
              return;
            }
            spendWage(g, cost);
            bumpStat(g, "resourceOrders");
            consoleLine(`ORDER PLACED: ${resId} x${amount} (-${cost} CR)`, "good");

            // Broadcast order placement to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("action", {
                message: `ORDER PLACED: ${resId} x${amount}`,
                messageClass: "good",
                sound: "click"
              });
            }

            g.lastRefresh = Date.now();
            renderAll();
          });
        });

        ui.resourceList.querySelectorAll("[data-action='order-dec']").forEach(btn => {
          btn.addEventListener("click", () => {
            const resId = btn.getAttribute("data-resource");
            const res = g.resources[resId];
            if (!res || res.order) return;
            const nextAmount = normalizeOrderAmount((res.orderAmount || RESOURCE_ORDER_MIN) - 1);
            res.orderAmount = nextAmount;
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
              sendCoopAction("resource_order_amount", { resourceId: resId, amount: nextAmount });
            }
            renderAll();
          });
        });

        ui.resourceList.querySelectorAll("[data-action='order-inc']").forEach(btn => {
          btn.addEventListener("click", () => {
            const resId = btn.getAttribute("data-resource");
            const res = g.resources[resId];
            if (!res || res.order) return;
            const nextAmount = normalizeOrderAmount((res.orderAmount || RESOURCE_ORDER_MIN) + 1);
            res.orderAmount = nextAmount;
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
              sendCoopAction("resource_order_amount", { resourceId: resId, amount: nextAmount });
            }
            renderAll();
          });
        });

        ui.resourceList.querySelectorAll("[data-action='order-amount']").forEach(input => {
          const resId = input.getAttribute("data-resource");
          const res = g.resources[resId];
          if (!res || res.order) return;
          input.addEventListener("input", () => {
            const cleaned = sanitizeOrderAmountInput(input.value);
            if (input.value !== cleaned) input.value = cleaned;
            res.orderAmount = cleaned ? Number(cleaned) : RESOURCE_ORDER_MIN;
          });
          input.addEventListener("blur", () => {
            const finalValue = clampOrderAmountInput(input.value);
            input.value = finalValue;
            res.orderAmount = Number(finalValue);
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
              sendCoopAction("resource_order_amount", { resourceId: resId, amount: res.orderAmount });
            }
          });
          input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
              input.blur();
            }
          });
        });

        ui.resourceList.querySelectorAll("[data-action='upgrade']").forEach(btn => {
          btn.addEventListener("click", () => {
            const upgradeType = btn.getAttribute("data-upgrade-type");

            // Check if co-op invited player - request vote instead
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
              requestUpgradeVote(upgradeType);
              return;
            }

            // Host or solo: open upgrade modal
            openUpgradeModal(upgradeType);
          });
        });
      }

      ui.dockList.querySelectorAll("[data-action='detail']").forEach(btn => {
        btn.addEventListener("click", () => cmdDetail(btn.getAttribute("data-id"), { log: false, context: btn.getAttribute("data-context") || "dock" }));
      });
      ui.dockList.querySelectorAll("[data-action='decon']").forEach(btn => {
        btn.addEventListener("click", () => handleAction(btn.getAttribute("data-action"), btn.getAttribute("data-id")));
      });

      ui.alertCount.textContent = String(computeAlerts(g).length);
    }

    function getGateLatency(gateA, gateB, relayScoreA = 0, relayScoreB = 0) {
      const a = String(gateA || "").toUpperCase();
      const b = String(gateB || "").toUpperCase();
      if (!a || !b || a === b) return 0;

      // Get base latency from ping matrix or deterministic hash
      const pm = runtime.multiplayer?.pingMatrix || {};
      const g1 = a < b ? a : b;
      const g2 = a < b ? b : a;

      const candidates = [
        pm?.[a]?.[b],
        pm?.[b]?.[a],
        pm?.[`${g1}|${g2}`],
        pm?.[`${g1}-${g2}`],
        pm?.[`${g1}:${g2}`],
      ];

      let baseLatency = 0;
      for (const v of candidates) {
        if (typeof v === "number" && Number.isFinite(v)) {
          baseLatency = Math.round(v);
          break;
        }
      }

      // Fallback: deterministic hash
      if (baseLatency === 0) {
        const s = `${g1}|${g2}|TQE_LINKPING`;
        let h = 2166136261;
        for (let i = 0; i < s.length; i++) {
          h ^= s.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        const u = (h >>> 0);
        baseLatency = 1000 + (u % 8001);
      }

      // Apply degradation based on relay scores (0=healthy, 2=degraded, 3=critical, 4=severing)
      let degradation = 0;
      if (relayScoreA >= 2 || relayScoreB >= 2) {
        degradation = Math.max(relayScoreA, relayScoreB) * 500; // Add 500ms per degradation level
      }

      return Math.max(1000, Math.min(9000, baseLatency + degradation));
    }

    function renderGateNetwork() {
      const g = activeGate();
      const now = Date.now();
      const myGateId = g?.id || runtime.activeGateId;

      // Show/hide panel based on multiplayer connection
      if (!runtime.multiplayer.enabled || !ui.gateNetworkPanel) {
        if (ui.gateNetworkPanel) {
          ui.gateNetworkPanel.style.display = "none";
        }
        return;
      }

      ui.gateNetworkPanel.style.display = "";

      // Get other players (exclude self)
      const otherPlayers = (runtime.multiplayer.players || []).filter(p => p.gateId !== myGateId);

      // Get my relay health score
      const myRelayHealth = computeRelayHealthState(g);
      const myRelayScore = myRelayHealth.score;

      // Update gate states for each player
      otherPlayers.forEach(player => {
        if (!runtime.multiplayer.gateStates.has(player.gateId)) {
          runtime.multiplayer.gateStates.set(player.gateId, {
            gateId: player.gateId,
            status: "CONNECTED",
            connectedAt: now,
            showConnectedUntil: now + 5000,
            disconnectReason: null,
            disconnectStartedAt: null,
            removeAt: null,
            pendingPing: null,
            pingAudioTimer: null
          });
        }
      });

      // Clean up states for players no longer in the list
      const currentGateIds = new Set(otherPlayers.map(p => p.gateId));
      for (const [gateId, state] of runtime.multiplayer.gateStates.entries()) {
        if (!currentGateIds.has(gateId) && !state.removeAt) {
          // Player left - mark for removal (will be handled in player list handler)
        }
      }

      // Build gate data array
      const gateDataList = [];
      let hasPendingPings = false;

      for (const [gateId, state] of runtime.multiplayer.gateStates.entries()) {
        // Skip if marked for removal and past removal time
        if (state.removeAt && now >= state.removeAt) {
          runtime.multiplayer.gateStates.delete(gateId);
          continue;
        }

        const player = otherPlayers.find(p => p.gateId === gateId);
        const playerRelayScore = player?.relayScore || 0;
        const hasPendingPing = g.pendingPlayerPings?.some(p => p.sourceGateId === gateId && !p.acked) || false;

        // Check if this gate is part of a co-op session
        const isCoopGate = runtime.multiplayer.coop.enabled &&
                          runtime.multiplayer.coop.participants?.some(p => p.gateId === gateId);

        if (hasPendingPing) hasPendingPings = true;

        gateDataList.push({
          gateId,
          state,
          player,
          playerRelayScore,
          hasPendingPing,
          isCoopGate
        });
      }

      // Update panel header class for pulse effect when collapsed
      const panelHeader = ui.gateNetworkPanel.querySelector('.subsection-header');
      if (panelHeader) {
        panelHeader.classList.toggle('pending-ping', hasPendingPings);
      }

      // Sort: PINGING gates first, then by gateId
      gateDataList.sort((a, b) => {
        if (a.hasPendingPing && !b.hasPendingPing) return -1;
        if (!a.hasPendingPing && b.hasPendingPing) return 1;
        return a.gateId.localeCompare(b.gateId);
      });

      // Apply filter
      const filterText = runtime.multiplayer.gateNetworkFilter.toUpperCase();
      const filteredGates = filterText
        ? gateDataList.filter(gd => gd.gateId.toUpperCase().includes(filterText))
        : gateDataList;

      // Calculate pagination
      const GATES_PER_PAGE = 6;
      const totalGates = filteredGates.length;
      const totalPages = Math.ceil(totalGates / GATES_PER_PAGE);
      const needsPagination = totalGates > GATES_PER_PAGE;

      // Reset page if out of bounds
      if (runtime.multiplayer.gateNetworkPage >= totalPages && totalPages > 0) {
        runtime.multiplayer.gateNetworkPage = totalPages - 1;
      }
      if (runtime.multiplayer.gateNetworkPage < 0) {
        runtime.multiplayer.gateNetworkPage = 0;
      }

      const currentPage = runtime.multiplayer.gateNetworkPage;
      const startIdx = currentPage * GATES_PER_PAGE;
      const endIdx = Math.min(startIdx + GATES_PER_PAGE, totalGates);
      const displayedGates = filteredGates.slice(startIdx, endIdx);

      // Build HTML
      let html = "";

      // Add filter bar if needed (when multiple pages exist)
      if (needsPagination) {
        html += `
          <div class="gate-filter-bar">
            <label for="gate-filter-input">FILTER:</label>
            <input
              type="text"
              id="gate-filter-input"
              class="gate-filter-input"
              placeholder="GATE ID..."
              value="${escapeText(runtime.multiplayer.gateNetworkFilter)}"
            >
          </div>
        `;
      }

      // Render gate rows
      const rows = displayedGates.map(gateData => {
        const { gateId, state, player, playerRelayScore, hasPendingPing, isCoopGate } = gateData;
        const isDetailOpen = runtime.inlineGateDetailId === gateId;

        // Calculate latency
        let latencyDisplay = "";
        let statusDisplay = "";
        let indicatorClass = "";

        if (state.status === "CONNECTED" && now < state.showConnectedUntil) {
          statusDisplay = "CONNECTED";
          indicatorClass = "ok";
        } else if (state.status === "SEVERING") {
          // Increase latency over 10 seconds
          const elapsed = now - state.disconnectStartedAt;
          const baseLatency = getGateLatency(myGateId, gateId, myRelayScore, playerRelayScore);
          const increase = Math.min(elapsed / 10000, 1) * 5000; // Increase up to +5000ms
          latencyDisplay = `${Math.round(baseLatency + increase)}ms`;
          statusDisplay = elapsed >= 10000 ? "CONNECTION LOST" : latencyDisplay;
          indicatorClass = "bad blink";
        } else if (state.status === "DISCONNECTING") {
          const elapsed = now - state.disconnectStartedAt;
          const baseLatency = getGateLatency(myGateId, gateId, myRelayScore, playerRelayScore);
          const increase = Math.min(elapsed / 10000, 1) * 3000; // Increase up to +3000ms
          latencyDisplay = `${Math.round(baseLatency + increase)}ms`;
          statusDisplay = elapsed >= 10000 ? "DISCONNECTED" : latencyDisplay;
          indicatorClass = "warn blink";
        } else {
          // Normal operation - show latency with simulated variance
          const baseLatency = getGateLatency(myGateId, gateId, myRelayScore, playerRelayScore);
          const jitter = Math.floor(Math.random() * 200 - 100); // -100 to +100ms variance
          const displayLatency = Math.max(baseLatency + jitter, 100); // Keep minimum at 100ms
          latencyDisplay = `${displayLatency}ms`;
          statusDisplay = latencyDisplay;
          indicatorClass = hasPendingPing ? "warn blink" : "ok";
        }

        return `
          <div class="status-row gate-network-row${hasPendingPing ? " gate-ping" : ""}">
            <div class="status-name">${escapeText(gateId)}
              <span class="relay-hb">
                <span class="hb-indicator ${indicatorClass}" aria-hidden="true"></span>
                <span>${escapeText(statusDisplay)}</span>
              </span>
            </div>
            <div class="status-right">
              <button class="btn-mini approve" data-action="ping-gate" data-gate="${escapeText(gateId)}">PING</button>
              <button class="btn-mini hold${hasPendingPing ? " attn" : ""}" data-action="ack-gate" data-gate="${escapeText(gateId)}">ACK</button>
              <button class="btn-mini ${isDetailOpen ? "detail-open" : ""}" data-action="detail-gate" data-gate="${escapeText(gateId)}">DTL</button>
            </div>
          </div>
          ${isDetailOpen && player ? gateDetailRow(player, isCoopGate) : ""}
        `;
      });

      html += rows.join("");

      // Add pagination controls if needed
      if (needsPagination) {
        const pageNum = currentPage + 1;
        html += `
          <div class="gate-pagination">
            <div class="gate-page-info">PAGE ${pageNum} / ${totalPages}</div>
            <div class="gate-page-controls">
              <button class="btn-mini" data-action="gate-prev-page" ${currentPage === 0 ? 'disabled' : ''}>◄ PREV</button>
              <button class="btn-mini" data-action="gate-next-page" ${currentPage >= totalPages - 1 ? 'disabled' : ''}>NEXT ►</button>
            </div>
          </div>
        `;
      }

      ui.gateNetworkList.innerHTML = html;

      // Bind event handlers for filter
      const filterInput = document.getElementById("gate-filter-input");
      if (filterInput) {
        filterInput.addEventListener("input", (e) => {
          runtime.multiplayer.gateNetworkFilter = e.target.value;
          runtime.multiplayer.gateNetworkPage = 0; // Reset to first page on filter change
          renderAll();
        });
      }

      // Bind event handlers for pagination
      ui.gateNetworkList.querySelectorAll("[data-action='gate-prev-page']").forEach(btn => {
        btn.addEventListener("click", () => {
          if (runtime.multiplayer.gateNetworkPage > 0) {
            runtime.multiplayer.gateNetworkPage--;
            renderAll();
          }
        });
      });

      ui.gateNetworkList.querySelectorAll("[data-action='gate-next-page']").forEach(btn => {
        btn.addEventListener("click", () => {
          if (runtime.multiplayer.gateNetworkPage < totalPages - 1) {
            runtime.multiplayer.gateNetworkPage++;
            renderAll();
          }
        });
      });

      // Bind event handlers for gate actions
      ui.gateNetworkList.querySelectorAll("[data-action='ping-gate']").forEach(btn => {
        btn.addEventListener("click", () => {
          const targetGateId = btn.getAttribute("data-gate");
          cmdPingPlayer(targetGateId);
        });
      });

      ui.gateNetworkList.querySelectorAll("[data-action='ack-gate']").forEach(btn => {
        btn.addEventListener("click", () => {
          const sourceGateId = btn.getAttribute("data-gate");
          const g = activeGate();
          if (!g.pendingPlayerPings) return;
          const ping = g.pendingPlayerPings.find(p => p.sourceGateId === sourceGateId && !p.acked);
          if (ping) {
            cmdAckPlayer(sourceGateId);
          }
        });
      });

      ui.gateNetworkList.querySelectorAll("[data-action='detail-gate']").forEach(btn => {
        btn.addEventListener("click", () => {
          cmdDetailGate(btn.getAttribute("data-gate"), { log: false });
        });
      });
    }

    function updateConnectionIndicator(changeType) {
      const light = document.querySelector(".connection-light");
      const text = document.getElementById("connection-text");

      if (!light || !text) return;

      if (!runtime.multiplayer.enabled) {
        light.className = "connection-light offline";
        text.textContent = "GATE NETWORK DISCONNECTED // LOCAL MONITORING ONLY";
        return;
      }

      const count = runtime.multiplayer.playerCount;
      light.className = "connection-light online";
      text.textContent = `GATE NETWORK ONLINE // CONNECTED NODES: ${String(count).padStart(2, "0")}`;

      // Flash based on change type
      if (changeType === "join" && count > runtime.multiplayer.lastPlayerCount) {
        light.classList.add("flash-yellow");
        setTimeout(() => light.classList.remove("flash-yellow"), 600);
      } else if (changeType === "leave" && count < runtime.multiplayer.lastPlayerCount) {
        light.classList.add("flash-red");
        setTimeout(() => light.classList.remove("flash-red"), 600);
      }
    }

    function renderAll() {
      const g = activeGate();
      recomputeHealth(g);
      renderQueues();
      renderSystems();
      renderGateNetwork();
      ui.dataAge.textContent = formatClockHM(Date.now());

      // Apply collapsed states after rendering
      applyCollapsedStates();

      // Propagate alerts to collapsed panel headers
      propagateAlertsToHeaders();

      // Refresh navigation registries for keyboard/gamepad after DOM updates
      refreshNavigationRegistries();
    }

    function findShipById(g, id) {
      return g.inbound.find(s => s.id === id) || g.outbound.find(s => s.id === id) || null;
    }

    function resolveFacility(input) {
      const key = String(input || "").toUpperCase().replace(/[^A-Z]/g, "");
      if (!key) return null;
      for (const sys of FACILITY_SYSTEMS) {
        const match = sys.id === key || sys.name.replace(/[^A-Z]/g, "") === key;
        if (match) return sys.id;
        if (key.startsWith(sys.id)) return sys.id;
      }
      const alias = {
        DECONBAY: "DECON",
        FUELMANIFOLD: "FUEL",
        DOCKCLAMPARRAY: "DOCK",
        BEACONAMPLIFIER: "BEACON"
      };
      return alias[key] || null;
    }

    function resolveResource(input) {
      const key = String(input || "").toUpperCase().replace(/[^A-Z]/g, "");
      if (!key) return null;
      for (const r of RESOURCE_TYPES) {
        if (r.id === key || r.name.replace(/[^A-Z]/g, "") === key) return r.id;
        if (key.startsWith(r.id)) return r.id;
      }
      return null;
    }

		function resolveRelayId(input) {
			const raw = String(input || "").toUpperCase();
			// CHANGE: Allow digits 1-3
			const match = raw.match(/RELAY[\s-]*([1-3])/);
			if (match) return `RELAY-${match[1]}`;
			const trimmed = raw.replace(/[^A-Z0-9]/g, "");
			if (trimmed === "R1") return "RELAY-1";
			if (trimmed === "R2") return "RELAY-2";
			// CHANGE: Add R3 shortcut
			if (trimmed === "R3") return "RELAY-3";
			return null;
		}

		function resolveTargetId(input) {
			const raw = String(input || "").toUpperCase().trim();

			// Check if it's a gate ID pattern: GATE-1234, GATE-1234-A, etc.
			const gatePattern = /^GATE-\d{4}(?:-[A-Z]{1,8})?$/;
			if (gatePattern.test(raw)) {
				return { type: "gate", id: raw };
			}

			// Try to resolve as relay: RELAY-1, R1, R2, R3, etc.
			const relayId = resolveRelayId(raw);
			if (relayId) {
				return { type: "relay", id: relayId };
			}

			// Invalid/unknown ID
			return null;
		}

    function getFacility(g, id) {
      return (g.facility || []).find(f => f.id === id) || null;
    }

    function getResourceConfig(id) {
      return RESOURCE_TYPES.find(r => r.id === id) || null;
    }

    function normalizeOrderAmount(value) {
      const amount = Math.max(RESOURCE_ORDER_MIN, Math.round(Number(value) || RESOURCE_ORDER_MIN));
      return clamp(amount, RESOURCE_ORDER_MIN, RESOURCE_ORDER_MAX);
    }

    function sanitizeOrderAmountInput(value) {
      return String(value || "").replace(/\D/g, "").slice(0, 2);
    }

    function clampOrderAmountInput(value) {
      const digits = sanitizeOrderAmountInput(value);
      if (!digits) return String(RESOURCE_ORDER_MIN);
      return String(clamp(Number(digits), RESOURCE_ORDER_MIN, RESOURCE_ORDER_MAX));
    }

    function ensureResources(g) {
      g.resources ||= {};
      for (const r of RESOURCE_TYPES) {
        if (!g.resources[r.id]) {
          g.resources[r.id] = { level: randRange(r.startMin, r.startMax), order: null, orderAmount: RESOURCE_ORDER_MIN };
        }
        const levelValue = Number(g.resources[r.id].level);
        if (!Number.isFinite(levelValue)) {
          g.resources[r.id].level = randRange(r.startMin, r.startMax);
        } else {
          g.resources[r.id].level = levelValue;
        }
        if (typeof g.resources[r.id].orderAmount !== "number") {
          g.resources[r.id].orderAmount = RESOURCE_ORDER_MIN;
        }
        g.resources[r.id].orderAmount = normalizeOrderAmount(g.resources[r.id].orderAmount);
        if (g.resources[r.id].order) {
          g.resources[r.id].order.amount = normalizeOrderAmount(g.resources[r.id].order.amount ?? g.resources[r.id].orderAmount);
        }
      }
      return g.resources;
    }

    function ensureUpgrades(g) {
      g.upgrades ||= {
        reactorUpgraded: false,
        reactorUpgrading: false,
        reactorUpgradeCompletesAt: 0,
        maintenanceUpgraded: false,
        maintenanceUpgrading: false,
        maintenanceUpgradeCompletesAt: 0
      };
      return g.upgrades;
    }

    function resourceOrderAvailable(res) {
      return res.level <= RESOURCE_ORDER_THRESHOLD && !res.order;
    }

    function resourceOrderAllowed(res) {
      return !res.order;
    }

    function resourceOrderCost(resourceId, amount) {
      const config = getResourceConfig(resourceId);
      const price = typeof config?.pricePerUnit === "number" ? config.pricePerUnit : 1;
      return Math.max(0, Math.round(normalizeOrderAmount(amount) * price));
    }

    function availableWageCredits(g) {
      const stats = ensureGateStats(g);
      const shiftMs = Date.now() - runtime.shiftStart;
      return computeWage(stats, shiftMs);
    }

    function spendWage(g, cost, options = {}) {
      if (!cost) return;
      const stats = ensureGateStats(g);
      const kind = options.kind || "resource";
      if (kind === "purchase") {
        stats.purchaseSpend = (stats.purchaseSpend || 0) + cost;
      } else if (kind === "break") {
        stats.breakSpend = (stats.breakSpend || 0) + cost;
      } else {
        stats.resourceOrderSpend = (stats.resourceOrderSpend || 0) + cost;
      }
      if (g.id === runtime.activeGateId) {
        playSfx("spend");
      }
    }

    function hasActiveWorkOrder(g, id) {
      return (g.workOrders || []).some(w => w.systemId === id && w.state !== "COMPLETE");
    }

    function hasActiveRepair(g, systemId) {
      return (g.repairAttempts || []).some(r => r.systemId === systemId && r.state !== "COMPLETE");
    }

    function makeShipmentShip(resourceId, amount) {
      const config = getResourceConfig(resourceId);
      const rng = mulberry32(strHash(`${resourceId}::shipment::${Date.now()}`));
      const etaMax = getAdaptiveShipETAMax();

      // Generate crew for shipment ships
      const crewCount = getCrewCountForShipType("SHIPMENT");
      const crew = [];
      for (let i = 0; i < crewCount; i++) {
        const name = generateCrewName(rng);
        const role = assignCrewRole("SHIPMENT", i, crewCount, rng);
        crew.push({ name, deceased: false, role });
      }
      const shipmentCargoOptions = SHIPMENT_CARGO_BY_RESOURCE[resourceId] || CARGO_BY_TYPE.SHIPMENT || [CARGO_NONE];
      const shipmentCargo = pick(rng, shipmentCargoOptions);

      return {
        id: makeShipId(rng),
        dir: "IN",
        eta: randRange(Math.min(240, etaMax), etaMax),
        type: "SHIPMENT",
        request: config ? config.request : "RESUPPLY",
        state: "PENDING",
        transponder: "VALID",
        transponderMatch: 1,
        priority: true,
        reason: null,
        notes: "",
        doneAt: 0,
        slotId: null,
        dockState: null,
        deconEndsAt: 0,
        serviceEndsAt: 0,
        servicePausedAt: 0,
        clearingEndsAt: 0,
        wasCleared: false,
        queryPending: false,
        servicingBlocked: false,
        serviceFacilityStatus: "ONLINE",
        effects: [],
        hazardDeadline: 0,
        obscured: false,
        infoMasked: false,
        hiddenThreat: false,
        shipmentType: resourceId,
        shipmentAmount: normalizeOrderAmount(amount),
        shipmentDelivered: false,
        cargo: shipmentCargo,
        cargoUnknown: false,
        cargoIllegal: false,
        crew,
        crewUnknown: false,
        crewRevealed: true
      };
    }

    function startResourceOrder(g, resourceId, amount) {
      ensureResources(g);
      const res = g.resources[resourceId];
      if (!res || res.order) return false;
      const orderAmount = normalizeOrderAmount(amount ?? res.orderAmount);
      res.orderAmount = orderAmount;
      const phase = RESOURCE_ORDER_PHASES[0];
      res.order = {
        resourceId,
        amount: orderAmount,
        stage: phase.key,
        stageIndex: 0,
        stageEndsAt: Date.now() + randRange(phase.min, getAdaptiveResourceOrderMax(phase.min, phase.max)) * 1000,
        shipmentId: null,
        createdAt: Date.now(),
        completedAt: 0
      };
      if (g.id === runtime.activeGateId) eventLine(`ORDER STARTED: ${resourceId} x${orderAmount}`, "warn");

      // Broadcast ORDER STARTED to co-op clients
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("alert", {
          message: `ORDER STARTED: ${resourceId} x${orderAmount}`,
          messageClass: "warn"
        });
      }

      return true;
    }

    // Purchase system helper functions
    function calculatePurchaseCost(type, currentCount) {
      const config = PURCHASE_COSTS[type];
      if (!config) return null;
      const costScale = getShiftCostScale();
      const credits = Math.max(1, Math.round((config.baseCredits + (currentCount * config.creditIncrease)) * costScale));
      return {
        credits,
        supply: config.supply
      };
    }

    function canPurchase(g, type) {
      const currentCount = type === "RELAY" ? (g.relays || []).length : (g.dockSlots || []).length;
      const maxAllowed = type === "RELAY" ? MAX_RELAYS : MAX_DOCK_SLOTS;

      if (currentCount >= maxAllowed) return { allowed: false, reason: "MAX_CAPACITY" };

      const cost = calculatePurchaseCost(type, g[type === "RELAY" ? "relaysPurchased" : "docksPurchased"]);
      if (!cost) return { allowed: false, reason: "INVALID_TYPE" };

      const credits = availableWageCredits(g);
      if (credits < cost.credits) return { allowed: false, reason: "INSUFFICIENT_CREDITS", cost };

      const supplyLevel = (g.resources?.SUPPLY?.level || 0);
      if (supplyLevel < cost.supply) return { allowed: false, reason: "INSUFFICIENT_SUPPLY", cost };

      return { allowed: true, cost };
    }

    function purchaseRelay(g) {
      const check = canPurchase(g, "RELAY");
      if (!check.allowed) return check;

      const relayId = `RELAY-${(g.relays || []).length + 1}`;
      const now = Date.now();
      const assemblyDuration = scaleShiftSeconds(randRange(120, 180)); // 2-3 minutes

      const newRelay = {
        id: relayId,
        status: "ASSEMBLING",
        health: 0,
        lastChange: now,
        lastPacketAt: 0,
        lastRelayPingAt: 0,
        lastHeartbeatAt: 0,
        nextHeartbeatAt: 0,
        lastAckAt: 0,
        awaitingAck: false,
        ackDueAt: 0,
        offline: true,
        hiddenOffline: false,
        hiccupRecoverable: false,
        offlineReason: "ASSEMBLING",
        offlineSince: now,
        lastHealthPingAt: 0,
        nextHealthPingCooldown: now,
        shiftChance: RATES.relayShiftChance * (0.9 + Math.random() * 0.2), // Per-relay variance: 90-110% of base rate
        assembling: true,
        assemblyCompletesAt: now + (assemblyDuration * 1000)
      };

      g.relays.push(newRelay);
      g.relaysPurchased = (g.relaysPurchased || 0) + 1;

      // Real-time lifetime stat tracking
      const lifetimeStats = loadLifetimeStats();
      lifetimeStats.totalRelaysPurchased++;
      saveLifetimeStats(lifetimeStats);

      // Deduct costs
      spendWage(g, check.cost.credits, { kind: "purchase" });
      g.resources.SUPPLY.level = Math.max(0, g.resources.SUPPLY.level - check.cost.supply);

      if (g.id === runtime.activeGateId) {
        eventLine(`RELAY PURCHASED: ${relayId} (ASSEMBLING ${formatMMSS(assemblyDuration)})`, "good");
      }

      return { allowed: true, relayId, cost: check.cost };
    }

    function purchaseDock(g) {
      const check = canPurchase(g, "DOCK");
      if (!check.allowed) return check;

      const dockId = `SLOT-${(g.dockSlots || []).length + 1}`;
      const now = Date.now();
      const assemblyDuration = scaleShiftSeconds(randRange(120, 180)); // 2-3 minutes

      const newSlot = {
        id: dockId,
        state: "ASSEMBLING",
        shipId: null,
        phaseEndsAt: 0,
        assembling: true,
        assemblyCompletesAt: now + (assemblyDuration * 1000)
      };

      g.dockSlots.push(newSlot);
      g.docksPurchased = (g.docksPurchased || 0) + 1;

      // Real-time lifetime stat tracking
      const lifetimeStatsDock = loadLifetimeStats();
      lifetimeStatsDock.totalDocksPurchased++;
      saveLifetimeStats(lifetimeStatsDock);

      // Deduct costs
      spendWage(g, check.cost.credits, { kind: "purchase" });
      g.resources.SUPPLY.level = Math.max(0, g.resources.SUPPLY.level - check.cost.supply);

      if (g.id === runtime.activeGateId) {
        eventLine(`DOCK SLOT PURCHASED: ${dockId} (ASSEMBLING ${formatMMSS(assemblyDuration)})`, "good");
      }

      return { allowed: true, dockId, cost: check.cost };
    }

    function canUpgrade(g, type) {
      ensureUpgrades(g);

      if (type === "REACTOR") {
        if (g.upgrades.reactorUpgraded) return { allowed: false, reason: "ALREADY_UPGRADED" };
        if (g.upgrades.reactorUpgrading) return { allowed: false, reason: "UPGRADE_IN_PROGRESS" };
      } else if (type === "MAINTENANCE") {
        if (g.upgrades.maintenanceUpgraded) return { allowed: false, reason: "ALREADY_UPGRADED" };
        if (g.upgrades.maintenanceUpgrading) return { allowed: false, reason: "UPGRADE_IN_PROGRESS" };
      } else {
        return { allowed: false, reason: "INVALID_TYPE" };
      }

      const cost = getUpgradeCost(type);
      const credits = availableWageCredits(g);
      if (credits < cost) return { allowed: false, reason: "INSUFFICIENT_CREDITS", cost };

      return { allowed: true, cost };
    }

    function getUpgradeCost(type) {
      const base = type === "REACTOR" ? UPGRADE_REACTOR_COST : UPGRADE_MAINTENANCE_COST;
      return Math.max(1, Math.round(base * getShiftCostScale()));
    }

    function startUpgrade(g, type) {
      const check = canUpgrade(g, type);
      if (!check.allowed) return check;

      const now = Date.now();
      const cost = check.cost;
      const duration = type === "REACTOR" ? UPGRADE_REACTOR_DURATION : UPGRADE_MAINTENANCE_DURATION;

      // Deduct cost from wage (not affecting score)
      spendWage(g, cost, { kind: "purchase" });

      if (type === "REACTOR") {
        g.upgrades.reactorUpgrading = true;
        g.upgrades.reactorUpgradeCompletesAt = now + (duration * 1000);
        if (g.id === runtime.activeGateId) {
          eventLine(`REACTOR UPGRADE INITIATED (${formatMMSS(duration)}) - FUEL DRAIN INCREASED DURING UPGRADE`, "warn");
        }
      } else if (type === "MAINTENANCE") {
        g.upgrades.maintenanceUpgrading = true;
        g.upgrades.maintenanceUpgradeCompletesAt = now + (duration * 1000);
        if (g.id === runtime.activeGateId) {
          eventLine(`MAINTENANCE FACILITIES UPGRADE INITIATED (${formatMMSS(duration)}) - SUPPLY DRAIN INCREASED DURING UPGRADE`, "warn");
        }
      }

      return { allowed: true, cost };
    }

    function applyShipmentDelivery(g, ship) {
      if (!ship || ship.shipmentDelivered) return;
      const config = getResourceConfig(ship.shipmentType);
      if (!config) return;
      ensureResources(g);
      const res = g.resources[ship.shipmentType];
      const add = typeof ship.shipmentAmount === "number"
        ? normalizeOrderAmount(ship.shipmentAmount)
        : randRange(config.restockMin, config.restockMax);
      res.level = clamp(res.level + add, 0, 100);
      ship.shipmentDelivered = true;

      if (res.order && res.order.shipmentId === ship.id) {
        res.order.stage = "DELIVERED";
        res.order.completedAt = Date.now();
      }
      if (g.id === runtime.activeGateId) {
        eventLine(`SHIPMENT RECEIVED: ${ship.shipmentType}`, "good");

        // Broadcast shipment delivery to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("alert", {
            message: `SHIPMENT RECEIVED: ${ship.shipmentType}`,
            messageClass: "good"
          });
        }
      }
    }

    function tickResourceOrders(g) {
      ensureResources(g);
      const now = Date.now();
      for (const r of RESOURCE_TYPES) {
        const res = g.resources[r.id];
        if (!res || !res.order) continue;
        const order = res.order;
        if (order.stage === "DELIVERED") {
          if (order.completedAt && now - order.completedAt > 90_000) res.order = null;
          continue;
        }
        if (order.stage === "INBOUND") {
          const ship = findShipById(g, order.shipmentId || "");
          if (!ship || ship.state === "DENIED") {
            order.stage = "SHIPPING";
            order.stageIndex = RESOURCE_ORDER_PHASES.length - 1;
            order.stageEndsAt = now + randRange(60, 120) * 1000;
            order.shipmentId = null;
            if (g.id === runtime.activeGateId) eventLine(`ORDER REQUEUED: ${r.id}`, "warn");
          }
          continue;
        }
        if (now < order.stageEndsAt) continue;
        order.stageIndex++;
        if (order.stageIndex < RESOURCE_ORDER_PHASES.length) {
          const phase = RESOURCE_ORDER_PHASES[order.stageIndex];
          order.stage = phase.key;
          const phaseMax = getAdaptiveResourceOrderMax(phase.min, phase.max);
          order.stageEndsAt = now + randRange(phase.min, phaseMax) * 1000;
          if (g.id === runtime.activeGateId) eventLine(`ORDER ${order.stage}: ${r.id}`, "dim");
          continue;
        }
        const shipment = makeShipmentShip(r.id, order.amount ?? res.orderAmount);
        g.inbound.unshift(shipment);
        order.stage = "INBOUND";
        order.shipmentId = shipment.id;
        order.stageEndsAt = 0;
        if (g.id === runtime.activeGateId) playSfx("beep");
        if (g.id === runtime.activeGateId) {
          eventLine(`ORDER INBOUND: ${r.id} x${order.amount || 1} // ${shipment.id}`, "warn");
        }

        // Broadcast ORDER INBOUND to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("alert", {
            message: `ORDER INBOUND: ${r.id} x${order.amount || 1} // ${shipment.id}`,
            messageClass: "warn"
          });
          // Sound is now auto-synced by playSfx()
        }
      }
    }

    function tickResources(g) {
      ensureResources(g);
      ensureUpgrades(g);
      const paceScale = getShiftPaceScale();

      const fuel = g.resources.FUEL;
      if (fuel) {
        let fuelDrain = RATES.fuelDrain * paceScale;

        // Apply reactor upgrade benefit (reduced drain)
        if (g.upgrades.reactorUpgraded) {
          fuelDrain *= UPGRADE_FUEL_BENEFIT;
        }

        // Apply 3x drain multiplier during reactor upgrade
        if (g.upgrades.reactorUpgrading) {
          fuelDrain *= UPGRADE_DRAIN_MULTIPLIER;
        }

        fuel.level = clamp(fuel.level - fuelDrain, 0, 100);
      }

      const supply = g.resources.SUPPLY;
      if (supply) {
        let drain = 0;

        // During maintenance upgrade, apply base drain rate (same as fuel)
        if (g.upgrades.maintenanceUpgrading) {
          drain = RATES.fuelDrain * paceScale; // Use same base rate as fuel for consistency
        } else {
          // Normal drain only from work orders and decon
          if (hasActiveWorkOrders(g)) drain += RATES.supplyDrainWorkOrder * paceScale;
          const deconActive = (g.dockSlots || []).some(s => s.state === "DECON");
          if (deconActive) drain += RATES.supplyDrainDecon * paceScale;
        }

        // Apply maintenance upgrade benefit (reduced supply usage)
        if (g.upgrades.maintenanceUpgraded) {
          drain *= UPGRADE_SUPPLY_BENEFIT;
        }

        // Apply 3x drain multiplier during maintenance upgrade
        if (g.upgrades.maintenanceUpgrading) {
          drain *= UPGRADE_DRAIN_MULTIPLIER;
        }

        supply.level = clamp(supply.level - drain, 0, 100);
      }
      tickResourceOrders(g);
    }

    function tickUpgrades(g) {
      ensureUpgrades(g);
      const now = Date.now();

      // Check reactor upgrade completion
      if (g.upgrades.reactorUpgrading && now >= g.upgrades.reactorUpgradeCompletesAt) {
        g.upgrades.reactorUpgrading = false;
        g.upgrades.reactorUpgraded = true;
        if (g.id === runtime.activeGateId) {
          eventLine("REACTOR UPGRADE COMPLETE - FUEL EFFICIENCY IMPROVED", "good");
          playSfx("confirm");
        }
      }

      // Check maintenance upgrade completion
      if (g.upgrades.maintenanceUpgrading && now >= g.upgrades.maintenanceUpgradeCompletesAt) {
        g.upgrades.maintenanceUpgrading = false;
        g.upgrades.maintenanceUpgraded = true;
        if (g.id === runtime.activeGateId) {
          eventLine("MAINTENANCE FACILITIES UPGRADE COMPLETE - SUPPLY EFFICIENCY IMPROVED", "good");
          playSfx("confirm");
        }
      }
    }

    function tickAssembly(g) {
      const now = Date.now();

      // Check relays for assembly completion
      for (const relay of (g.relays || [])) {
        if (relay.assembling && relay.assemblyCompletesAt && now >= relay.assemblyCompletesAt) {
          // Assembly complete - activate relay
          relay.assembling = false;
          relay.offline = false;
          relay.hiddenOffline = false;
          relay.offlineReason = null;
          relay.offlineSince = 0;
          const prevHealth = setRelayHealth(relay, randRange(95, 100), now);
          relay.status = "ONLINE";
          relay.lastChange = now;
          relay.lastHeartbeatAt = now;
          relay.nextHeartbeatAt = now + randRange(RELAY_HEARTBEAT_ONLINE_MIN_MS, RELAY_HEARTBEAT_ONLINE_MAX_MS);
          delete relay.assemblyCompletesAt;

          // Update total relay count in relay health tracking
          g.relayHealth.totalRelayCount = (g.relays || []).filter(r => !r.assembling).length;

          if (g.id === runtime.activeGateId) {
            if (prevHealth !== relay.health) g.lastRefresh = now;
            eventLine(`${relay.id}: ASSEMBLY COMPLETE (ONLINE)`, "good");
            playSfx("restore");
          }
        }
      }

      // Check dock slots for assembly completion
      for (const slot of (g.dockSlots || [])) {
        if (slot.assembling && slot.assemblyCompletesAt && now >= slot.assemblyCompletesAt) {
          // Assembly complete - activate slot
          slot.assembling = false;
          slot.state = "EMPTY";
          delete slot.assemblyCompletesAt;

          if (g.id === runtime.activeGateId) {
            eventLine(`${slot.id}: ASSEMBLY COMPLETE (READY)`, "good");
            playSfx("restore");
          }
        }
      }
    }

    function bumpConcourse(g, amount) {
      g.concourseLevel = clamp((g.concourseLevel || 0) + amount, 0, 100);
    }

    function shipHasEffect(s, name) {
      return (s.effects || []).some(e => e.name === name);
    }

    function shipInfoMasked(s) {
      return !!s.infoMasked;
    }

    function shipCargoUnknown(s) {
      return !!s.cargoUnknown || shipInfoMasked(s);
    }

    function shipDisplayType(s) {
      // Check typeUnknown flag first, then fall back to infoMasked
      if (s.typeUnknown || shipInfoMasked(s)) return "UNKNOWN";
      return s.type;
    }

    function shipDisplayRequest(s) {
      return shipInfoMasked(s) ? "UNKNOWN" : s.request;
    }

    function shipDisplayTransponder(s) {
      return shipInfoMasked(s) ? "UNKNOWN" : s.transponder;
    }

    function shipDisplayPriority(s) {
      // Check priorityUnknown flag first, then fall back to infoMasked
      if (s.priorityUnknown || shipInfoMasked(s)) return null; // null = unknown state
      return s.priority;
    }

    function shipDisplayCargo(s) {
      if (shipCargoUnknown(s)) return "UNKNOWN";
      const cargo = s.cargo || CARGO_NONE;
      if (s.cargoIllegal) return `ILLEGAL - ${cargo}`;
      return cargo;
    }

    function shipCargoIsIllegalVisible(s) {
      return !!s.cargoIllegal && !shipCargoUnknown(s);
    }

    function shipHasIllegalCargo(s) {
      return !!s.cargoIllegal;
    }

    function shipIsHazardous(s) {
      return shipHasEffect(s, "VACUUM BLOOM") ||
             shipHasEffect(s, "RAIDER") ||
             shipHasEffect(s, "PIRATE") ||
             (s.dir === "OUT" && shipHasEffect(s, "CORRIDOR RADIATION"));
    }

    function shipHasDangerEffect(s) {
      return shipHasEffect(s, "CORRIDOR RADIATION") || shipHasEffect(s, "VACUUM BLOOM");
    }

    function shipIsRaider(s) {
      return shipHasEffect(s, "RAIDER") || shipHasEffect(s, "PIRATE");
    }

    function denyReasonForShip(s) {
      if (shipHasEffect(s, "VACUUM BLOOM")) return "QUARANTINE REQUIRED";
      if (shipIsRaider(s) || s.hiddenThreat) return "AUTHORITIES NOTIFIED";
      if (s.dir === "OUT" && shipHasEffect(s, "CORRIDOR RADIATION")) return "RADIATION HAZARD";
      if (shipHasIllegalCargo(s)) return "ILLEGAL CARGO";
      if (s.obscured && s.infoMasked) return "SIGNAL MASKED";
      if (s.infoMasked) return "UNVERIFIED REGISTRY";
      if (s.transponder !== "VALID") return "TRANSPONDER ANOMALY";
      if (s.type === "UNKNOWN") return "UNVERIFIED REGISTRY";
      return "DENIED - OPERATOR DISCRETION";
    }

    function isCorrectDeny(s) {
      if (shipHasEffect(s, "VACUUM BLOOM")) return true;
      if (shipIsRaider(s) || s.hiddenThreat) return true;
      if (s.transponder !== "VALID") return true;
      // OUTGOING ships with Corridor Radiation should be denied
      if (s.dir === "OUT" && shipHasEffect(s, "CORRIDOR RADIATION")) return true;
      if (shipHasIllegalCargo(s)) return true;
      return false;
    }

    function shipIsPriorityOrCritical(s) {
      return !!s.priority || s.deadlineType === "CRITICAL";
    }

    function shouldSeverForNoCauseExpiry(s) {
      return shipIsPriorityOrCritical(s) && !isCorrectDeny(s);
    }

    function outgoingShipHasHazard(s) {
      if (s.dir !== "OUT") return false;
      if (shipHasEffect(s, "VACUUM BLOOM")) return true;
      if (shipHasEffect(s, "CORRIDOR RADIATION")) return true;
      if (shipIsRaider(s) || s.hiddenThreat) return true;
      return false;
    }

    function hazardLossCause(s) {
      if (shipHasEffect(s, "VACUUM BLOOM")) return "Vacuum Bloom Outbreak";
      if (shipHasEffect(s, "CORRIDOR RADIATION")) return "Corridor Radiation Contamination";
      return "Corridor Radiation Contamination";
    }

    function startDecon(g, s) {
      const facility = getFacility(g, "DECON");
      if (!facility || facility.status !== "ONLINE") {
        consoleLine("DECON START REFUSED: DECON BAY OFFLINE", "warn");
        playSfx("error");
        return false;
      }
      if (shipHasEffect(s, "VACUUM BLOOM")) {
        consoleLine(`DECON REFUSED: ${s.id} VACUUM BLOOM`, "warn");
        playSfx("error");
        return false;
      }
      if (s.state !== "WAITING DECON") {
        consoleLine(`DECON START REFUSED: ${s.id} NOT READY`, "warn");
        playSfx("error");
        return false;
      }
      const slot = (g.dockSlots || []).find(x => x.id === s.slotId);
      if (!slot) {
        consoleLine(`DECON START FAILED: SLOT NOT FOUND`, "warn");
        playSfx("error");
        return false;
      }
      let duration = randRange(3 * 60, 6 * 60);
      // Ships with transponder mismatches take 50% longer to process
      if (s.transponder !== "VALID") {
        duration *= 1.5;
      }
      duration = scaleShiftSeconds(duration);
      s.deconEndsAt = Date.now() + duration * 1000;
      s.deconFacilityStatus = getFacility(g, "DECON")?.status || "ONLINE";
      s.deconPausedAt = 0;
      s.state = "DECON";
      s.dockState = "DECON";
      s.hazardDeadline = 0;
      slot.state = "DECON";
      slot.phaseEndsAt = s.deconEndsAt;
      consoleLine(`DECON STARTED: ${s.id} (${formatMMSS(duration)})`, "dim");
      if (g.id === runtime.activeGateId) {
        eventLine(`DECON START: ${s.id}`, "dim");
        updateKlaxon();
      }

      // Broadcast DECON START to co-op clients
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("alert", {
          message: `DECON START: ${s.id}`,
          messageClass: "dim"
        });
      }

      bumpStat(g, "deconStarts");
      return true;
    }

    function queueQuery(g, s) {
      if (s.queryPending) {
        consoleLine(`QUERY PENDING: ${s.id}`, "warn");
        return;
      }

      // Check cooldown (3-5 seconds between queries on same ship)
      const now = Date.now();
      const cooldownTime = 3000; // 3 second minimum cooldown
      if (s.lastQueryTime && (now - s.lastQueryTime) < cooldownTime) {
        const remaining = Math.ceil((cooldownTime - (now - s.lastQueryTime)) / 1000);
        consoleLine(`QUERY COOLDOWN: ${s.id} (${remaining}s)`, "warn");
        return;
      }

      // Check if there's anything to query
      const hasUnknownFields = s.typeUnknown || s.priorityUnknown || s.etaUnknown ||
                               s.infoMasked || s.transponder !== "VALID" || s.cargoUnknown ||
                               (s.crewUnknown && !s.crewRevealed);
      if (!hasUnknownFields) {
        consoleLine(`QUERY NOT REQUIRED: ${s.id}`, "dim");
        return;
      }

      s.queryPending = true;
      s.lastQueryTime = now;
      consoleLine(`QUERY SENT: ${s.id}`, "dim");
      playSfx("qrying"); // Sound is now auto-synced to co-op players

      const delay = randRange(3, 8) * 1000;
      setTimeout(() => {
        const target = findShipById(g, s.id);
        if (!target) {
          stopSfx("qrying");
          return;
        }
        target.queryPending = false;

        // Obscured ships always fail
        if (target.obscured) {
          stopSfx("qrying");
          if (g.id === runtime.activeGateId) eventLine(`QUERY FAILED: ${target.id} SIGNAL MASKED`, "warn");
          // Trigger signal masked animation
          target.signalMaskedPulse = true;
          setTimeout(() => {
            target.signalMaskedPulse = false;
          }, 1200);  // Match animation duration
          g.lastRefresh = Date.now();
          renderAll();
          return;
        }

        // Track what was revealed
        const revealed = [];

        const isMismatch = target.transponder === "MISMATCH";
        let revealChance = 0.70;
        let crewRevealChance = 0.80;
        if (isMismatch) {
          const currentMatch = typeof target.transponderMatch === "number" ? target.transponderMatch : 0;
          const bump = 0.18 + Math.random() * 0.22;
          target.transponderMatch = clamp(currentMatch + bump, 0, 1);
          revealChance = 0.30 + 0.55 * target.transponderMatch;
          crewRevealChance = 0.35 + 0.55 * target.transponderMatch;
        }

        // Roll for TYPE reveal (70% chance)
        if (target.typeUnknown) {
          if (Math.random() < revealChance) {
            // If ship has hazard, show SCAN REQUIRED instead of revealing type
            if (target.hazardType) {
              stopSfx("qrying");
              if (g.id === runtime.activeGateId) eventLine(`QUERY FAILED: ${target.id} SCAN REQUIRED`, "warn");
              target.scanRequiredPulse = true;
              setTimeout(() => {
                target.scanRequiredPulse = false;
              }, 800);
              g.lastRefresh = Date.now();
              renderAll();
              return;
            }
            // Non-hazard ship: reveal type
            target.typeUnknown = false;
            revealed.push(`TYPE ${target.type}`);
          }
        }

        // Roll for PRIORITY reveal (70% chance)
        if (target.priorityUnknown) {
          if (Math.random() < revealChance) {
            target.priorityUnknown = false;
            revealed.push(`PRIORITY ${target.priority ? "YES" : "NO"}`);
          }
        }

        // Roll for ETA reveal (70% chance)
        if (target.etaUnknown) {
          if (Math.random() < revealChance) {
            target.etaUnknown = false;
            revealed.push(`ETA ${formatMMSS(target.eta)}`);
          }
        }

        // Roll for CARGO reveal (70% chance)
        if (target.cargoUnknown) {
          if (Math.random() < revealChance) {
            target.cargoUnknown = false;
            const cargoLabel = target.cargoIllegal ? `ILLEGAL ${target.cargo}` : target.cargo;
            revealed.push(`CARGO ${cargoLabel}`);
          }
        }

        // Roll for CREW reveal (80% chance) - does not reveal for PIRATE/RAIDER ships
        const isPirateRaider = target.crew && target.crew.length > 0 && target.crew[0].name === "UNKNOWN";
        if (target.crewUnknown && !target.crewRevealed && !isPirateRaider) {
          if (Math.random() < crewRevealChance) {
            target.crewRevealed = true;
            revealed.push(`CREW IDENTIFIED`);
          }
        }

        // Handle infoMasked ships (legacy behavior for non-hazard masked ships)
        if (target.infoMasked && !target.hazardType) {
          const infoRevealChance = isMismatch ? revealChance : 1.0;
          if (Math.random() < infoRevealChance) {
            target.infoMasked = false;
            for (const ef of target.effects || []) {
              ef.revealed = true;
            }
            revealed.push(`EFFECTS REVEALED`);
          }
        }

        // Handle transponder resolution (legacy behavior)
        if (target.transponder === "MISMATCH") {
          if (target.transponderMatch >= 1) {
            target.transponder = "VALID";
            target.transponderMatch = 1;
            revealed.push(`TRANSPONDER VALID`);
            if (target.state === "HOLD" && target.reason === "TRANSPONDER VERIFY" && target.wasCleared) {
              target.state = "CLEARED";
              target.reason = null;
              target.holdStartTime = 0;
              target.holdDuration = 0;
              if (target.eta <= 0) target.eta = randRange(60, 180);
              if (g.id === runtime.activeGateId) {
                eventLine(`CLEARANCE RESTORED: ${target.id}`, "good");

                // Broadcast clearance restored to co-op clients
                if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                  sendCoopEvent("alert", {
                    message: `CLEARANCE RESTORED: ${target.id}`,
                    messageClass: "good"
                  });
                }
              }
            }
          }
        } else if (target.transponder !== "VALID") {
          const roll = Math.random();
          if (roll < 0.55) {
            target.transponder = "VALID";
            target.transponderMatch = 1;
            revealed.push(`TRANSPONDER VALID`);
            if (target.state === "HOLD" && target.reason === "TRANSPONDER VERIFY" && target.wasCleared) {
              target.state = "CLEARED";
              target.reason = null;
              target.holdStartTime = 0;
              target.holdDuration = 0;
              if (target.eta <= 0) target.eta = randRange(60, 180);
              if (g.id === runtime.activeGateId) {
                eventLine(`CLEARANCE RESTORED: ${target.id}`, "good");

                // Broadcast clearance restored to co-op clients
                if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                  sendCoopEvent("alert", {
                    message: `CLEARANCE RESTORED: ${target.id}`,
                    messageClass: "good"
                  });
                }
              }
            }
          }
        }

        // Display results (or nothing if nothing was revealed)
        if (revealed.length > 0) {
          const summary = revealed.slice(0, 2).join(" / ");
          if (g.id === runtime.activeGateId) {
            eventLine(`QUERY RESOLVED: ${target.id} ${summary}${revealed.length > 2 ? " / ..." : ""}`, "dim");

            // Broadcast query results to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: `QUERY RESOLVED: ${target.id} ${summary}${revealed.length > 2 ? " / ..." : ""}`,
                messageClass: "dim"
              });
            }
          }
          // Trigger success query animation
          target.qrySuccessPulse = true;
          setTimeout(() => {
            target.qrySuccessPulse = false;
          }, 1000);  // Match animation duration
        }
        // If nothing revealed, trigger failed query animation
        if (revealed.length === 0) {
          if (g.id === runtime.activeGateId) {
            consoleLine(`QUERY INCONCLUSIVE: ${target.id} — NO DATA REVEALED`, "dim");

            // Broadcast query failure to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: `QUERY INCONCLUSIVE: ${target.id} — NO DATA REVEALED`,
                messageClass: "dim"
              });
            }
          }
          target.qryFailedPulse = true;
          setTimeout(() => {
            target.qryFailedPulse = false;
          }, 1000);  // Match animation duration
        }

        stopSfx("qrying");
        g.lastRefresh = Date.now();
        renderAll();
      }, delay);
    }

    // Helper function to check if a ship decision has been finalized
    function isShipFinalized(ship) {
      return ship.state === "CLEARED" || ship.state === "DENIED";
    }

    function handleAction(action, id, context) {
      const g = activeGate();
      const s = findShipById(g, id);
      if (!s) {
        consoleLine(`NOT FOUND: ${id}`, "bad");
        return;
      }
      ensureGateStats(g);
      const prevState = s.state;

      if (action === "detail") {
        cmdDetail(id, { log: false, context: context || "queue" });
        return;
      }

      if (action === "query") {
        // If invited co-op player, send command to host instead of executing locally
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `QUERY ${id}` });
          consoleLine(`> QUERY ${id}`, "dim");
          playSfx("click");
          return;
        }
        queueQuery(g, s);
        return;
      }

      if (action === "decon") {
        // If invited co-op player, send command to host instead of executing locally
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `DECON START ${id}` });
          consoleLine(`> DECON START ${id}`, "dim");
          playSfx("click");
          return;
        }
        if (startDecon(g, s)) {
          g.lastRefresh = Date.now();
          renderAll();
        }
        return;
      }

      // If invited co-op player, send ship decision actions to host
      if (["approve", "deny", "hold"].includes(action)) {
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `${action.toUpperCase()} ${id}` });
          consoleLine(`> ${action.toUpperCase()} ${id}`, "dim");
          playSfx("click");
          return;
        }
      }

      // Prevent changing decisions that have been finalized
      if (["approve", "deny", "hold"].includes(action) && isShipFinalized(s)) {
        const finalState = s.state === "CLEARED" ? "APPROVED" : "DENIED";
        consoleLine(`DECISION LOCKED: ${s.id} (ALREADY ${finalState})`, "warn");
        playSfx("error");
        // Add error shake animation to the ship row
        const shipElement = document.querySelector(`tr:has([data-id="${s.id}"])`);
        if (shipElement) {
          shipElement.classList.add("decision-locked-error");
          setTimeout(() => shipElement.classList.remove("decision-locked-error"), 600);
        }
        return;
      }

      // Decisions no longer apply once the contact is departing / completed
			const st = String(s.state || "").toUpperCase();
			const decisionClosed = st.includes("DEPART") || st.includes("ARRIV") || st.includes("COMPLETE");

			if (["approve", "deny", "hold"].includes(action) && decisionClosed) {
				const stateLabel = st.includes("COMPLETE") ? "DEPARTING GATE" : s.state;
				consoleLine(`ACTION REFUSED: ${s.id} ${stateLabel}`, "warn");
				playSfx("error");
				return;
			}

      if (["WAITING TO DOCK","WAITING DECON","DECON","SERVICING","CLEARING"].includes(s.state)) {
        consoleLine(`ACTION REFUSED: ${s.id} DOCKED`, "warn");
        playSfx("error");
        return;
      }

      if (action === "approve") {
        if (g.alignment === "OUT OF TOLERANCE") {
          consoleLine("APPROVAL REFUSED: ALIGNMENT OUT OF TOLERANCE", "warn");
          if (g.id === runtime.activeGateId) {
            eventLine("CANNOT APPROVE - ALIGNMENT OUT OF TOLERANCE", "warn");
          }
          playSfx("error");
          const approveBtn = document.querySelector(`button[data-action="approve"][data-id="${s.id}"]`);
          if (approveBtn) flashErrorButton(approveBtn);
          const shipElement = document.querySelector(`tr:has([data-id="${s.id}"])`);
          if (shipElement) {
            shipElement.classList.add("decision-locked-error");
            setTimeout(() => shipElement.classList.remove("decision-locked-error"), 600);
          }
          return;
        }
        // Check if DOCKING CLAMP ARRAY is online for inbound ships
        if (s.dir === "IN") {
          const dockClamp = getFacility(g, "DOCK");
          if (!dockClamp || dockClamp.status !== "ONLINE") {
            consoleLine(`APPROVAL REFUSED: DOCKING CLAMP ARRAY OFFLINE`, "warn");
            if (g.id === runtime.activeGateId) {
              eventLine(`CANNOT APPROVE FOR DOCK - DOCKING CLAMP ARRAY OFFLINE`, "warn");
            }
            playSfx("error");
            // Add error shake animation to the ship row
            const shipElement = document.querySelector(`tr:has([data-id="${s.id}"])`);
            if (shipElement) {
              shipElement.classList.add("decision-locked-error");
              setTimeout(() => shipElement.classList.remove("decision-locked-error"), 600);
            }
            return;
          }
        }

        // Resume deadline timer if ship was on HOLD
        if (prevState === "HOLD" && s.holdDeadlinePausedAt && s.holdDeadlinePausedAt > 0) {
          const holdTime = Date.now() - s.holdDeadlinePausedAt;
          if (s.departureDeadline && s.departureDeadline > 0) {
            s.departureDeadline += holdTime;
          }
          if (s.deadlineWarningAt && s.deadlineWarningAt > 0) {
            s.deadlineWarningAt += holdTime;
          }
          s.holdDeadlinePausedAt = 0;
        }

        if (s.transponder !== "VALID") {
          s.state = "CLEARED";
          s.reason = "TRANSPONDER OVERRIDE";
          s.wasCleared = true;
          consoleLine(`CLEARED: ${id} (TRANSPONDER OVERRIDE)`, "warn");
          if (g.id === runtime.activeGateId) eventLine(`CLEARANCE OVERRIDE: ${id} (TRANSPONDER)`, "warn");
          if (["DOCK","DECON","REFUEL","CREW TRANSFER"].includes(s.request)) bumpConcourse(g, 2 + Math.random() * 4);
        } else {
          s.state = "CLEARED";
          s.reason = null;
          s.wasCleared = true;
          consoleLine(`CLEARED: ${id} (${shipDisplayRequest(s)})`, "good");
          if (["DOCK","DECON","REFUEL","CREW TRANSFER"].includes(s.request)) bumpConcourse(g, 3 + Math.random() * 5);
        }

        if (shipHasIllegalCargo(s)) {
          bumpStat(g, "illegalApprovals");
          consoleLine(`ILLEGAL CARGO APPROVED: ${id} (-20 CR)`, "warn");
          if (g.id === runtime.activeGateId) {
            eventLine(`ILLEGAL CARGO APPROVED: ${id} (-20 CR)`, "warn");
          }
        }

        // Broadcast APPROVE action to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("action", {
            message: `CLEARED: ${id}`,
            messageClass: "good",
            sound: "click"
          });
        }

        // Check if OUTGOING ship with hazards was incorrectly approved
        if (outgoingShipHasHazard(s)) {
          bumpStat(g, "operatorErrors");
          const errorReason = denyReasonForShip(s);
          if (g.id === runtime.activeGateId) {
            eventLine(`OPERATOR ERROR: ${id} (${errorReason})`, "warn");
          }
        }
      } else if (action === "hold") {
        if (s.holdUsed) {
          consoleLine(`HOLD UNAVAILABLE: ${id} (ALREADY USED)`, "warn");
          return;
        }
        s.state = "HOLD";
        s.holdUsed = true;
        s.holdStartTime = Date.now();
        s.holdDuration = 30000 + Math.random() * 30000; // 30-60 seconds

        // Pause deadline timer if ship has a decision deadline
        if (s.departureDeadline && s.departureDeadline > 0) {
          s.holdDeadlinePausedAt = Date.now();
        }

        if (s.transponder !== "VALID") {
          s.reason = s.reason || "TRANSPONDER VERIFY";
        }
        const durationSec = Math.round(s.holdDuration / 1000);
        const holdReason = s.reason ? ` (${s.reason})` : "";
        consoleLine(`HOLD SET: ${id}${holdReason} - ${durationSec}s`, "warn");

        // Broadcast HOLD action to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("action", {
            message: `HOLD SET: ${id} - ${durationSec}s`,
            messageClass: "warn",
            sound: "click"
          });
        }
      } else if (action === "deny") {
        // Resume deadline timer if ship was on HOLD
        if (prevState === "HOLD" && s.holdDeadlinePausedAt && s.holdDeadlinePausedAt > 0) {
          const holdTime = Date.now() - s.holdDeadlinePausedAt;
          if (s.departureDeadline && s.departureDeadline > 0) {
            s.departureDeadline += holdTime;
          }
          if (s.deadlineWarningAt && s.deadlineWarningAt > 0) {
            s.deadlineWarningAt += holdTime;
          }
          s.holdDeadlinePausedAt = 0;
        }

        s.state = "DENIED";
        const correct = isCorrectDeny(s);
        s.reason = correct ? denyReasonForShip(s) : "DENIED - OPERATOR DISCRETION";
        if (prevState !== "DENIED") bumpStat(g, correct ? "deniedCorrect" : "deniedIncorrect");
        s.doneAt = Date.now();
        if (!correct && shipIsPriorityOrCritical(s)) {
          severGate(`PRIORITY DENIAL WITHOUT CAUSE: ${s.id}`);
        }
        if (correct && shipHasIllegalCargo(s)) {
          bumpStat(g, "contrabandDenied");
          consoleLine(`CONTRABAND SEIZED: ${id} (+8 CR)`, "good");
          if (g.id === runtime.activeGateId) {
            eventLine(`CONTRABAND SEIZED: ${id} (+8 CR)`, "good");
          }
        }

        // Show credit bonus for correctly denying hazardous OUTGOING ships
        if (correct && outgoingShipHasHazard(s)) {
          consoleLine(`DENIED: ${id} (${s.reason})`, "bad");
        } else {
          consoleLine(`DENIED: ${id} (${s.reason})`, "bad");
        }

        // Broadcast DENY action to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("action", {
            message: `DENIED: ${id}`,
            messageClass: "bad",
            sound: "click"
          });
        }

        if (!correct && g.id === runtime.activeGateId) eventLine(`DENY PENALTY: ${id} (NO CAUSE)`, "warn");
      }

      if (prevState !== "CLEARED" && s.state === "CLEARED") g.stats.approved++;
      if (prevState !== "DENIED" && s.state === "DENIED") g.stats.denied++;

      g.lastRefresh = Date.now();
      renderAll();
    }

    // ---------------------------
    // Panel Collapse Functionality
    // ---------------------------

    function triggerHazardPanelPulses(hazardShips) {
      if (!hazardShips || !hazardShips.length) return;

      const g = activeGate();
      if (!g) return;

      // Check which panels need to pulse
      let needInboundPulse = false;
      let needOutboundPulse = false;

      for (const ship of hazardShips) {
        if (ship.dir === "IN") {
          needInboundPulse = true;
        } else if (ship.dir === "OUT") {
          needOutboundPulse = true;
        }
      }

      // Get panel and subsection elements
      const trafficPanel = document.getElementById('traffic');
      const trafficHeader = trafficPanel?.querySelector('.panel-header');
      const inboundSection = document.querySelector('#traffic .queue-section:nth-child(1)');
      const inboundHeader = inboundSection?.querySelector('.subsection-header');
      const outboundSection = document.querySelector('#traffic .queue-section:nth-child(2)');
      const outboundHeader = outboundSection?.querySelector('.subsection-header');

      // Check collapse states
      const trafficCollapsed = trafficPanel?.classList.contains('collapsed') || false;
      const inboundCollapsed = inboundSection?.classList.contains('collapsed') || false;
      const outboundCollapsed = outboundSection?.classList.contains('collapsed') || false;

      // Apply pulse to appropriate headers
      if (trafficCollapsed && trafficHeader) {
        // Traffic panel is collapsed - pulse the main panel header
        trafficHeader.classList.add('hazard-pulse');
        setTimeout(() => {
          trafficHeader.classList.remove('hazard-pulse');
        }, 1600);
      } else {
        // Traffic panel is expanded - check subsections
        if (needInboundPulse && inboundCollapsed && inboundHeader) {
          inboundHeader.classList.add('hazard-pulse');
          setTimeout(() => {
            inboundHeader.classList.remove('hazard-pulse');
          }, 1600);
        }
        if (needOutboundPulse && outboundCollapsed && outboundHeader) {
          outboundHeader.classList.add('hazard-pulse');
          setTimeout(() => {
            outboundHeader.classList.remove('hazard-pulse');
          }, 1600);
        }
      }
    }

    function togglePanel(panelId) {
      if (!runtime.collapsedPanels) {
        runtime.collapsedPanels = {};
      }

      runtime.collapsedPanels[panelId] = !runtime.collapsedPanels[panelId];
      saveCollapsedPanels();
      applyCollapsedStates();
      propagateAlertsToHeaders();
      playSfx("showhide");
    }

    /**
     * Maximize a specific panel by expanding it and collapsing all others
     * @param {string} panelId - ID of the panel to maximize ('traffic', 'systems', or 'terminal')
     */
    function maximizePanel(panelId) {
      if (!runtime.collapsedPanels) {
        runtime.collapsedPanels = {};
      }

      // Define all parent panels
      const parentPanels = ['traffic', 'systems', 'terminal'];

      // Validate that panelId is a parent panel
      if (!parentPanels.includes(panelId)) {
        console.warn(`Invalid panel ID for maximize: ${panelId}`);
        return;
      }

      // Set the target panel to expanded (false = not collapsed)
      runtime.collapsedPanels[panelId] = false;

      // Collapse all other parent panels
      parentPanels.forEach(id => {
        if (id !== panelId) {
          runtime.collapsedPanels[id] = true;
        }
      });

      // Save and apply the new state
      saveCollapsedPanels();
      applyCollapsedStates();
      propagateAlertsToHeaders();

      // Play sound effect
      playSfx("showhide");
    }

    function applyCollapsedStates() {
      if (!runtime.collapsedPanels) return;

      let shouldScrollConsole = false;

      // Main panels
      ['traffic', 'systems', 'terminal'].forEach(id => {
        const panel = document.getElementById(id);
        if (!panel) return;

        const wasCollapsed = panel.classList.contains('collapsed');
        const isCollapsed = runtime.collapsedPanels[id] || false;
        panel.classList.toggle('collapsed', isCollapsed);

        const header = panel.querySelector('.panel-header');
        if (header) {
          header.setAttribute('aria-expanded', String(!isCollapsed));
          header.setAttribute('role', 'button');
          header.setAttribute('tabindex', '0');
        }

        if (id === 'terminal' && wasCollapsed && !isCollapsed) {
          shouldScrollConsole = true;
        }
      });

      // Update grid layout based on collapsed state
      updateInterfaceGridLayout();

      // Sub-sections
      const subSections = [
        { id: 'traffic-inbound', selector: '#traffic .queue-section:nth-child(1)' },
        { id: 'traffic-outbound', selector: '#traffic .queue-section:nth-child(2)' },
        { id: 'systems-gate', selector: '#systems .sys-block:nth-child(1)' },
        { id: 'systems-corridor', selector: '#systems .sys-block:nth-child(2)' },
        { id: 'systems-facility', selector: '#systems .sys-block:nth-child(3)' },
        { id: 'systems-resources', selector: '#systems .sys-block:nth-child(4)' },
        { id: 'systems-concourse', selector: '#systems .sys-block:nth-child(5)' },
        { id: 'systems-relays', selector: '#systems .sys-block:nth-child(6)' },
        { id: 'systems-gatenetwork', selector: '#gate-network-panel' },
        { id: 'systems-maintenance', selector: '#systems .sys-block:nth-child(8)' },
        { id: 'terminal-console', selector: '#console-log' }
      ];

      subSections.forEach(({ id, selector }) => {
        const element = document.querySelector(selector);
        if (!element) return;

        const wasCollapsed = element.classList.contains('collapsed');
        const isCollapsed = runtime.collapsedPanels[id] || false;
        element.classList.toggle('collapsed', isCollapsed);

        const header = element.querySelector('.subsection-header');
        if (header) {
          header.setAttribute('aria-expanded', String(!isCollapsed));
          header.setAttribute('role', 'button');
          header.setAttribute('tabindex', '0');
        }

        // Scroll console to bottom only when first expanded (transitioning from collapsed to expanded)
        if (id === 'terminal-console' && wasCollapsed && !isCollapsed) {
          shouldScrollConsole = true;
        }
      });

      if (shouldScrollConsole) {
        const consoleLog = document.getElementById('console-log');
        if (consoleLog) {
          requestAnimationFrame(() => {
            consoleLog.scrollTop = consoleLog.scrollHeight;
          });
        }
      }
    }

    function propagateAlertsToHeaders() {
      // Remove all existing propagated alert classes from headers
      document.querySelectorAll('.panel-header, .subsection-header').forEach(header => {
        header.classList.remove(
          'alert-propagated-ack',
          'alert-propagated-exposure',
          'alert-propagated-gate-critical',
          'alert-propagated-congested',
          'alert-propagated-relay-ping',
          'alert-propagated-awaiting-action'
        );
      });

      // Define alert types to watch for
      const alertTypes = [
        { selector: '.btn-mini.attn', className: 'alert-propagated-ack' },
        { selector: '.exposure-critical', className: 'alert-propagated-exposure' },
        { selector: '.gate-alert-pulse', className: 'alert-propagated-gate-critical' },
        { selector: '.congested-pulse', className: 'alert-propagated-congested' },
        { selector: '.relay-ping', className: 'alert-propagated-relay-ping' }
      ];

      // Apply all relevant alert classes (no priority system - all alerts can coexist)
      alertTypes.forEach(({ selector, className }) => {
        const alertElements = document.querySelectorAll(selector);

        alertElements.forEach(alertElement => {
          // Find the nearest parent subsection or panel
          const subsection = alertElement.closest('.queue-section, .sys-block, .logbox');

          if (subsection) {
            const subsectionHeader = subsection.querySelector('.subsection-header');

            // If the subsection is collapsed, propagate to its header
            if (subsection.classList.contains('collapsed') && subsectionHeader) {
              subsectionHeader.classList.add(className);
            }

            // Also check if parent panel is collapsed (independent of subsection state)
            const panel = subsection.closest('.panel');
            if (panel && panel.classList.contains('collapsed')) {
              const panelHeader = panel.querySelector('.panel-header');
              if (panelHeader) {
                panelHeader.classList.add(className);
              }
            }
          } else {
            // Check if we're directly in a panel without being in a subsection
            const panel = alertElement.closest('.panel');
            if (panel && panel.classList.contains('collapsed')) {
              const panelHeader = panel.querySelector('.panel-header');
              if (panelHeader) {
                panelHeader.classList.add(className);
              }
            }
          }
        });
      });

      // Check for ships awaiting action in collapsed INBOUND/OUTBOUND sections
      const g = activeGate();
      if (g) {
        // Helper function to check if a ship is awaiting action
        const isAwaitingAction = (ship) => {
          const st = String(ship.state || "").toUpperCase();
          const canDecide = !(st.includes("DEPART") || st.includes("ARRIV") || st.includes("COMPLETE") || st.includes("WAITING TO DOCK"));
          const isFinalized = ship.state === "CLEARED" || ship.state === "DENIED";
          return canDecide && !isFinalized;
        };

        // Check INBOUND queue
        const inboundSection = document.querySelector('#traffic .queue-section:nth-child(1)');
        if (inboundSection) {
          const inboundCollapsed = inboundSection.classList.contains('collapsed');
          const inboundHeader = inboundSection.querySelector('.subsection-header');
          const inboundVisible = g.inbound.filter(s => !s.slotId && !s.dockState);
          const hasAwaitingInbound = inboundVisible.some(isAwaitingAction);

          if (hasAwaitingInbound) {
            // Check parent panel first (hierarchical behavior)
            const trafficPanel = document.getElementById('traffic');
            const trafficHeader = trafficPanel?.querySelector('.panel-header');
            if (trafficPanel?.classList.contains('collapsed') && trafficHeader) {
              trafficHeader.classList.add('alert-propagated-awaiting-action');
            } else if (inboundCollapsed && inboundHeader) {
              // Only light up subsection if parent is expanded
              inboundHeader.classList.add('alert-propagated-awaiting-action');
            }
          }
        }

        // Check OUTBOUND queue
        const outboundSection = document.querySelector('#traffic .queue-section:nth-child(2)');
        if (outboundSection) {
          const outboundCollapsed = outboundSection.classList.contains('collapsed');
          const outboundHeader = outboundSection.querySelector('.subsection-header');
          const hasAwaitingOutbound = g.outbound.some(isAwaitingAction);

          if (hasAwaitingOutbound) {
            // Check parent panel first (hierarchical behavior)
            const trafficPanel = document.getElementById('traffic');
            const trafficHeader = trafficPanel?.querySelector('.panel-header');
            if (trafficPanel?.classList.contains('collapsed') && trafficHeader) {
              trafficHeader.classList.add('alert-propagated-awaiting-action');
            } else if (outboundCollapsed && outboundHeader) {
              // Only light up subsection if parent is expanded
              outboundHeader.classList.add('alert-propagated-awaiting-action');
            }
          }
        }
      }
    }

    function saveCollapsedPanels() {
      try {
        const json = JSON.stringify(runtime.collapsedPanels || {});
        localStorage.setItem(LS.collapsedPanels, json);
      } catch (e) {
        console.warn("Failed to save collapsed panels:", e);
      }
    }

    function loadCollapsedPanels() {
      try {
        const raw = localStorage.getItem(LS.collapsedPanels);
        if (!raw) return;

        const parsed = JSON.parse(raw);
        if (typeof parsed === 'object' && parsed !== null) {
          runtime.collapsedPanels = { ...runtime.collapsedPanels, ...parsed };
        }
      } catch (e) {
        console.warn("Failed to load collapsed panels:", e);
      }
    }

    function updateInterfaceGridLayout() {
      const interfaceEl = document.querySelector('.interface');
      if (!interfaceEl) return;

      // Get collapsed state for each main panel
      const trafficCollapsed = runtime.collapsedPanels['traffic'] || false;
      const systemsCollapsed = runtime.collapsedPanels['systems'] || false;
      const terminalCollapsed = runtime.collapsedPanels['terminal'] || false;

      // Check viewport width for responsive behavior
      const width = window.innerWidth;

      if (width <= 680) {
        // Tiny mobile - reset to CSS defaults
        interfaceEl.style.gridTemplateColumns = '';
        interfaceEl.style.gridTemplateRows = '';
        updateTerminalLogsLayout(width);
        updateTrafficQueueLayout(width);
        return;
      }

      if (width <= 780) {
        // Mobile layout - single column, adjust rows
        applyMobileLayout(trafficCollapsed, systemsCollapsed, terminalCollapsed, interfaceEl);
      } else {
        // Desktop layout - two columns
        applyDesktopLayout(trafficCollapsed, systemsCollapsed, terminalCollapsed, interfaceEl);
      }

      // Update terminal sub-panel layout
      updateTerminalLogsLayout(width);

      // Update traffic queue sub-panel layout
      updateTrafficQueueLayout(width);
    }

    function applyDesktopLayout(trafficCollapsed, systemsCollapsed, terminalCollapsed, interfaceEl) {
      let columns, rows;

      // Determine column sizing based on top panels
      if (trafficCollapsed && systemsCollapsed) {
        columns = '1fr 1fr'; // Both collapsed - terminal expands to fill space
      } else if (trafficCollapsed) {
        columns = 'auto 1fr'; // Traffic collapsed, Systems takes full width
      } else if (systemsCollapsed) {
        columns = '1fr auto'; // Systems collapsed, Traffic takes full width
      } else {
        columns = '1fr 1fr'; // Both expanded - equal width
      }

      // Determine row sizing based on collapsed states
      if (terminalCollapsed) {
        rows = 'minmax(0, 1fr) auto'; // Top row expands, terminal minimal
      } else if (trafficCollapsed && systemsCollapsed) {
        rows = 'auto 1fr'; // Both top panels collapsed - terminal expands to fill vertical space
      } else {
        rows = 'minmax(0, 1fr) var(--terminal-h)'; // Normal layout
      }

      interfaceEl.style.gridTemplateColumns = columns;
      interfaceEl.style.gridTemplateRows = rows;
    }

    function applyMobileLayout(trafficCollapsed, systemsCollapsed, terminalCollapsed, interfaceEl) {
      // Single column - only rows change
      const trafficRow = trafficCollapsed ? 'auto' : 'minmax(0, 1fr)';
      const systemsRow = systemsCollapsed ? 'auto' : 'minmax(0, 1fr)';
      const terminalRow = terminalCollapsed ? 'auto' : 'var(--terminal-h)';

      interfaceEl.style.gridTemplateColumns = '1fr';
      interfaceEl.style.gridTemplateRows = `${trafficRow} ${systemsRow} ${terminalRow}`;
    }

    function updateTerminalLogsLayout(width) {
      const logsEl = document.querySelector('.logs');
      if (!logsEl) return;

      // Single console log - no dynamic column adjustment needed
      // Mobile layout resets inline styles
      if (width <= 780) {
        logsEl.style.gridTemplateColumns = '';
        return;
      }

      // Desktop layout - single column (defined in CSS)
      logsEl.style.gridTemplateColumns = '1fr';
    }

    function updateTrafficQueueLayout(width) {
      const queueEl = document.querySelector('.queue');
      if (!queueEl) return;

      // Get collapsed state for traffic queue sub-panels
      const inboundCollapsed = runtime.collapsedPanels['traffic-inbound'] || false;
      const outboundCollapsed = runtime.collapsedPanels['traffic-outbound'] || false;

      // Determine row sizing based on collapsed state (applies to both mobile and desktop)
      let rows;
      if (inboundCollapsed && outboundCollapsed) {
        rows = 'max-content max-content'; // Both collapsed - minimal height
      } else if (inboundCollapsed) {
        rows = 'max-content 1fr'; // Inbound collapsed, Outbound expands
      } else if (outboundCollapsed) {
        rows = '1fr max-content'; // Outbound collapsed, Inbound expands
      } else {
        rows = 'minmax(0, 1fr) minmax(0, 1fr)'; // Both expanded - equal height
      }

      queueEl.style.gridTemplateRows = rows;
    }


    // ---------------------------
    // Gate tick + events (slow, lonely)
    // ---------------------------
    function maybeSpawnShip(g, dir) {
      if (g.beacon !== "ONLINE") return;
      const paceScale = getShiftPaceScale();
      const trafficMod = trafficMultiplier(g);
      if (trafficMod <= 0) return;
      const list = dir === "IN" ? g.inbound : g.outbound;
      const baseCap = dir === "IN" ? RATES.maxIn : RATES.maxOut;
      const cap = Math.max(0, Math.round(baseCap * trafficMod));
      if (list.length >= cap) return;

      const baseChance = dir === "IN" ? RATES.spawnInChance : RATES.spawnOutChance;
      const chance = baseChance * trafficMod * paceScale;
      if (Math.random() > chance) return;

      const rng = mulberry32(strHash(`${g.id}::${Date.now()}::${dir}`));
      const s = makeShip(rng, dir);
      if (dir === "OUT") {
        calculateDepartureDeadline(s, rng);
        enforceLegalCargoForCritical(s, rng);
      }
      list.unshift(s);
      if (g.id === runtime.activeGateId) playSfx("beep");

      const msg = dir === "IN"
        ? `INBOUND REQUEST: ${s.id} // ${shipDisplayRequest(s)} // ETA ${formatMMSS(s.eta)}`
        : `OUTBOUND REQUEST: ${s.id} // ${shipDisplayRequest(s)} // ETA ${formatMMSS(s.eta)}`;

      if (g.id === runtime.activeGateId) eventLine(msg, "dim");
    }

    function corridorTrafficMultiplier(g) {
      if (!g.corridors || !g.corridors.length) return 1;
      let sum = 0;
      for (const c of g.corridors) {
        sum += CORRIDOR_TRAFFIC_WEIGHTS[c.status] ?? 1;
      }
      return sum / g.corridors.length;
    }

    function syncTrafficMultiplier(g) {
      return SYNC_TRAFFIC_WEIGHTS[g.sync] ?? 1;
    }

    function trafficMultiplier(g) {
      return clamp(corridorTrafficMultiplier(g) * syncTrafficMultiplier(g), 0, 1);
    }

    function enforceBeaconDependency(g) {
      const amp = getFacility(g, "BEACON");
      if (!amp || amp.status !== "OFFLINE") return;
      if (g.beacon !== "OFFLINE") {
        g.beacon = "OFFLINE";
        if (g.id === runtime.activeGateId) {
          playSfx("offline");
          eventLine("BEACON ARRAY: OFFLINE (AMPLIFIER OFFLINE)", "bad");
        }
      }
    }

    const SYSCHECK_RESULT_VARIANTS = {
      nominal: [
        ["dim", "SYSCHECK RESULTS: ALL SYSTEMS NOMINAL"],
        ["dim", "SYSCHECK RESULTS: OPERATING NORMALLY"],
        ["dim", "SYSCHECK RESULTS: NO ACTIVE FAULTS"],
      ],
      acceptable: [
        ["dim", "SYSCHECK RESULTS: WITHIN PARAMETERS"],
        ["dim", "SYSCHECK RESULTS: MINOR DRIFT DETECTED"],
        ["dim", "SYSCHECK RESULTS: STABILITY ACCEPTABLE"],
      ],
      degraded: [
        ["warn", "SYSCHECK RESULTS: DEGRADED PERFORMANCE"],
        ["warn", "SYSCHECK RESULTS: MAINTENANCE ADVISED"],
        ["warn", "SYSCHECK RESULTS: SYSTEM STRAIN DETECTED"],
      ],
      critical: [
        ["bad", "SYSCHECK RESULTS: CRITICAL SYSTEMS COMPROMISED"],
        ["bad", "SYSCHECK RESULTS: IMMEDIATE ACTION REQUIRED"],
        ["bad", "SYSCHECK RESULTS: MULTIPLE FAULTS ACTIVE"],
      ],
      catastrophic: [
        ["bad", "SYSCHECK RESULTS: EMERGENCY PROTOCOLS ACTIVE"],
        ["bad", "SYSCHECK RESULTS: FAILURE CASCADE RISK"],
        ["bad", "SYSCHECK RESULTS: SYSTEMS UNSTABLE"],
      ],
      collapse: [
        ["bad", "SYSCHECK RESULTS: TERMINAL COLLAPSE IMMINENT"],
        ["bad", "SYSCHECK RESULTS: EVACUATION RECOMMENDED"],
        ["bad", "SYSCHECK RESULTS: CORE SYSTEMS FAILING"],
      ],
    };

    function syscheckResultLine(g) {
      const gateStatus = calculateGateStatus(g);
      let bucket = "nominal";
      if (gateStatus >= 90) bucket = "nominal";
      else if (gateStatus >= 75) bucket = "acceptable";
      else if (gateStatus >= 60) bucket = "degraded";
      else if (gateStatus >= 40) bucket = "critical";
      else if (gateStatus >= 20) bucket = "catastrophic";
      else bucket = "collapse";
      return pick(Math.random, SYSCHECK_RESULT_VARIANTS[bucket]);
    }

    function maybeGenerateReport(g) {
      if (Math.random() > RATES.reportChance) return;

      const templates = [
        ["dim", "REPORT: AUX POWER FLUCTUATION"],
        ["dim", "REPORT: CONCOURSE QUIET"],
        ["warn", "NOTICE: HANDSHAKE LATENCY"],
      ];
      templates.push(syscheckResultLine(g));

      const offline = g.corridors.find(c => c.status === "OFFLINE");
      if (offline && Math.random() < 0.55) {
        if (g.id === runtime.activeGateId) eventLine(`ALERT: LINK ${offline.link} OFFLINE`, "bad");
        return;
      }

      const resources = ensureResources(g);
      if (resourceOrderAvailable(resources.SUPPLY)) {
        templates.push(["dim", "REPORT: INVENTORY REQUEST (SUPPLIES)"]);
      }
      if (resourceOrderAvailable(resources.FUEL)) {
        templates.push(["dim", "REPORT: INVENTORY REQUEST (FUEL)"]);
      }

      const slots = g.dockSlots || [];
      const allSlotsFilled = slots.length > 0 && slots.every(slot => slot.state !== "EMPTY");
      const waitingToDockCount = (g.inbound || []).filter(s => s.state === "WAITING TO DOCK").length;
      // Only show congestion notice when exactly 3 ships are waiting (CONGESTED state)
      if (allSlotsFilled && waitingToDockCount === 3) {
        templates.push(["warn", "NOTICE: DOCK SLOT CONGESTION"]);
      }

      const deconOnline = getFacility(g, "DECON")?.status === "ONLINE";
      const deconReady = deconOnline && g.inbound.some(s =>
        s.state === "WAITING DECON" && !shipHasEffect(s, "VACUUM BLOOM")
      );
      if (deconReady) {
        templates.push(["dim", "REPORT: DECON BAY READY"]);
      }

      const [cls, msg] = pick(Math.random, templates);
      if (g.id === runtime.activeGateId) eventLine(msg, cls);
    }

    function maybeFlavorEvent(g) {
      if (Math.random() > RATES.flavorChance) return;
      const now = Date.now();
      const minGapMs = 150_000;
      if (g.lastFlavorAt && (now - g.lastFlavorAt) < minGapMs) return;

      const templates = [
        "LOG NOTE: AMBIENT TRAFFIC LIGHT",
        "STATUS: BACKGROUND RADIATION NORMAL",
        "OP NOTE: SENSOR ARRAY STEADY",
        "LOG NOTE: PERIMETER LIGHTS CYCLING",
        "STATUS: ROUTE HAZARDS CLEAR",
        "LOG NOTE: COMMS TRAFFIC QUIET"
      ];

      const msg = pick(Math.random, templates);
      g.lastFlavorAt = now;
      if (g.id === runtime.activeGateId) eventLine(msg, "dim");
    }

    function driftSystems(g) {
      const now = Date.now();
      const driftAllowed = now > (g.tech?.driftSuppressedUntil || 0);
      const wobbleAllowed = now > (g.tech?.wobbleSuppressedUntil || 0);

      if (driftAllowed && Math.random() < RATES.driftChance) {
        const drift = ["DRIFTING","OUT OF TOLERANCE"];
        const prevAlignment = g.alignment;
        g.alignment = pick(mulberry32(strHash(`${g.id}::align::${Date.now()}`)), drift);
        if (g.id === runtime.activeGateId) {
          if (didWorsen(prevAlignment, g.alignment, GATE_ALIGNMENT_RANK)) playSfx("restore");
          eventLine(`SYSTEM: ALIGNMENT ${g.alignment}`, g.alignment === "OUT OF TOLERANCE" ? "bad" : "warn");

          // Broadcast alignment change to co-op clients
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
            sendCoopEvent("alert", {
              message: `SYSTEM: ALIGNMENT ${g.alignment}`,
              messageClass: g.alignment === "OUT OF TOLERANCE" ? "bad" : "warn"
            });
            // Sound is now auto-synced by playSfx()
          }
        }
      }

      // SYNC drift: inversely proportional to relay health ratio
      // More down relays = higher chance to drift to ASYNC/FAULT
      const relayRatio = getRelayHealthRatio(g);
      const relayFailureMultiplier = 1 + (1 - relayRatio) * 3; // 1x to 4x based on relay health
      const effectiveDriftChance = RATES.syncDriftChance * relayFailureMultiplier;

      if (Math.random() < effectiveDriftChance) {
        const prevSync = g.sync;
        g.sync = (Math.random() < 0.88) ? "ASYNC" : "FAULT";
        if (g.id === runtime.activeGateId) {
          if (didWorsen(prevSync, g.sync, GATE_SYNC_RANK)) playSfx("restore");
          eventLine(`SYSTEM: SYNC ${g.sync}`, g.sync === "FAULT" ? "bad" : "warn");

          // Broadcast SYNC alert to co-op clients
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
            sendCoopEvent("alert", {
              message: `SYSTEM: SYNC ${g.sync}`,
              messageClass: g.sync === "FAULT" ? "bad" : "warn"
            });
            // Sound is now auto-synced by playSfx()
          }
        }
      }

      // ASYNC recovery: proportional to relay health ratio
      // More healthy relays = higher chance to recover to SYNC
      if (g.sync === "ASYNC") {
        const relayRatio = getRelayHealthRatio(g);
        const effectiveRecoverChance = RATES.syncRecoverChance * relayRatio;

        if (relayRatio > 0 && Math.random() < effectiveRecoverChance) {
          g.sync = "SYNC";
          if (g.id === runtime.activeGateId) {
            eventLine("SYSTEM: SYNC RESTORED", "good");

            // Broadcast SYNC restore to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: "SYSTEM: SYNC RESTORED",
                messageClass: "good"
              });
            }
          }
        }
      }

      if (wobbleAllowed && Math.random() < RATES.wobbleChance && g.corridors.length) {
        const idx = Math.floor(Math.random() * g.corridors.length);
        const current = g.corridors[idx].status;

        const next = (current === "STABLE") ? pick(Math.random, ["DEGRADED","INTERMITTENT"]) :
                     (current === "DEGRADED") ? pick(Math.random, ["STABLE","INTERMITTENT"]) :
                     (current === "INTERMITTENT") ? pick(Math.random, ["DEGRADED","OFFLINE","STABLE"]) :
                     (current === "OFFLINE") ? pick(Math.random, ["INTERMITTENT","DEGRADED"]) : "STABLE";

        g.corridors[idx].status = next;
        g.corridors[idx].cls = CORRIDOR_STATES.find(x => x.key === next)?.cls || "warn";
        g.corridors[idx].lastChange = Date.now();

        if (g.id === runtime.activeGateId) {
          const rank = { STABLE: 0, DEGRADED: 1, INTERMITTENT: 2, OFFLINE: 3 };
          if (rank[next] > rank[current] && next !== "OFFLINE") {
            playSfx("restore");
          }
          if (next === "OFFLINE") playSfx("warn");
          eventLine(`LINK ${g.corridors[idx].link}: ${next}`, next === "OFFLINE" ? "bad" : (next === "STABLE" ? "good" : "warn"));

          // Broadcast corridor status to co-op clients
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
            sendCoopEvent("alert", {
              message: `LINK ${g.corridors[idx].link}: ${next}`,
              messageClass: next === "OFFLINE" ? "bad" : (next === "STABLE" ? "good" : "warn")
            });
            // Sounds are now auto-synced by playSfx()
          }
        }
      }
    }

    function pauseDeconTimers(g) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      for (const ship of allShips) {
        if (ship.state === "DECON" && ship.deconEndsAt > 0 && !ship.deconPausedAt) {
          ship.deconPausedAt = now;
        }
      }
      if (g.id === runtime.activeGateId) {
        eventLine("DECON BAY OFFLINE: ACTIVE DECON PAUSED", "warn");
      }
    }

    function resumeDeconTimers(g, newStatus) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let resumedCount = 0;

      for (const ship of allShips) {
        if (ship.state === "DECON" && ship.deconPausedAt > 0) {
          const pauseDuration = now - ship.deconPausedAt;
          ship.deconEndsAt += pauseDuration;
          ship.deconPausedAt = 0;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot && slot.phaseEndsAt > 0) {
            slot.phaseEndsAt += pauseDuration;
          }
          resumedCount++;
        }
      }

      if (g.id === runtime.activeGateId && resumedCount > 0) {
        eventLine("DECON BAY ONLINE: ACTIVE DECON RESUMED", "good");
      }

      if (newStatus === "DEGRADED") {
        degradeDeconTimers(g);
      }
    }

    function degradeDeconTimers(g) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let degradedCount = 0;

      for (const ship of allShips) {
        if (ship.state === "DECON" && ship.deconFacilityStatus === "ONLINE") {
          const remaining = Math.max(0, ship.deconEndsAt - now);
          ship.deconEndsAt += remaining;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot) {
            slot.phaseEndsAt = ship.deconEndsAt;
          }
          degradedCount++;
        }
      }

      if (g.id === runtime.activeGateId && degradedCount > 0) {
        eventLine("DECON BAY DEGRADED: PROCESSING SLOWED", "warn");
      }
    }

    function restoreDeconTimers(g) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let restoredCount = 0;

      for (const ship of allShips) {
        if (ship.state === "DECON" && ship.deconFacilityStatus === "DEGRADED") {
          const remaining = Math.max(0, ship.deconEndsAt - now);
          ship.deconEndsAt -= remaining / 2;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot) {
            slot.phaseEndsAt = ship.deconEndsAt;
          }
          restoredCount++;
        }
      }

      if (g.id === runtime.activeGateId && restoredCount > 0) {
        eventLine("DECON BAY RESTORED: PROCESSING NORMALIZED", "good");
      }
    }

    function adjustDeconTimersForStatus(g, newStatus) {
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      const firstDeconShip = allShips.find(s => s.state === "DECON");
      const prevStatus = firstDeconShip?.deconFacilityStatus || "ONLINE";

      if (newStatus === "OFFLINE") {
        pauseDeconTimers(g);
      } else if (prevStatus === "OFFLINE") {
        resumeDeconTimers(g, newStatus);
      } else if (newStatus === "DEGRADED" && prevStatus === "ONLINE") {
        degradeDeconTimers(g);
      } else if (newStatus === "ONLINE" && prevStatus === "DEGRADED") {
        restoreDeconTimers(g);
      }

      for (const ship of allShips) {
        if (ship.state === "DECON") {
          ship.deconFacilityStatus = newStatus;
        }
      }
    }

    function pauseServiceTimers(g) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let pausedCount = 0;

      for (const ship of allShips) {
        if (ship.state === "SERVICING" && ship.serviceEndsAt > 0 && !ship.servicePausedAt) {
          ship.servicePausedAt = now;
          ship.servicingBlocked = true;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot && slot.phaseEndsAt > 0) {
            slot.phaseEndsAt = ship.serviceEndsAt;
          }
          pausedCount++;
        }
      }

      if (g.id === runtime.activeGateId && pausedCount > 0) {
        eventLine("FUEL MANIFOLD OFFLINE: SERVICING PAUSED", "warn");
      }
    }

    function resumeServiceTimers(g, newStatus) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let resumedCount = 0;

      for (const ship of allShips) {
        if (ship.state === "SERVICING" && ship.servicePausedAt > 0) {
          const pauseDuration = now - ship.servicePausedAt;
          ship.serviceEndsAt += pauseDuration;
          ship.servicePausedAt = 0;
          ship.servicingBlocked = false;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot && slot.phaseEndsAt > 0) {
            slot.phaseEndsAt = ship.serviceEndsAt;
          }
          resumedCount++;
        }
      }

      if (g.id === runtime.activeGateId && resumedCount > 0) {
        eventLine("FUEL MANIFOLD ONLINE: SERVICING RESUMED", "good");
      }

      if (newStatus === "DEGRADED") {
        degradeServiceTimers(g, true);
      }
    }

    function degradeServiceTimers(g, force = false) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let degradedCount = 0;

      for (const ship of allShips) {
        if (ship.state === "SERVICING" && (ship.serviceFacilityStatus === "ONLINE" || (force && ship.serviceFacilityStatus !== "DEGRADED"))) {
          const remaining = Math.max(0, ship.serviceEndsAt - now);
          ship.serviceEndsAt += remaining;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot) {
            slot.phaseEndsAt = ship.serviceEndsAt;
          }
          degradedCount++;
        }
      }

      if (g.id === runtime.activeGateId && degradedCount > 0) {
        eventLine("FUEL MANIFOLD DEGRADED: SERVICING SLOWED", "warn");
      }
    }

    function restoreServiceTimers(g) {
      const now = Date.now();
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      let restoredCount = 0;

      for (const ship of allShips) {
        if (ship.state === "SERVICING" && ship.serviceFacilityStatus === "DEGRADED") {
          const remaining = Math.max(0, ship.serviceEndsAt - now);
          ship.serviceEndsAt -= remaining / 2;

          const slot = (g.dockSlots || []).find(x => x.shipId === ship.id);
          if (slot) {
            slot.phaseEndsAt = ship.serviceEndsAt;
          }
          restoredCount++;
        }
      }

      if (g.id === runtime.activeGateId && restoredCount > 0) {
        eventLine("FUEL MANIFOLD RESTORED: SERVICING NORMALIZED", "good");
      }
    }

    function adjustServiceTimersForStatus(g, newStatus) {
      const allShips = [...(g.inbound || []), ...(g.outbound || [])];
      const firstServiceShip = allShips.find(s => s.state === "SERVICING");
      const prevStatus = firstServiceShip?.serviceFacilityStatus || "ONLINE";

      if (newStatus === "OFFLINE") {
        pauseServiceTimers(g);
      } else if (prevStatus === "OFFLINE") {
        resumeServiceTimers(g, newStatus);
      } else if (newStatus === "DEGRADED" && prevStatus === "ONLINE") {
        degradeServiceTimers(g);
      } else if (newStatus === "ONLINE" && prevStatus === "DEGRADED") {
        restoreServiceTimers(g);
      }

      for (const ship of allShips) {
        if (ship.state === "SERVICING") {
          ship.serviceFacilityStatus = newStatus;
          if (newStatus !== "OFFLINE") {
            ship.servicingBlocked = false;
          }
        }
      }
    }

    function driftFacility(g) {
      const now = Date.now();
      if (!g.facility) return;
      const concourseLevel = g.concourseLevel || 0;
      const concourseFactor = 1 + (concourseStress(concourseLevel) * 1.5);
      const degradeBias = 0.75 + (concourseStress(concourseLevel) * 0.2);
      for (const f of g.facility) {
        const hasWO = hasActiveWorkOrder(g, f.id);
        if (hasWO) continue;
        if (f.status === "ONLINE" && now > (f.stableUntil || 0) && Math.random() < (RATES.facilityFaultChance * concourseFactor)) {
          f.status = Math.random() < degradeBias ? "DEGRADED" : "OFFLINE";
          f.lastChange = now;
          if (f.status === "DEGRADED") {
            f.degradedSince = now;
            f.degradedTimeoutAt = now + randRange(DEGRADED_TIMEOUT_MIN_MS, DEGRADED_TIMEOUT_MAX_MS);
          }
          if (f.id === "DECON") {
            adjustDeconTimersForStatus(g, f.status);
          }
          if (f.id === "FUEL") {
            adjustServiceTimersForStatus(g, f.status);
          }
          if (g.id === runtime.activeGateId) {
            if (f.status === "DEGRADED") playSfx("restore");
            if (f.status === "OFFLINE") playSfx("offline");
            eventLine(`FACILITY: ${f.name} ${f.status}`, f.status === "OFFLINE" ? "bad" : "warn");

            // Broadcast facility degradation to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: `FACILITY: ${f.name} ${f.status}`,
                messageClass: f.status === "OFFLINE" ? "bad" : "warn"
              });
              // Sounds are now auto-synced by playSfx()
            }
          }
        } else if (f.status === "DEGRADED") {
          if (!f.degradedSince) {
            f.degradedSince = now;
            f.degradedTimeoutAt = now + randRange(DEGRADED_TIMEOUT_MIN_MS, DEGRADED_TIMEOUT_MAX_MS);
          }

          const hasRepair = hasActiveRepair(g, f.id);

          if (!hasRepair && now > f.degradedTimeoutAt) {
            f.status = "OFFLINE";
            f.lastChange = now;
            f.degradedSince = 0;
            f.degradedTimeoutAt = 0;
            if (f.id === "DECON") {
              adjustDeconTimersForStatus(g, f.status);
            }
            if (f.id === "FUEL") {
              adjustServiceTimersForStatus(g, f.status);
            }
            if (g.id === runtime.activeGateId) {
              playSfx("offline");
              eventLine(`FACILITY: ${f.name} OFFLINE (TIMEOUT)`, "bad");

              // Broadcast facility timeout to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: `FACILITY: ${f.name} OFFLINE (TIMEOUT)`,
                  messageClass: "bad"
                });
                // Sound is now auto-synced by playSfx()
              }
            }
          }
          else if (!hasRepair && Math.random() < RATES.facilityWorsenChance) {
            f.status = "OFFLINE";
            f.lastChange = now;
            f.degradedSince = 0;
            f.degradedTimeoutAt = 0;
            if (f.id === "DECON") {
              adjustDeconTimersForStatus(g, f.status);
            }
            if (f.id === "FUEL") {
              adjustServiceTimersForStatus(g, f.status);
            }
            if (g.id === runtime.activeGateId) {
              playSfx("offline");
              eventLine(`FACILITY: ${f.name} OFFLINE`, "bad");
            }
          }
        }
      }
    }

    function tickRepairAttempts(g) {
      if (!g.repairAttempts) return;
      const now = Date.now();

      for (const r of g.repairAttempts) {
        if (r.state === "COMPLETE") continue;
        if (now < r.completesAt) continue;

        const sys = getFacility(g, r.systemId);
        if (!sys) {
          r.state = "COMPLETE";
          continue;
        }

        if (sys.status !== "DEGRADED") {
          r.state = "COMPLETE";
          consoleLine(`REPAIR CANCELLED: ${sys.name} (STATE CHANGED)`, "dim");
          continue;
        }

        r.state = "COMPLETE";

        if (Math.random() < REPAIR_FAILURE_CHANCE) {
          bumpStat(g, "repairFailures");
          const goesOffline = Math.random() < REPAIR_FAILURE_OFFLINE_CHANCE;
          if (goesOffline) {
            sys.status = "OFFLINE";
            sys.lastChange = now;
            sys.degradedSince = 0;
            sys.degradedTimeoutAt = 0;
            if (sys.id === "FUEL") {
              adjustServiceTimersForStatus(g, "OFFLINE");
            }
            if (g.id === runtime.activeGateId) {
              playSfx("offline");
              eventLine(`REPAIR FAILED: ${sys.name} OFFLINE`, "bad");

              // Broadcast repair failure to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: `REPAIR FAILED: ${sys.name} OFFLINE`,
                  messageClass: "bad"
                });
                // Sound is now auto-synced by playSfx()
              }
            }
          } else {
            sys.status = "DEGRADED";
            sys.lastChange = now;
            sys.degradedSince = now;
            sys.degradedTimeoutAt = now + randRange(DEGRADED_TIMEOUT_MIN_MS, DEGRADED_TIMEOUT_MAX_MS);
            if (g.id === runtime.activeGateId) {
              playSfx("error");
              eventLine(`REPAIR FAILED: ${sys.name} DEGRADED`, "warn");

              // Broadcast repair failure to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: `REPAIR FAILED: ${sys.name} DEGRADED`,
                  messageClass: "warn"
                });
              }
            }
          }
        } else {
          sys.status = "ONLINE";
          sys.lastChange = now;
          sys.degradedSince = 0;
          sys.degradedTimeoutAt = 0;
          sys.stableUntil = now + randRange(45 * 60_000, 90 * 60_000);
          if (sys.id === "DECON") {
            adjustDeconTimersForStatus(g, "ONLINE");
          }
          if (sys.id === "FUEL") {
            adjustServiceTimersForStatus(g, "ONLINE");
          }
          bumpStat(g, "repairSuccesses");
          if (g.id === runtime.activeGateId) {
            playSfx("restore");
            eventLine(`REPAIR SUCCESS: ${sys.name} ONLINE`, "good");

            // Broadcast repair success to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: `REPAIR SUCCESS: ${sys.name} ONLINE`,
                messageClass: "good"
              });
              // Sound is now auto-synced by playSfx()
            }
          }
        }
      }

      g.repairAttempts = g.repairAttempts.filter(r =>
        !(r.state === "COMPLETE" && now > r.completesAt + 10000)
      );
    }

    function tickWorkOrders(g) {
      if (!g.workOrders) return;
      const now = Date.now();
      for (const w of g.workOrders) {
        if (now < w.phaseEndsAt) continue;
        w.phaseIndex++;
        if (w.phaseIndex >= WORKORDER_PHASES.length) {
          w.completedAt = now;
          continue;
        }
        const phase = WORKORDER_PHASES[w.phaseIndex];
        w.state = phase.key;
        const phaseMax = getAdaptiveWorkOrderMax(phase.min, phase.max);
        w.phaseEndsAt = now + randRange(phase.min, phaseMax) * 1000;
        if (g.id === runtime.activeGateId) {
          const cls = w.state === "COMPLETE" ? "good" : "dim";
          eventLine(`WORKORDER ${w.state}: ${w.systemName}`, cls);

          // Broadcast work order progress to co-op clients
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
            sendCoopEvent("alert", {
              message: `WORKORDER ${w.state}: ${w.systemName}`,
              messageClass: cls
            });
          }
        }
        if (w.state === "COMPLETE") {
          bumpStat(g, "workOrdersCompleted");
          const sys = getFacility(g, w.systemId);
          const relay = findRelay(g, w.systemId);
          if (relay) bumpStat(g, "relayRepairs");
          if (sys) {
            sys.status = "ONLINE";
            sys.lastChange = now;
            sys.degradedSince = 0;
            sys.degradedTimeoutAt = 0;
            sys.stableUntil = now + randRange(45 * 60_000, 90 * 60_000);
            if (sys.id === "DECON") {
              adjustDeconTimersForStatus(g, "ONLINE");
            }
            if (sys.id === "FUEL") {
              adjustServiceTimersForStatus(g, "ONLINE");
            }
          }
          if (relay) {
            relay.offline = false;
            relay.hiddenOffline = false;
            const prevHealth = setRelayHealth(relay, randRange(85, 100), now); // Work order restores relay to excellent health
            relay.lastChange = now;
            relay.hiccupRecoverable = false;
            scheduleRelayHeartbeat(relay, now);
            relay.awaitingAck = false;
            relay.ackDueAt = 0;
            relay.offlineReason = null;
            relay.offlineSince = 0;
          }
          if (g.id === runtime.activeGateId) {
            if (relay && prevHealth !== relay.health) g.lastRefresh = now;
            if (relay) eventLine(`RELAY ${relay.id}: ONLINE`, "good");
            if (sys) eventLine(`FACILITY: ${w.systemName} ONLINE`, "good");

            // Broadcast system restoration to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              if (relay) {
                sendCoopEvent("alert", {
                  message: `RELAY ${relay.id}: ONLINE`,
                  messageClass: "good"
                });
              }
              if (sys) {
                sendCoopEvent("alert", {
                  message: `FACILITY: ${w.systemName} ONLINE`,
                  messageClass: "good"
                });
              }
            }
          }
        }
      }
      g.workOrders = g.workOrders.filter(w => !(w.state === "COMPLETE" && now > w.phaseEndsAt));
    }

    function assignDockSlot(g, s) {
      const reserved = (g.dockSlots || []).find(x => x.state === "RESERVED" && x.shipId === s.id);
      const slot = reserved || (g.dockSlots || []).find(x => x.state === "EMPTY");
      if (!slot) return false;
      if (shipIsRaider(s)) {
        if (g.id === runtime.activeGateId) eventLine(`HOSTILE DOCKING: ${s.id}`, "bad");
        severGate("Pirater / Raider attack");
        return false;
      }
      slot.state = "DOCKED";
      slot.shipId = s.id;
      slot.phaseEndsAt = 0;
      s.slotId = slot.id;
      s.state = "WAITING DECON";
      s.dockState = "WAITING DECON";
      s.eta = 0;
			// NEW: Set universal exposure deadline (30s to 60s)
      s.exposureDeadline = Date.now() + randRange(30, 60) * 1000;

      if (shipHasEffect(s, "VACUUM BLOOM")) {
        if (g.id === runtime.activeGateId) eventLine(`DOCK BREACH: ${s.id}`, "bad");
        severGate("Vacuum Bloom Outbreak");
        return false;
      }
      if (s.shipmentType) applyShipmentDelivery(g, s);
      if (g.id === runtime.activeGateId) playSfx("beep");
      return true;
    }

    function manageDockReservations(g) {
      if (!g.dockSlots) return;
      for (const slot of g.dockSlots) {
        if (slot.state !== "RESERVED") continue;
        const ship = findShipById(g, slot.shipId || "");
        if (!ship || ship.state !== "CLEARED") {
          slot.state = "EMPTY";
          slot.shipId = null;
          slot.phaseEndsAt = 0;
        }
      }
      const available = (g.dockSlots || []).find(x => x.state === "EMPTY");
      if (!available) return;
      const candidate = g.inbound.find(s => s.state === "CLEARED" && s.eta <= 180 && !s.slotId && !(g.dockSlots || []).some(x => x.shipId === s.id));
      if (candidate) {
        available.state = "RESERVED";
        available.shipId = candidate.id;
        if (g.id === runtime.activeGateId) eventLine(`SLOT RESERVED: ${available.id} -> ${candidate.id}`, "dim");
      }
    }

    function tickDockSlots(g) {
      if (!g.dockSlots) return;
      const now = Date.now();
      for (const slot of g.dockSlots) {
        if (!slot.shipId) continue;
        const ship = findShipById(g, slot.shipId);
        if (!ship) {
          slot.state = "EMPTY";
          slot.shipId = null;
          slot.phaseEndsAt = 0;
          continue;
        }
        if (slot.state === "SERVICING" && ship.serviceEndsAt <= 0 && slot.phaseEndsAt > 0) {
          ship.serviceEndsAt = slot.phaseEndsAt;
          ship.serviceFacilityStatus = getFacility(g, "FUEL")?.status || "ONLINE";
        }
				if (ship.state === "WAITING DECON" && ship.exposureDeadline && now > ship.exposureDeadline) {
          if (g.id === runtime.activeGateId) eventLine(`RADIATION CRITICAL: ${ship.id}`, "bad");
          severGate("GATE EXPOSURE TO RADIATION");
          return;
        }
        const deconFacility = getFacility(g, "DECON");
        const deconNotOffline = !deconFacility || deconFacility.status !== "OFFLINE";

        if (slot.state === "DECON" && deconNotOffline && now >= slot.phaseEndsAt) {
          if (Math.random() < 0.12) {
            slot.state = "DOCKED";
            ship.state = "WAITING DECON";
            ship.dockState = "WAITING DECON";
            // Reset EXPOSURE timer to exactly 20 seconds on DECON failure
            ship.exposureDeadline = Date.now() + 20 * 1000;
            if (shipHasDangerEffect(ship)) {
              ship.hazardDeadline = Date.now() + randRange(60, 2 * 60) * 1000;
            }
            if (g.id === runtime.activeGateId) eventLine(`DECON FAIL: ${ship.id} (RETRY REQUIRED)`, "warn");
            continue;
          }
          slot.state = "SERVICING";
          ship.state = "SERVICING";
          ship.dockState = "SERVICING";
          let serviceDuration = randRange(3 * 60, 8 * 60);
          // Ships with transponder mismatches take 50% longer to service
          if (ship.transponder !== "VALID") {
            serviceDuration *= 1.5;
          }
          serviceDuration = scaleShiftSeconds(serviceDuration);
          slot.phaseEndsAt = now + serviceDuration * 1000;
          ship.serviceEndsAt = slot.phaseEndsAt;
          ship.servicePausedAt = 0;
          ship.servicingBlocked = false;
          ship.serviceFacilityStatus = getFacility(g, "FUEL")?.status || "ONLINE";
          if (ship.serviceFacilityStatus === "OFFLINE") {
            ship.servicePausedAt = now;
            ship.servicingBlocked = true;
          }
          if (g.id === runtime.activeGateId) eventLine(`DECON COMPLETE: ${ship.id} (SERVICING)`, "dim");
        } else if (slot.state === "SERVICING" && now >= slot.phaseEndsAt) {
          // Check if FUEL MANIFOLD is online before allowing servicing to complete
          const fuelManifold = getFacility(g, "FUEL");
          if (!fuelManifold || fuelManifold.status !== "ONLINE") {
            // Keep ship stuck in SERVICING until FUEL MANIFOLD comes online
            if (!ship.servicingBlocked) {
              // First time blocked - show event
              ship.servicingBlocked = true;
              if (g.id === runtime.activeGateId) {
                eventLine(`SERVICING BLOCKED: ${ship.id} (FUEL MANIFOLD OFFLINE)`, "warn");
              }
            }
            continue;
          }
          // FUEL MANIFOLD is online - check if ship was previously blocked
          if (ship.servicingBlocked && g.id === runtime.activeGateId) {
            eventLine(`SERVICING RESUMED: ${ship.id} (FUEL MANIFOLD ONLINE)`, "dim");
          }
          ship.servicingBlocked = false;
          slot.state = "CLEARING";
          ship.state = "CLEARING";
          ship.dockState = "CLEARING";
          let clearDuration = randRange(1 * 60, 2 * 60);
          // Ships with transponder mismatches take 50% longer to clear
          if (ship.transponder !== "VALID") {
            clearDuration *= 1.5;
          }
          clearDuration = scaleShiftSeconds(clearDuration);
          slot.phaseEndsAt = now + clearDuration * 1000;
          if (g.id === runtime.activeGateId) eventLine(`SERVICING COMPLETE: ${ship.id} (CLEARING)`, "dim");
        } else if (slot.state === "CLEARING" && now >= slot.phaseEndsAt) {
          slot.state = "EMPTY";
          slot.shipId = null;
          slot.phaseEndsAt = 0;
          ship.state = "COMPLETE";
          ship.doneAt = now;
          ship.slotId = null;
          ship.dockState = null;
          if (g.id === runtime.activeGateId) eventLine(`SLOT CLEAR: ${ship.id}`, "dim");
        }
      }
    }

    function dockWaitingShips(g) {
      const slot = (g.dockSlots || []).find(x => x.state === "EMPTY");
      if (!slot) return null;
      const waiting = g.inbound.find(s => s.state === "WAITING TO DOCK");
      if (!waiting) return null;
      const ok = assignDockSlot(g, waiting);
      return ok ? waiting : null;
    }

    function driftConcourse(g) {
      if (typeof g.concourseLevel !== "number") g.concourseLevel = randRange(6, 26);
      const activeSlots = (g.dockSlots || []).some(s => s.state !== "EMPTY");
      const activeMoves = [...g.inbound, ...g.outbound].some(s => ["CLEARED","WAITING DECON","DECON","SERVICING","CLEARING"].includes(s.state));
      const fade = (activeSlots || activeMoves) ? RATES.concourseFade * 0.25 : RATES.concourseFade;
      g.concourseLevel = clamp(g.concourseLevel - fade, 0, 100);
    }

    function driftRelays(g) {
      if (!g.relays) return;
      const now = Date.now();
      for (const r of g.relays) {
        if (r.awaitingAck && now > r.ackDueAt) {
          r.awaitingAck = false;

          // Gradual penalty instead of instant death
          // Lose 25-40% health, can still recover if acted upon quickly
          const penalty = randRange(25, 40);
          const prevHealth = setRelayHealth(r, Math.max(0, r.health - penalty), now);
          r.lastChange = now;
          if (g.id === runtime.activeGateId && prevHealth !== r.health) g.lastRefresh = now;

          // Only go offline if health reaches 0
          if (r.health === 0) {
            r.offline = true;
            r.hiddenOffline = false;
            r.hiccupRecoverable = false;
            r.offlineReason = "ACK_TIMEOUT";
            r.offlineSince = now;
            if (g.id === runtime.activeGateId) {
              playSfx("offline");
              eventLine(`RELAY ${r.id}: OFFLINE (ACK TIMEOUT)`, "bad");

              // Broadcast relay offline to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: `RELAY ${r.id}: OFFLINE (ACK TIMEOUT)`,
                  messageClass: "bad"
                });
                // Sound is now auto-synced by playSfx()
              }
            }
          } else {
            // Still online but degraded
            if (g.id === runtime.activeGateId) {
              playSfx("restore");
            }
            scheduleRelayHeartbeat(r, now);
          }
          continue;
        }

        if (r.offline) continue;

        if (!r.nextHeartbeatAt || r.nextHeartbeatAt <= now) {
          scheduleRelayHeartbeat(r, now);
        }

        if (!r.awaitingAck && Math.random() < RATES.relayPingChance) {
          r.awaitingAck = true;
          r.ackDueAt = now + RELAY_ACK_WINDOW_MS;
          r.lastRelayPingAt = now;
          g.relayHealth.unackedPings = (g.relays || []).filter(r => r.awaitingAck && !r.offline).length;
          pushPacket(g, `PING ${r.id}`);
          if (g.id === runtime.activeGateId) eventLine(`RELAY ${r.id}: PING`, "warn");
        }

        if (Math.random() < RATES.relayDropChance) {
          r.offline = true;
          r.hiddenOffline = true;
          r.hiccupRecoverable = Math.random() < RELAY_HICCUP_RECOVERABLE_CHANCE;
          r.offlineReason = "SILENT_DROP";
          r.offlineSince = now;
          r.awaitingAck = false;
          r.ackDueAt = 0;
          continue;
        }

        // Each relay has its own independent shift chance for realistic individual system behavior
        const relayShiftChance = r.shiftChance || RATES.relayShiftChance;
        if (Math.random() < relayShiftChance) {
          const prevStatus = relayHealthToStatus(r.health);
          const currentHealth = r.health;
          let healthChanged = false;
          let healthImproved = false;

          // Health-based degradation with random variance (reduced for better player control)
          if (currentHealth >= 75 && Math.random() < 0.45) {
            // ONLINE -> degrade by 10-20% (slightly increased chance from 40% to 45%)
            r.health = Math.max(1, currentHealth - randRange(10, 20));
            healthChanged = true;
            healthImproved = false;
          } else if (currentHealth >= 50 && currentHealth < 75 && Math.random() < 0.35) {
            // WEAK -> degrade by 8-15% (slightly increased chance from 30% to 35%)
            r.health = Math.max(1, currentHealth - randRange(8, 15));
            healthChanged = true;
            healthImproved = false;
          } else if (currentHealth < 75 && Math.random() < 0.5) {
            // Any degraded state -> chance to improve by 10-25%
            r.health = Math.min(100, currentHealth + randRange(10, 25));
            healthChanged = true;
            healthImproved = true;
          }

          const newStatus = relayHealthToStatus(r.health);
          if (prevStatus !== newStatus) {
            r.lastChange = now;
            scheduleRelayHeartbeat(r, now);
            if (g.id === runtime.activeGateId) {
              if (["WEAK", "FAULT", "CRITICAL"].includes(newStatus) && newStatus !== prevStatus) {
                playSfx("restore");
              }
              eventLine(`RELAY ${r.id}: ${newStatus}`, ["FAULT", "CRITICAL"].includes(newStatus) ? "bad" : "warn");
            }
          }

          // Trigger blink for any health change during drift
          if (healthChanged && g.id === runtime.activeGateId) {
            triggerHealthBlink(r, healthImproved ? "positive" : "warn", now);
            g.lastRefresh = now;
          }
        }
        if (Math.random() < RATES.relayPacketChance) {
          const packetTypes = [
            "HANDSHAKE",
            "TELEMETRY BURST",
            "STATUS UPDATE",
            "SYNC REQUEST",
            "HEALTH CHECK",
            "ROUTE TRACE",
            "DATA STREAM",
            "SIGNAL BOOST",
            "CHANNEL SWEEP",
            "FREQ ALIGN",
            "BUFFER FLUSH",
            "LATENCY TEST",
            "BANDWIDTH PROBE",
            "CACHE REFRESH",
            "TIMESTAMP SYNC",
            "CONFIG POLL",
            "INTEGRITY CHECK",
            "NODE DISCOVERY",
            "KEEPALIVE"
          ];
          const msg = pick(packetTypes);
          pushPacket(g, `${r.id} ${msg}`);
          if (g.id === runtime.activeGateId) eventLine(`RELAY ${r.id}: ${msg}`, "dim");
          r.lastPacketAt = now;
        }
      }
      if (g.id === runtime.activeGateId) updateAckAlarm();
    }

    function pushPacket(g, text) {
      g.packets ||= [];
      g.packets.push({ ts: Date.now(), text });
      g.packets = g.packets.slice(-8);
      if (g.id === runtime.activeGateId) {
        // Play "ping" for relay PING/ACK packets and random relay events (HANDSHAKE/TELEMETRY BURST), "blip" for everything else
        const isPingPacket = /^(PING|ACK)\s+(RELAY-\d+|GATE-\d+)|^(RELAY-\d+|GATE-\d+)\s+(PING|ACK)/i.test(text) ||
                             /PING FROM/.test(text) ||
                             /(HANDSHAKE|TELEMETRY BURST)/.test(text);
        playSfx(isPingPacket ? "ping" : "blip");
      }
    }

    function checkOutboundDeadlines(g, s) {
      if (s.dir !== "OUT" || !s.departureDeadline || s.penaltyApplied || s.state === "CLEARED" || s.state === "DENIED" || s.state === "DEPARTED") return;

      const now = Date.now();

      // Warning phase
      if (now >= s.deadlineWarningAt && !s.deadlineWarning) {
        s.deadlineWarning = true;
        if (g.id === runtime.activeGateId) {
          const remaining = Math.max(0, Math.ceil((s.departureDeadline - now) / 1000));
          eventLine(`DEADLINE WARNING: ${s.id} (${formatMMSS(remaining)} REMAINING)`, "warn");
          playSfx("error");
        }
      }

      // Deadline passed
      if (now > s.departureDeadline) {
        applyDeadlinePenalty(g, s);
      }
    }

    function applyDeadlinePenalty(g, s) {
      if (s.penaltyApplied) return;

      s.penaltyApplied = true;
      s.missedDeadline = true;

      if (shouldSeverForNoCauseExpiry(s)) {
        severGate(`PRIORITY DEADLINE EXPIRED: ${s.id}`);
      }

      const now = Date.now();
      const overtime = Math.floor((now - s.departureDeadline) / 1000);

      // Consequences by deadline type
      switch(s.deadlineType) {
        case "CRITICAL":
          applyCriticalDeadlineMiss(g, s, overtime);
          break;

        case "URGENT":
          applyUrgentDeadlineMiss(g, s, overtime);
          break;

        case "STANDARD":
          applyStandardDeadlineMiss(g, s, overtime);
          break;

        case "RELAXED":
          applyRelaxedDeadlineMiss(g, s, overtime);
          break;
      }
    }

    function applyCriticalDeadlineMiss(g, s, overtime) {
      const resources = ensureResources(g);

      switch(s.request) {
        case "DEPART":
          // VIP missed connection - severe reputation hit
          s.state = "DENIED";
          s.reason = "DEADLINE EXPIRED (VIP MISSED CONNECTION)";
          s.doneAt = Date.now();
          bumpStat(g, "deniedIncorrect");
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "criticalMisses");
          bumpConcourse(g, 5 + Math.random() * 7);
          if (g.id === runtime.activeGateId) {
            eventLine(`CRITICAL FAILURE: ${s.id} VIP MISSED CONNECTION`, "bad");
            playSfx("offline");
          }
          break;

        case "TOW":
          // Stranded ship lost - GAME OVER scenario
          if (overtime > 300) {
            severGate(`EMERGENCY TOW FAILURE: ${s.id} LOST`);
          } else {
            s.state = "DENIED";
            s.reason = "TOW EMERGENCY CRITICAL";
            s.doneAt = Date.now();
            bumpStat(g, "deadlinesMissed");
            bumpStat(g, "criticalMisses");
            resources.FUEL.level = Math.max(0, resources.FUEL.level - 15);
            resources.SUPPLY.level = Math.max(0, resources.SUPPLY.level - 15);
            if (g.id === runtime.activeGateId) {
              eventLine(`CRITICAL: ${s.id} TOW MISSION FAILURE`, "bad");
              consoleLine(`RESOURCE LOSS: EMERGENCY RESPONSE DEPLOYED`, "bad");
              playSfx("offline");
            }
          }
          break;

        case "CREW TRANSFER":
          // Critical personnel delayed - system degradation
          s.state = "DENIED";
          s.reason = "DEADLINE EXPIRED (PERSONNEL CRITICAL)";
          s.doneAt = Date.now();
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "criticalMisses");
          const facility = g.facility || [];
          const online = facility.filter(f => f.status === "ONLINE");
          if (online.length > 0) {
            const target = online[Math.floor(Math.random() * online.length)];
            target.status = "DEGRADED";
            if (g.id === runtime.activeGateId) {
              eventLine(`SYSTEM DEGRADED: ${target.name} (CREW DELAY)`, "bad");
              playSfx("error");
            }
          }
          break;

        default:
          // Generic critical failure
          s.state = "DENIED";
          s.reason = "DEADLINE EXPIRED (CRITICAL)";
          s.doneAt = Date.now();
          bumpStat(g, "deniedIncorrect");
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "criticalMisses");
      }
    }

    function applyUrgentDeadlineMiss(g, s, overtime) {
      const resources = ensureResources(g);

      switch(s.request) {
        case "DEPART":
          s.state = "DENIED";
          s.reason = "DEADLINE EXPIRED (DEPARTURE SLOT LOST)";
          s.doneAt = Date.now();
          bumpConcourse(g, 3 + Math.random() * 5);
          bumpStat(g, "deniedIncorrect");
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "urgentMisses");
          if (g.id === runtime.activeGateId) {
            eventLine(`DEADLINE MISS: ${s.id} DEPARTURE WINDOW CLOSED`, "warn");
            playSfx("error");
          }
          break;

        case "TOW":
          s.state = "DENIED";
          s.reason = "TOW DEADLINE EXPIRED";
          s.doneAt = Date.now();
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "urgentMisses");
          resources.FUEL.level = Math.max(0, resources.FUEL.level - 8);
          resources.SUPPLY.level = Math.max(0, resources.SUPPLY.level - 8);
          if (g.id === runtime.activeGateId) {
            eventLine(`TOW DELAY: ${s.id} ADDITIONAL RESOURCES CONSUMED`, "warn");
            consoleLine(`RESOURCE DRAIN: FUEL -8, SUPPLY -8`, "warn");
          }
          break;

        case "REFUEL":
          s.state = "DENIED";
          s.reason = "REFUEL WINDOW EXPIRED";
          s.doneAt = Date.now();
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "urgentMisses");
          resources.FUEL.level = Math.max(0, resources.FUEL.level - 10);
          if (g.id === runtime.activeGateId) {
            eventLine(`REFUEL TIMEOUT: ${s.id} FUEL TRANSFER ABORTED`, "warn");
            consoleLine(`FUEL LOSS: -10 (TRANSFER CANCELLED)`, "warn");
          }
          break;

        case "CREW TRANSFER":
        case "CARGO LOAD":
          s.state = "DENIED";
          s.reason = "DEADLINE EXPIRED (URGENT)";
          s.doneAt = Date.now();
          bumpStat(g, "deniedIncorrect");
          bumpStat(g, "deadlinesMissed");
          bumpStat(g, "urgentMisses");
          bumpConcourse(g, 2 + Math.random() * 3);
          if (g.id === runtime.activeGateId) {
            eventLine(`DEADLINE MISS: ${s.id} ${s.request} FAILED`, "warn");
          }
          break;
      }
    }

    function applyStandardDeadlineMiss(g, s, overtime) {
      const resources = ensureResources(g);

      s.state = "DENIED";
      s.reason = `DEADLINE EXPIRED (${s.request})`;
      s.doneAt = Date.now();
      bumpStat(g, "deadlinesMissed");

      if (s.request === "REFUEL") {
        resources.FUEL.level = Math.max(0, resources.FUEL.level - 5);
      } else if (s.request === "CARGO LOAD") {
        resources.SUPPLY.level = Math.max(0, resources.SUPPLY.level - 5);
      }

      bumpConcourse(g, 1 + Math.random() * 2);
      bumpStat(g, "deniedIncorrect");

      if (g.id === runtime.activeGateId) {
        eventLine(`DEADLINE MISS: ${s.id} (PENALTY APPLIED)`, "warn");
      }
    }

    function applyRelaxedDeadlineMiss(g, s, overtime) {
      s.state = "DENIED";
      s.reason = "DEADLINE EXPIRED";
      s.doneAt = Date.now();
      bumpStat(g, "deadlinesMissed");

      bumpConcourse(g, 0.5 + Math.random() * 1.5);

      if (g.id === runtime.activeGateId) {
        eventLine(`DEADLINE MISS: ${s.id} (MINOR DELAY)`, "dim");
      }
    }

    function resolveTraffic(g) {
      manageDockReservations(g);
      const waitingShip = dockWaitingShips(g);
      if (waitingShip && g.id === runtime.activeGateId) {
        eventLine(`DOCK EVENT: ${waitingShip.id} ASSIGNED (FROM WAITING)`, "dim");
      }
      // Check for expired HOLD timers
      for (const s of [...g.inbound, ...g.outbound]) {
        if (s.state === "HOLD" && s.holdStartTime > 0 && s.holdDuration > 0) {
          const elapsed = Date.now() - s.holdStartTime;
          if (elapsed >= s.holdDuration) {
            // HOLD timer expired - release the ship
            s.state = "PENDING";
            s.reason = null;
            s.holdStartTime = 0;
            s.holdDuration = 0;

            // Resume deadline timer by extending it by the time spent on HOLD
            if (s.holdDeadlinePausedAt && s.holdDeadlinePausedAt > 0) {
              const holdTime = Date.now() - s.holdDeadlinePausedAt;
              if (s.departureDeadline && s.departureDeadline > 0) {
                s.departureDeadline += holdTime;
              }
              if (s.deadlineWarningAt && s.deadlineWarningAt > 0) {
                s.deadlineWarningAt += holdTime;
              }
              s.holdDeadlinePausedAt = 0;
            }

            if (g.id === runtime.activeGateId) eventLine(`HOLD EXPIRED: ${s.id}`, "dim");
          }
        }
      }

      // release holds when dock slots open
      const hasEmptySlot = (g.dockSlots || []).some(x => x.state === "EMPTY");
      if (hasEmptySlot) {
        for (const s of g.inbound) {
          if (s.state === "HOLD" && s.reason === "NO SLOT" && s.wasCleared) {
            s.state = "CLEARED";
            s.eta = randRange(60, 180);
            s.holdStartTime = 0;
            s.holdDuration = 0;

            // Resume deadline timer by extending it by the time spent on HOLD
            if (s.holdDeadlinePausedAt && s.holdDeadlinePausedAt > 0) {
              const holdTime = Date.now() - s.holdDeadlinePausedAt;
              if (s.departureDeadline && s.departureDeadline > 0) {
                s.departureDeadline += holdTime;
              }
              if (s.deadlineWarningAt && s.deadlineWarningAt > 0) {
                s.deadlineWarningAt += holdTime;
              }
              s.holdDeadlinePausedAt = 0;
            }

            if (g.id === runtime.activeGateId) eventLine(`HOLD RELEASE: ${s.id} (SLOT OPEN)`, "dim");
            break;
          }
        }
      }

      // step size (sim-time): slow enough to feel lonely; still moves
      for (const s of [...g.inbound, ...g.outbound]) {
        if (s.state === "DENIED") continue;
        if (s.state === "HOLD") continue;

        if (["ARRIVED","DEPARTED","WAITING TO DOCK","WAITING DECON","DECON","SERVICING","CLEARING","COMPLETE"].includes(s.state)) continue;

          const isPending = s.state === "PENDING" || s.state === "PENDING AUTH";
          let step = isPending ? 0.6 : 1.2; // seconds per tick
          if (s.transponder !== "VALID" && s.state !== "CLEARED") step *= 0.55;
          s.eta = Math.max(0, s.eta - step);

        // Check outbound deadlines (warnings and violations)
        if (s.dir === "OUT") {
          checkOutboundDeadlines(g, s);
        }

        if (s.eta <= 0) {
          if (s.dir === "IN") {
            if (s.state === "CLEARED") {
              const docked = assignDockSlot(g, s);
              if (docked) {
                if (g.id === runtime.activeGateId) {
                  eventLine(`DOCK EVENT: ${s.id} ARRIVED (WAITING DECON)`, "dim");

                  // Broadcast ship arrival to co-op clients
                  if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                    sendCoopEvent("alert", {
                      message: `DOCK EVENT: ${s.id} ARRIVED (WAITING DECON)`,
                      messageClass: "dim"
                    });
                  }
                }
              } else {
                s.state = "WAITING TO DOCK";
                s.reason = "NO SLOT";
                s.wasCleared = true;
                s.eta = 0;
                if (g.id === runtime.activeGateId) {
                  eventLine(`WAITING TO DOCK: ${s.id} (NO SLOT)`, "warn");

                  // Broadcast waiting to dock to co-op clients
                  if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                    sendCoopEvent("alert", {
                      message: `WAITING TO DOCK: ${s.id} (NO SLOT)`,
                      messageClass: "warn"
                    });
                  }
                }
              }
            } else {
              // Inbound ship timer expired without approval/denial - remove from queue with -5 CR penalty
              if (shouldSeverForNoCauseExpiry(s)) {
                severGate(`PRIORITY SHIP EXPIRED: ${s.id}`);
              }
              s.state = "DENIED";
              s.reason = "TIMEOUT";
              s.doneAt = Date.now();
              bumpStat(g, "inboundTimeouts");
              // No event message - penalty applied silently, visible only in wage total
            }
          } else {
            if (s.state === "CLEARED") {
              s.state = "DEPARTED";
              s.doneAt = Date.now();
              // Track deadline success
              if (s.departureDeadline && Date.now() < s.departureDeadline) {
                bumpStat(g, "deadlinesMet");
              }
              if (g.id === runtime.activeGateId) {
                eventLine(`DEPART EVENT: ${s.id} DEPARTED`, "dim");

                // Broadcast ship departure to co-op clients
                if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                  sendCoopEvent("alert", {
                    message: `DEPART EVENT: ${s.id} DEPARTED`,
                    messageClass: "dim"
                  });
                }
              }
            } else {
              // Check if deadline passed
              const now = Date.now();
              if (s.departureDeadline && now > s.departureDeadline && !s.penaltyApplied) {
                applyDeadlinePenalty(g, s);
              } else {
                s.state = "PENDING AUTH";
                s.eta = 60 + Math.floor(Math.random() * 240); // 1–5 min more waiting
                if (g.id === runtime.activeGateId) eventLine(`OUTBOUND STALL: ${s.id} (AUTH WAIT)`, "warn");
              }
            }
          }
        }
      }

      // keep completed ships visible for a bit; then drop them
      const now = Date.now();
      const keepMs = 30_000; // 30s visibility
      g.inbound = g.inbound.filter(s => !(s.state === "ARRIVED" && s.doneAt && (now - s.doneAt) > keepMs) && !(s.state === "DENIED" && s.doneAt && (now - s.doneAt) > keepMs) && !(s.state === "COMPLETE" && s.doneAt && (now - s.doneAt) > keepMs));
      g.outbound = g.outbound.filter(s => !(s.state === "DEPARTED" && s.doneAt && (now - s.doneAt) > keepMs) && !(s.state === "DENIED" && s.doneAt && (now - s.doneAt) > keepMs));
    }


    function checkUrgentDeadlineAudio(g) {
      if (g.id !== runtime.activeGateId) return;

      const now = Date.now();

      for (const s of g.outbound) {
        if (s.state === "DEPARTED" || s.state === "DENIED" || s.state === "CLEARED") continue;
        if (!s.departureDeadline) continue;
        // All outbound deadlines use the alert sound

        const remainingMs = s.departureDeadline - now;
        const remainingSec = Math.ceil(remainingMs / 1000);

        // Play alert sound at 20 seconds (once)
        if (remainingSec === 20 && !s.alert20sPlayed) {
          playSfx("alert");
          s.alert20sPlayed = true;
        }

        // Play alert sound every second for the last 5 seconds
        if (remainingSec > 0 && remainingSec <= 5) {
          // Track which second we last played for to avoid duplicates
          if (!s.lastAlertSecond || s.lastAlertSecond !== remainingSec) {
            playSfx("alert");
            s.lastAlertSecond = remainingSec;
          }
        }
      }
    }

function tickGate(g) {
      const now = Date.now();
      resolveTraffic(g);
      checkUrgentDeadlineAudio(g);
      tickDockSlots(g);
      driftSystems(g);
      driftFacility(g);
      tickWorkOrders(g);
      tickRepairAttempts(g);
      enforceBeaconDependency(g);
      maybeSpawnShip(g, "IN");
      maybeSpawnShip(g, "OUT");
      tickResources(g);
      driftConcourse(g);
      driftRelays(g);
      tickAssembly(g);
      tickUpgrades(g);
      syncGateSystemsFailureTimer(g, now);
      if (g.id === runtime.activeGateId) updateKlaxon();

      // Enhanced relay health state tracking
      const healthState = computeRelayHealthState(g);

      // Track state transitions
      if (g.relayHealth.lastHealthState !== healthState.state) {
        const prevState = g.relayHealth.lastHealthState;
        g.relayHealth.lastHealthState = healthState.state;

        // State change logic
        if (healthState.state === "DEGRADED" && !g.relayHealth.degradedSince) {
          g.relayHealth.degradedSince = now;
          if (g.id === runtime.activeGateId) {
            eventLine("RELAY HEALTH: DEGRADED (REDUCED REDUNDANCY)", "warn");
            playSfx("error");

            // Broadcast relay degraded to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: "RELAY HEALTH: DEGRADED (REDUCED REDUNDANCY)",
                messageClass: "warn"
              });
              // Sound is now auto-synced by playSfx()
            }
          }
        } else if (healthState.state === "CRITICAL") {
          if (!g.relayHealth.criticalSince) {
            g.relayHealth.criticalSince = now;
            if (g.id === runtime.activeGateId) {
              eventLine("RELAY HEALTH: CRITICAL (IMMINENT FAILURE)", "bad");
              playSfx("offline");

              // Broadcast relay critical to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: "RELAY HEALTH: CRITICAL (IMMINENT FAILURE)",
                  messageClass: "bad"
                });
                // Sound is now auto-synced by playSfx()
              }
            }
          }
        } else if (healthState.state === "SEVERING") {
          if (!g.relayFailureSince) {
            g.relayFailureSince = now;
            if (g.id === runtime.activeGateId) {
              eventLine("RELAY NETWORK: ALL RELAYS OFFLINE", "bad");
              playSfx("offline");

              // Broadcast all relays offline to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: "RELAY NETWORK: ALL RELAYS OFFLINE",
                  messageClass: "bad"
                });
                // Sound is now auto-synced by playSfx()
              }
            }
          }
        } else if (healthState.state === "HEALTHY") {
          // Recovery
          if (prevState !== "HEALTHY" && g.id === runtime.activeGateId) {
            eventLine("RELAY HEALTH: RESTORED", "good");
            playSfx("restore"); // Moved before broadcast so it auto-syncs

            // Broadcast relay health restored to co-op clients
            if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
              sendCoopEvent("alert", {
                message: "RELAY HEALTH: RESTORED",
                messageClass: "good"
              });
              // Sound is now auto-synced by playSfx()
            }
          }
          g.relayHealth.degradedSince = 0;
          g.relayHealth.criticalSince = 0;
          g.relayFailureSince = 0;
          g.broadcastTimeAdded = 0;
          g.broadcastClickCount = 0;
        }
      }

      // SEVERING state final countdown
      if (healthState.state === "SEVERING") {
        if (!g.relayFailureSince) g.relayFailureSince = now;
      }

      // Reset failure timer if not in SEVERING state
      if (healthState.state !== "SEVERING") {
        g.relayFailureSince = 0;
      }

      maybeGenerateReport(g);
      maybeFlavorEvent(g);
      recomputeHealth(g);
      if (g.id === runtime.activeGateId) {
        const severReason = gateSeverReason(g);
        if (severReason) {
          severGate(severReason);
          return;
        }
      }
      

      g.lastRefresh = now;
    }

    function tickAllGates() {
      if (runtime.severed) return;

      // Invited players don't run their own tick logic - they receive state from host
      const isInvitedPlayer = runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited";

      if (runtime.gate && !isInvitedPlayer) {
        tickGate(runtime.gate);
      }

      runtime.saveTick++;
      if (runtime.saveTick % 6 === 0) {
        // Skip auto-save if user is invited co-op player to preserve their localStorage
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === 'invited') {
          // Guest: Do not save host's data to localStorage
        } else {
          // Host or non-co-op: Save normally
				saveShiftMsToStorage();
				window.addEventListener("pagehide", saveShiftMsToStorage);
				window.addEventListener("beforeunload", () => {
					saveShiftMsToStorage();
					cleanupMultiplayer();
				});
        }
      }

      // Co-op state sync (every tick = ~100ms for more responsive updates)
      if (runtime.saveTick % 1 === 0) {
        sendCoopStateSync();
      }

      renderAll();
    }

    // ---------------------------
    // Maintenance actions (now actually changes systems/links)
    // ---------------------------
    function improveLinkOneStep(g) {
      if (!g.corridors.length) return null;
      // pick the worst link to improve first
      const score = (st) => st === "OFFLINE" ? 3 : (st === "INTERMITTENT" ? 2 : (st === "DEGRADED" ? 1 : 0));
      const worst = [...g.corridors].sort((a,b) => score(b.status) - score(a.status))[0];
      if (!worst) return null;

      const next = (worst.status === "OFFLINE") ? "INTERMITTENT"
                 : (worst.status === "INTERMITTENT") ? "DEGRADED"
                 : (worst.status === "DEGRADED") ? "STABLE"
                 : "STABLE";

      worst.status = next;
      worst.cls = CORRIDOR_STATES.find(x => x.key === next)?.cls || "warn";
      worst.lastChange = Date.now();
      return worst;
    }

    function fullyStabilizeLink(g) {
      if (!g.corridors.length) return null;
      // pick the worst link and fully stabilize it
      const score = (st) => st === "OFFLINE" ? 3 : (st === "INTERMITTENT" ? 2 : (st === "DEGRADED" ? 1 : 0));
      const worst = [...g.corridors].sort((a,b) => score(b.status) - score(a.status))[0];
      if (!worst || worst.status === "STABLE") return null;

      worst.status = "STABLE";
      worst.cls = CORRIDOR_STATES.find(x => x.key === "STABLE")?.cls || "good";
      worst.lastChange = Date.now();
      return worst;
    }

    function fullyStabilizeAllLinks(g) {
      if (!g.corridors.length) return [];
      const improved = [];
      for (const corridor of g.corridors) {
        if (corridor.status !== "STABLE") {
          corridor.status = "STABLE";
          corridor.cls = CORRIDOR_STATES.find(x => x.key === "STABLE")?.cls || "good";
          corridor.lastChange = Date.now();
          improved.push(corridor);
        }
      }
      return improved;
    }

    function worsenLink(g, c, opts = {}) {
      if (!c) return null;
      const next = (c.status === "STABLE") ? "DEGRADED"
                 : (c.status === "DEGRADED") ? "INTERMITTENT"
                 : (c.status === "INTERMITTENT") ? "OFFLINE"
                 : "OFFLINE";
      c.status = next;
      c.cls = CORRIDOR_STATES.find(x => x.key === next)?.cls || "warn";
      c.lastChange = Date.now();
      if (!opts.silent && g.id === runtime.activeGateId) {
        if (next !== "OFFLINE") playSfx("restore");
        else playSfx("warn");
      }
      return c;
    }

    function worsenRandomLink(g) {
      if (!g.corridors.length) return null;
      const c = g.corridors[Math.floor(Math.random() * g.corridors.length)];
      return worsenLink(g, c);
    }

    function hasRealignNeed(g) {
      if (g.alignment !== "WITHIN TOLERANCE") return true;
      return (g.corridors || []).some(c => c.status !== "STABLE");
    }

    function hasResetNeed(g) {
      return g.sync !== "SYNC" || g.beacon !== "ONLINE";
    }

    function hasPurgeNeed(g) {
      const allShips = [...g.inbound, ...g.outbound];
      const hasPending = g.inbound.some(s => s.state === "PENDING" && !s.priority)
        || g.outbound.some(s => (s.state === "PENDING" || s.state === "PENDING AUTH") && !s.priority);
      const hasHold = allShips.some(s => s.state === "HOLD");
      const hasAuth = allShips.some(s => s.state === "PENDING AUTH");
      return hasPending || hasHold || hasAuth;
    }

    function hasScanNeed(g) {
      const allShips = [...g.inbound, ...g.outbound];
      const hasAnomaly = allShips.some(s => s.transponder !== "VALID");
      const hasHiddenEffect = allShips.some(s => (s.effects || []).some(ef => ef.hidden && !ef.revealed));
      const hasUnknownFields = allShips.some(s =>
        s.typeUnknown || s.priorityUnknown || s.etaUnknown || s.infoMasked ||
        s.cargoUnknown || (s.crewUnknown && !s.crewRevealed)
      );
      return hasAnomaly || hasHiddenEffect || hasUnknownFields;
    }

    function doMaintenance(kind) {
      const g = activeGate();

      if (kind === "realign") {
        const shouldAward = hasRealignNeed(g);
        g.lastRealignAt = Date.now();
        consoleLine("MAINT: REALIGN (IN PROGRESS)...", "dim");
        setTimeout(() => {
          g.alignment = "WITHIN TOLERANCE";
          g.tech.driftSuppressedUntil = Date.now() + 150_000; // calmer for 2.5 min
          consoleLine("MAINT: ALIGNMENT WITHIN TOLERANCE", "good");
          if (g.id === runtime.activeGateId) eventLine("MAINT: ALIGNMENT WITHIN TOLERANCE", "good");

          let improvedAny = false;
          const jackpotRoll = Math.random();

          // 1% chance: JACKPOT - fully stabilize ALL links and alignment
          if (jackpotRoll < 0.01) {
            const allImproved = fullyStabilizeAllLinks(g);
            if (allImproved.length > 0) {
              improvedAny = true;
              consoleLine("MAINT: ALL LINKS FULLY STABILIZED", "good");
              if (g.id === runtime.activeGateId) {
                eventLine("MAINT: ALL LINKS FULLY STABILIZED", "good");
                playSfx("restore");
              }
              for (const corridor of allImproved) {
                consoleLine(`MAINT: LINK ${corridor.link} -> STABLE`, "good");
                if (g.id === runtime.activeGateId) {
                  eventLine(`MAINT: LINK ${corridor.link} -> STABLE`, "good");
                }
              }
            }
          }
          // 5% chance: major success - fully stabilize ONE link OR alignment is already done
          else if (jackpotRoll < 0.06) {
            const fullyImproved = fullyStabilizeLink(g);
            if (fullyImproved) {
              improvedAny = true;
              consoleLine(`MAINT: LINK ${fullyImproved.link} FULLY STABILIZED`, "good");
              if (g.id === runtime.activeGateId) {
                eventLine(`MAINT: LINK ${fullyImproved.link} FULLY STABILIZED`, "good");
                playSfx("restore");
              }
            } else {
              consoleLine("MAINT: GATE ALIGNMENT OPTIMAL", "good");
              if (g.id === runtime.activeGateId) {
                eventLine("MAINT: GATE ALIGNMENT OPTIMAL", "good");
              }
            }
          }
          // Normal behavior: improve links step by step
          else {
            // 78% chance for first improvement
            if (Math.random() < 0.78) {
              const improved = improveLinkOneStep(g);
              if (improved) {
                improvedAny = true;
                consoleLine(`MAINT: LINK ${improved.link} -> ${improved.status}`, improved.status === "STABLE" ? "good" : "warn");
                if (g.id === runtime.activeGateId) {
                  eventLine(`MAINT: LINK ${improved.link} -> ${improved.status}`, improved.status === "STABLE" ? "good" : "warn");
                }
              }
            }

            // 25% chance for multiple additional improvements (2-3 more links)
            if (Math.random() < 0.25 && hasRealignNeed(g)) {
              const additionalImprovements = Math.floor(Math.random() * 2) + 2; // 2-3 additional improvements
              for (let i = 0; i < additionalImprovements; i++) {
                if (!hasRealignNeed(g)) break; // stop if everything is stable
                const improved = improveLinkOneStep(g);
                if (improved) {
                  improvedAny = true;
                  consoleLine(`MAINT: LINK ${improved.link} -> ${improved.status}`, improved.status === "STABLE" ? "good" : "warn");
                  if (g.id === runtime.activeGateId) {
                    eventLine(`MAINT: LINK ${improved.link} -> ${improved.status}`, improved.status === "STABLE" ? "good" : "warn");
                  }
                }
              }
            }
          }

          if (!improvedAny) {
            consoleLine("MAINT: LINK STATE UNCHANGED", "dim");
            if (g.id === runtime.activeGateId) eventLine("MAINT: LINK STATE UNCHANGED", "dim");
          }

          g.lastRefresh = Date.now();
          if (shouldAward) bumpStat(g, "maintenanceOps");
          renderAll();
        }, 950);
        return;
      }

        if (kind === "reset") {
          const shouldAward = hasResetNeed(g);
          g.lastResetAt = Date.now();
          consoleLine("MAINT: RESYNC HANDSHAKE (IN PROGRESS)...", "dim");
          setTimeout(() => {
            const prevSync = g.sync;
            // Fix sync proportionally based on relay health
            const relayRatio = getRelayHealthRatio(g);
            const resetRecoveryChance = 0.35 * relayRatio;

            if (relayRatio > 0 && Math.random() < resetRecoveryChance) {
              g.sync = "SYNC";
            } else {
              g.sync = (Math.random() < 0.92) ? "ASYNC" : "FAULT";
            }
            // beacon recovers often
            if (g.beacon !== "ONLINE" && Math.random() < 0.70) g.beacon = "ONLINE";

            if (g.id === runtime.activeGateId && didWorsen(prevSync, g.sync, GATE_SYNC_RANK)) {
              playSfx("restore");
            }
            consoleLine(`MAINT: SYNC ${g.sync}`, g.sync === "SYNC" ? "good" : (g.sync === "FAULT" ? "bad" : "warn"));
            consoleLine(`MAINT: BEACON ${g.beacon}`, g.beacon === "ONLINE" ? "good" : "bad");
            if (g.id === runtime.activeGateId) {
              eventLine(`MAINT: SYNC ${g.sync}`, g.sync === "SYNC" ? "good" : (g.sync === "FAULT" ? "bad" : "warn"));
              eventLine(`MAINT: BEACON ${g.beacon}`, g.beacon === "ONLINE" ? "good" : "bad");

              // Broadcast RESYNC results to co-op clients
              if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                sendCoopEvent("alert", {
                  message: `MAINT: SYNC ${g.sync}`,
                  messageClass: g.sync === "SYNC" ? "good" : (g.sync === "FAULT" ? "bad" : "warn")
                });
                sendCoopEvent("alert", {
                  message: `MAINT: BEACON ${g.beacon}`,
                  messageClass: g.beacon === "ONLINE" ? "good" : "bad"
                });
              }
            }

            g.lastRefresh = Date.now();
            if (shouldAward) bumpStat(g, "maintenanceOps");
            renderAll();
          }, 800);
          return;
        }

      if (kind === "purge") {
        const shouldAward = hasPurgeNeed(g);
        g.lastPurgeAt = Date.now();

        // Deduct 10 fuel for PURGE operation
        ensureResources(g);
        const resources = g.resources;
        resources.FUEL.level = Math.max(0, resources.FUEL.level - 10);

        consoleLine("MAINT: PURGE QUEUE (LOCAL)", "warn");
        consoleLine("FUEL: -10", "warn");
        let removed = 0;
        let released = 0;
        let authReset = 0;

        const beforeIn = g.inbound.length;
        g.inbound = g.inbound.filter(s => !(s.state === "PENDING" && !s.priority));
        removed += beforeIn - g.inbound.length;

        const beforeOut = g.outbound.length;
        g.outbound = g.outbound.filter(s => !((s.state === "PENDING" || s.state === "PENDING AUTH") && !s.priority));
        removed += beforeOut - g.outbound.length;

        for (const s of [...g.inbound, ...g.outbound]) {
          if (s.state === "HOLD") {
            const chance = s.priority ? 0.25 : 0.65;
            if (Math.random() < chance) {
            s.state = "PENDING";
            s.reason = null;
            s.holdStartTime = 0;
            s.holdDuration = 0;
            released += 1;
            }
          }
          if (s.state === "PENDING AUTH" && Math.random() < 0.6) {
            s.state = "PENDING";
            s.eta = randRange(45, 160);
            authReset += 1;
          }
        }

        if (removed) consoleLine(`MAINT: REMOVED ${removed} NON-PRIORITY`, "dim");
        if (released) consoleLine(`MAINT: RELEASED ${released} HOLDS`, "dim");
        if (authReset) consoleLine(`MAINT: AUTH RESET ${authReset}`, "dim");
        g.lastRefresh = Date.now();
        if (shouldAward) bumpStat(g, "maintenanceOps");
        renderAll();
        return;
      }

      if (kind === "scan") {
        const now = Date.now();
        const cooldownMs = MAINT_COOLDOWNS_MS.scan;
        const elapsed = now - g.lastScanAt;
        if (elapsed < cooldownMs) {
          const remainingS = Math.ceil((cooldownMs - Math.max(0, elapsed)) / 1000);
          consoleLine(`SCAN: COOLDOWN (${remainingS}s)`, "warn");
          playSfx("error");
          return;
        }
        g.lastScanAt = now;
        const shouldAward = hasScanNeed(g);
        consoleLine("SCAN: ACTIVE SWEEP...", "dim");

        setTimeout(() => {
          // scan can reveal issues AND occasionally triggers a soft fault
          // Only scan active ships (exclude completed/denied/departed/arrived states)
          const activeShips = [...g.inbound, ...g.outbound].filter(s =>
            s.state !== "ARRIVED" && s.state !== "DENIED" && s.state !== "DEPARTED" && s.state !== "COMPLETE"
          );

          // Check for hidden hazards before displaying "NO ANOMALIES"
          const hasHiddenHazards = activeShips.some(s =>
            (s.hazardType && s.type === "UNKNOWN" && s.infoMasked) ||
            (s.effects || []).some(ef => ef.hidden && !ef.revealed)
          );

          const transponderFlagged = activeShips.filter(s => s.transponder !== "VALID");
          const hazardDetectedShips = [];
          const hazardDetectedSet = new Set();
          const markHazardDetected = (ship) => {
            if (hazardDetectedSet.has(ship.id)) return;
            hazardDetectedSet.add(ship.id);
            ship.hazardDetected = true;
            hazardDetectedShips.push(ship);
          };

          const effectHits = [];
          const dataHits = [];
          const addDataHit = (ship, text) => {
            dataHits.push(`${ship.id} ${text}`);
          };
          const restoreClearanceIfNeeded = (ship) => {
            if (ship.state === "HOLD" && ship.reason === "TRANSPONDER VERIFY" && ship.wasCleared) {
              ship.state = "CLEARED";
              ship.reason = null;
              ship.holdStartTime = 0;
              ship.holdDuration = 0;
              if (ship.eta <= 0) ship.eta = randRange(60, 180);
              if (g.id === runtime.activeGateId) {
                eventLine(`CLEARANCE RESTORED: ${ship.id}`, "good");

                // Broadcast clearance restored to co-op clients
                if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
                  sendCoopEvent("alert", {
                    message: `CLEARANCE RESTORED: ${ship.id}`,
                    messageClass: "good"
                  });
                }
              }
            }
          };
          for (const s of activeShips) {
            // CRITICAL: Reveal hazard ships by changing type from UNKNOWN to actual hazard type
            if (s.hazardType && s.type === "UNKNOWN" && s.infoMasked) {
              s.type = s.hazardType;  // Change from UNKNOWN to PIRATE/RAIDER/INFESTED/IRRADIATED
              s.typeUnknown = false;
              s.infoMasked = false;
              effectHits.push(`${s.id} IDENTIFIED: ${s.type}`);
              s.hazardType = null;  // Clear hazardType since it's now revealed in type
              markHazardDetected(s);
            }

            for (const ef of s.effects || []) {
              if (!ef.hidden || ef.revealed) continue;
              // CHANGE: 100% reveal of effects (removed RNG check)
              ef.revealed = true;
              effectHits.push(`${s.id} ${ef.name}`);
              markHazardDetected(s);
            }
          }

          // SCAN can reveal the same fields as QUERY, with a higher chance per field.
          for (const s of activeShips) {
            const isMismatch = s.transponder === "MISMATCH";
            let revealChance = 0.88;
            let crewRevealChance = 0.92;
            if (isMismatch) {
              const currentMatch = typeof s.transponderMatch === "number" ? s.transponderMatch : 0;
              const bump = 0.22 + Math.random() * 0.25;
              s.transponderMatch = clamp(currentMatch + bump, 0, 1);
              revealChance = 0.55 + 0.45 * s.transponderMatch;
              crewRevealChance = 0.60 + 0.35 * s.transponderMatch;
            }

            if (s.typeUnknown && !s.hazardType && Math.random() < revealChance) {
              s.typeUnknown = false;
              addDataHit(s, `TYPE ${s.type}`);
            }

            if (s.priorityUnknown && Math.random() < revealChance) {
              s.priorityUnknown = false;
              addDataHit(s, `PRIORITY ${s.priority ? "YES" : "NO"}`);
            }

            if (s.etaUnknown && Math.random() < revealChance) {
              s.etaUnknown = false;
              addDataHit(s, `ETA ${formatMMSS(s.eta)}`);
            }

            if (s.cargoUnknown && Math.random() < revealChance) {
              s.cargoUnknown = false;
              const cargoLabel = s.cargoIllegal ? `ILLEGAL ${s.cargo}` : s.cargo;
              addDataHit(s, `CARGO ${cargoLabel}`);
            }

            const isPirateRaider = s.crew && s.crew.length > 0 && s.crew[0].name === "UNKNOWN";
            if (s.crewUnknown && !s.crewRevealed && !isPirateRaider && Math.random() < crewRevealChance) {
              s.crewRevealed = true;
              addDataHit(s, "CREW IDENTIFIED");
            }

            if (s.infoMasked && !s.hazardType) {
              const infoRevealChance = isMismatch ? revealChance : 0.95;
              if (Math.random() < infoRevealChance) {
                s.infoMasked = false;
                for (const ef of s.effects || []) {
                  ef.revealed = true;
                }
                addDataHit(s, "EFFECTS REVEALED");
              }
            }

            if (s.transponder === "MISMATCH") {
              if (s.transponderMatch >= 1) {
                s.transponder = "VALID";
                s.transponderMatch = 1;
                addDataHit(s, "TRANSPONDER VALID");
                restoreClearanceIfNeeded(s);
              }
            } else if (s.transponder !== "VALID") {
              if (Math.random() < 0.70) {
                s.transponder = "VALID";
                s.transponderMatch = 1;
                addDataHit(s, "TRANSPONDER VALID");
                restoreClearanceIfNeeded(s);
              }
            }
          }

          const hazardTypes = ["INFESTED", "IRRADIATED", "PIRATE", "RAIDER"];
          const hazardFlagged = activeShips.filter(s =>
            hazardTypes.includes(s.type) ||
            (s.effects || []).some(ef => ef.revealed && EFFECTS.includes(ef.name))
          );

          const flaggedShips = [];
          const flaggedSet = new Set();
          const addFlagged = (ship) => {
            if (flaggedSet.has(ship.id)) return;
            flaggedSet.add(ship.id);
            flaggedShips.push(ship);
          };
          for (const ship of transponderFlagged) addFlagged(ship);
          for (const ship of hazardFlagged) addFlagged(ship);

          if (!flaggedShips.length && !effectHits.length && !dataHits.length && !hasHiddenHazards) {
            consoleLine("SCAN: NO ANOMALIES", "good");
            if (g.id === runtime.activeGateId) eventLine("SCAN: NO ANOMALIES", "good");
          } else if (flaggedShips.length) {
            const sample = flaggedShips.slice(0, 3).map(s => s.id).join(" / ");
            consoleLine(`SCAN: FLAGGED ${flaggedShips.length} CONTACTS (${sample}${flaggedShips.length > 3 ? " / ..." : ""})`, "warn");
            if (g.id === runtime.activeGateId) eventLine(`SCAN: FLAGGED ${flaggedShips.length} CONTACTS (${sample}${flaggedShips.length > 3 ? " / ..." : ""})`, "warn");

            // Mark transponder-flagged ships for pulse animation
            for (const ship of transponderFlagged) {
              ship.justFlagged = true;
            }
          }

          for (const ship of hazardFlagged) {
            markHazardDetected(ship);
          }

          if (effectHits.length) {
            const sample = effectHits.slice(0, 2).join(" / ");
            consoleLine(`SCAN: EFFECTS REVEALED (${sample}${effectHits.length > 2 ? " / ..." : ""})`, "warn");
            if (g.id === runtime.activeGateId) eventLine(`SCAN: EFFECTS REVEALED (${sample}${effectHits.length > 2 ? " / ..." : ""})`, "warn");
          }

          if (dataHits.length) {
            const sample = dataHits.slice(0, 2).join(" / ");
            consoleLine(`SCAN: DATA REVEALED (${sample}${dataHits.length > 2 ? " / ..." : ""})`, "warn");
            if (g.id === runtime.activeGateId) eventLine(`SCAN: DATA REVEALED (${sample}${dataHits.length > 2 ? " / ..." : ""})`, "warn");
          }

          const scanLinkDegradeChance = 0.38;
          const scanLinkOfflineChance = 0.12;
          const scanAlignDegradeChance = 0.32;
          const scanAlignSevereChance = 0.10;
          const scanRelayDegradeChance = 0.26;
          const scanSyncDegradeChance = 0.18;
          const scanSyncFaultChance = 0.06;
          const nowScan = Date.now();

          for (const corridor of g.corridors || []) {
            if (Math.random() < scanLinkOfflineChance && corridor.status !== "OFFLINE") {
              corridor.status = "OFFLINE";
              corridor.cls = CORRIDOR_STATES.find(x => x.key === "OFFLINE")?.cls || "bad";
              corridor.lastChange = nowScan;
              eventLine(`SCAN SIDE EFFECT: LINK ${corridor.link} -> OFFLINE`, "bad");
              continue;
            }
            if (Math.random() < scanLinkDegradeChance) {
              const c = worsenLink(g, corridor, { silent: true });
              if (c) eventLine(`SCAN SIDE EFFECT: LINK ${c.link} -> ${c.status}`, c.status === "OFFLINE" ? "bad" : "warn");
            }
          }

          const prevAlignment = g.alignment;
          if (Math.random() < scanAlignSevereChance && g.alignment !== "OUT OF TOLERANCE") {
            g.alignment = "OUT OF TOLERANCE";
          } else if (Math.random() < scanAlignDegradeChance) {
            if (g.alignment === "WITHIN TOLERANCE") g.alignment = "DRIFTING";
            else if (g.alignment === "DRIFTING") g.alignment = "OUT OF TOLERANCE";
          }
          if (g.alignment !== prevAlignment) {
            if (g.id === runtime.activeGateId && didWorsen(prevAlignment, g.alignment, GATE_ALIGNMENT_RANK)) {
              playSfx("restore");
            }
            eventLine(`SCAN SIDE EFFECT: ALIGNMENT ${g.alignment}`, g.alignment === "OUT OF TOLERANCE" ? "bad" : "warn");
          }

          const prevSync = g.sync;
          if (Math.random() < scanSyncFaultChance && g.sync !== "FAULT") {
            g.sync = "FAULT";
          } else if (Math.random() < scanSyncDegradeChance) {
            if (g.sync === "SYNC") g.sync = "ASYNC";
            else if (g.sync === "ASYNC") g.sync = "FAULT";
          }
          if (g.sync !== prevSync) {
            if (g.id === runtime.activeGateId && didWorsen(prevSync, g.sync, GATE_SYNC_RANK)) {
              playSfx("restore");
            }
            eventLine(`SCAN SIDE EFFECT: SYNC ${g.sync}`, g.sync === "FAULT" ? "bad" : "warn");
          }

          for (const relay of g.relays || []) {
            if (relay.offline) continue;
            if (Math.random() < scanRelayDegradeChance) {
              const prevStatus = relayHealthToStatus(relay.health);
              const penalty = randRange(12, 22);
              setRelayHealth(relay, Math.max(0, relay.health - penalty), nowScan);
              relay.lastChange = nowScan;
              const newStatus = relayHealthToStatus(relay.health);

              if (relay.health === 0) {
                relay.offline = true;
                relay.hiddenOffline = false;
                relay.hiccupRecoverable = false;
                relay.offlineReason = "SCAN_SIDE_EFFECT";
                relay.offlineSince = nowScan;
              } else {
                scheduleRelayHeartbeat(relay, nowScan);
              }

              if (newStatus !== prevStatus || relay.health === 0) {
                eventLine(`SCAN SIDE EFFECT: RELAY ${relay.id} -> ${newStatus}`, newStatus === "OFFLINE" ? "bad" : "warn");
              }
            }
          }

          g.lastRefresh = Date.now();
          if (shouldAward) bumpStat(g, "maintenanceOps");

          // Trigger panel header pulses if hazards detected and panels are collapsed
          if (hazardDetectedShips.length) {
            triggerHazardPanelPulses(hazardDetectedShips);
          }

          // Broadcast scan results to co-op clients
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
            const eventMessage = effectHits.length
              ? `SCAN: EFFECTS REVEALED (${effectHits.slice(0, 2).join(" / ")}${effectHits.length > 2 ? " / ..." : ""})`
              : dataHits.length
                ? `SCAN: DATA REVEALED (${dataHits.slice(0, 2).join(" / ")}${dataHits.length > 2 ? " / ..." : ""})`
              : flaggedShips.length
                ? `SCAN: FLAGGED ${flaggedShips.length} CONTACTS`
                : "SCAN: NO ANOMALIES";
            const eventClass = effectHits.length || dataHits.length || flaggedShips.length ? "warn" : "good";

            sendCoopEvent("scan_result", {
              flaggedShips: flaggedShips.map(s => s.id),
              hazardDetectedShips: hazardDetectedShips.map(s => s.id),
              message: eventMessage,
              messageClass: eventClass,
              sound: "scan"
            });
          }

          renderAll();

          // Clear flagged ship pulse after animation completes
          if (flaggedShips.length) {
            setTimeout(() => {
              for (const ship of transponderFlagged) {
                ship.justFlagged = false;
              }
              renderAll();
            }, 800);
          }

          // Clear hazard detected pulse after animation completes
          if (hazardDetectedShips.length) {
            setTimeout(() => {
              for (const ship of hazardDetectedShips) {
                ship.hazardDetected = false;
              }
              renderAll();
            }, 1600);
          }
        }, 700);
      }

      if (kind === "stresstest") {
        g.lastStressTestAt = Date.now();
        consoleLine("MAINT: STRESS TEST INITIATING...", "dim");

        setTimeout(() => {
          const lines = [];
          const now = Date.now();

          // Header
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "COMPREHENSIVE SYSTEM DIAGNOSTICS - STRESS TEST", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          // GATE SYSTEMS
          lines.push({ text: "GATE SYSTEMS:", cls: "dim" });

          // Beacon
          const beaconCls = g.beacon === "ONLINE" ? "good" : (g.beacon === "FAULT" ? "warn" : "bad");
          lines.push({ text: `  BEACON AMPLIFIER           ${g.beacon.padEnd(20)}`, cls: beaconCls });
          if (g.beacon !== "ONLINE") {
            // Degrade beacon
            const prevBeacon = g.beacon;
            if (g.beacon === "FAULT") g.beacon = "OFFLINE";
            if (prevBeacon !== g.beacon) {
              lines.push({ text: `  └─ STRESS: ${g.beacon}`, cls: "warn" });
            }
          }

          // Alignment
          const alignCls = g.alignment === "WITHIN TOLERANCE" ? "good" : (g.alignment === "DRIFTING" ? "warn" : "bad");
          lines.push({ text: `  ALIGNMENT MATRIX           ${g.alignment.padEnd(20)}`, cls: alignCls });
          if (g.alignment !== "WITHIN TOLERANCE") {
            // Degrade alignment
            const prevAlign = g.alignment;
            if (g.alignment === "DRIFTING") g.alignment = "OUT OF TOLERANCE";
            if (prevAlign !== g.alignment) {
              lines.push({ text: `  └─ STRESS: ${g.alignment}`, cls: "warn" });
            }
          }

          // Sync
          const syncCls = g.sync === "SYNC" ? "good" : (g.sync === "ASYNC" ? "warn" : "bad");
          lines.push({ text: `  SYNC CONTROLLER            ${g.sync.padEnd(20)}`, cls: syncCls });
          if (g.sync !== "SYNC") {
            // Degrade sync
            const prevSync = g.sync;
            if (g.sync === "ASYNC") g.sync = "FAULT";
            if (prevSync !== g.sync) {
              lines.push({ text: `  └─ STRESS: ${g.sync}`, cls: "warn" });
            }
          }

          lines.push({ text: "", cls: "dim" });

          // CORRIDOR LINKS - report only, don't degrade
          lines.push({ text: "CORRIDOR LINKS:", cls: "dim" });
          for (const c of g.corridors || []) {
            const linkCls = c.status === "STABLE" ? "good" : (c.status === "OFFLINE" ? "bad" : "warn");
            lines.push({ text: `  ${c.link.padEnd(25)} ${c.status.padEnd(20)}`, cls: linkCls });
          }

          lines.push({ text: "", cls: "dim" });

          // FACILITY SUBSYSTEMS
          lines.push({ text: "FACILITY SUBSYSTEMS:", cls: "dim" });
          for (const f of g.facility || []) {
            const facCls = f.status === "ONLINE" ? "good" : (f.status === "OFFLINE" ? "bad" : "warn");
            const sysInfo = FACILITY_SYSTEMS.find(fs => fs.id === f.id);
            const name = sysInfo ? sysInfo.name : f.id;
            lines.push({ text: `  ${name.padEnd(25)} ${f.status.padEnd(20)}`, cls: facCls });

            // Check if facility is near degraded or worse
            const timeToDegrade = (f.stableUntil || 0) - now;
            const nearDegraded = timeToDegrade < 60000; // Within 60 seconds of degrading

            if (f.status === "ONLINE" && nearDegraded) {
              // Knock down to DEGRADED
              f.status = "DEGRADED";
              f.lastChange = now;
              f.degradedSince = now;
              f.degradedTimeoutAt = now + randRange(DEGRADED_TIMEOUT_MIN_MS, DEGRADED_TIMEOUT_MAX_MS);
              if (f.id === "DECON") adjustDeconTimersForStatus(g, "DEGRADED");
              if (f.id === "FUEL") adjustServiceTimersForStatus(g, "DEGRADED");
              lines.push({ text: `  └─ STRESS: DEGRADED`, cls: "warn" });
            } else if (f.status === "DEGRADED") {
              // Worsen to OFFLINE
              f.status = "OFFLINE";
              f.lastChange = now;
              f.degradedSince = 0;
              f.degradedTimeoutAt = 0;
              if (f.id === "DECON") adjustDeconTimersForStatus(g, "OFFLINE");
              if (f.id === "FUEL") adjustServiceTimersForStatus(g, "OFFLINE");
              lines.push({ text: `  └─ STRESS: OFFLINE`, cls: "bad" });
            }
          }

          lines.push({ text: "", cls: "dim" });

          // REPEATER RELAYS
          const relays = g.relays || [];
          lines.push({ text: `RELAY NETWORK: (${relays.length} NODES)`, cls: "dim" });
          for (const r of relays) {
            const displayStatus = relayDisplayStatus(r);
            const relayCls = displayStatus === "ONLINE" ? "good" : (displayStatus === "OFFLINE" || displayStatus === "FAULT" ? "bad" : "warn");
            lines.push({ text: `  ${r.id.padEnd(25)} ${displayStatus.padEnd(20)}`, cls: relayCls });

            // Check if relay is weak or worse
            if (!r.offline && r.health < 75) {
              const prevStatus = relayHealthToStatus(r.health);
              const penalty = randRange(15, 25);
              setRelayHealth(r, Math.max(0, r.health - penalty), now);
              r.lastChange = now;
              const newStatus = relayHealthToStatus(r.health);

              if (r.health === 0) {
                r.offline = true;
                r.hiddenOffline = false;
                r.hiccupRecoverable = false;
                r.offlineReason = "STRESS_TEST";
                r.offlineSince = now;
                lines.push({ text: `  └─ STRESS: OFFLINE`, cls: "bad" });
              } else if (newStatus !== prevStatus) {
                scheduleRelayHeartbeat(r, now);
                lines.push({ text: `  └─ STRESS: ${newStatus}`, cls: "warn" });
              }
            }
          }

          lines.push({ text: "", cls: "dim" });
          lines.push({ text: "STRESS TEST COMPLETE", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          consoleLineDelayed(lines);

          g.lastRefresh = Date.now();
          bumpStat(g, "maintenanceOps");
          renderAll();
        }, 800);
      }
    }

    function issueWorkOrder(systemText) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `WORKORDER ${systemText}` });
        consoleLine(`> WORKORDER ${systemText}`, "dim");
        playSfx("click");
        return;
      }

      const g = activeGate();
      const relayId = resolveRelayId(systemText);
      if (relayId) {
        const relay = findRelay(g, relayId);
        if (!relay) {
          consoleLine(`RELAY NOT FOUND: ${relayId}`, "bad");
          playSfx("error");
          return;
        }
        if (!relayIsDown(relay)) {
          consoleLine(`WORKORDER REFUSED: ${relay.id} ONLINE`, "dim");
          playSfx("error");
          return;
        }
        if (hasActiveWorkOrder(g, relay.id)) {
          consoleLine(`WORKORDER EXISTS: ${relay.id}`, "warn");
          playSfx("error");
          return;
        }
        const phase = WORKORDER_PHASES[0];
        const w = {
          systemId: relay.id,
          systemName: `${relay.id} REPEATER`,
          state: phase.key,
          phaseIndex: 0,
          phaseEndsAt: Date.now() + randRange(phase.min, getAdaptiveWorkOrderMax(phase.min, phase.max)) * 1000,
          createdAt: Date.now()
        };
        g.workOrders ||= [];
        g.workOrders.push(w);
        bumpStat(g, "workOrdersIssued");
        consoleLine(`WORKORDER QUEUED: ${relay.id}`, "dim");
        if (g.id === runtime.activeGateId) eventLine(`WORKORDER QUEUED: ${relay.id}`, "dim");

        // Broadcast work order to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("action", {
            message: `WORKORDER QUEUED: ${relay.id}`,
            messageClass: "dim",
            sound: "click"
          });
        }

        g.lastRefresh = Date.now();
        renderAll();
        return;
      }
      const sysId = resolveFacility(systemText);
      if (!sysId) {
        consoleLine("USAGE: WORKORDER <SYSTEM>", "warn");
        playSfx("error");
        return;
      }
      const sys = getFacility(g, sysId);
      if (!sys) {
        consoleLine(`UNKNOWN SYSTEM: ${systemText}`, "bad");
        playSfx("error");
        return;
      }
      if (sys.status === "ONLINE") {
        consoleLine(`WORKORDER REFUSED: ${sys.name} ONLINE`, "dim");
        playSfx("error");
        return;
      }
      if (sys.status === "DEGRADED") {
        consoleLine(`WORKORDER REFUSED: ${sys.name} DEGRADED (USE REPAIR)`, "dim");
        playSfx("error");
        return;
      }
      if (hasActiveWorkOrder(g, sysId)) {
        consoleLine(`WORKORDER EXISTS: ${sys.name}`, "warn");
        playSfx("error");
        return;
      }
      const phase = WORKORDER_PHASES[0];
      const w = {
        systemId: sysId,
        systemName: sys.name,
        state: phase.key,
        phaseIndex: 0,
        phaseEndsAt: Date.now() + randRange(phase.min, getAdaptiveWorkOrderMax(phase.min, phase.max)) * 1000,
        createdAt: Date.now()
      };
      g.workOrders ||= [];
      g.workOrders.push(w);
      bumpStat(g, "workOrdersIssued");
      consoleLine(`WORKORDER QUEUED: ${sys.name}`, "dim");
      if (g.id === runtime.activeGateId) eventLine(`WORKORDER QUEUED: ${sys.name}`, "dim");

      // Broadcast work order to co-op clients
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("action", {
          message: `WORKORDER QUEUED: ${sys.name}`,
          messageClass: "dim",
          sound: "click"
        });
      }

      g.lastRefresh = Date.now();
      renderAll();
    }

    function initiateRepair(systemText) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `REPAIR ${systemText}` });
        consoleLine(`> REPAIR ${systemText}`, "dim");
        playSfx("click");
        return;
      }

      const g = activeGate();
      const sysId = resolveFacility(systemText);

      if (!sysId) {
        consoleLine("USAGE: REPAIR <SYSTEM>", "warn");
        playSfx("error");
        return;
      }

      const sys = getFacility(g, sysId);
      if (!sys) {
        consoleLine(`UNKNOWN SYSTEM: ${systemText}`, "bad");
        playSfx("error");
        return;
      }

      if (sys.status !== "DEGRADED") {
        consoleLine(`REPAIR REFUSED: ${sys.name} NOT DEGRADED`, "dim");
        playSfx("error");
        return;
      }

      const now = Date.now();
      const cooldownRemaining = REPAIR_COOLDOWN_MS - (now - (sys.lastRepairAttemptAt || 0));
      if (cooldownRemaining > 0) {
        const secRemaining = Math.ceil(cooldownRemaining / 1000);
        consoleLine(`REPAIR COOLDOWN: ${sys.name} (${secRemaining}s)`, "warn");
        playSfx("error");
        return;
      }

      if (hasActiveRepair(g, sysId)) {
        consoleLine(`REPAIR IN PROGRESS: ${sys.name}`, "warn");
        playSfx("error");
        return;
      }

      ensureResources(g);
      ensureUpgrades(g);
      let supplyCost = REPAIR_SUPPLY_COST;
      if (g.upgrades.maintenanceUpgraded) {
        supplyCost *= UPGRADE_SUPPLY_BENEFIT;
      }

      g.resources.SUPPLY.level = clamp(g.resources.SUPPLY.level - supplyCost, 0, 100);

      const delaySec = randRange(REPAIR_DELAY_MIN, REPAIR_DELAY_MAX);
      const repair = {
        systemId: sysId,
        systemName: sys.name,
        startedAt: now,
        completesAt: now + delaySec * 1000,
        state: "REPAIRING"
      };

      g.repairAttempts.push(repair);
      sys.lastRepairAttemptAt = now;
      bumpStat(g, "repairAttempts");

      consoleLine(`REPAIR INITIATED: ${sys.name}`, "dim");
      if (g.id === runtime.activeGateId) {
        eventLine(`REPAIR INITIATED: ${sys.name}`, "dim");
      }

      // Broadcast repair to co-op clients
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("action", {
          message: `REPAIR INITIATED: ${sys.name}`,
          messageClass: "dim",
          sound: "click"
        });
      }

      g.lastRefresh = now;
      renderAll();
    }

    // ---------------------------
    // Terminal commands (console-only; events keep running)
    // ---------------------------
    function findRelay(g, id) {
      return (g.relays || []).find(r => r.id === id) || null;
    }

    function cmdPingPlayer(targetGateId) {
      if (!runtime.multiplayer.enabled) {
        consoleLine("GATE NETWORK: OFFLINE", "warn");
        return;
      }

      const g = activeGate();
      const sourceGateId = g.id;

      // Validate target exists
      const targetPlayer = runtime.multiplayer.players.find(p => p.gateId === targetGateId);
      if (!targetPlayer) {
        consoleLine(`OPERATOR NOT FOUND: ${targetGateId}`, "bad");
        return;
      }

      // Check DND
      if (targetPlayer.dndPing || targetPlayer.dndAll) {
        consoleLine(`PING FAILED: ${targetGateId} (DND)`, "warn");
        return;
      }

      // Send ping to server
      const msg = {
        type: "ping_player",
        timestamp: Date.now(),
        data: {
          sourceGateId: sourceGateId,
          targetGateId: targetGateId
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
      consoleLine(`PING SENT: ${targetGateId}`, "dim");
      pushPacket(g, `PING ${targetGateId}`);

      // Track pending ping with 30-second timeout
      const timeout = setTimeout(() => {
        const pending = runtime.multiplayer.pendingPings.get(targetGateId);
        if (pending && !pending.acked) {
          runtime.multiplayer.pendingPings.delete(targetGateId);
          consoleLine(`NO RESPONSE: ${targetGateId}`, "warn");
          eventLine(`PING TIMEOUT: ${targetGateId}`, "warn");
        }
      }, 30000);

      runtime.multiplayer.pendingPings.set(targetGateId, {
        sentAt: Date.now(),
        timeout: timeout,
        acked: false
      });
    }

    function cmdAckPlayer(sourceGateId) {
      if (!runtime.multiplayer.enabled) {
        consoleLine("GATE NETWORK: OFFLINE", "warn");
        return;
      }

      const g = activeGate();

      // Find pending ping from this source
      if (!g.pendingPlayerPings) g.pendingPlayerPings = [];
      const ping = g.pendingPlayerPings.find(p =>
        p.sourceGateId === sourceGateId && !p.acked
      );

      if (!ping) {
        consoleLine(`NO PENDING PING: ${sourceGateId}`, "warn");
        return;
      }

      // Mark as ACKed
      ping.acked = true;

      // Clear the repeating audio timer
      if (ping.audioTimer) {
        clearInterval(ping.audioTimer);
        ping.audioTimer = null;
      }

      // Clear from gate state
      const gateState = runtime.multiplayer.gateStates.get(sourceGateId);
      if (gateState) {
        gateState.pendingPing = null;
      }

      // Send ACK to server
      sendPlayerAck(sourceGateId, ping.expectedLatency);

      consoleLine(`ACK SENT: ${sourceGateId}`, "good");
      playSfx("pingplayer");
    }

    function sendPlayerAck(targetGateId, expectedLatency) {
      if (!runtime.multiplayer.enabled) return;

      const g = activeGate();
      const sourceGateId = g.id;
      const actualLatency = expectedLatency + randRange(-20, 20); // Jitter

      const msg = {
        type: "ack_player",
        timestamp: Date.now(),
        data: {
          sourceGateId: sourceGateId,
          targetGateId: targetGateId,
          latency: actualLatency
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
      consoleLine(`ACK SENT: ${targetGateId}`, "dim");
    }

    function getPingLatency(sourceGate, targetGate) {
      const matrix = runtime.multiplayer.pingMatrix[sourceGate];
      if (matrix && matrix[targetGate]) {
        return matrix[targetGate].outbound;
      }
      return 300; // Default
    }

    function cmdRestoreRelay(id) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `RESTORE ${id}` });
        consoleLine(`> RESTORE ${id}`, "dim");
        playSfx("click");
        return;
      }

      const g = activeGate();
      const relay = findRelay(g, id);
      if (!relay) {
        consoleLine(`RELAY NOT FOUND: ${id}`, "bad");
        playSfx("error");
        return;
      }
      if (relay.offline) {
        consoleLine(`RESTORE REFUSED: ${relay.id} OFFLINE`, "warn");
        playSfx("error");
        return;
      }
      const relayStatus = relayHealthToStatus(relay.health);
      if (!["FAULT", "WEAK", "CRITICAL"].includes(relayStatus)) {
        consoleLine(`RESTORE REFUSED: ${relay.id} NOT DEGRADED`, "dim");
        playSfx("error");
        return;
      }

      consoleLine(`RESTORE INITIATED: ${relay.id}`, "dim");
      pushPacket(g, `RESTORE ${relay.id}`);

      const now = Date.now();

      // Health-based success rate (skill-based, not RNG gambling)
      // Better health = higher success rate, rewarding early intervention
      const currentHealth = relay.health;
      let successChance;
      if (currentHealth >= 75) {
        successChance = 0.92; // ONLINE state: 92% success
      } else if (currentHealth >= 50) {
        successChance = 0.80; // WEAK state: 80% success
      } else if (currentHealth >= 25) {
        successChance = 0.65; // FAULT state: 65% success
      } else {
        successChance = 0.50; // CRITICAL state: 50% success
      }

      if (Math.random() < successChance) {
        // Success: restore to healthy level (85-95%)
        setRelayHealth(relay, randRange(85, 95), now);
        relay.lastChange = now;
        relay.awaitingAck = false;
        relay.ackDueAt = 0;
        relay.lastAckAt = now;
        relay.offline = false;
        relay.hiddenOffline = false;
        relay.hiccupRecoverable = false;
        scheduleRelayHeartbeat(relay, now);
        relay.offlineReason = null;
        relay.offlineSince = 0;
        bumpStat(g, "relayRepairs");
      } else {
        // Failure: no change, no backfire, no cascade failures
        // Encourages trying again or using work orders instead
        if (g.id === runtime.activeGateId) eventLine(`RELAY ${relay.id}: RESTORE FAILED`, "dim");
        relay.lastChange = now;
      }
      if (g.id === runtime.activeGateId) updateAckAlarm();
      g.lastRefresh = now;
      renderAll();
    }

    function cmdStabilizeRelay(id) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `STABILIZE ${id}` });
        consoleLine(`> STABILIZE ${id}`, "dim");
        playSfx("click");
        return;
      }

      const g = activeGate();
      const relay = findRelay(g, id);
      if (!relay) {
        consoleLine(`RELAY NOT FOUND: ${id}`, "bad");
        playSfx("error");
        return;
      }
      if (relay.offline) {
        consoleLine(`STABILIZE REFUSED: ${relay.id} OFFLINE`, "warn");
        playSfx("error");
        return;
      }

      const relayStatus = relayHealthToStatus(relay.health);
      // Can only stabilize ONLINE or WEAK relays (proactive maintenance)
      if (!["ONLINE", "WEAK"].includes(relayStatus)) {
        consoleLine(`STABILIZE REFUSED: ${relay.id} TOO DEGRADED (use RESTORE)`, "warn");
        playSfx("error");
        return;
      }

      // Check if relay is already at high health
      if (relay.health >= 85) {
        consoleLine(`STABILIZE REFUSED: ${relay.id} ALREADY STABLE`, "dim");
        playSfx("error");
        return;
      }

      const now = Date.now();
      const STABILIZE_COOLDOWN_MS = 30000; // 30 seconds cooldown

      // Check cooldown
      if (relay.lastStabilizeAt && (now - relay.lastStabilizeAt) < STABILIZE_COOLDOWN_MS) {
        const remainingSec = Math.ceil((STABILIZE_COOLDOWN_MS - (now - relay.lastStabilizeAt)) / 1000);
        consoleLine(`STABILIZE REFUSED: ${relay.id} COOLDOWN (${remainingSec}s remaining)`, "warn");
        playSfx("error");
        return;
      }

      consoleLine(`STABILIZE INITIATED: ${relay.id}`, "dim");
      pushPacket(g, `STABILIZE ${relay.id}`);

      // Proactive maintenance: modest boost (10-20% health)
      // Rewards attention but doesn't trivialize the game
      const boost = randRange(10, 20);
      setRelayHealth(relay, Math.min(95, relay.health + boost), now); // Cap at 95%
      relay.lastChange = now;
      relay.lastStabilizeAt = now;
      scheduleRelayHeartbeat(relay, now);

      const newStatus = relayHealthToStatus(relay.health);
      bumpStat(g, "relayRepairs");
      if (g.id === runtime.activeGateId) {
        playSfx("blip");
      }

      if (g.id === runtime.activeGateId) updateAckAlarm();
      g.lastRefresh = now;
      renderAll();
    }

    function cmdBroadcast() {
      const g = activeGate();
      const now = Date.now();

      // Only works when in SEVERING state (all relays offline)
      const healthState = computeRelayHealthState(g);
      if (healthState.state !== "SEVERING" || !g.relayFailureSince) {
        consoleLine("BROADCAST REFUSED: RELAY NETWORK OPERATIONAL", "dim");
        playSfx("error");
        return;
      }

      // Add time extension
      g.broadcastTimeAdded = (g.broadcastTimeAdded || 0) + RELAY_BROADCAST_EXTENSION_MS;
      g.broadcastClickCount = (g.broadcastClickCount || 0) + 1;

      // Calculate current remaining time
      const elapsed = now - g.relayFailureSince;
      const baseRemaining = RELAY_SEVER_GRACE_MS - elapsed;
      const totalRemaining = baseRemaining + g.broadcastTimeAdded;
      const remainingSec = Math.max(0, Math.ceil(totalRemaining / 1000));

      playSfx("blip");
      consoleLine(`EMERGENCY BROADCAST: +${RELAY_BROADCAST_EXTENSION_MS / 1000}s (${remainingSec}s remaining)`, "warn");
      if (g.id === runtime.activeGateId) {
        eventLine(`BROADCAST: EXTENDING CONNECTION (${remainingSec}s)`, "warn");
      }

      g.lastRefresh = now;
      renderAll();
    }

    function cmdRelays() {
      const g = activeGate();

      // Initial loading message
      consoleLine("ESTABLISHING RELAY HANDSHAKE...", "dim");

      // Show loading animation
      setTimeout(() => {
        consoleLine("...", "dim");

        // Build the relay report
        setTimeout(() => {
          const lines = [];

          // Header
          lines.push({ text: "RELAY NETWORK STATUS", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          const now = Date.now();

          for (const [idx, rawRelay] of (g.relays || []).entries()) {
            const r = rawRelay || {};
            const relayId = r.id || `RELAY-${idx + 1}`;
            // Check if relay is assembling
            if (r.assembling && r.assemblyCompletesAt) {
              const assemblyRemaining = Math.max(0, Math.ceil((r.assemblyCompletesAt - now) / 1000));
              lines.push({ text: `${relayId}`, cls: "dim" });
              lines.push({ text: `  STATUS: ASSEMBLING (${formatMMSS(assemblyRemaining)} REMAINING)`, cls: "warn" });
              lines.push({ text: "", cls: "dim" });
              continue;
            }

            const isOffline = !!r.offline && !r.hiddenOffline;
            const health = typeof r.health === "number" ? r.health : (isOffline ? 0 : 95);
            const displayStatus = isOffline ? "OFFLINE" : relayHealthToStatus(health);

            // Determine signal strength description based on health (thematic, not explicit)
            let signalDesc = "";
            let signalCls = "good";

            if (isOffline) {
              signalDesc = "NO SIGNAL";
              signalCls = "bad";
            } else if (health >= 93) {
              signalDesc = "STRONG";
              signalCls = "good";
            } else if (health >= 85) {
              signalDesc = "STABLE";
              signalCls = "good";
            } else if (health >= 75) {
              signalDesc = "NOMINAL";
              signalCls = "dim";
            } else if (health >= 50) {
              signalDesc = "WEAK";
              signalCls = "warn";
            } else if (health >= 25) {
              signalDesc = "DEGRADED";
              signalCls = "warn";
            } else if (health > 0) {
              signalDesc = "FAILING";
              signalCls = "bad";
            } else {
              signalDesc = "NO SIGNAL";
              signalCls = "bad";
            }

            // Heartbeat status description
            const hbAgeSec = relayHeartbeatAgeSec(r, now);
            let heartbeatDesc = "";

            if (isOffline) {
              heartbeatDesc = "FLATLINE";
            } else if (hbAgeSec === null) {
              heartbeatDesc = "NO DATA";
            } else if (hbAgeSec < 3) {
              heartbeatDesc = "STEADY";
            } else if (hbAgeSec < 8) {
              heartbeatDesc = "DELAYED";
            } else {
              heartbeatDesc = "IRREGULAR";
            }

            // ACK status
            const ackFlag = r.awaitingAck ? " [ACK REQUIRED]" : "";

            // Determine status class
            let statusCls = "dim";
            if (displayStatus === "OFFLINE") statusCls = "bad";
            else if (["FAULT", "CRITICAL"].includes(displayStatus)) statusCls = "bad";
            else if (displayStatus === "WEAK") statusCls = "warn";
            else if (displayStatus === "ONLINE") statusCls = "good";

            // Build available actions
            const actions = [];
            const canRestore = ["FAULT", "WEAK", "CRITICAL"].includes(displayStatus);
            const canStabilize = ["ONLINE", "WEAK"].includes(displayStatus) && health < 85;
            const needsRelayWO = relayIsDown(r) && !r.hiddenOffline && !hasActiveWorkOrder(g, relayId);

            if (canRestore) actions.push("RESTORE");
            if (canStabilize) actions.push("STABILIZE");
            if (needsRelayWO) actions.push("WORKORDER");
            const actionText = actions.length > 0 ? `  ACTIONS: ${actions.join(", ")}` : "";

            // Build the line
            lines.push({ text: `${relayId}`, cls: "dim" });
            lines.push({ text: `  STATUS: ${displayStatus}  |  SIGNAL: ${signalDesc}  |  HEARTBEAT: ${heartbeatDesc}${ackFlag}`, cls: statusCls });

            // Show available actions
            if (actionText) {
              lines.push({ text: actionText, cls: "dim" });
            }

            lines.push({ text: "", cls: "dim" });
          }

          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Print with animation
          consoleLineDelayed(lines);
        }, 500);
      }, 300);
    }

    function pulseRelayPanel(g, relay) {
      const now = Date.now();
      relay.pingPulseUntil = now + 900;
      g.lastRefresh = now;
      renderAll();
      setTimeout(() => {
        if (relay.pingPulseUntil && relay.pingPulseUntil <= Date.now()) {
          g.lastRefresh = Date.now();
          renderAll();
        }
      }, 950);
    }

    function triggerHealthBlink(relay, type, now) {
      // type: "positive" or "warn"
      // Random blink count: 1-3 times
      const blinkCount = Math.floor(Math.random() * 3) + 1; // 1, 2, or 3
      const blinkDuration = blinkCount * 400; // 400ms per blink cycle

      relay.healthBlinkUntil = now + blinkDuration;
      relay.healthBlinkType = type;
      relay.healthBlinkCount = blinkCount;
    }

    function setRelayHealth(relay, newHealth, now, opts = {}) {
      const prevHealth = relay.health;
      relay.health = newHealth;
      if (!opts.noBlink && typeof prevHealth === "number" && prevHealth !== newHealth) {
        triggerHealthBlink(relay, newHealth > prevHealth ? "positive" : "warn", now || Date.now());
      }
      return prevHealth;
    }


    function cmdPingGate(gateIdRaw) {
      const gateId = (gateIdRaw || "").toUpperCase().trim();

      // Accept the same general pattern your generator uses, plus common two-letter suffixes (e.g. GATE-1234-AA).
      // Examples accepted: GATE-0420, GATE-0420-A, GATE-0420-ALPHA, GATE-0420-AA
      const valid = /^GATE-\d{4}(?:-[A-Z]{1,8})?$/.test(gateId);
      if (!valid) {
        consoleLine(`INVALID GATE ID: ${gateIdRaw}`, "warn");
        playSfx("error");
        return;
      }

      // Delegate to player PING handler
      return cmdPingPlayer(gateId);
    }

    function cmdAckGate(gateId) {
      // Validate gate ID pattern
      const valid = /^GATE-\d{4}(?:-[A-Z]{1,8})?$/.test(gateId);
      if (!valid) {
        consoleLine(`INVALID GATE ID: ${gateId}`, "warn");
        playSfx("error");
        return;
      }

      // Delegate to player ACK handler
      return cmdAckPlayer(gateId);
    }

function cmdPingRelay(id) {
      const g = activeGate();
      const relay = findRelay(g, id);
      if (!relay) {
        consoleLine(`RELAY NOT FOUND: ${id}`, "bad");
        playSfx("error");
        return;
      }
      const now = Date.now();
      const hbAgeSec = relayHeartbeatAgeSec(relay, now);
      const hbBand = relayHeartbeatBand(relay, hbAgeSec);
      if (relay.offline && !relay.hiddenOffline) playSfx("error");
      consoleLine(`PING SENT: ${relay.id}`, "dim");
      pushPacket(g, `PING ${relay.id}`);
      pulseRelayPanel(g, relay);
      if (relay.offline) {
        if (relay.hiddenOffline && hbBand.stale) {
          const decay = Math.min(1, (hbAgeSec || 0) / RELAY_HICCUP_JOSTLE_DECAY_SEC);
          const jostleChance = relay.hiccupRecoverable ? Math.max(0.2, 1 - (decay * 0.7)) : 0;
          if (relay.hiccupRecoverable && Math.random() < jostleChance) {
            relay.offline = false;
            relay.hiddenOffline = false;
            relay.hiccupRecoverable = false;
            setRelayHealth(relay, randRange(60, 85), now); // Recovered from hiccup, but not perfect health
            relay.lastChange = now;
            relay.awaitingAck = false;
            relay.ackDueAt = 0;
            relay.offlineReason = null;
            relay.offlineSince = 0;
            scheduleRelayHeartbeat(relay, now);
            g.lastRefresh = now;
            renderAll();
            return;
          }
          relay.hiddenOffline = false;
          relay.hiccupRecoverable = false;
          setRelayHealth(relay, 0, now);
          relay.lastChange = now;
          if (g.id === runtime.activeGateId) playSfx("error");
        } else if (relay.hiddenOffline) {
          relay.hiddenOffline = false;
          relay.hiccupRecoverable = false;
          setRelayHealth(relay, 0, now);
          relay.lastChange = now;
          if (g.id === runtime.activeGateId) playSfx("error");
        }
        consoleLine(`PING TIMEOUT: ${relay.id}`, "warn");
        if (g.id === runtime.activeGateId) eventLine(`RELAY ${relay.id}: NO RESPONSE`, "bad");
        g.lastRefresh = now;
        renderAll();
        return;
      }
      const latency = randRange(120, relay.health >= 75 ? 520 : 1200);
      setTimeout(() => {
        if (relay.offline) {
          if (relay.hiddenOffline) {
            const timeoutNow = Date.now();
            setRelayHealth(relay, 0, timeoutNow);
            relay.hiddenOffline = false;
            relay.hiccupRecoverable = false;
            relay.lastChange = timeoutNow;
            if (g.id === runtime.activeGateId) playSfx("error");
          }
          consoleLine(`PING TIMEOUT: ${relay.id}`, "warn");
          if (g.id === runtime.activeGateId) eventLine(`RELAY ${relay.id}: NO RESPONSE`, "bad");
          g.lastRefresh = Date.now();
          renderAll();
          return;
        }
        // Degraded relays (FAULT/CRITICAL) have higher chance of timeout
        if (relay.health < 50 && Math.random() < 0.6) {
          consoleLine(`PING TIMEOUT: ${relay.id}`, "warn");
          if (g.id === runtime.activeGateId) eventLine(`RELAY ${relay.id}: TIMEOUT`, "warn");
          return;
        }

        // Health effect logic (silent, no user notification)
        const pingTime = Date.now();
        if (pingTime >= relay.nextHealthPingCooldown) {
          const roll = Math.random();
          const prevStatus = relayHealthToStatus(relay.health);
          const prevHealth = relay.health;

          // 20% chance to improve health by 5-15%
          if (roll < 0.20) {
            relay.health = Math.min(100, relay.health + randRange(5, 15));
          }
          // 3% chance to degrade health by 3-8% (slightly increased from 2%)
          else if (roll < 0.23) { // 0.20 + 0.03 = 0.23
            relay.health = Math.max(1, relay.health - randRange(3, 8));
          }

          // Trigger blink if health changed
          if (relay.health !== prevHealth && g.id === runtime.activeGateId) {
            const healthImproved = relay.health > prevHealth;
            triggerHealthBlink(relay, healthImproved ? "positive" : "warn", pingTime);
            g.lastRefresh = pingTime;
          }

          // Update lastChange if status threshold was crossed
          const newStatus = relayHealthToStatus(relay.health);
          if (prevStatus !== newStatus) {
            relay.lastChange = pingTime;
          }

          // Update heartbeat interval based on new health
          scheduleRelayHeartbeat(relay, pingTime);

          // Set next cooldown (15-90 seconds from now)
          relay.lastHealthPingAt = pingTime;
          relay.nextHealthPingCooldown = pingTime + randRange(15000, 90000);
        }

        // Calculate health-representative ms with variance for immersion
        // 100 health: 100-300ms, 90 health: 200-400ms, 80 health: 300-500ms, etc.
        const minMs = 100 + (100 - relay.health) * 10;
        const healthMs = Math.round(minMs + Math.random() * 200);
        consoleLine(`PING ACK RELAY: ${relay.id} (${healthMs}ms)`, relay.health >= 75 ? "good" : "warn");
        pushPacket(g, `ACK ${relay.id} ${healthMs}ms`);
      }, latency);
    }

    function cmdAckRelay(id) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `ACK ${id}` });
        consoleLine(`> ACK ${id}`, "dim");
        playSfx("click");
        return;
      }

      const g = activeGate();
      const relay = findRelay(g, id);
      if (!relay) {
        consoleLine(`RELAY NOT FOUND: ${id}`, "bad");
        playSfx("error");
        return;
      }
      const now = Date.now();
      if (relay.awaitingAck && now > relay.ackDueAt) {
        consoleLine(`ACK LATE: ${relay.id}`, "warn");
        playSfx("error");
        return;
      }
      if (relay.awaitingAck) {
        relay.awaitingAck = false;
        relay.ackDueAt = 0;
        relay.lastAckAt = now;
        bumpStat(g, "relayAcks");
        g.relayHealth.unackedPings = (g.relays || []).filter(r => r.awaitingAck && !r.offline).length;
      }
      consoleLine(`ACK SENT: ${relay.id}`, "dim");
      pushPacket(g, `ACK ${relay.id}`);
      if (g.id === runtime.activeGateId) updateAckAlarm();
      g.lastRefresh = now;
      renderAll();
    }

    function cmdPackets() {
      const g = activeGate();
      const packets = (g.packets || []).slice(-6).reverse();
      consoleLine(`PACKETS (${packets.length})`, "dim");
      for (const p of packets) {
        consoleLine(`  ${formatClock(p.ts)}  ${p.text}`, "dim");
      }
    }

    function cmdOrder(resourceText) {
      // If invited co-op player, send command to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("command", { command: `ORDER ${resourceText}` });
        consoleLine(`> ORDER ${resourceText}`, "dim");
        playSfx("click");
        return;
      }

      const resId = resolveResource(resourceText);
      const amountMatch = String(resourceText || "").match(/\b(\d+)\b/);
      const rawAmount = amountMatch ? parseInt(amountMatch[1], 10) : NaN;
      if (!resId || !Number.isFinite(rawAmount)) {
        consoleLine("USAGE: ORDER FUEL <AMOUNT> | ORDER <AMOUNT> FUEL", "warn");
        playSfx("error");
        return;
      }
      if (rawAmount < RESOURCE_ORDER_MIN) {
        consoleLine(`ORDER REFUSED: AMOUNT MIN ${RESOURCE_ORDER_MIN}`, "warn");
        playSfx("error");
        return;
      }
      const amount = normalizeOrderAmount(rawAmount);
      const g = activeGate();
      ensureResources(g);
      const res = g.resources[resId];
      if (res.order) {
        consoleLine(`ORDER PENDING: ${resId}`, "warn");
        playSfx("error");
        return;
      }
      const cost = resourceOrderCost(resId, amount);
      const credits = availableWageCredits(g);
      if (credits < cost) {
        consoleLine(`ORDER REFUSED: ${resId} INSUFFICIENT WAGE (${cost} CR)`, "warn");
        playSfx("error");
        return;
      }
      res.orderAmount = amount;
      if (startResourceOrder(g, resId, amount)) {
        spendWage(g, cost);
        bumpStat(g, "resourceOrders");
        consoleLine(`ORDER PLACED: ${resId} x${amount} (-${cost} CR)`, "good");

        // Broadcast order placement to co-op clients
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("action", {
            message: `ORDER PLACED: ${resId} x${amount}`,
            messageClass: "good",
            sound: "click"
          });
        }

        g.lastRefresh = Date.now();
        renderAll();
      }
    }

    function isDockedShip(s) {
      return !!(s.slotId || s.dockState || ["WAITING DECON","DECON","SERVICING","CLEARING"].includes(s.state));
    }

    function listShips(dir) {
      const g = activeGate();
      const list = dir === "IN" ? g.inbound.filter(s => !isDockedShip(s)) : g.outbound;
      consoleLine(`${dir === "IN" ? "INBOUND" : "OUTBOUND"} (${list.length})`, "dim");
      for (const s of list.slice(0, 10)) {
        const etaFrozen = ["DENIED","ARRIVED","DEPARTED"].includes(s.state);
        const eta = etaFrozen ? "--:--" : (s.etaUnknown ? "??:??" : formatMMSS(s.eta));
        const displayType = shipDisplayType(s);
        const displayRequest = shipDisplayRequest(s);
        const displayTransponder = shipDisplayTransponder(s);
        const prioDisplay = shipDisplayPriority(s);
        const prioFlag = prioDisplay === null ? "?" : (prioDisplay ? "★" : "");
        const flags = `${prioFlag}${displayTransponder !== "VALID" ? "!" : ""}${s.obscured ? "X" : ""}`.padEnd(2, " ");
        consoleLine(`  ${s.id}  ${eta}  ${flags}  ${displayType}  ${displayRequest}  ${s.state}`, "dim");
      }
      if (list.length > 10) consoleLine("  ...", "dim");
    }

    function listDockedShips() {
      const g = activeGate();
      const list = (g.inbound || []).filter(isDockedShip);
      consoleLine(`DOCKED (${list.length})`, "dim");
      for (const s of list.slice(0, 10)) {
        const etaFrozen = ["DENIED","ARRIVED","DEPARTED"].includes(s.state);
        const eta = etaFrozen ? "--:--" : (s.etaUnknown ? "??:??" : formatMMSS(s.eta));
        const displayType = shipDisplayType(s);
        const displayRequest = shipDisplayRequest(s);
        const displayTransponder = shipDisplayTransponder(s);
        const prioDisplay = shipDisplayPriority(s);
        const prioFlag = prioDisplay === null ? "?" : (prioDisplay ? "ミ." : "");
        const flags = `${prioFlag}${displayTransponder !== "VALID" ? "!" : ""}${s.obscured ? "X" : ""}`.padEnd(2, " ");
        consoleLine(`  ${s.id}  ${eta}  ${flags}  ${displayType}  ${displayRequest}  ${s.state}`, "dim");
      }
      if (list.length > 10) consoleLine("  ...", "dim");
    }

    function cmdHelp() {
      consoleLine("COMMANDS", "dim");
      consoleLine("  HELP", "dim");
      consoleLine("  DOCKS                     - Display docking slot details and occupancy", "dim");
      consoleLine("  SYSREPORT (SYS)           - Comprehensive system diagnostic report", "dim");
      consoleLine("  SHIFT                     - Display shift and performance summary", "dim");
      consoleLine("  LINKS", "dim");
      consoleLine("  LIST INBOUND | LIST OUTBOUND | LIST DOCKED", "dim");
      consoleLine("  DETAIL <ID>", "dim");
      consoleLine("  NOTE <ID> <TEXT>", "dim");
      consoleLine("  APPROVE <ID> | HOLD <ID> | DENY <ID>", "dim");
      consoleLine("  QUERY <ID>", "dim");
      consoleLine("  MANIFEST <ID> (MFST)      - Display crew roster for ship", "dim");
      consoleLine("  DECON START <ID>", "dim");
      consoleLine("  REALIGN | RESYNC | PURGE (costs 10 FUEL) | SCAN", "dim");
      if (!runtime.multiplayer.coop.enabled) {
        consoleLine("  BREAK <MINUTES>           - Take paid break (25 CR/MIN)", "dim");
      }
      consoleLine("  REPAIR <SYSTEM>           - Quick repair DEGRADED system (30% fail, rarely OFFLINE)", "dim");
      consoleLine("  WORKORDER <SYSTEM>", "dim");
      consoleLine("  RELAYS | PING <RELAY-ID> | PING GATE <GATE-ID> | ACK <RELAY-ID> | RESTORE <RELAY-ID>", "dim");
      consoleLine("  PACKETS", "dim");
      consoleLine("  ORDER <AMOUNT> FUEL | ORDER <AMOUNT> SUPPLY", "dim");
      consoleLine("  PURCHASE RELAY | PURCHASE DOCK - Buy additional relays/docking slots (costs CR + SUPPLY)", "dim");
      consoleLine("  VOTE YES | VOTE NO | VOTE ABSTAIN - Vote on co-op purchase proposals", "dim");
      consoleLine("  CANCEL VOTE               - Cancel active vote (initiator/host only)", "dim");
      consoleLine("  CALLSIGN <NAME> | CALLSIGN CLEAR", "dim");
      consoleLine("  SFX ON|OFF|TOGGLE", "dim");
      consoleLine("  MUSIC ON|OFF|TOGGLE", "dim");
      consoleLine("  VFX REG|LOW|TOGGLE", "dim");
      const baseThemeHelp = [...THEME_OPTIONS, "sunset"].map(id => getThemeDisplayName(id)).join("|");
      consoleLine(`  THEME ${baseThemeHelp}`, "dim");
      consoleLine("  CODE - USE WITH ACCESS CODE", "dim");
      consoleLine("  ZOOM UP | ZOOM DOWN | ZOOM RESET | ZOOM <50-200>%", "dim");
      consoleLine("  CLEAR", "dim");
    }

    function cmdDocks() {
      const g = activeGate();
      consoleLine("DOCKING SLOTS", "dim");

      for (const slot of g.dockSlots) {
        let line = `  ${slot.id.padEnd(8)} STATE: ${slot.state.padEnd(12)}`;

        // Find ship occupying this slot
        if (slot.shipId) {
          const ship = findShipById(g, slot.shipId);
          if (ship) {
            line += ` SHIP: ${ship.id}`;
          } else {
            line += ` SHIP: ${slot.shipId}`;
          }
        } else if (slot.state !== "EMPTY" && slot.state !== "ASSEMBLING") {
          // Slot has a state but no shipId - shouldn't happen, but handle it
          line += ` SHIP: NONE`;
        }

        // Color code by state
        let style = "dim";
        if (slot.state === "DECON" || slot.state === "SERVICING") {
          style = "warn";
        } else if (slot.state === "ASSEMBLING") {
          style = "dim";
        } else if (slot.state === "EMPTY") {
          style = "good";
        }

        consoleLine(line, style);
      }

      // Show count and purchased info
      const totalSlots = g.dockSlots.length;
      const purchasedSlots = g.docksPurchased || 0;
      const emptySlots = g.dockSlots.filter(s => s.state === "EMPTY").length;

      consoleLine("", "dim");
      consoleLine(`TOTAL: ${totalSlots}  PURCHASED: ${purchasedSlots}  AVAILABLE: ${emptySlots}`, "dim");
    }

    function cmdStatus() {
      const g = activeGate();
      consoleLine(`NODE: ${g.id}`, "dim");
      consoleLine(`HEALTH: ${g.health}`, "dim");
      consoleLine(`BEACON: ${g.beacon}`, g.beacon === "ONLINE" ? "good" : "bad");
      consoleLine(`ALIGN: ${g.alignment}`, g.alignment === "OUT OF TOLERANCE" ? "bad" : (g.alignment === "DRIFTING" ? "warn" : "dim"));
      consoleLine(`SYNC: ${g.sync}`, g.sync === "FAULT" ? "bad" : "dim");
      consoleLine(`LINKS: ${g.corridors.map(c => `${c.link}:${c.status}`).join("  ")}`, "dim");
      consoleLine(`CONCOURSE: ${concourseBand(g.concourseLevel || 0).text}`, "dim");
      consoleLine(`DOCKS: ${g.dockSlots.map(s => `${s.id}:${s.state}`).join("  ")}`, "dim");
      consoleLine(`FACILITY: ${g.facility.map(f => `${f.id}:${f.status}`).join("  ")}`, "dim");
      const resources = ensureResources(g);
      for (const r of RESOURCE_TYPES) {
        const res = resources[r.id];
        const stage = res.order ? ` (${res.order.stage})` : "";
        consoleLine(`RESOURCE: ${r.id} ${Math.round(res.level)}%${stage}`, res.level <= RESOURCE_ORDER_THRESHOLD ? "warn" : "dim");
      }
      const alerts = computeAlerts(g);
      consoleLine(`ALERTS: ${alerts.length ? alerts.join(" / ") : "NONE"}`, alerts.length ? "warn" : "good");
    }

    function cmdLinks() {
      const g = activeGate();
      consoleLine("CORRIDOR LINKS", "dim");
      for (const c of g.corridors) {
        const age = Math.floor((Date.now() - (c.lastChange || Date.now())) / 1000);
        consoleLine(`  ${c.link}  ${c.status}  (age ${formatMMSS(age)})`, c.status === "STABLE" ? "good" : (c.status === "OFFLINE" ? "bad" : "warn"));
      }
    }

    function cmdSysReport() {
      const g = activeGate();

      // Initial loading message
      consoleLine("INITIATING SYSTEM DIAGNOSTIC...", "dim");

      // Show loading animation
      setTimeout(() => {
        consoleLine("...", "dim");

        // Build the report lines
        setTimeout(() => {
          const lines = [];

          // Header
          lines.push({ text: "GATE CONTROL TERMINAL - SYSTEM REPORT", cls: "dim" });
          lines.push({ text: `NODE: ${g.id}`, cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          // CORE SYSTEMS
          lines.push({ text: "CORE SYSTEMS:", cls: "dim" });

          // Beacon
          const beaconCls = g.beacon === "ONLINE" ? "good" : (g.beacon === "FAULT" ? "warn" : "bad");
          lines.push({ text: `  BEACON AMPLIFIER           ${g.beacon.padEnd(20)}`, cls: beaconCls });

          // Alignment
          const alignCls = g.alignment === "WITHIN TOLERANCE" ? "good" : (g.alignment === "DRIFTING" ? "warn" : "bad");
          lines.push({ text: `  ALIGNMENT MATRIX           ${g.alignment.padEnd(20)}`, cls: alignCls });

          // Sync
          const syncCls = g.sync === "SYNC" ? "good" : (g.sync === "ASYNC" ? "warn" : "bad");
          lines.push({ text: `  SYNC CONTROLLER            ${g.sync.padEnd(20)}`, cls: syncCls });

          lines.push({ text: "", cls: "dim" });

          // CORRIDOR LINKS
          lines.push({ text: "CORRIDOR LINKS:", cls: "dim" });
          for (const c of g.corridors || []) {
            const linkCls = c.status === "STABLE" ? "good" : (c.status === "OFFLINE" ? "bad" : "warn");
            const dest = c.link.split("→")[1] || c.link.split(":")[1] || "UNKNOWN";
            lines.push({ text: `  ${c.link.padEnd(25)} ${c.status.padEnd(20)}`, cls: linkCls });
          }

          lines.push({ text: "", cls: "dim" });

          // FACILITY SYSTEMS
          lines.push({ text: "FACILITY SYSTEMS:", cls: "dim" });
          for (const f of g.facility || []) {
            const facCls = f.status === "ONLINE" ? "good" : (f.status === "OFFLINE" ? "bad" : "warn");
            const sysInfo = FACILITY_SYSTEMS.find(fs => fs.id === f.id);
            const name = sysInfo ? sysInfo.name : f.id;
            lines.push({ text: `  ${name.padEnd(25)} ${f.status.padEnd(20)}`, cls: facCls });
          }

          lines.push({ text: "", cls: "dim" });

          // RELAY NETWORK
          const relays = g.relays || [];
          lines.push({ text: `RELAY NETWORK: (${relays.length} NODES)`, cls: "dim" });
          for (const r of relays) {
            const displayStatus = relayDisplayStatus(r);
            const relayCls = displayStatus === "ONLINE" ? "good" : (displayStatus === "OFFLINE" || displayStatus === "FAULT" ? "bad" : "warn");
            lines.push({ text: `  ${r.id.padEnd(25)} ${displayStatus.padEnd(20)}`, cls: relayCls });
          }

          lines.push({ text: "", cls: "dim" });

          // RESOURCES
          lines.push({ text: "RESOURCES:", cls: "dim" });
          const resources = ensureResources(g);
          for (const r of RESOURCE_TYPES) {
            const res = resources[r.id];
            const level = Math.round(res.level);
            const capacity = res.capacity || 100;
            const amount = Math.round((level / 100) * capacity);
            const percentage = `${level}%`;
            const resCls = level <= RESOURCE_ORDER_THRESHOLD ? "warn" : (level >= 75 ? "good" : "dim");
            lines.push({ text: `  ${r.name}: ${amount}/${capacity}  (${percentage})`, cls: resCls });
          }

          lines.push({ text: "", cls: "dim" });

          // WORK ORDERS
          const workOrders = g.workOrders || [];
          const activeWorkOrders = workOrders.filter(w => w.phaseEndsAt > Date.now());
          if (activeWorkOrders.length > 0) {
            lines.push({ text: "ACTIVE WORK ORDERS:", cls: "dim" });
            for (const w of activeWorkOrders) {
              const remaining = Math.max(0, w.phaseEndsAt - Date.now());
              const timeStr = formatMMSS(remaining / 1000);
              lines.push({ text: `  ${w.systemName.padEnd(25)} ${timeStr.padEnd(20)}`, cls: "warn" });
            }
            lines.push({ text: "", cls: "dim" });
          }

          // UPGRADES
          const upgrades = ensureUpgrades(g);
          const activeUpgrades = [];
          if (upgrades.reactorUpgrading) {
            const remaining = Math.max(0, upgrades.reactorUpgradeCompletesAt - Date.now());
            activeUpgrades.push({ name: "REACTOR UPGRADE", remaining });
          }
          if (upgrades.maintenanceUpgrading) {
            const remaining = Math.max(0, upgrades.maintenanceUpgradeCompletesAt - Date.now());
            activeUpgrades.push({ name: "MAINTENANCE UPGRADE", remaining });
          }
          if (activeUpgrades.length > 0) {
            lines.push({ text: "ACTIVE UPGRADES:", cls: "dim" });
            for (const u of activeUpgrades) {
              const timeStr = formatMMSS(u.remaining / 1000);
              lines.push({ text: `  ${u.name.padEnd(25)} ${timeStr.padEnd(20)}`, cls: "good" });
            }
            lines.push({ text: "", cls: "dim" });
          }

          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // GATE STATUS PERCENTAGE
          const gateStatus = calculateGateStatus(g);
          const statusCls = gateStatus >= 80 ? "good" : (gateStatus >= 50 ? "warn" : "bad");
          lines.push({ text: `GATE STATUS: ${gateStatus}%`, cls: statusCls });

          // Status descriptor
          let descriptor;
          if (gateStatus >= 90) {
            descriptor = "ALL SYSTEMS NOMINAL";
          } else if (gateStatus >= 75) {
            descriptor = "OPERATING WITHIN ACCEPTABLE PARAMETERS";
          } else if (gateStatus >= 60) {
            descriptor = "DEGRADED PERFORMANCE - MAINTENANCE ADVISED";
          } else if (gateStatus >= 40) {
            descriptor = "CRITICAL SYSTEMS COMPROMISED - IMMEDIATE ACTION REQUIRED";
          } else if (gateStatus >= 20) {
            descriptor = "CATASTROPHIC FAILURE IMMINENT - EMERGENCY PROTOCOLS ACTIVE";
          } else {
            descriptor = "TERMINAL COLLAPSE - EVACUATION RECOMMENDED";
          }

          lines.push({ text: `  ${descriptor}`, cls: statusCls });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Print with animation
          consoleLineDelayed(lines);
        }, 600);
      }, 100);
    }

    function cmdShift() {
      const g = activeGate();

      // Initial loading message
      consoleLine("RETRIEVING SHIFT RECORDS...", "dim");

      // Show loading animation
      setTimeout(() => {
        consoleLine("...", "dim");

        // Build the shift report
        setTimeout(() => {
          const lines = [];

          // Get shift data
          const shiftElapsedMs = getShiftMs();
          const shiftElapsedSec = Math.floor(shiftElapsedMs / 1000);

          // Get shift duration (handle both co-op and regular gates)
          let shiftDurationMs = runtime.shiftDurationMs || loadShiftDuration();
          if (shiftDurationMs === null || shiftDurationMs === undefined) {
            shiftDurationMs = -1; // Unlimited mode
          }

          // Calculate shift percentage
          let shiftPercentage = 0;
          let shiftDurationDisplay = "UNLIMITED";
          if (shiftDurationMs > 0) {
            shiftPercentage = Math.min(100, Math.floor((shiftElapsedMs / shiftDurationMs) * 100));
            const shiftDurationSec = Math.floor(shiftDurationMs / 1000);
            shiftDurationDisplay = formatMMSS(shiftDurationSec);
          } else {
            shiftPercentage = 0;
            shiftDurationDisplay = "UNLIMITED";
          }

          // Calculate wage and score
          const wage = computeWage(g.stats, shiftElapsedMs);
          const mode = g.mode || "normal";
          const score = computeScore(g.stats, shiftElapsedMs, wage, mode);

          // Format dates (month/day hour:minute, no year)
          const formatDateTime = (timestamp) => {
            const date = new Date(timestamp);
            const month = pad2(date.getMonth() + 1);
            const day = pad2(date.getDate());
            const hour = pad2(date.getHours());
            const minute = pad2(date.getMinutes());
            return `${month}/${day} ${hour}:${minute}`;
          };

          const shiftStartTime = formatDateTime(runtime.shiftStart);
          const sessionStartTime = formatDateTime(runtime.sessionStart);

          // Header
          lines.push({ text: "OPERATOR SHIFT REPORT", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          // Gate and operator info
          lines.push({ text: `GATE-ID:          ${g.id}`, cls: "dim" });
          lines.push({ text: `OPERATOR:         ${runtime.operatorCallsign || "UNKNOWN"}`, cls: "dim" });

          // Co-op indicator
          if (runtime.multiplayer.coop.enabled) {
            const coopRole = runtime.multiplayer.coop.role === "host" ? "HOST" : "INVITED";
            const coopSession = runtime.multiplayer.coop.sessionId || "UNKNOWN";
            lines.push({ text: `CO-OP MODE:       ${coopRole} (${coopSession})`, cls: "warn" });
          }

          lines.push({ text: "", cls: "dim" });

          // Shift timing
          lines.push({ text: "SHIFT TIMING:", cls: "dim" });
          lines.push({ text: `  DURATION:       ${shiftDurationDisplay}`, cls: "dim" });
          lines.push({ text: `  ELAPSED:        ${formatMMSS(shiftElapsedSec)}`, cls: "dim" });

          // Shift percentage with visual indicator
          const percentCls = shiftPercentage >= 90 ? "warn" : (shiftPercentage >= 75 ? "dim" : "good");
          let percentBar = "";
          if (shiftDurationMs > 0) {
            const barLength = 20;
            const filled = Math.floor((shiftPercentage / 100) * barLength);
            percentBar = "[" + "█".repeat(filled) + "░".repeat(barLength - filled) + "]";
            lines.push({ text: `  PROGRESS:       ${shiftPercentage}% ${percentBar}`, cls: percentCls });
          } else {
            lines.push({ text: `  PROGRESS:       N/A (UNLIMITED MODE)`, cls: "dim" });
          }

          lines.push({ text: "", cls: "dim" });

          // Performance metrics
          lines.push({ text: "PERFORMANCE:", cls: "dim" });
          lines.push({ text: `  WAGE:           ${wage} CR`, cls: "good" });
          lines.push({ text: `  SCORE:          ${score}`, cls: "good" });

          lines.push({ text: "", cls: "dim" });

          // Timestamp info
          lines.push({ text: "TIMESTAMPS:", cls: "dim" });
          lines.push({ text: `  SHIFT START:    ${shiftStartTime}`, cls: "dim" });
          lines.push({ text: `  SESSION START:  ${sessionStartTime}`, cls: "dim" });

          lines.push({ text: "", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Status message based on shift progress
          let statusMsg = "";
          if (shiftDurationMs > 0) {
            if (shiftPercentage >= 95) {
              statusMsg = "SHIFT NEARING COMPLETION - FINAL MINUTES";
            } else if (shiftPercentage >= 75) {
              statusMsg = "SHIFT IN FINAL QUARTER";
            } else if (shiftPercentage >= 50) {
              statusMsg = "SHIFT HALF COMPLETE";
            } else if (shiftPercentage >= 25) {
              statusMsg = "SHIFT IN PROGRESS - FIRST QUARTER COMPLETE";
            } else {
              statusMsg = "SHIFT COMMENCED - RECORDING ACTIVE";
            }
          } else {
            statusMsg = "UNLIMITED SHIFT MODE - NO TIME CONSTRAINTS";
          }

          lines.push({ text: statusMsg, cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Print with animation
          consoleLineDelayed(lines);
        }, 600);
      }, 100);
    }

    function cmdManifest(id) {
      const g = activeGate();
      const shipId = String(id || "").toUpperCase();

      const s = findShipById(g, shipId);
      if (!s) {
        consoleLine(`NOT FOUND: ${shipId}`, "bad");
        playSfx("error");
        return;
      }

      // Check if ship has crew
      if (!s.crew || s.crew.length === 0) {
        consoleLine(`NO CREW DATA: ${shipId}`, "warn");
        playSfx("error");
        return;
      }

      // Check if crew has been revealed
      const isPirateRaider = s.crew && s.crew.length > 0 && s.crew[0].name === "UNKNOWN";
      const isSignalMasked = s.obscured && s.infoMasked;
      if (!isSignalMasked && s.crewUnknown && !s.crewRevealed && !isPirateRaider) {
        consoleLine(`CREW DATA UNAVAILABLE: ${shipId} - QUERY REQUIRED`, "warn");
        playSfx("error");
        return;
      }

      // Initial loading message
      consoleLine("ACCESSING CREW MANIFEST DATABASE...", "dim");

      // Show loading animation
      setTimeout(() => {
        consoleLine("...", "dim");

        // Build the manifest
        setTimeout(() => {
          const lines = [];

          // Header
          lines.push({ text: "CREW MANIFEST", cls: "dim" });
          lines.push({ text: `VESSEL: ${s.id}`, cls: "dim" });
          lines.push({ text: `TYPE: ${s.type}`, cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          // Check if crew is UNKNOWN (pirates/raiders)
          if (isSignalMasked) {
            lines.push({ text: "CREW ROSTER:", cls: "dim" });
            lines.push({ text: "  [SIGNAL MASKED - IDENTITIES OBFUSCATED]", cls: "warn" });
            for (let i = 0; i < s.crew.length; i++) {
              const member = s.crew[i];
              const namePadded = maskCrewName(member.name).padEnd(25);
              const rolePadded = maskCrewName(member.role || "Unknown");
              lines.push({ text: `  ${(i + 1).toString().padStart(2, "0")}. ${namePadded} ${rolePadded}`, cls: "dim" });
            }
          } else if (isPirateRaider) {
            lines.push({ text: "CREW ROSTER:", cls: "dim" });
            lines.push({ text: "  [DATA CORRUPTED - IDENTITIES MASKED]", cls: "warn" });
            for (let i = 0; i < s.crew.length; i++) {
              lines.push({ text: `  ${(i + 1).toString().padStart(2, "0")}. UNKNOWN              [UNIDENTIFIED]`, cls: "bad" });
            }
          } else {
            // Check if ship has unrevealed Vacuum Bloom hazard
            const hasUnrevealedVacuumBloom = (s.effects || []).some(e =>
              e.name === "VACUUM BLOOM" && e.hidden && !e.revealed
            );

            lines.push({ text: "CREW ROSTER:", cls: "dim" });
            for (let i = 0; i < s.crew.length; i++) {
              const member = s.crew[i];
              const namePadded = member.name.padEnd(25);
              const rolePadded = member.role || "Unknown";

              // Only show deceased status if Vacuum Bloom hazard is revealed
              if (member.deceased && !hasUnrevealedVacuumBloom) {
                lines.push({ text: `  ${(i + 1).toString().padStart(2, "0")}. ${namePadded} [DECEASED] ${rolePadded}`, cls: "bad" });
              } else {
                lines.push({ text: `  ${(i + 1).toString().padStart(2, "0")}. ${namePadded} ${rolePadded}`, cls: "dim" });
              }
            }
          }

          lines.push({ text: "", cls: "dim" });

          // Summary
          // Check if ship has unrevealed Vacuum Bloom hazard
          const hasUnrevealedVacuumBloom = (s.effects || []).some(e =>
            e.name === "VACUUM BLOOM" && e.hidden && !e.revealed
          );

          const totalCrew = s.crew.length;
          // Only count deceased if Vacuum Bloom hazard is revealed
          const deceasedCount = hasUnrevealedVacuumBloom ? 0 : s.crew.filter(c => c.deceased).length;
          const activeCrew = totalCrew - deceasedCount;

          if (deceasedCount > 0) {
            lines.push({ text: `CREW STATUS: ${activeCrew}/${totalCrew} ACTIVE`, cls: "warn" });
            lines.push({ text: `  ${deceasedCount} DECEASED - MEDICAL ATTENTION REQUIRED`, cls: "bad" });
          } else {
            lines.push({ text: `CREW STATUS: ${totalCrew}/${totalCrew} ACTIVE`, cls: "good" });
          }

          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Print with animation
          consoleLineDelayed(lines);
        }, 600);
      }, 100);
    }

    function cmdDetail(id, opts) {
      const g = activeGate();
      const shipId = String(id || "").toUpperCase();
      const options = (typeof opts === "object" && opts) ? opts : { log: opts !== false };
      const log = options.log !== false;
      const context = options.context || "queue"; // Default to "queue" for backward compatibility

      const s = findShipById(g, shipId);
      if (!s) {
        if (log) consoleLine(`NOT FOUND: ${shipId}`, "bad");
        playSfx("error");
        return;
      }

      // Toggle inline detail panel (DTL button only, not DETAIL command)
      if (!log) {
        const contextualId = `${context}:${s.id}`;
        runtime.inlineDetailId = (runtime.inlineDetailId === contextualId) ? null : contextualId;
        renderAll();
        return;
      }

      if (s.obscured) {
        consoleLine("ACCESSING VESSEL INFORMATION...", "dim");
        setTimeout(() => {
          consoleLine("...", "dim");
          setTimeout(() => {
            const lines = [];
            lines.push({ text: `DETAIL REFUSED: ${s.id}`, cls: "warn" });
            lines.push({ text: "SIGNAL MASKED / IDENTITY UNVERIFIED", cls: "warn" });
            consoleLineDelayed(lines);
          }, 300);
        }, 200);
        return;
      }

      // Initial loading message
      consoleLine("ACCESSING VESSEL INFORMATION...", "dim");

      // Show loading animation
      setTimeout(() => {
        consoleLine("...", "dim");

        // Build the detail report
        setTimeout(() => {
          const lines = [];

          // Header
          lines.push({ text: `VESSEL DIAGNOSTIC - ${s.id}`, cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });
          lines.push({ text: "", cls: "dim" });

          // VESSEL IDENTIFICATION
          lines.push({ text: "VESSEL IDENTIFICATION:", cls: "dim" });
          lines.push({ text: `  ID:             ${s.id}`, cls: "dim" });
          lines.push({ text: `  TYPE:           ${shipDisplayType(s)}`, cls: "dim" });
          const cargoDisplay = shipDisplayCargo(s);
          const cargoCls = shipCargoIsIllegalVisible(s) ? "warn" : (shipCargoUnknown(s) ? "warn" : "dim");
          lines.push({ text: `  CARGO:          ${cargoDisplay}`, cls: cargoCls });

          const displayTransponder = shipDisplayTransponder(s);
          const transponderCls = displayTransponder === "VALID" ? "good" : "warn";
          lines.push({ text: `  TRANSPONDER:    ${displayTransponder}`, cls: transponderCls });

          lines.push({ text: "", cls: "dim" });

          // TRAFFIC STATUS
          lines.push({ text: "TRAFFIC STATUS:", cls: "dim" });
          lines.push({ text: `  DIRECTION:      ${s.dir}`, cls: "dim" });
          lines.push({ text: `  REQUEST:        ${shipDisplayRequest(s)}`, cls: "dim" });

          const stateCls = ["DENIED","DECON"].includes(s.state) ? "warn" :
                          ["DEPARTED","COMPLETE"].includes(s.state) ? "good" : "dim";
          lines.push({ text: `  STATE:          ${s.state}`, cls: stateCls });

          const etaFrozen = ["DENIED","ARRIVED","DEPARTED","WAITING TO DOCK","WAITING DECON","DECON","SERVICING","CLEARING","COMPLETE"].includes(s.state);
          const etaDisplay = etaFrozen ? "--:--" : (s.etaUnknown ? "??:??" : formatMMSS(s.eta));
          const etaCls = s.etaUnknown ? "warn" : "dim";
          lines.push({ text: `  ETA:            ${etaDisplay}`, cls: etaCls });

          const prioDisplay = shipDisplayPriority(s);
          const prioText = prioDisplay === null ? "???" : (prioDisplay ? "CRITICAL" : "STANDARD");
          const prioCls = prioDisplay === true ? "warn" : "dim";
          lines.push({ text: `  PRIORITY:       ${prioText}`, cls: prioCls });

          lines.push({ text: "", cls: "dim" });

          // DOCKING INFORMATION
          if (s.slotId || s.dockState) {
            lines.push({ text: "DOCKING INFORMATION:", cls: "dim" });
            if (s.slotId) {
              lines.push({ text: `  SLOT:           ${s.slotId}`, cls: "dim" });
            }
            if (s.dockState) {
              const dockStateCls = s.dockState.includes("COMPLETE") ? "good" : "dim";
              lines.push({ text: `  DOCK STATUS:    ${s.dockState}`, cls: dockStateCls });
            }
            lines.push({ text: "", cls: "dim" });
          }

          // DECONTAMINATION
          const deconTime = deconCountdown(s);
          if (deconTime) {
            lines.push({ text: "DECONTAMINATION:", cls: "warn" });
            lines.push({ text: `  TIME REMAINING: ${deconTime}`, cls: "warn" });
            lines.push({ text: "", cls: "dim" });
          }

          // ADDITIONAL INFORMATION
          lines.push({ text: "ADDITIONAL INFORMATION:", cls: "dim" });

          if (s.reason) {
            lines.push({ text: `  REASON:         ${s.reason}`, cls: "dim" });
          }

          const visibleEffects = (s.effects || []).filter(e => !e.hidden || e.revealed).map(e => e.name);
          if (visibleEffects.length) {
            const effectLine = visibleEffects.join(" / ");
            lines.push({ text: `  EFFECTS:        ${effectLine}`, cls: "warn" });
          } else {
            lines.push({ text: `  EFFECTS:        NONE`, cls: "dim" });
          }

          if (s.notes) {
            lines.push({ text: `  NOTES:          ${s.notes}`, cls: "dim" });
          }

          lines.push({ text: "", cls: "dim" });
          lines.push({ text: "═══════════════════════════════════════════════════════", cls: "dim" });

          // Print with animation
          consoleLineDelayed(lines);
        }, 500);
      }, 300);
    }

    // ===== GATE DETAIL FUNCTIONS =====

    function computeGateStatus(player) {
      const gateState = runtime.multiplayer.gateStates.get(player.gateId);

      if (!gateState) return "UNKNOWN";

      // Check connection state
      if (gateState.status === "SEVERING" || gateState.status === "DISCONNECTING") {
        return "CRITICAL";
      }

      if (gateState.status === "CONNECTED") {
        return "OPERATIONAL";
      }

      return "UNKNOWN";
    }

    function gateDetailKVHtml(player, isCoopGate) {
      const shiftMs = Date.now() - player.shiftStart;
      const shiftElapsed = formatHMS(shiftMs);
      const shiftMode = (typeof player.shiftMode === "string" && player.shiftMode) ||
        (typeof player.mode === "string" && player.mode) ||
        "normal";
      const shiftDurationMs = Number.isFinite(player.shiftDurationMs)
        ? player.shiftDurationMs
        : (Number.isFinite(player.shiftDuration) ? player.shiftDuration : (8 * 60 * 60 * 1000)); // Default to 8 hours

      // Determine shift duration display
      let shiftDuration;
      if (shiftMode === "unlimited" || shiftDurationMs === -1) {
        shiftDuration = "UNLIMITED";
      } else if (shiftMode === "endurance") {
        shiftDuration = "ENDURANCE";
      } else {
        shiftDuration = formatHMS(shiftDurationMs);
      }

      // Calculate percentage only for normal mode
      let elapsedDisplay;
      if (shiftMode === "unlimited" || shiftMode === "endurance" || shiftDurationMs === -1) {
        elapsedDisplay = shiftElapsed;
      } else {
        const shiftPercentage = Math.min(100, Math.floor((shiftMs / shiftDurationMs) * 100));
        elapsedDisplay = `${shiftElapsed} (${shiftPercentage}%)`;
      }

      const wage = computeWage(player.stats || {}, shiftMs);
      const score = computeScore(player.stats || {}, shiftMs, wage, shiftMode);
      const status = computeGateStatus(player);

      const rows = [
        ["GATE-ID", player.gateId],
        ["OPERATOR", player.operatorCallsign || "UNKNOWN"],
      ];

      // Add crew information for co-op gates
      if (isCoopGate && runtime.multiplayer.coop.enabled) {
        const participants = runtime.multiplayer.coop.participants || [];
        const operators = participants
          .map(p => p.operatorCallsign)
          .filter(c => c && c !== "OPERATOR")
          .join(", ");
        rows.push(["CREW", "MULTI-PERSONNEL CREW"]);
        rows.push(["CREW OPERATORS", operators || "NONE"]);
      }

      rows.push(
        ["SHIFT DURATION", shiftDuration],
        ["SHIFT ELAPSED", elapsedDisplay],
        ["WAGE", `${wage} credits`],
        ["SCORE", score],
        ["STATUS", status]
      );

      return rows.map(([k, v]) => `<div class="k">${escapeText(k)}</div><div class="v">${escapeText(String(v))}</div>`).join("");
    }

    function gateInlineDetailPanel(player, isCoopGate) {
      return `
        <div class="inline-detail">
          <div class="inline-detail-head">
            <div>
              <div class="inline-detail-title">GATE DETAIL: ${escapeText(player.gateId)}</div>
            </div>
            <button class="btn-mini hold" data-action="detail-gate" data-gate="${escapeText(player.gateId)}">CLOSE</button>
          </div>
          <div class="kv">${gateDetailKVHtml(player, isCoopGate)}</div>
        </div>
      `;
    }

    function gateDetailRow(player, isCoopGate) {
      return `
        <div class="status-row gate-detail-row">
          <div style="grid-column: 1 / -1;">
            ${gateInlineDetailPanel(player, isCoopGate)}
          </div>
        </div>
      `;
    }

    function cmdDetailGate(gateId, opts) {
      const options = (typeof opts === "object" && opts) ? opts : { log: opts !== false };
      const log = options.log !== false;

      // Find player by gateId
      const player = (runtime.multiplayer.players || []).find(p => p.gateId === gateId);

      if (!player) {
        if (log) consoleLine(`GATE NOT FOUND: ${gateId}`, "bad");
        playSfx("error");
        return;
      }

      // Toggle inline detail panel
      runtime.inlineGateDetailId = (runtime.inlineGateDetailId === gateId) ? null : gateId;
      renderAll();

      if (!log) return;

      // Console output
      const shiftMs = Date.now() - player.shiftStart;
      const shiftElapsed = formatHMS(shiftMs);
      const shiftMode = (typeof player.shiftMode === "string" && player.shiftMode) ||
        (typeof player.mode === "string" && player.mode) ||
        "normal";
      const shiftDurationMs = Number.isFinite(player.shiftDurationMs)
        ? player.shiftDurationMs
        : (Number.isFinite(player.shiftDuration) ? player.shiftDuration : (8 * 60 * 60 * 1000)); // Default to 8 hours

      // Determine shift duration display
      let shiftDuration;
      if (shiftMode === "unlimited" || shiftDurationMs === -1) {
        shiftDuration = "UNLIMITED";
      } else if (shiftMode === "endurance") {
        shiftDuration = "ENDURANCE";
      } else {
        shiftDuration = formatHMS(shiftDurationMs);
      }

      // Calculate percentage only for normal mode
      let elapsedDisplay;
      if (shiftMode === "unlimited" || shiftMode === "endurance" || shiftDurationMs === -1) {
        elapsedDisplay = shiftElapsed;
      } else {
        const shiftPercentage = Math.min(100, Math.floor((shiftMs / shiftDurationMs) * 100));
        elapsedDisplay = `${shiftElapsed} (${shiftPercentage}%)`;
      }

      const wage = computeWage(player.stats || {}, shiftMs);
      const score = computeScore(player.stats || {}, shiftMs, wage, shiftMode);
      const status = computeGateStatus(player);

      consoleLine(`DETAIL: ${gateId}`, "dim");
      consoleLine(`  GATE-ID: ${gateId}`, "dim");
      consoleLine(`  OPERATOR: ${player.operatorCallsign || "UNKNOWN"}`, "dim");
      consoleLine(`  SHIFT DURATION: ${shiftDuration}`, "dim");
      consoleLine(`  SHIFT ELAPSED: ${elapsedDisplay}`, "dim");
      consoleLine(`  WAGE: ${wage} credits`, "dim");
      consoleLine(`  SCORE: ${score}`, "dim");
      consoleLine(`  STATUS: ${status}`, status === "OPERATIONAL" ? "good" : (status === "CRITICAL" ? "bad" : "warn"));
    }


    function cmdNote(id, note) {
      const g = activeGate();
      const s = findShipById(g, id);
      if (!s) { consoleLine(`NOT FOUND: ${id}`, "bad"); return; }
      s.notes = (note || "").slice(0, 120);
      consoleLine(`NOTE SET: ${id}`, "dim");
      g.lastRefresh = Date.now();
    }

    function runCommand(lineRaw) {
      const line = lineRaw.trim();
      if (!line) return;

      consoleLine(`${runtime.activeGateId}> ${line}`, "dim");

      const parts = line.split(/\s+/);
      const cmd = parts[0].toUpperCase();

      // Handle pending confirmation (for PURGE command)
      if (runtime.pendingConfirmation) {
        const answer = cmd;
        const pending = runtime.pendingConfirmation;
        runtime.pendingConfirmation = null;

        if (answer === "Y" || answer === "YES") {
          if (pending.type === "purge") {
            queueMaintenance("purge", ui.btnPurge, { showConsole: true, skipFuelCheck: true });
          } else if (pending.type === "stresstest") {
            queueMaintenance("stresstest", ui.btnStresstest, { showConsole: true });
          } else if (pending.type === "break") {
            startBreak(pending.minutes);
          } else if (pending.type === "purchase-relay") {
            const g = activeGate();
            const result = purchaseRelay(g);
            if (result.allowed) {
              consoleLine(`RELAY PURCHASED: ${result.relayId} (-${result.cost.credits} CR, -${result.cost.supply}% SUPPLY)`, "good");
              playSfx("click");
              g.lastRefresh = Date.now();
              renderAll();
            } else {
              consoleLine("PURCHASE FAILED", "bad");
              playSfx("error");
            }
          } else if (pending.type === "purchase-dock") {
            const g = activeGate();
            const result = purchaseDock(g);
            if (result.allowed) {
              consoleLine(`DOCK SLOT PURCHASED: ${result.dockId} (-${result.cost.credits} CR, -${result.cost.supply}% SUPPLY)`, "good");
              playSfx("click");
              g.lastRefresh = Date.now();
              renderAll();
            } else {
              consoleLine("PURCHASE FAILED", "bad");
              playSfx("error");
            }
          }
          return;
        } else if (answer === "N" || answer === "NO") {
          if (pending.type === "purge") {
            consoleLine("PURGE CANCELLED", "dim");
          } else if (pending.type === "stresstest") {
            consoleLine("STRESS TEST CANCELLED", "dim");
          } else if (pending.type === "break") {
            consoleLine("BREAK CANCELLED", "dim");
          } else if (pending.type === "purchase-relay") {
            consoleLine("RELAY PURCHASE CANCELLED", "dim");
          } else if (pending.type === "purchase-dock") {
            consoleLine("DOCK PURCHASE CANCELLED", "dim");
          }
          return;
        } else {
          consoleLine(`INVALID RESPONSE. ${pending.type === "break" ? "BREAK" : pending.type === "purge" ? "PURGE" : "PURCHASE"} CANCELLED`, "warn");
          return;
        }
      }

      if (cmd === "HELP" || cmd === "?") return cmdHelp();
      if (cmd === "STATUS") return cmdStatus();
      if (cmd === "DOCKS") return cmdDocks();
      if (cmd === "SYSREPORT" || cmd === "SYS") return cmdSysReport();
      if (cmd === "SHIFT") return cmdShift();
      if (cmd === "LINKS") return cmdLinks();

      if (cmd === "LIST") {
        const arg1 = (parts[1] || "").toUpperCase();
        if (arg1 === "INBOUND" || arg1 === "IN") return listShips("IN");
        if (arg1 === "OUTBOUND" || arg1 === "OUT") return listShips("OUT");
        if (arg1 === "DOCKED") return listDockedShips();
        consoleLine("USAGE: LIST INBOUND | LIST OUTBOUND | LIST DOCKED", "warn");
        return;
      }

      if (cmd === "DETAIL" || cmd === "DTL") {
        const id = (parts[1] || "").toUpperCase();
        if (!id) return consoleLine("USAGE: DETAIL <ID>", "warn");

        // Try ship first
        const g = activeGate();
        const s = findShipById(g, id);
        if (s) return cmdDetail(id);

        // Try gate
        const player = (runtime.multiplayer.players || []).find(p => p.gateId === id);
        if (player) return cmdDetailGate(id);

        // Not found
        consoleLine(`NOT FOUND: ${id}`, "bad");
        playSfx("error");
        return;
      }

      if (cmd === "QUERY" || cmd === "QRY") {
        const id = (parts[1] || "").toUpperCase();
        if (!id) return consoleLine("USAGE: QUERY <ID>", "warn");

        // If invited co-op player, send command to host
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `QUERY ${id}` });
          consoleLine(`> QUERY ${id}`, "dim");
          playSfx("click");
          return;
        }

        const g = activeGate();
        const s = findShipById(g, id);
        if (!s) return consoleLine(`NOT FOUND: ${id}`, "bad");
        return queueQuery(g, s);
      }

      if (cmd === "MANIFEST" || cmd === "MFST") {
        const id = (parts[1] || "").toUpperCase();
        if (!id) return consoleLine("USAGE: MANIFEST <ID>", "warn");
        return cmdManifest(id);
      }

      if (cmd === "DECON") {
        const sub = (parts[1] || "").toUpperCase();
        // Allow both "DECON <ID>" and "DECON START <ID>"
        const id = sub === "START" ? (parts[2] || "").toUpperCase() : sub;
        if (!id) return consoleLine("USAGE: DECON <ID>", "warn");

        // If invited co-op player, send command to host
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `DECON START ${id}` });
          consoleLine(`> DECON START ${id}`, "dim");
          playSfx("click");
          return;
        }

        const g = activeGate();
        const s = findShipById(g, id);
        if (!s) return consoleLine(`NOT FOUND: ${id}`, "bad");
        if (startDecon(g, s)) {
          g.lastRefresh = Date.now();
          renderAll();
        }
        return;
      }

      if (cmd === "NOTE") {
        const id = (parts[1] || "").toUpperCase();
        const note = parts.slice(2).join(" ");
        if (!id || !note) return consoleLine("USAGE: NOTE <ID> <TEXT>", "warn");

        // If invited co-op player, send command to host
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
          sendCoopAction("command", { command: `NOTE ${id} ${note}` });
          consoleLine(`> NOTE ${id} ${note}`, "dim");
          playSfx("click");
          return;
        }

        return cmdNote(id, note);
      }

      if (cmd === "CALLSIGN" || cmd === "OPERATOR") {
        const callsign = parts.slice(1).join(" ").trim();
        if (!callsign) {
          consoleLine(`OPERATOR ${runtime.operatorCallsign || "UNSET"}`, "dim");
          return;
        }
        if (callsign.toUpperCase() === "CLEAR") {
          setOperatorCallsign("");
          consoleLine("OPERATOR CLEARED", "dim");
          return;
        }
        setOperatorCallsign(callsign);
        consoleLine(`OPERATOR SET: ${runtime.operatorCallsign || "UNSET"}`, "dim");
        return;
      }

      if (cmd === "APPROVE" || cmd === "APP" || cmd === "HOLD" || cmd === "HLD" || cmd === "DENY" || cmd === "DNY") {
        const id = (parts[1] || "").toUpperCase();
        // Normalize aliases to full command names
        let action = cmd;
        if (cmd === "APP") action = "APPROVE";
        if (cmd === "HLD") action = "HOLD";
        if (cmd === "DNY") action = "DENY";
        if (!id) return consoleLine(`USAGE: ${action} <ID>`, "warn");
        handleAction(action.toLowerCase(), id);
        return;
      }

      if (cmd === "REALIGN") return queueMaintenance("realign", ui.btnRealign, { showConsole: true });
      if (cmd === "RESYNC") return queueMaintenance("reset", ui.btnReset, { showConsole: true });
      if (cmd === "PURGE") {
        const g = activeGate();
        ensureResources(g);
        const fuel = g.resources.FUEL;
        if (fuel.level < 10) {
          consoleLine("PURGE REFUSED: INSUFFICIENT FUEL (10 REQUIRED)", "warn");
          playSfx("error");
          return;
        }
        runtime.pendingConfirmation = { type: "purge" };
        consoleLine("PURGE COSTS 10 FUEL. CONTINUE (Y,N):", "warn");
        return;
      }
      if (cmd === "STRESSTEST") {
        runtime.pendingConfirmation = { type: "stresstest" };
        consoleLine("INITIATE FULL-SPECTRUM DIAGNOSTIC PROTOCOL? (Y,N):", "warn");
        consoleLine("WARNING: WEAKENED SUBSYSTEMS MAY FAIL UNDER LOAD TEST", "warn");
        return;
      }
      if (cmd === "BREAK") {
        // BREAK is disabled in co-op mode
        if (runtime.multiplayer.coop.enabled) {
          consoleLine("BREAK IS DISABLED IN CO-OP MODE", "warn");
          playSfx("error");
          return;
        }

        // Check if already on break
        if (runtime.breakState.active) {
          consoleLine("BREAK ALREADY IN PROGRESS", "warn");
          playSfx("error");
          return;
        }

        // Parse minutes parameter
        const minutesStr = parts[1];
        if (!minutesStr) {
          consoleLine("USAGE: BREAK <MINUTES>", "warn");
          playSfx("error");
          return;
        }

        const minutes = parseInt(minutesStr);
        if (isNaN(minutes) || minutes < 1 || minutes > 60) {
          consoleLine("BREAK DURATION MUST BE 1-60 MINUTES", "warn");
          playSfx("error");
          return;
        }

        // Calculate cost
        const cost = minutes * BREAK_COST_PER_MIN;

        // Check available wage
        const g = activeGate();
        const stats = ensureGateStats(g);
        const shiftMs = Date.now() - runtime.shiftStart;
        const currentWage = computeWage(stats, shiftMs);

        if (cost > currentWage) {
          consoleLine(`INSUFFICIENT FUNDS. BREAK COSTS ${cost} CR. CURRENT WAGE: ${currentWage} CR`, "warn");
          playSfx("error");
          return;
        }

        // Set pending confirmation
        runtime.pendingConfirmation = { type: "break", minutes: minutes, cost: cost };
        consoleLine(`BREAK: ${minutes} MIN (-${cost} CR). CONTINUE (Y,N):`, "warn");
        return;
      }
      if (cmd === "SCAN") return queueMaintenance("scan", ui.btnScan, { showConsole: true });

      if (cmd === "REPAIR") return initiateRepair(parts.slice(1).join(" "));

      if (cmd === "WORKORDER") return issueWorkOrder(parts.slice(1).join(" "));
      if (cmd === "RELAYS") return cmdRelays();
      if (cmd === "PING") {
        const arg1 = (parts[1] || "").toUpperCase();
        const arg2 = (parts[2] || "").toUpperCase();

        // Backward compatibility: PING GATE <GATE-ID> (deprecated syntax)
        if (arg1 === "GATE" && arg2) {
          consoleLine("NOTE: Use 'PING <GATE-ID>' instead of 'PING GATE <GATE-ID>'", "dim");
          // Check if multiplayer and if it's a player gate
          if (runtime.multiplayer.enabled && arg2.startsWith("GATE-")) {
            return cmdPingPlayer(arg2);
          }
          return cmdPingGate(arg2);
        }

        // No argument provided
        if (!arg1) {
          return consoleLine("USAGE: PING <GATE-ID> | PING <RELAY-ID>", "warn");
        }

        // NEW: Check if player gate ID (multiplayer)
        if (arg1.startsWith("GATE-") && runtime.multiplayer.enabled) {
          return cmdPingPlayer(arg1);
        }

        // Resolve the target ID
        const target = resolveTargetId(arg1);

        if (!target) {
          consoleLine(`INVALID TARGET ID: ${arg1}`, "warn");
          playSfx("error");
          return;
        }

        // Route to appropriate handler
        if (target.type === "gate") {
          return cmdPingGate(target.id);
        } else {
          return cmdPingRelay(target.id);
        }
      }

      if (cmd === "ACKNOWLEDGE") {
        const arg1 = (parts[1] || "").toUpperCase();
        const arg2 = (parts[2] || "").toUpperCase();

        // Remove "GATE" keyword if present for backward compatibility
        let targetId = arg1;
        if (arg1 === "GATE" && arg2) {
          targetId = arg2;
        }

        // Require ID
        if (!targetId) {
          return consoleLine("USAGE: ACKNOWLEDGE <GATE-ID> | ACKNOWLEDGE <RELAY-ID>", "warn");
        }

        // Resolve the target ID
        const target = resolveTargetId(targetId);

        if (!target) {
          consoleLine(`INVALID TARGET ID: ${targetId}`, "warn");
          playSfx("error");
          return;
        }

        // Route to appropriate handler
        if (target.type === "gate") {
          return cmdAckGate(target.id);
        } else {
          return cmdAckRelay(target.id);
        }
      }

      if (cmd === "ACK") {
        const arg1 = (parts[1] || "").toUpperCase();

        // Require ID
        if (!arg1) {
          return consoleLine("USAGE: ACK <GATE-ID> | ACK <RELAY-ID>", "warn");
        }

        // NEW: Check if player gate ID (multiplayer)
        if (arg1.startsWith("GATE-") && runtime.multiplayer.enabled) {
          return cmdAckPlayer(arg1);
        }

        // Resolve the target ID
        const target = resolveTargetId(arg1);

        if (!target) {
          consoleLine(`INVALID TARGET ID: ${arg1}`, "warn");
          playSfx("error");
          return;
        }

        // Route to appropriate handler
        if (target.type === "gate") {
          return cmdAckGate(target.id);
        } else {
          return cmdAckRelay(target.id);
        }
      }
      if (cmd === "RESTORE") {
        const relayId = resolveRelayId(parts.slice(1).join(" "));
        if (!relayId) return consoleLine("USAGE: RESTORE <RELAY-ID>", "warn");
        return cmdRestoreRelay(relayId);
      }
      if (cmd === "STABILIZE") {
        const relayId = resolveRelayId(parts.slice(1).join(" "));
        if (!relayId) return consoleLine("USAGE: STABILIZE <RELAY-ID>", "warn");
        return cmdStabilizeRelay(relayId);
      }
      if (cmd === "PACKETS") return cmdPackets();
      if (cmd === "ORDER") return cmdOrder(parts.slice(1).join(" "));

      if (cmd === "PURCHASE" || cmd === "BUY") {
        const arg = (parts[1] || "").toUpperCase();
        if (!arg) {
          consoleLine("USAGE: PURCHASE RELAY | PURCHASE DOCK", "warn");
          playSfx("error");
          return;
        }

        if (arg === "RELAY") {
          const g = activeGate();
          const check = canPurchase(g, "RELAY");

          if (!check.allowed) {
            if (check.reason === "MAX_CAPACITY") {
              consoleLine(`PURCHASE REFUSED: MAX RELAY CAPACITY REACHED (${MAX_RELAYS})`, "warn");
            } else if (check.reason === "INSUFFICIENT_CREDITS") {
              consoleLine(`PURCHASE REFUSED: INSUFFICIENT WAGE (${check.cost.credits} CR REQUIRED)`, "warn");
            } else if (check.reason === "INSUFFICIENT_SUPPLY") {
              consoleLine(`PURCHASE REFUSED: INSUFFICIENT SUPPLY (${check.cost.supply}% REQUIRED)`, "warn");
            } else {
              consoleLine("PURCHASE REFUSED: INVALID REQUEST", "warn");
            }
            playSfx("error");
            return;
          }

          // Check if co-op invited player - request vote instead
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
            sendCoopAction("request_vote", {
              purchaseType: "RELAY",
              cost: check.cost
            });
            consoleLine("VOTE REQUESTED: PURCHASE RELAY", "info");
            playSfx("click");
            return;
          }

          // Host or solo: use Y/N confirmation
          runtime.pendingConfirmation = { type: "purchase-relay", cost: check.cost };
          consoleLine(`PURCHASE RELAY: -${check.cost.credits} CR, -${check.cost.supply}% SUPPLY. CONTINUE (Y,N):`, "warn");
          return;
        }

        if (arg === "DOCK") {
          const g = activeGate();
          const check = canPurchase(g, "DOCK");

          if (!check.allowed) {
            if (check.reason === "MAX_CAPACITY") {
              consoleLine(`PURCHASE REFUSED: MAX DOCK CAPACITY REACHED (${MAX_DOCK_SLOTS})`, "warn");
            } else if (check.reason === "INSUFFICIENT_CREDITS") {
              consoleLine(`PURCHASE REFUSED: INSUFFICIENT WAGE (${check.cost.credits} CR REQUIRED)`, "warn");
            } else if (check.reason === "INSUFFICIENT_SUPPLY") {
              consoleLine(`PURCHASE REFUSED: INSUFFICIENT SUPPLY (${check.cost.supply}% REQUIRED)`, "warn");
            } else {
              consoleLine("PURCHASE REFUSED: INVALID REQUEST", "warn");
            }
            playSfx("error");
            return;
          }

          // Check if co-op invited player - request vote instead
          if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
            sendCoopAction("request_vote", {
              purchaseType: "DOCK",
              cost: check.cost
            });
            consoleLine("VOTE REQUESTED: PURCHASE DOCK", "info");
            playSfx("click");
            return;
          }

          // Host or solo: use Y/N confirmation
          runtime.pendingConfirmation = { type: "purchase-dock", cost: check.cost };
          consoleLine(`PURCHASE DOCK SLOT: -${check.cost.credits} CR, -${check.cost.supply}% SUPPLY. CONTINUE (Y,N):`, "warn");
          return;
        }

        consoleLine("USAGE: PURCHASE RELAY | PURCHASE DOCK", "warn");
        playSfx("error");
        return;
      }

      if (cmd === "VOTE") {
        if (!runtime.multiplayer.coop.enabled) {
          consoleLine("VOTING REQUIRES CO-OP MODE", "warn");
          playSfx("error");
          return;
        }

        const voteChoice = (parts[1] || "").toUpperCase();

        if (!["YES", "NO", "ABSTAIN"].includes(voteChoice)) {
          consoleLine("USAGE: VOTE YES | VOTE NO | VOTE ABSTAIN", "warn");
          playSfx("error");
          return;
        }

        // Check if there's an active vote (host checks activeVote, invited assumes exists)
        if (runtime.multiplayer.coop.role === "host" && !runtime.multiplayer.coop.activeVote) {
          consoleLine("NO ACTIVE VOTE", "warn");
          playSfx("error");
          return;
        }

        submitVote(voteChoice);
        return;
      }

      if (cmd === "CANCEL" && parts[1] && parts[1].toUpperCase() === "VOTE") {
        if (!runtime.multiplayer.coop.enabled) {
          consoleLine("VOTING REQUIRES CO-OP MODE", "warn");
          playSfx("error");
          return;
        }

        if (!runtime.multiplayer.coop.activeVote) {
          consoleLine("NO ACTIVE VOTE", "warn");
          playSfx("error");
          return;
        }

        const vote = runtime.multiplayer.coop.activeVote;
        const g = activeGate();
        const isInitiator = (g.id === vote.initiatorGateId);
        const isHost = (runtime.multiplayer.coop.role === "host");

        if (!isInitiator && !isHost) {
          consoleLine("ONLY INITIATOR OR HOST CAN CANCEL VOTE", "warn");
          playSfx("error");
          return;
        }

        cancelVote(vote.voteId, "cancelled_by_user");
        return;
      }

      if (cmd === "SFX") {
        const arg = (parts[1] || "").toUpperCase();
        if (!arg || arg === "STATUS") {
          consoleLine(`SFX ${audioState.sfxEnabled ? "ON" : "OFF"}`, "dim");
          return;
        }
        if (!["ON", "OFF", "TOGGLE"].includes(arg)) {
          consoleLine("USAGE: SFX ON|OFF|TOGGLE", "warn");
          playSfx("error");
          return;
        }
        const next = arg === "ON" ? true : (arg === "OFF" ? false : !audioState.sfxEnabled);
        setSfxEnabled(next);
        consoleLine(`SFX ${next ? "ON" : "OFF"}`, "dim");
        return;
      }

      if (cmd === "MUSIC") {
        const arg = (parts[1] || "").toUpperCase();
        if (!arg || arg === "STATUS") {
          consoleLine(`MUSIC ${audioState.musicEnabled ? "ON" : "OFF"}`, "dim");
          return;
        }
        if (!["ON", "OFF", "TOGGLE"].includes(arg)) {
          consoleLine("USAGE: MUSIC ON|OFF|TOGGLE", "warn");
          playSfx("error");
          return;
        }
        const next = arg === "ON" ? true : (arg === "OFF" ? false : !audioState.musicEnabled);
        setMusicEnabled(next);
        consoleLine(`MUSIC ${next ? "ON" : "OFF"}`, "dim");
        return;
      }

      if (cmd === "VFX") {
        const arg = (parts[1] || "").toUpperCase();
        if (!arg || arg === "STATUS") {
          consoleLine(`VFX ${vfxState.enabled ? "REG" : "LOW"}`, "dim");
          return;
        }
        if (!["REG", "LOW", "TOGGLE"].includes(arg)) {
          consoleLine("USAGE: VFX REG|LOW|TOGGLE", "warn");
          playSfx("error");
          return;
        }
        const next = arg === "REG" ? true : (arg === "LOW" ? false : !vfxState.enabled);
        setVfxEnabled(next);
        consoleLine(`VFX ${next ? "REG" : "LOW"}`, "dim");
        return;
      }

      if (cmd === "CODE") {
        const code = (parts[1] || "").toUpperCase();
        if (!code) {
          consoleLine("USAGE: CODE <ACCESS CODE>", "warn");
          return;
        }

        const codeMap = {
          "THEJOLLYEND": {
            type: "theme",
            value: "christmas",
            name: "CHRISTMAS"
          },
          "SPOOKYSCARY": {
            type: "theme",
            value: "halloween",
            name: "HALLOWEEN"
          },
          "SOVIETSOLARUNION": {
            type: "theme",
            value: "soviet",
            name: "WORKERS"
          },
          "1-800-OPERATOR": {
            type: "theme",
            value: "synthwave",
            name: "NOSTALGIA"
          },
          "FORDEMOCRACY": {
            type: "theme",
            value: "superearth",
            name: "EARTH"
          },
          "HEYRAIDER": {
            type: "theme",
            value: "speranza",
            name: "RAIDER"
          },
          "GROOVY": {
            type: "theme",
            value: "sunset",
            name: "SUNSET"
          },
          "TRAUMATEAM": {
            type: "theme",
            value: "medical",
            name: "MEDICAL"
          },
          "PROGAMER": {
            type: "theme",
            value: "gamer",
            name: "GAMER"
          },
          "THEENRICHMENTCENTER": {
            type: "theme",
            value: "aperture",
            name: "TESTING"
          },
          "FLATLINED": {
            type: "theme",
            value: "netrunner",
            name: "HACKER"
          },
          "ENDOFLINE": {
            type: "theme",
            value: "tron",
            name: "GRID"
          },
          "MANAGEDDEMOCRACY": {
            type: "theme",
            value: "helldiver",
            name: "HAZARD"
          },
          "BLUESCREEN": {
            type: "theme",
            value: "dos",
            name: "VINTAGE"
          },
          "INTHEVOID": {
            type: "theme",
            value: "deepspace",
            name: "DEEP SPACE"
          },
          "THIRDSTREET": {
            type: "theme",
            value: "saints",
            name: "ROYAL"
          },
          "PRETTYCOLOURS": {
            type: "unlockall"
          },
          "ILOVEVETASO": {
            type: "restore"
          }
        };

        const unlock = codeMap[code];
        if (!unlock) {
          consoleLine("ACCESS CODE INVALID", "bad");
          playSfx("error");
          return;
        }

        if (unlock.type === "unlockall") {
          // Unlock all themes
          const allThemes = [
            "christmas", "halloween", "fireworks", "verdant", "easter",
            "soviet", "synthwave", "superearth", "speranza", "sunset", "medical",
            "gamer", "aperture", "netrunner", "tron", "helldiver", "dos",
            "deepspace", "saints", "aurora", "rustbelt", "oceanic", "obsidian",
            "desertradar", "herbal"
          ];
          let newUnlocks = 0;
          for (const themeId of allThemes) {
            if (unlockTheme(themeId)) {
              newUnlocks++;
            }
          }
          consoleLine(`ALL THEMES UNLOCKED (${newUnlocks} NEW)`, "good");
          populateThemeDropdown();
          playSfx("charged");
          return;
        }

        if (unlock.type === "restore") {
          // Restore all systems to 100%
          const g = activeGate();
          if (!g) {
            consoleLine("NO ACTIVE GATE", "bad");
            playSfx("error");
            return;
          }

          // Restore resources to 100
          ensureResources(g);
          if (g.resources.FUEL) g.resources.FUEL.level = 100;
          if (g.resources.SUPPLY) g.resources.SUPPLY.level = 100;

          // Restore all relays to 100% health
          const now = Date.now();
          for (const relay of g.relays) {
            setRelayHealth(relay, 100, now);
            relay.offline = false;
            relay.hiddenOffline = false;
            relay.awaitingAck = false;
            relay.ackDueAt = 0;
          }
          if (g.id === runtime.activeGateId) g.lastRefresh = now;

          // Restore relay health tracking
          g.relayHealth.degradedSince = 0;
          g.relayHealth.criticalSince = 0;
          g.relayHealth.lastHealthState = "HEALTHY";
          g.relayHealth.unackedPings = 0;

          // Restore facility systems
          if (g.facility) {
            for (const sys of g.facility) {
              sys.status = "ONLINE";
              sys.degradedSince = 0;
              sys.degradedTimeoutAt = 0;
            }
          }

          // Restore core systems
          g.beacon = "ONLINE";
          g.alignment = "WITHIN TOLERANCE";
          g.sync = "SYNC";

          // Reset failure tracking
          g.relayFailureSince = 0;

          consoleLine("ALL SYSTEMS RESTORED TO FULL HEALTH", "good");
          playSfx("charged");
          return;
        }

        if (unlock.type === "theme") {
          // Special handling for Christmas code on Dec 24-25
          if (code === "THEJOLLYEND") {
            const now = new Date();
            const month = now.getMonth();
            const day = now.getDate();

            // If it's Dec 24 or 25, show special message instead
            if (month === 11 && (day === 24 || day === 25)) {
              consoleLine("MERRY CHRISTMAS FROM THE CORRIDOR NAVIGATIONAL AUTHORITY", "good");
              playSfx("charged");
              return;
            }
          }

          // Special handling for Halloween code on Oct 31
          if (code === "SPOOKYSCARY") {
            const now = new Date();
            const month = now.getMonth();
            const day = now.getDate();

            // If it's Oct 31, show special message instead
            if (month === 9 && day === 31) {
              consoleLine("BOO!", "good");
              playSfx("charged");
              return;
            }
          }

          // Normal theme unlock logic
          const wasUnlocked = unlockTheme(unlock.value);
          if (wasUnlocked) {
            consoleLine(`THEME UNLOCKED: ${unlock.name}`, "good");
            consoleLine(`USE 'THEME ${getThemeDisplayName(unlock.value)}' TO ACTIVATE`, "dim");
            populateThemeDropdown();
            playSfx("charged");
          } else {
            consoleLine(`THEME ALREADY UNLOCKED: ${unlock.name}`, "dim");
          }
        }
        return;
      }

      if (cmd === "THEME") {
        const themeInput = parts.slice(1).join(" ");
        const t = resolveThemeId(themeInput);
        if (!t || !isThemeUnlocked(t)) {
          const available = getAllAvailableThemes().map(id => getThemeDisplayName(id)).join("|");
          consoleLine(`USAGE: THEME ${available}`, "warn");
          return;
        }
        setTheme(t);
        populateThemeDropdown();
        return;
      }

      if (cmd === "ZOOM") {
        const arg = (parts[1] || "").toUpperCase();
        if (arg === "UP") {
          return cmdFontUp();
        } else if (arg === "DOWN") {
          return cmdFontDown();
        } else if (arg === "RESET") {
          return cmdFontReset();
        } else if (arg.endsWith("%")) {
          const percent = parseInt(arg.slice(0, -1), 10);
          if (!isNaN(percent)) {
            return cmdFontSet(percent);
          }
        } else if (arg) {
          // Try parsing as plain number (% symbol is optional)
          const percent = parseInt(arg, 10);
          if (!isNaN(percent)) {
            return cmdFontSet(percent);
          }
        }
        consoleLine("USAGE: ZOOM UP | ZOOM DOWN | ZOOM RESET | ZOOM <50-200>%", "warn");
        return;
      }

      if (cmd === "CLEAR" || cmd === "CLS") {
        clearLog(ui.console);
        consoleLine("CONSOLE CLEARED", "dim");
        return;
      }

      if (cmd === "ACTIVE") {
        if (!runtime.multiplayer.enabled) {
          consoleLine("GATE NETWORK: OFFLINE", "warn");
          return;
        }

        const players = runtime.multiplayer.players || [];
        const now = Date.now();

        consoleLine(`ACTIVE NODES (${players.length})`, "dim");

        for (const p of players) {
          const shiftMs = now - p.shiftStart;
          const shiftTime = formatHMS(shiftMs);
          const operator = p.operatorCallsign || "UNKNOWN";
          consoleLine(`  ${p.gateId} - ${operator} - ${shiftTime}`, "dim");
        }

        return;
      }

      if (cmd === "RECONNECT") {
        // Check if already connected
        if (runtime.multiplayer.ws && runtime.multiplayer.ws.readyState === WebSocket.OPEN) {
          consoleLine("GATE NETWORK: ALREADY CONNECTED", "warn");
          return;
        }

        // Check if reconnection is possible (not after a reset/intentional disconnect)
        if (runtime.multiplayer.shouldReconnect === false && runtime.multiplayer.reconnectAttempts === 0) {
          consoleLine("GATE NETWORK: RECONNECTION DISABLED (USE START TO RE-ENABLE MULTIPLAYER)", "warn");
          return;
        }

        // Attempt manual reconnection
        consoleLine("GATE NETWORK: ATTEMPTING MANUAL RECONNECT...", "dim");

        // Mark this as a reconnection attempt
        runtime.multiplayer.wasConnectedBefore = true;
        runtime.multiplayer.shouldReconnect = true;
        runtime.multiplayer.reconnectAttempts = 0;

        // Clear any pending reconnect timer
        if (runtime.multiplayer.reconnectTimer) {
          clearTimeout(runtime.multiplayer.reconnectTimer);
          runtime.multiplayer.reconnectTimer = null;
        }

        initMultiplayer();
        return;
      }

      if (cmd === "MSG") {
        if (!runtime.multiplayer.enabled) {
          consoleLine("GATE NETWORK: OFFLINE", "warn");
          return;
        }

        const text = parts.slice(1).join(" ").trim();

        if (!text) {
          consoleLine("USAGE: MSG <TEXT>", "warn");
          return;
        }

        if (text.length > 160) {
          consoleLine("MESSAGE TOO LONG (MAX 160 CHARS)", "bad");
          return;
        }

        const g = activeGate();
        const gateId = activeGate().id;
        const senderHealthState = computeRelayHealthState(g);
        const senderScore = senderHealthState.score;

        // Corrupt outgoing text based on sender's relay health
        const corruptedText = corruptMessageText(text, senderScore);

        const msg = {
          type: "message",
          timestamp: Date.now(),
          data: {
            gateId: gateId,
            operatorCallsign: formatOperatorCallsignWithClearance(runtime.operatorCallsign || "OPERATOR"),
            text: corruptedText,
            recipients: "all",
            senderRelayScore: senderScore
          }
        };

        runtime.multiplayer.ws.send(JSON.stringify(msg));
        consoleLine("MESSAGE SENT", "dim");

        return;
      }

      if (cmd === "DND") {
        if (!runtime.multiplayer.enabled) {
          consoleLine("GATE NETWORK: OFFLINE", "warn");
          return;
        }

        const arg = (parts[1] || "").toUpperCase();

        if (!arg) {
          // Show current DND status
          const status = [];
          if (runtime.multiplayer.dnd.all) status.push("ALL");
          else {
            if (runtime.multiplayer.dnd.msg) status.push("MSG");
            if (runtime.multiplayer.dnd.ping) status.push("PING");
          }
          const statusText = status.length ? status.join(", ") : "NONE";
          consoleLine(`DND STATUS: ${statusText}`, "dim");
          return;
        }

        let updated = false;

        if (arg === "MSG") {
          runtime.multiplayer.dnd.msg = !runtime.multiplayer.dnd.msg;
          runtime.multiplayer.dnd.all = false;
          updated = true;
        } else if (arg === "PING") {
          runtime.multiplayer.dnd.ping = !runtime.multiplayer.dnd.ping;
          runtime.multiplayer.dnd.all = false;
          updated = true;
        } else if (arg === "ALL") {
          runtime.multiplayer.dnd.all = !runtime.multiplayer.dnd.all;
          if (runtime.multiplayer.dnd.all) {
            runtime.multiplayer.dnd.msg = false;
            runtime.multiplayer.dnd.ping = false;
          }
          updated = true;
        } else {
          consoleLine("USAGE: DND [MSG|PING|ALL]", "warn");
          return;
        }

        if (updated) {
          const msg = {
            type: "dnd_update",
            timestamp: Date.now(),
            data: {
              gateId: activeGate().id,
              dndMsg: runtime.multiplayer.dnd.msg,
              dndPing: runtime.multiplayer.dnd.ping,
              dndAll: runtime.multiplayer.dnd.all
            }
          };
          runtime.multiplayer.ws.send(JSON.stringify(msg));

          const status = runtime.multiplayer.dnd.all ? "ALL" :
                         (runtime.multiplayer.dnd.msg && runtime.multiplayer.dnd.ping ? "MSG, PING" :
                          runtime.multiplayer.dnd.msg ? "MSG" :
                          runtime.multiplayer.dnd.ping ? "PING" : "NONE");
          consoleLine(`DND SET: ${status}`, "dim");
        }

        return;
      }

      consoleLine("UNKNOWN COMMAND. TYPE HELP.", "warn");
      playSfx("error");
    }

    // ---------------------------
    // Wire up UI
    // ---------------------------
    updateAudioButtons();
    applySfxVolume();
    applyKeyboardVolume();
    applyMusicVolume();
    updateVolumeControls();
    applyVfxMode();

    if (ui.btnSfx) {
      ui.btnSfx.addEventListener("click", () => setSfxEnabled(!audioState.sfxEnabled));
    }
    if (ui.btnMusic) {
      ui.btnMusic.addEventListener("click", () => setMusicEnabled(!audioState.musicEnabled));
    }
    if (ui.btnVfx) {
      ui.btnVfx.addEventListener("click", () => setVfxEnabled(!vfxState.enabled));
    }

    // Zoom buttons
    if (ui.btnZoomIn) {
      ui.btnZoomIn.addEventListener("click", () => {
        cmdFontUp();
        playSfx("click");
      });
    }
    if (ui.btnZoomOut) {
      ui.btnZoomOut.addEventListener("click", () => {
        cmdFontDown();
        playSfx("click");
      });
    }

    // Gamepad button
    const btnGamepad = document.getElementById('btn-gamepad');
    if (btnGamepad) {
      btnGamepad.addEventListener("click", () => {
        const enabled = loadStoredBool(LS.gamepadEnabled, true);
        setGamepadEnabled(!enabled);
      });
    }

    // Co-op buttons
    const btnHostCoop = document.getElementById('btn-host-coop');
    const btnJoinCoop = document.getElementById('btn-join-coop');
    const coopSessionCodeInput = document.getElementById('coop-session-code');
    const btnDisableCoop = document.getElementById('btn-disable-coop');

    if (btnHostCoop) {
      btnHostCoop.addEventListener("click", () => {
        if (!document.body.classList.contains("started")) {
          updateCoopStatus("ERROR: START GAME FIRST");
          setTimeout(() => updateCoopStatus(""), 3000);
          return;
        }
        createCoopSession();
      });
    }

    if (btnJoinCoop && coopSessionCodeInput) {
      btnJoinCoop.addEventListener("click", () => {
        const sessionCode = coopSessionCodeInput.value.trim();
        if (!sessionCode || sessionCode.length !== 6) {
          updateCoopStatus("ERROR: INVALID SESSION CODE");
          setTimeout(() => updateCoopStatus(""), 3000);
          return;
        }

        if (!document.body.classList.contains("started")) {
          // Store the join code and auto-start the game
          runtime.multiplayer.coop.pendingJoinCode = sessionCode.toUpperCase();
          updateCoopStatus("STARTING GAME...");
          coopSessionCodeInput.value = "";

          // Dismiss options panel
          const optionsPanel = document.getElementById("options-panel");
          const btnOptions = document.getElementById("btn-start-options");
          if (optionsPanel && btnOptions) {
            optionsPanel.classList.remove("visible");
            btnOptions.setAttribute("aria-expanded", "false");
          }

          // Auto-start the game (shift validation will be skipped when joining via invite)
          beginSession();
          return;
        }

        // Game already started - show initialization animation before joining
        coopSessionCodeInput.value = "";

        // Dismiss options panel
        const optionsPanel = document.getElementById("options-panel");
        const btnOptions = document.getElementById("btn-start-options");
        if (optionsPanel && btnOptions) {
          optionsPanel.classList.remove("visible");
          btnOptions.setAttribute("aria-expanded", "false");
        }

        // Show loading overlay with "INITIALIZING..." animation
        const startOverlay = ui.startOverlay;
        if (startOverlay) {
          startOverlay.removeAttribute("aria-hidden");
          document.body.classList.add("start-loading");

          // Play startup sound
          requestStartupSound();
          playSfx("click");

          // After 4 seconds (shorter than full boot), join the session
          setTimeout(() => {
            document.body.classList.remove("start-loading");
            startOverlay.setAttribute("aria-hidden", "true");

            // Now join the session
            joinCoopSession(sessionCode);
          }, 4000);
        } else {
          // Fallback if overlay not found
          joinCoopSession(sessionCode);
        }
      });

      // Allow Enter key to join
      coopSessionCodeInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          e.stopPropagation();
          btnJoinCoop.click(); // Use the button handler which has auto-start logic
        }
      });
    }

    if (btnDisableCoop) {
      btnDisableCoop.addEventListener("click", () => {
        if (!runtime.multiplayer.coop.enabled) return;
        if (runtime.multiplayer.coop.role !== "host") return;

        leaveCoopSession("host_disabled");
        updateCoopButtonVisibility();
      });
    }

    if (ui.sfxVolumeSlider) {
      ui.sfxVolumeSlider.addEventListener("input", (e) => {
        setSfxVolume(parseInt(e.target.value, 10) / 100);
      });
    }
    if (ui.btnSfxVolumeReset) {
      ui.btnSfxVolumeReset.addEventListener("click", () => {
        setSfxVolume(0.8);
        playSfx("beep");
      });
    }

    if (ui.btnKeyboard) {
      ui.btnKeyboard.addEventListener("click", () => setKeyboardEnabled(!audioState.keyboardEnabled));
    }
    if (ui.keyboardVolumeSlider) {
      ui.keyboardVolumeSlider.addEventListener("input", (e) => {
        setKeyboardVolume(parseInt(e.target.value, 10) / 100);
      });
    }
    if (ui.btnKeyboardVolumeReset) {
      ui.btnKeyboardVolumeReset.addEventListener("click", () => {
        setKeyboardVolume(0.8);
        playSfx("beep");
      });
    }

    if (ui.musicVolumeSlider) {
      ui.musicVolumeSlider.addEventListener("input", (e) => {
        setMusicVolume(parseInt(e.target.value, 10) / 100);
      });
    }
    if (ui.btnMusicVolumeReset) {
      ui.btnMusicVolumeReset.addEventListener("click", () => {
        setMusicVolume(0.8);
        playSfx("beep");
      });
    }

    document.addEventListener("click", (e) => {
      if (!isUiInteractionTarget(e.target)) return;
      unlockAudio();
      playSfx("click");
    }, true);

    document.addEventListener("change", (e) => {
      if (!isUiInteractionTarget(e.target)) return;
      unlockAudio();
      playSfx("click");
    }, true);

    ui.themeSelect.addEventListener("change", () => setTheme(ui.themeSelect.value));
    if (ui.startThemeSelect) {
      ui.startThemeSelect.addEventListener("change", () => {
        // On start screen, only save to storage if there's saved data
        // Otherwise, theme will be saved when game begins
        const shouldSave = hasSavedData();
        setTheme(ui.startThemeSelect.value, false, shouldSave);
      });
    }
    if (ui.btnExport) {
      ui.btnExport.addEventListener("click", async () => {
        try {
          const filename = await exportSaveFile();
          consoleLine(`EXPORT READY: ${filename}`, "good");
        } catch (_) {
          consoleLine("EXPORT FAILED", "warn");
        }
      });
    }
    if (ui.btnResume && ui.resumeInput) {
      ui.btnResume.addEventListener("click", () => ui.resumeInput.click());
      ui.resumeInput.addEventListener("change", async () => {
        const file = ui.resumeInput.files?.[0];
        ui.resumeInput.value = "";
        if (!file) return;
        try {
          const ok = await resumeFromFile(file);
          consoleLine(ok ? "RESUME LOADED" : "RESUME FAILED", ok ? "good" : "warn");
        } catch (_) {
          consoleLine("RESUME FAILED", "warn");
        }
      });
    }
    if (ui.btnProfileExport) {
      ui.btnProfileExport.addEventListener("click", async () => {
        try {
          const filename = await exportProfileFile();
          consoleLine(`PROFILE EXPORT READY: ${filename}`, "good");
        } catch (_) {
          consoleLine("PROFILE EXPORT FAILED", "warn");
        }
      });
    }
    if (ui.btnProfileImport && ui.profileImportInput) {
      ui.btnProfileImport.addEventListener("click", () => ui.profileImportInput.click());
      ui.profileImportInput.addEventListener("change", async () => {
        const file = ui.profileImportInput.files?.[0];
        ui.profileImportInput.value = "";
        if (!file) return;
        try {
          const ok = await importProfileFile(file);
          consoleLine(ok ? "PROFILE LOADED" : "PROFILE FAILED", ok ? "good" : "warn");
        } catch (_) {
          consoleLine("PROFILE FAILED", "warn");
        }
      });
    }
    if (ui.btnClearanceUpgrade) {
      ui.btnClearanceUpgrade.addEventListener("click", () => {
        playSfx("click");
        if (!canUpgradeClearance()) {
          updateClearanceDisplays();
          consoleLine("CLEARANCE NOT READY", "warn");
          return;
        }
        setClearanceConfirmOpen(true);
      });
    }
    if (ui.btnClearanceConfirm) {
      ui.btnClearanceConfirm.addEventListener("click", () => {
        performClearanceUpgrade();
        setClearanceConfirmOpen(false);
      });
    }
    if (ui.btnClearanceCancel) {
      ui.btnClearanceCancel.addEventListener("click", () => {
        playSfx("click");
        setClearanceConfirmOpen(false);
      });
    }

    if (ui.operatorLabel && ui.operatorInput && ui.operatorSlot) {
      ui.operatorLabel.addEventListener("click", () => startOperatorEdit());
      ui.operatorLabel.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startOperatorEdit();
        }
      });
      ui.operatorInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          finishOperatorEdit(true);
        } else if (e.key === "Escape") {
          e.preventDefault();
          finishOperatorEdit(false);
        }
      });
      ui.operatorInput.addEventListener("blur", () => finishOperatorEdit(true));
    }

    if (ui.startNameLabel && ui.startNameInput && ui.startNameSlot) {
      ui.startNameLabel.addEventListener("click", () => startStartNameEdit());
      ui.startNameLabel.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startStartNameEdit();
        }
      });
      ui.startNameInput.addEventListener("keydown", (e) => {
        unlockAudio();

        // Play typing sounds
        if (!MODIFIER_ONLY.has(e.key)) {
          if (e.key !== "Enter") playSfx("clack");
        }

        if (e.key === "Enter") {
          playSfx("click");
          e.preventDefault();
          finishStartNameEdit(true);
        } else if (e.key === "Escape") {
          e.preventDefault();
          finishStartNameEdit(false);
        }
      });
      ui.startNameInput.addEventListener("blur", () => finishStartNameEdit(true));
    }

    function getMaintenanceButton(kind) {
      const buttonMap = {
        realign: ui.btnRealign,
        reset: ui.btnReset,
        purge: ui.btnPurge,
        stresstest: ui.btnStresstest,
        scan: ui.btnScan
      };
      return buttonMap[kind] || null;
    }

    // Simulate button cooldown when maintenance is triggered by co-op
    function simulateMaintenanceCooldown(kind, durationSec = 3, startedAt = null) {
      const btn = getMaintenanceButton(kind);
      if (!btn) return;

      // If already in maintenance or busy, skip
      if (runtime.maintenance[kind] || btn.dataset.busy === "true") return;

      const g = activeGate();
      const label = btn?.dataset.label || btn?.textContent.trim() || kind.toUpperCase();

      // Mark button as busy
      if (btn) {
        btn.dataset.label = label;
        btn.dataset.busy = "true";
        btn.classList.add("btn-busy");
      }

      const delaySec = Number.isFinite(durationSec) ? durationSec : 3;
      const durationMs = delaySec * 1000;
      const endAt = (typeof startedAt === "number" && Number.isFinite(startedAt))
        ? startedAt + durationMs
        : Date.now() + durationMs;
      const remainingMs = endAt - Date.now();
      if (remainingMs <= 0) {
        btn.classList.remove("btn-busy");
        btn.dataset.busy = "false";
        btn.textContent = label;
        const now = Date.now();
        if (kind === "realign") g.lastRealignAt = now;
        if (kind === "reset") g.lastResetAt = now;
        if (kind === "purge") g.lastPurgeAt = now;
        if (kind === "scan") g.lastScanAt = now;
        if (kind === "stresstest") g.lastStressTestAt = now;
        return;
      }

      // Show countdown on button
      if (btn) {
        btn.textContent = `${label} (IN PROCESS ${delaySec}s)`;
      }
      const tick = btn ? setInterval(() => {
        const remaining = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));
        btn.textContent = `${label} (IN PROCESS ${remaining}s)`;
      }, 250) : null;

      const timer = setTimeout(() => {
        if (tick) clearInterval(tick);
        if (btn) {
          btn.classList.remove("btn-busy");
          btn.dataset.busy = "false";
          btn.textContent = label;
        }

        // Set the cooldown timestamp so the button shows cooldown afterwards
        const now = Date.now();
        if (kind === "realign") g.lastRealignAt = now;
        if (kind === "reset") g.lastResetAt = now;
        if (kind === "purge") g.lastPurgeAt = now;
        if (kind === "scan") g.lastScanAt = now;
        if (kind === "stresstest") g.lastStressTestAt = now;

        delete runtime.maintenance[kind];
      }, remainingMs);

      runtime.maintenance[kind] = { timer, tick };
    }

    function queueMaintenance(kind, btn, options = {}) {
      // If invited co-op player, send action to host instead of executing locally
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        sendCoopAction("maintenance", { kind, options });
        playSfx("click");
        return;
      }

      if (!btn) btn = getMaintenanceButton(kind);

      if (runtime.maintenance[kind]) {
        playSfx("error");
        flashErrorButton(btn);
        return;
      }
      if (btn && btn.dataset.busy === "true") {
        playSfx("error");
        flashErrorButton(btn);
        return;
      }

      const g = activeGate();
      const remainingMs = maintCooldownRemainingMs(g, kind);
      if (remainingMs > 0) {
        const remainingS = Math.ceil(remainingMs / 1000);
        if (kind === "scan") {
          consoleLine(`SCAN: COOLDOWN (${remainingS}s)`, "warn");
        } else {
          consoleLine(`MAINT: ${kind.toUpperCase()} COOLDOWN (${remainingS}s)`, "warn");
        }
        playSfx("error");
        flashErrorButton(btn);
        return;
      }

      // Check fuel cost for PURGE (unless skipFuelCheck is set from confirmation)
      if (kind === "purge" && !options.skipFuelCheck) {
        ensureResources(g);
        const fuel = g.resources.FUEL;
        if (fuel.level < 10) {
          consoleLine("PURGE REFUSED: INSUFFICIENT FUEL (10 REQUIRED)", "warn");
          playSfx("error");
          flashErrorButton(btn);
          return;
        }
      }

      const label = btn?.dataset.label || btn?.textContent.trim() || kind.toUpperCase();
      if (btn) {
        btn.dataset.label = label;
        btn.dataset.busy = "true";
        btn.classList.add("btn-busy");
      }
      if (kind === "purge") {
        playSfx("purge"); // Sound is now auto-synced to co-op players
      }
      if (kind === "reset") {
        playSfx("reset"); // Sound is now auto-synced to co-op players
      }
      if (kind === "scan") {
        playSfx("scan"); // Sound is now auto-synced to co-op players
      }
      if (kind === "stresstest") {
        playSfx("stress"); // Sound is now auto-synced to co-op players
      }
      if (kind === "realign") {
        // Realign sound is auto-synced by processing logic
        if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
          sendCoopEvent("sound", { sfx: "realign" });
        }
      }

      const delaySec = kind === "stresstest" ? 15 : (runtime.multiplayer.coop.enabled ? 3 : randRange(2, 3));
      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        sendCoopEvent("maintenance_start", { kind, durationSec: delaySec, startedAt: Date.now() });
      }
      const endAt = Date.now() + delaySec * 1000;
      const dotTotal = 4;

      let progressLine = null;
      let progressTick = null;
      let progressLabel = label.toUpperCase();
      let dots = 0;
      if (options.showConsole) {
        dots = 1;
        progressLine = logProgressLine(ui.console, `MAINT: ${progressLabel} .`, "dim");
        progressTick = setInterval(() => {
          const remaining = Math.max(0, endAt - Date.now());
          const progress = Math.min(1, Math.max(0, 1 - (remaining / (delaySec * 1000))));
          const nextDots = Math.max(1, Math.ceil(progress * dotTotal));
          if (nextDots !== dots && progressLine) {
            dots = nextDots;
            progressLine.textContent = `MAINT: ${progressLabel} ${".".repeat(dots)}`;
          }
        }, 120);
      }

      if (btn) {
        btn.textContent = `${label} (IN PROCESS ${delaySec}s)`;
      }
      const tick = btn ? setInterval(() => {
        const remaining = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));
        btn.textContent = `${label} (IN PROCESS ${remaining}s)`;
      }, 250) : null;

      const useProcessing = kind === "realign";
      if (useProcessing) bumpProcessingSound(1);

      const timer = setTimeout(() => {
        if (tick) clearInterval(tick);
        if (progressTick) clearInterval(progressTick);
        if (progressLine) {
          progressLine.textContent = `MAINT: ${progressLabel} ${".".repeat(dotTotal)}`;
        }
        if (btn) {
          btn.classList.remove("btn-busy");
          btn.dataset.busy = "false";
          btn.textContent = label;
        }
        if (kind === "purge") stopSfx("purge");
        if (kind === "reset") stopSfx("reset");
        if (kind === "scan") stopSfx("scan");
        if (kind === "stresstest") stopSfx("stress");
        if (useProcessing) bumpProcessingSound(-1);
        doMaintenance(kind);
        delete runtime.maintenance[kind];
      }, delaySec * 1000);

      runtime.maintenance[kind] = { timer, tick, progressTick };
    }

    function announceMaintenanceReady(kind, g, labelOverride = "") {
      const label = labelOverride || kind.toUpperCase();
      const msg = `${label} READY`;
      consoleLine(msg, "good");
      if (g && g.id === runtime.activeGateId) eventLine(msg, "good");
      playSfx("charged");
    }

    function updateMaintenanceCooldownUI() {
      const g = activeGate();
      const defs = [
        { kind: "realign", btn: ui.btnRealign },
        { kind: "reset", btn: ui.btnReset },
        { kind: "purge", btn: ui.btnPurge },
        { kind: "scan", btn: ui.btnScan },
        { kind: "stresstest", btn: ui.btnStresstest }
      ];
      for (const { kind, btn } of defs) {
        if (!btn) continue;
        btn.dataset.baseLabel ||= (btn.dataset.label || btn.textContent.trim() || kind.toUpperCase());

        // don't stomp the in-process label
        if (btn.dataset.busy === "true" || runtime.maintenance[kind]) continue;

        const remainingMs = maintCooldownRemainingMs(g, kind);
        if (remainingMs > 0) {
          const remainingS = Math.ceil(remainingMs / 1000);
          btn.dataset.cooldown = "true";
          btn.dataset.cooldownGate = g.id;
          btn.classList.add("btn-cooldown");
          btn.textContent = `${btn.dataset.baseLabel} (COOLDOWN ${remainingS}s)`;
        } else if (btn.dataset.cooldown === "true") {
          const sameGate = (btn.dataset.cooldownGate || "") === g.id;
          delete btn.dataset.cooldown;
          delete btn.dataset.cooldownGate;
          btn.classList.remove("btn-cooldown");
          // Show fuel cost for PURGE when available
          if (kind === "purge") {
            btn.textContent = "PURGE (-10 FUEL)";
          } else {
            btn.textContent = btn.dataset.baseLabel;
          }
          if (sameGate) announceMaintenanceReady(kind, g, btn.dataset.baseLabel);
        } else {
          btn.classList.remove("btn-cooldown");
          // Show fuel cost for PURGE when available
          if (kind === "purge") {
            btn.textContent = "PURGE (-10 FUEL)";
          }
        }
      }
    }

    function severedRestart() {
      // Close multiplayer connection cleanly so it can reconnect when START is pressed
      cleanupMultiplayer("reset");

      // Stop all game timers
      if (runtime.tickTimer) {
        clearInterval(runtime.tickTimer);
        runtime.tickTimer = null;
      }
      if (runtime.uiTimer) {
        clearInterval(runtime.uiTimer);
        runtime.uiTimer = null;
      }
      if (runtime.ambientSoundTimer) {
        clearInterval(runtime.ambientSoundTimer);
        runtime.ambientSoundTimer = null;
      }

      // Clear all maintenance timers
      for (const kind in runtime.maintenance) {
        const maint = runtime.maintenance[kind];
        if (maint.timer) clearTimeout(maint.timer);
        if (maint.tick) clearInterval(maint.tick);
        if (maint.progressTick) clearInterval(maint.progressTick);
      }
      runtime.maintenance = {};

      // Stop all sound effects
      stopMaintenanceSfx();
      runtime.processingCount = 0;
      updateProcessingSound();
      setAckAlarm(false);
      if (audio.music) {
        audio.music.pause();
        audio.music.currentTime = 0;
      }

      // Clear current gate progress only
      clearCurrentGateData();

      // Reset runtime state
      runtime.gate = null;
      runtime.severed = false;
      runtime.lastSevered = null;
      runtime.shiftCompleteShown = false;
      runtime.lastShiftComplete = null;
      runtime.lastShiftComplete = null;
      runtime.lastShiftComplete = null;

      // Update start screen state
      updateStartNameLabel();
      updateDataResetButtonVisibility();
      updateShiftTimeButtonVisibility();

      // Clear URL hash to prevent reload from hash
      try {
        const cleared = safeReplaceState(location.pathname + location.search);
        if (!cleared) location.hash = "";
      } catch (_) {}

      // Reset to start screen
      didBoot = false;
      startInProgress = false;
      document.body.classList.remove("started");
      document.body.classList.remove("severed");
      document.body.classList.remove("shiftcomplete");
      ui.startOverlay?.setAttribute("aria-hidden", "false");
      ui.btnStart?.removeAttribute("disabled");
      ui.btnStart?.focus();
    }

    function hostDisconnectReturn() {
      // Multiplayer already cleaned up in handleCoopSessionEnded

      // Stop all game timers
      if (runtime.tickTimer) {
        clearInterval(runtime.tickTimer);
        runtime.tickTimer = null;
      }
      if (runtime.uiTimer) {
        clearInterval(runtime.uiTimer);
        runtime.uiTimer = null;
      }
      if (runtime.ambientSoundTimer) {
        clearInterval(runtime.ambientSoundTimer);
        runtime.ambientSoundTimer = null;
      }

      // Clear all maintenance timers
      for (const kind in runtime.maintenance) {
        const maint = runtime.maintenance[kind];
        if (maint.timer) clearTimeout(maint.timer);
        if (maint.tick) clearInterval(maint.tick);
        if (maint.progressTick) clearInterval(maint.progressTick);
      }
      runtime.maintenance = {};

      // Stop all sound effects
      stopMaintenanceSfx();
      runtime.processingCount = 0;
      updateProcessingSound();
      setAckAlarm(false);
      if (audio.music) {
        audio.music.pause();
        audio.music.currentTime = 0;
      }

      // Clear current gate progress only
      clearCurrentGateData();

      // Reset runtime state
      runtime.gate = null;
      runtime.severed = false;
      runtime.lastSevered = null;
      runtime.shiftCompleteShown = false;

      // Update start screen state
      updateStartNameLabel();
      updateDataResetButtonVisibility();
      updateShiftTimeButtonVisibility();

      // Keep current theme (don't randomize like severedRestart does)

      // Clear URL hash to prevent reload from hash
      try {
        const cleared = safeReplaceState(location.pathname + location.search);
        if (!cleared) location.hash = "";
      } catch (_) {}

      // Reset to start screen
      didBoot = false;
      startInProgress = false;
      document.body.classList.remove("started");
      document.body.classList.remove("severed");
      document.body.classList.remove("shiftcomplete");
      document.body.classList.remove("host-disconnected");
      ui.startOverlay?.setAttribute("aria-hidden", "false");
      ui.btnStart?.removeAttribute("disabled");
      ui.btnStart?.focus();
    }

    ui.btnRealign.addEventListener("click", () => queueMaintenance("realign", ui.btnRealign));
    ui.btnReset.addEventListener("click", () => queueMaintenance("reset", ui.btnReset));
    ui.btnPurge.addEventListener("click", () => openPurgeModal());
    ui.btnScan.addEventListener("click", () => queueMaintenance("scan", ui.btnScan));
    ui.btnStresstest.addEventListener("click", () => openStressTestModal());
    ui.btnClr.addEventListener("click", () => {
      clearLog(ui.console);
      consoleLine("CONSOLE CLEARED", "dim");
    });
    if (ui.btnHardReset) {
      ui.btnHardReset.addEventListener("click", () => setResetConfirmOpen(true));
    }
    if (ui.btnRestart) ui.btnRestart.addEventListener("click", severedRestart);
    if (ui.btnHostDisconnectReturn) ui.btnHostDisconnectReturn.addEventListener("click", hostDisconnectReturn);
    if (ui.btnShiftcompleteContinue) ui.btnShiftcompleteContinue.addEventListener("click", continueAfterShiftComplete);
    if (ui.btnShiftcompleteReset) ui.btnShiftcompleteReset.addEventListener("click", () => setResetConfirmOpen(true));

    loadTheme();
		populateThemeDropdown();
    loadFontScale();

    let didBoot = false;
    let startInProgress = false;
    function beginSession() {
      console.log("beginSession called!");
      console.log("didBoot:", didBoot, "startInProgress:", startInProgress);

      if (didBoot || startInProgress) return;

      console.log("hasSavedData():", hasSavedData());
      console.log("hasShiftDurationSelected():", hasShiftDurationSelected());

      // Check if shift duration is selected when there's no save data
      // Skip this check if joining via invite code (will use host's shift settings)
      const isJoiningViaInvite = runtime.multiplayer.coop.pendingJoinCode;
      if (!isJoiningViaInvite && !hasSavedData() && !hasShiftDurationSelected()) {
        if (ui.startShiftError) {
          ui.startShiftError.textContent = "PLEASE SELECT SHIFT DURATION";
          ui.startShiftError.style.display = "block";
          ui.startShiftError.style.visibility = "visible";
          console.log("Error set:", ui.startShiftError.textContent);
          console.log("Error element:", ui.startShiftError);
          console.log("Error display:", window.getComputedStyle(ui.startShiftError).display);
          console.log("Error visibility:", window.getComputedStyle(ui.startShiftError).visibility);
        } else {
          console.log("startShiftError element not found!");
        }
        playSfx("error");
        return;
      }

      startInProgress = true;

      // Save the current theme to localStorage when the game begins
      const currentTheme = document.documentElement.dataset.theme;
      if (currentTheme) {
        safeStorageSet(LS.theme, currentTheme);
      }

      document.body.classList.add("start-loading");
      const loadingNameEl = document.getElementById("start-loading-name");
      if (loadingNameEl) {
        loadingNameEl.textContent = runtime.operatorCallsign || "USER";
      }
      ui.btnStart?.setAttribute("disabled", "true");
      ui.btnShiftTime?.classList.remove("visible");
      if (ui.startShiftError) {
        ui.startShiftError.textContent = "";
        ui.startShiftError.style.display = "none";
        ui.startShiftError.style.visibility = "hidden";
      }
      ui.startOverlay?.setAttribute("aria-hidden", "false");
      unlockAudio();
      requestStartupSound();
      playSfx("click");
      setTimeout(() => {
        didBoot = true;
        document.body.classList.remove("start-loading");
        document.body.classList.add("started");
        ui.startOverlay?.setAttribute("aria-hidden", "true");
        boot();
      }, 8000);
    }

    if (ui.btnStart) {
      ui.btnStart.addEventListener("click", beginSession);
      // Only focus START if it's enabled
      if (!ui.btnStart.classList.contains("btn-disabled")) {
        ui.btnStart.focus();
      }
    }

    if (ui.btnStartResume && ui.startResumeInput) {
      ui.btnStartResume.addEventListener("click", () => ui.startResumeInput.click());
      ui.startResumeInput.addEventListener("change", async () => {
        const file = ui.startResumeInput.files?.[0];
        ui.startResumeInput.value = "";
        if (!file) return;
        try {
          const ok = await resumeFromFileToStartScreen(file);
          if (ok) {
            playSfx("click");
          } else {
            playSfx("error");
          }
        } catch (_) {
          playSfx("error");
        }
      });
    }

    // Initialize data reset button visibility
    updateDataResetButtonVisibility();

    // Initialize shift time button visibility
    updateShiftTimeButtonVisibility();

    // Initialize operator callsign on start screen (tie to saved gate data)
    const storedGateId = getStoredGateId();
    if (!hasSavedData()) {
      clearOperatorCallsignForGate(storedGateId);
      try { localStorage.removeItem(LS.operatorCallsign); } catch (_) {}
    }
    runtime.operatorCallsign = loadOperatorCallsignForGate(storedGateId);
    applyDefaultCallsignIfNeeded(storedGateId);
    updateStartNameLabel();
    updateClearanceDisplays();

    // Shift time modal event listeners
    if (ui.btnShiftTime) {
      ui.btnShiftTime.addEventListener("click", () => {
        playSfx("click");
        openShiftTimeModal();
      });
    }

    if (ui.btnShiftTimeConfirm) {
      ui.btnShiftTimeConfirm.addEventListener("click", confirmShiftTimeSelection);
    }

    if (ui.btnShiftTimeCancel) {
      ui.btnShiftTimeCancel.addEventListener("click", () => {
        playSfx("click");
        closeShiftTimeModal();
      });
    }

    // Shift time preset button handlers
    document.querySelectorAll(".shift-time-preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        playSfx("click");
        // Clear other selections
        document.querySelectorAll(".shift-time-preset-btn").forEach(b => b.classList.remove("selected"));
        // Clear custom input
        if (ui.shiftTimeCustomHours) ui.shiftTimeCustomHours.value = "";
        if (ui.shiftTimeCustomMinutes) ui.shiftTimeCustomMinutes.value = "";
        if (ui.shiftTimeError) ui.shiftTimeError.textContent = "";
        // Mark this button as selected
        btn.classList.add("selected");
      });
    });

    // Custom input handlers
    if (ui.shiftTimeCustomHours || ui.shiftTimeCustomMinutes) {
      const handleCustomInput = () => {
        // Clear preset selection when custom input is used
        document.querySelectorAll(".shift-time-preset-btn").forEach(b => b.classList.remove("selected"));
        if (ui.shiftTimeError) ui.shiftTimeError.textContent = "";
      };
      if (ui.shiftTimeCustomHours) {
        ui.shiftTimeCustomHours.addEventListener("input", handleCustomInput);
      }
      if (ui.shiftTimeCustomMinutes) {
        ui.shiftTimeCustomMinutes.addEventListener("input", handleCustomInput);
      }
    }

    function setHelpOpen(open) {
      if (!ui.helpPanel) return;
      ui.helpPanel.classList.toggle("open", open);
      ui.helpPanel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ui.btnHelp) {
        ui.btnHelp.setAttribute("aria-expanded", open ? "true" : "false");
      }
      if (ui.btnStartHelp) {
        ui.btnStartHelp.setAttribute("aria-expanded", open ? "true" : "false");
      }
    }

    function setOptionsOpen(open) {
      if (!ui.optionsPanel) return;
      ui.optionsPanel.classList.toggle("open", open);
      ui.optionsPanel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ui.btnOptions) {
        ui.btnOptions.setAttribute("aria-expanded", open ? "true" : "false");
      }
      if (ui.btnStartOptions) {
        ui.btnStartOptions.setAttribute("aria-expanded", open ? "true" : "false");
      }
    }

    function setProfileOpen(open) {
      if (!ui.profilePanel) return;
      ui.profilePanel.classList.toggle("open", open);
      ui.profilePanel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ui.btnProfile) {
        ui.btnProfile.setAttribute("aria-expanded", open ? "true" : "false");
      }
      if (ui.btnStartProfile) {
        ui.btnStartProfile.setAttribute("aria-expanded", open ? "true" : "false");
      }

      if (open) {
        updateProfilePanel();
      }
    }

    function setMenuOpen(open) {
      if (!ui.menuPanel) return;
      ui.menuPanel.classList.toggle("open", open);
      ui.menuPanel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ui.btnMenu) {
        ui.btnMenu.setAttribute("aria-expanded", open ? "true" : "false");
      }
    }

    function formatClearanceLabel(level) {
      return `CLEARANCE-${level}`;
    }

    function hasAllVisibleAchievements(achievements) {
      const unlocked = new Set((achievements && achievements.unlocked) || []);
      return ACHIEVEMENTS.filter(a => !a.hidden).every(a => unlocked.has(a.id));
    }

    function hasAllUnlockableThemes(unlockedThemes) {
      const unlocked = new Set(unlockedThemes || []);
      return getUnlockableThemeIds().every(id => unlocked.has(id));
    }

    function canUpgradeClearance() {
      const achievements = loadAchievements();
      const unlockedThemes = getUnlockedThemes();
      return hasAllVisibleAchievements(achievements) && hasAllUnlockableThemes(unlockedThemes);
    }

    function updateClearanceDisplays() {
      const level = getClearanceLevel();

      if (ui.startClearance) {
        if (level > 0) {
          ui.startClearance.textContent = formatClearanceLabel(level);
          ui.startClearance.style.display = "block";
        } else {
          ui.startClearance.style.display = "none";
        }
      }

      if (ui.profileClearanceRow && ui.profileClearanceValue) {
        if (level > 0) {
          ui.profileClearanceValue.textContent = formatClearanceLabel(level);
          ui.profileClearanceRow.style.display = "grid";
        } else {
          ui.profileClearanceRow.style.display = "none";
        }
      }

      if (ui.btnClearanceUpgrade) {
        ui.btnClearanceUpgrade.style.display = canUpgradeClearance() ? "inline-flex" : "none";
      }
    }

    function updateProfilePanel() {
      const lifetimeStats = loadLifetimeStats();
      const achievements = loadAchievements();
      const unlockedThemes = getUnlockedThemes();
      const defaultCallsign = safeStorageGet(LS.defaultOperatorCallsign) || "";

      // Update default callsign input
      if (ui.profileDefaultCallsign) {
        ui.profileDefaultCallsign.value = defaultCallsign;
      }

      // Update career summary
      document.getElementById("profile-shifts-completed").textContent = lifetimeStats.totalShiftsCompleted;
      document.getElementById("profile-shifts-severed").textContent = lifetimeStats.totalShiftsSevered;
      document.getElementById("profile-total-time").textContent = formatHMS(lifetimeStats.totalShiftTimeMs);
      document.getElementById("profile-longest-shift").textContent = formatHMS(lifetimeStats.longestShiftMs);

      const firstShiftElem = document.getElementById("profile-first-shift");
      if (lifetimeStats.firstShiftDate) {
        const date = new Date(lifetimeStats.firstShiftDate);
        firstShiftElem.textContent = date.toLocaleDateString();
      } else {
        firstShiftElem.textContent = "—";
      }

      document.getElementById("profile-total-wage").textContent = `${lifetimeStats.totalWageEarned} credits`;

      // Update traffic stats
      document.getElementById("profile-ships-approved").textContent = lifetimeStats.totalShipsApproved;
      document.getElementById("profile-ships-denied").textContent = lifetimeStats.totalShipsDenied;
      document.getElementById("profile-denials-correct").textContent = lifetimeStats.totalDenialsCorrect;
      document.getElementById("profile-perfect-shifts").textContent = lifetimeStats.perfectShifts;
      document.getElementById("profile-decon-ops").textContent = lifetimeStats.totalDeconOps;

      // Update maintenance stats
      document.getElementById("profile-maintenance-ops").textContent = lifetimeStats.totalMaintenanceOps;
      document.getElementById("profile-work-orders").textContent = lifetimeStats.totalWorkOrdersCompleted;
      document.getElementById("profile-relay-repairs").textContent = lifetimeStats.totalRelayRepairs;
      document.getElementById("profile-relays-purchased").textContent = lifetimeStats.totalRelaysPurchased;
      document.getElementById("profile-docks-purchased").textContent = lifetimeStats.totalDocksPurchased;

      // Update achievements
      renderAchievements(achievements, lifetimeStats);

      // Update themes
      renderDefaultThemes();
      renderThemeGallery(unlockedThemes);
      renderSeasonalThemes();

      updateClearanceDisplays();
    }

    function renderAchievements(achievements, lifetimeStats) {
      const container = document.getElementById("profile-achievements-container");
      const countElem = document.getElementById("profile-achievement-count");

      container.innerHTML = "";

      const visibleAchievements = ACHIEVEMENTS.filter(a => {
        // Hide hidden achievements if not unlocked
        if (a.hidden && !achievements.unlocked.includes(a.id)) return false;
        return true;
      });

      countElem.textContent = `(${achievements.unlocked.length}/${ACHIEVEMENTS.length})`;

      for (const achievement of visibleAchievements) {
        const isUnlocked = achievements.unlocked.includes(achievement.id);
        const progress = getAchievementProgress(achievement, lifetimeStats, {}, 0);

        const card = document.createElement("div");
        card.className = `achievement-card ${isUnlocked ? "unlocked" : "locked"}`;

        const icon = document.createElement("div");
        icon.className = "achievement-icon";
        icon.textContent = achievement.icon;

        const info = document.createElement("div");
        info.className = "achievement-info";

        const name = document.createElement("div");
        name.className = "achievement-name";
        name.textContent = achievement.name;

        const description = document.createElement("div");
        description.className = "achievement-description";
        description.textContent = achievement.description;

        info.appendChild(name);
        info.appendChild(description);

          // Progress bar for locked achievements
          if (!isUnlocked && progress) {
            if (progress.segments && progress.segments.length > 0) {
              const progressGroup = document.createElement("div");
              progressGroup.className = "achievement-progress-group";
              for (const segment of progress.segments) {
                const progressBar = document.createElement("div");
                progressBar.className = "achievement-progress";
                const progressFill = document.createElement("div");
                progressFill.className = "achievement-progress-bar";
                const percent = Math.min(100, (segment.current / segment.target) * 100);
                progressFill.style.width = `${percent}%`;
                progressBar.appendChild(progressFill);

                const progressText = document.createElement("div");
                progressText.className = "achievement-progress-text";
                progressText.textContent = `${segment.label}: ${segment.current} / ${segment.target}`;

                progressGroup.appendChild(progressBar);
                progressGroup.appendChild(progressText);
              }
              info.appendChild(progressGroup);
            } else {
              const progressBar = document.createElement("div");
              progressBar.className = "achievement-progress";
              const progressFill = document.createElement("div");
              progressFill.className = "achievement-progress-bar";
              const percent = Math.min(100, (progress.current / progress.target) * 100);
              progressFill.style.width = `${percent}%`;
              progressBar.appendChild(progressFill);

              const progressText = document.createElement("div");
              progressText.className = "achievement-progress-text";
              progressText.textContent = `${progress.current} / ${progress.target}`;

              info.appendChild(progressBar);
              info.appendChild(progressText);
            }
          }

        const tier = document.createElement("div");
        tier.className = `achievement-tier ${achievement.tier}`;
        tier.textContent = achievement.tier;

        card.appendChild(icon);
        card.appendChild(info);
        card.appendChild(tier);

        container.appendChild(card);
      }
    }

    function renderThemeGallery(unlockedThemes) {
      const container = document.getElementById("profile-themes-container");
      const countElem = document.getElementById("profile-theme-count");

      container.innerHTML = "";

      const currentTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";
      const codeUnlockThemes = getUnlockableThemeIds();

      const allThemes = codeUnlockThemes.map(id => ({
        id: id,
        name: id.toUpperCase().replace(/([A-Z])/g, " $1").trim()
      }));

      const unlockedCount = unlockedThemes.filter(themeId => codeUnlockThemes.includes(themeId)).length;
      countElem.textContent = `(${unlockedCount}/${codeUnlockThemes.length})`;

      for (const theme of allThemes) {
        const isUnlocked = unlockedThemes.includes(theme.id);

        const card = document.createElement("div");
        card.className = `theme-card ${isUnlocked ? "" : "locked"}${theme.id === currentTheme ? " active" : ""}`;
        card.textContent = isUnlocked ? getThemeDisplayName(theme.id) : "????";
        if (theme.id === currentTheme) {
          card.setAttribute("aria-current", "true");
        }

        if (isUnlocked) {
          card.addEventListener("click", () => {
            setTheme(theme.id);
            playSfx("click");
            updateProfilePanel();
          });
        }

        container.appendChild(card);
      }
    }

    function renderSeasonalThemes() {
      const container = document.getElementById("profile-seasonal-container");
      const countElem = document.getElementById("profile-seasonal-count");
      const section = document.getElementById("profile-seasonal-section");

      if (!container || !countElem || !section) return;

      container.innerHTML = "";

      const currentTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";
      const holidayUnlocked = getHolidayUnlockedThemes();
      const allHolidayThemes = getHolidayThemeIds();

      // Only show section if player has unlocked at least one seasonal theme
      if (holidayUnlocked.length === 0) {
        section.style.display = "none";
        return;
      }

      section.style.display = "block";
      countElem.textContent = `(${holidayUnlocked.length}/${allHolidayThemes.length})`;

      // Only render unlocked seasonal themes (no "????" for locked ones)
      for (const themeId of holidayUnlocked) {
        const card = document.createElement("div");
        card.className = `theme-card${themeId === currentTheme ? " active" : ""}`;
        card.textContent = getThemeDisplayName(themeId);
        if (themeId === currentTheme) {
          card.setAttribute("aria-current", "true");
        }

        card.addEventListener("click", () => {
          setTheme(themeId);
          playSfx("click");
          updateProfilePanel();
        });

        container.appendChild(card);
      }
    }

    function renderDefaultThemes() {
      const container = document.getElementById("profile-default-themes-container");
      const countElem = document.getElementById("profile-default-theme-count");

      if (!container || !countElem) return;

      container.innerHTML = "";

      const preference = safeStorageGet(LS.themePreference);
      const currentTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";
      const defaults = THEME_OPTIONS;
      countElem.textContent = `(${defaults.length}/${defaults.length})`;

      for (const themeId of defaults) {
        const card = document.createElement("div");
        // For RANDOM, check if preference is RANDOM; for others, check if they match the current theme AND preference is not RANDOM
        const isActive = themeId === "RANDOM" ? preference === "RANDOM" : (themeId === currentTheme && preference !== "RANDOM");
        card.className = `theme-card${isActive ? " active" : ""}`;
        card.textContent = getThemeDisplayName(themeId);
        if (isActive) {
          card.setAttribute("aria-current", "true");
        }
        card.addEventListener("click", () => {
          setTheme(themeId);
          playSfx("click");
          updateProfilePanel();
        });
        container.appendChild(card);
      }
    }

    function setResetConfirmOpen(open) {
      if (!ui.resetOverlay) return;
      document.body.classList.toggle("resetting", open);
      ui.resetOverlay.setAttribute("aria-hidden", open ? "false" : "true");
      if (open) {
        ui.btnResetConfirm?.focus();
      } else {
        ui.btnHardReset?.focus();
      }
    }

    function setClearanceConfirmOpen(open) {
      if (!ui.clearanceOverlay) return;
      document.body.classList.toggle("clearance-upgrading", open);
      ui.clearanceOverlay.setAttribute("aria-hidden", open ? "false" : "true");
      if (open) {
        ui.btnClearanceConfirm?.focus();
      } else {
        ui.btnClearanceUpgrade?.focus();
      }
    }

    function performClearanceUpgrade() {
      if (!canUpgradeClearance()) {
        consoleLine("CLEARANCE NOT READY", "warn");
        return false;
      }

      const nextLevel = getClearanceLevel() + 1;
      setClearanceLevel(nextLevel);
      saveAchievements({ version: 1, unlocked: [], progress: {}, unlockedAt: {} });
      try { localStorage.removeItem(LS.unlockedThemes); } catch (_) {}

      populateThemeDropdown();
      const currentTheme = document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green";
      if (!isThemeUnlocked(currentTheme)) {
        setTheme("green", true, true);
      }

      updateClearanceDisplays();
      updateProfilePanel();
      consoleLine(`CLEARANCE UPGRADED: CL-${nextLevel}`, "good");
      playSfx("confirm");
      return true;
    }

    function formatOperatorCallsignWithClearance(callsign) {
      const base = String(callsign || "OPERATOR").trim() || "OPERATOR";
      const level = getClearanceLevel();
      return level > 0 ? `${base} CL-${level}` : base;
    }

    function hasSavedData() {
      try {
        // Check for severed state (indicates game was severed)
        if (localStorage.getItem(LS.severed)) {
          return true;
        }
        // Check for gate states (any keys starting with the prefix)
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith(LS.gateStatePrefix)) {
            return true;
          }
        }
        // Check for shift time (indicates active or past shift)
        if (localStorage.getItem(LS.shiftMs)) {
          return true;
        }
        // Check for shift complete shown flag
        if (localStorage.getItem(LS.shiftCompleteShown)) {
          return true;
        }
      } catch (_) {}
      return false;
    }

    function updateDataResetButtonVisibility() {
      if (!ui.btnDataReset) return;
      if (hasSavedData()) {
        ui.btnDataReset.classList.add("visible");
      } else {
        ui.btnDataReset.classList.remove("visible");
      }
    }

    function setDataResetConfirmOpen(open) {
      if (!ui.dataResetOverlay) return;
      document.body.classList.toggle("data-resetting", open);
      ui.dataResetOverlay.setAttribute("aria-hidden", open ? "false" : "true");
      if (open) {
        ui.btnDataResetConfirm?.focus();
      } else {
        ui.btnDataReset?.focus();
      }
    }

    // ---------------------------
    // Shift Time Selection
    // ---------------------------
    function hasShiftDurationSelected() {
      const stored = localStorage.getItem(LS.shiftDurationMs);
      return stored !== null && stored !== "";
    }

    function updateShiftTimeButtonVisibility() {
      if (!ui.btnShiftTime) return;
      const savedData = hasSavedData();

      if (savedData) {
        ui.btnShiftTime.classList.remove("visible");
        // Enable START button if there's saved data
        if (ui.btnStart) ui.btnStart.classList.remove("btn-disabled");
      } else {
        ui.btnShiftTime.classList.add("visible");
        // Update button text to show selected duration or default text
        updateShiftTimeButtonText();
        // Disable START button if no shift duration selected
        if (ui.btnStart) {
          if (hasShiftDurationSelected()) {
            ui.btnStart.classList.remove("btn-disabled");
          } else {
            ui.btnStart.classList.add("btn-disabled");
          }
        }
      }
    }

    function openShiftTimeModal() {
      document.body.classList.add("shift-time-modal-open");
      if (ui.shiftTimeModalOverlay) {
        ui.shiftTimeModalOverlay.setAttribute("aria-hidden", "false");
      }
      // Clear previous selection
      const presetButtons = document.querySelectorAll(".shift-time-preset-btn");
      presetButtons.forEach(btn => btn.classList.remove("selected"));
      if (ui.shiftTimeCustomHours) ui.shiftTimeCustomHours.value = "";
      if (ui.shiftTimeCustomMinutes) ui.shiftTimeCustomMinutes.value = "";
      if (ui.shiftTimeError) ui.shiftTimeError.textContent = "";
      if (ui.startShiftError) {
        ui.startShiftError.textContent = "";
        ui.startShiftError.style.display = "none";
        ui.startShiftError.style.visibility = "hidden";
      }
    }

    function closeShiftTimeModal() {
      document.body.classList.remove("shift-time-modal-open");
      if (ui.shiftTimeModalOverlay) {
        ui.shiftTimeModalOverlay.setAttribute("aria-hidden", "true");
      }
    }

    function saveShiftDuration(durationMs) {
      localStorage.setItem(LS.shiftDurationMs, String(durationMs));
    }

    function loadShiftDuration() {
      if (runtime.multiplayer?.coop?.role === "invited" && typeof runtime.shiftDurationMs === "number") {
        return runtime.shiftDurationMs;
      }
      const stored = localStorage.getItem(LS.shiftDurationMs);
      if (stored) {
        const parsed = parseInt(stored, 10);
        if (!isNaN(parsed) && parsed === -1) {
          return -1; // Unlimited mode
        }
        if (!isNaN(parsed) && parsed > 0) {
          return parsed;
        }
      }
      return 28_800_000; // Default 8 hours
    }

    function saveShiftMode(mode) {
      localStorage.setItem(LS.shiftMode, mode || "normal");
    }

    function loadShiftMode() {
      if (runtime.multiplayer?.coop?.role === "invited" && typeof runtime.shiftMode === "string" && runtime.shiftMode) {
        return runtime.shiftMode;
      }
      return localStorage.getItem(LS.shiftMode) || "normal";
    }

    function formatShiftDuration(durationMs) {
      const mode = loadShiftMode();
      if (mode === "unlimited") {
        return "UNLIMITED";
      }
      if (mode === "endurance") {
        return "ENDURANCE";
      }
      if (durationMs === -1) {
        return "UNLIMITED";
      }

      const totalMinutes = Math.floor(durationMs / 60000);
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;

      if (hours === 0) {
        return `${minutes} MIN`;
      } else if (minutes === 0) {
        return hours === 1 ? "1 HR" : `${hours} HR`;
      } else {
        return `${hours} HR ${minutes} MIN`;
      }
    }

    function updateShiftTimeButtonText() {
      if (!ui.btnShiftTime) return;

      if (hasShiftDurationSelected()) {
        const durationMs = loadShiftDuration();
        ui.btnShiftTime.textContent = formatShiftDuration(durationMs);
      } else {
        ui.btnShiftTime.textContent = "SHIFT TIME";
      }
    }

    function updateEnduranceButtons() {
      const shiftMode = loadShiftMode();
      const isEndurance = shiftMode === "endurance";

      // Disable LOAD FILE and EXPORT buttons in endurance mode
      if (ui.menuBtnResume) {
        ui.menuBtnResume.disabled = isEndurance;
        ui.menuBtnResume.style.opacity = isEndurance ? "0.4" : "";
        ui.menuBtnResume.style.cursor = isEndurance ? "not-allowed" : "";
        if (isEndurance) {
          ui.menuBtnResume.title = "Disabled in ENDURANCE mode";
        } else {
          ui.menuBtnResume.title = "";
        }
      }
      if (ui.menuBtnExport) {
        ui.menuBtnExport.disabled = isEndurance;
        ui.menuBtnExport.style.opacity = isEndurance ? "0.4" : "";
        ui.menuBtnExport.style.cursor = isEndurance ? "not-allowed" : "";
        if (isEndurance) {
          ui.menuBtnExport.title = "Disabled in ENDURANCE mode";
        } else {
          ui.menuBtnExport.title = "";
        }
      }
    }

    function confirmShiftTimeSelection() {
      let selectedDurationMs = null;
      let selectedMode = "normal"; // normal, unlimited, endurance

      // Check if a preset is selected
      const selectedPreset = document.querySelector(".shift-time-preset-btn.selected");
      if (selectedPreset) {
        const mode = selectedPreset.getAttribute("data-mode");
        if (mode) {
          // Special modes: unlimited or endurance
          selectedMode = mode;
          selectedDurationMs = -1; // Special value for unlimited modes
        } else {
          const minutes = parseInt(selectedPreset.getAttribute("data-minutes"));
          selectedDurationMs = minutes * 60 * 1000;
        }
      } else {
        // Check custom input
        const hours = parseInt(ui.shiftTimeCustomHours?.value || "0", 10);
        const minutes = parseInt(ui.shiftTimeCustomMinutes?.value || "0", 10);
        const totalMinutes = hours * 60 + minutes;

        if (totalMinutes < 10) {
          if (ui.shiftTimeError) {
            ui.shiftTimeError.textContent = "Minimum shift duration is 10 minutes";
          }
          playSfx("error");
          return;
        }

        if (totalMinutes > 1440) {
          if (ui.shiftTimeError) {
            ui.shiftTimeError.textContent = "Maximum shift duration is 24 hours. Use UNLIMITED or ENDURANCE for longer shifts.";
          }
          playSfx("error");
          return;
        }

        selectedDurationMs = totalMinutes * 60 * 1000;
      }

      if (selectedDurationMs === null) {
        if (ui.shiftTimeError) {
          ui.shiftTimeError.textContent = "Please select or enter a shift duration";
        }
        playSfx("error");
        return;
      }

      saveShiftDuration(selectedDurationMs);
      saveShiftMode(selectedMode);
      updateEnduranceButtons();
      // Enable the START button now that shift duration is selected
      if (ui.btnStart) ui.btnStart.classList.remove("btn-disabled");
      if (ui.startShiftError) {
        ui.startShiftError.textContent = "";
        ui.startShiftError.style.display = "none";
        ui.startShiftError.style.visibility = "hidden";
      }
      // Update the shift time button to show the selected duration
      updateShiftTimeButtonText();
      closeShiftTimeModal();
      playSfx("click");
    }

    // ---------------------------
    // Break System
    // ---------------------------
    const BREAK_COST_PER_MIN = 25;

    function openBreakModal() {
      if (runtime.severed || runtime.shiftCompleteShown) return;
      if (runtime.breakState.active) return;

      const g = activeGate();
      const stats = ensureGateStats(g);
      const shiftMs = Date.now() - runtime.shiftStart;
      const currentWage = computeWage(stats, shiftMs);

      // Update current wage display
      if (ui.breakCurrentWage) {
        ui.breakCurrentWage.textContent = currentWage;
      }

      // Update button states based on available funds
      const breakButtons = document.querySelectorAll('.break-duration-btn');
      breakButtons.forEach(btn => {
        const minutes = parseInt(btn.getAttribute('data-minutes'));
        const cost = minutes * BREAK_COST_PER_MIN;
        btn.disabled = cost > currentWage;
      });

      document.body.classList.add('break-modal-open');
      if (ui.breakModalOverlay) {
        ui.breakModalOverlay.setAttribute('aria-hidden', 'false');
      }
      if (ui.breakInsufficientFunds) {
        ui.breakInsufficientFunds.style.display = 'none';
      }
    }

    function closeBreakModal() {
      document.body.classList.remove('break-modal-open');
      if (ui.breakModalOverlay) {
        ui.breakModalOverlay.setAttribute('aria-hidden', 'true');
      }
    }

    function startBreak(minutes) {
      const g = activeGate();
      const stats = ensureGateStats(g);
      const shiftMs = Date.now() - runtime.shiftStart;
      const currentWage = computeWage(stats, shiftMs);
      const cost = minutes * BREAK_COST_PER_MIN;

      // Check if user has enough funds
      if (cost > currentWage) {
        if (ui.breakInsufficientFunds) {
          ui.breakInsufficientFunds.style.display = 'block';
        }
        return;
      }

      // Deduct cost from wage by adjusting stats
      spendWage(g, cost, { kind: "break" });

      const lifetimeStats = loadLifetimeStats();
      lifetimeStats.totalBreakMs += minutes * 60 * 1000;
      saveLifetimeStats(lifetimeStats);

      // Close modal
      closeBreakModal();

      // Pause the game
      pauseGame();

      // Set break state
      runtime.breakState.active = true;
      runtime.breakState.endTime = Date.now() + (minutes * 60 * 1000);

      // Show break screen
      document.body.classList.add('on-break');
      if (ui.breakScreenOverlay) {
        ui.breakScreenOverlay.setAttribute('aria-hidden', 'false');
      }

      // Start countdown timer
      updateBreakTimer();
      runtime.breakState.timer = setInterval(updateBreakTimer, 1000);

      playSfx("confirm");
    }

    // Purchase Modal Functions
    let pendingPurchase = null;

    function openPurchaseModal(type) {
      const g = activeGate();
      const check = canPurchase(g, type);

      if (!check.allowed) {
        if (check.reason === "MAX_CAPACITY") {
          const max = type === "RELAY" ? MAX_RELAYS : MAX_DOCK_SLOTS;
          consoleLine(`PURCHASE REFUSED: MAX ${type} CAPACITY REACHED (${max})`, "warn");
        } else if (check.reason === "INSUFFICIENT_CREDITS") {
          consoleLine(`PURCHASE REFUSED: INSUFFICIENT WAGE (${check.cost?.credits || 0} CR REQUIRED)`, "warn");
        } else if (check.reason === "INSUFFICIENT_SUPPLY") {
          consoleLine(`PURCHASE REFUSED: INSUFFICIENT SUPPLY (${check.cost?.supply || 0}% REQUIRED)`, "warn");
        } else {
          consoleLine("PURCHASE REFUSED: INVALID REQUEST", "warn");
        }
        playSfx("error");
        return;
      }

      const currentWage = availableWageCredits(g);
      const currentSupply = g.resources?.SUPPLY?.level || 0;
      const afterWage = currentWage - check.cost.credits;
      const afterSupply = currentSupply - check.cost.supply;

      pendingPurchase = { type, cost: check.cost };

      const itemName = type === "RELAY" ? "RELAY" : "DOCKING SLOT";
      const currentCount = type === "RELAY" ? g.relays.length : g.dockSlots.length;

      ui.purchaseModalDetails.innerHTML = `
        <p>Purchase <strong>${itemName}</strong> for your gate?</p>
        <p style="margin-top: 8px;">Current ${type === "RELAY" ? "Relays" : "Docking Slots"}: <strong>${currentCount}</strong> → <strong>${currentCount + 1}</strong></p>
      `;

      ui.purchaseModalSummary.innerHTML = `
<div style="display: grid; grid-template-columns: auto 1fr auto; gap: 8px 12px; align-items: baseline;">
  <div>COST:</div>
  <div></div>
  <div style="text-align: right; color: var(--alert);">-${check.cost.credits} CR</div>

  <div></div>
  <div></div>
  <div style="text-align: right; color: var(--alert);">-${check.cost.supply}% SUPPLY</div>

  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px;">WAGE:</div>
  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px;">${currentWage} CR</div>
  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px; text-align: right;">→ ${afterWage} CR</div>

  <div>SUPPLY:</div>
  <div>${Math.round(currentSupply)}%</div>
  <div style="text-align: right;">→ ${Math.round(afterSupply)}%</div>
</div>
      `;

      document.body.classList.add("purchase-modal-open");
      if (ui.purchaseModalOverlay) {
        ui.purchaseModalOverlay.style.display = "flex";
        ui.purchaseModalOverlay.setAttribute("aria-hidden", "false");
      }

      playSfx("click");
    }

    function closePurchaseModal() {
      pendingPurchase = null;
      document.body.classList.remove("purchase-modal-open");
      if (ui.purchaseModalOverlay) {
        ui.purchaseModalOverlay.style.display = "none";
        ui.purchaseModalOverlay.setAttribute("aria-hidden", "true");
      }
    }

    function confirmPurchase() {
      if (!pendingPurchase) return;

      const g = activeGate();
      const type = pendingPurchase.type;

      let result;
      if (type === "RELAY") {
        result = purchaseRelay(g);
      } else if (type === "DOCK") {
        result = purchaseDock(g);
      }

      if (result && result.allowed) {
        const itemId = result.relayId || result.dockId;
        consoleLine(`${type} PURCHASED: ${itemId} (-${result.cost.credits} CR, -${result.cost.supply}% SUPPLY)`, "good");
        playSfx("confirm");
        g.lastRefresh = Date.now();
        renderAll();
      } else {
        consoleLine("PURCHASE FAILED", "bad");
        playSfx("error");
      }

      closePurchaseModal();
    }

    // Wire up purchase button event listeners
    if (ui.btnPurchaseRelay) {
      ui.btnPurchaseRelay.addEventListener("click", () => openPurchaseModal("RELAY"));
    }
    if (ui.btnPurchaseDock) {
      ui.btnPurchaseDock.addEventListener("click", () => openPurchaseModal("DOCK"));
    }
    if (ui.btnPurchaseConfirm) {
      ui.btnPurchaseConfirm.addEventListener("click", confirmPurchase);
    }
    if (ui.btnPurchaseCancel) {
      ui.btnPurchaseCancel.addEventListener("click", () => {
        playSfx("click");
        closePurchaseModal();
      });
    }

    // Upgrade Modal Functions
    let pendingUpgrade = null;

    function openUpgradeModal(type) {
      const g = activeGate();
      const check = canUpgrade(g, type);

      if (!check.allowed) {
        if (check.reason === "ALREADY_UPGRADED") {
          consoleLine(`UPGRADE REFUSED: ${type} ALREADY UPGRADED`, "warn");
        } else if (check.reason === "UPGRADE_IN_PROGRESS") {
          consoleLine(`UPGRADE REFUSED: ${type} UPGRADE IN PROGRESS`, "warn");
        } else if (check.reason === "INSUFFICIENT_CREDITS") {
          consoleLine(`UPGRADE REFUSED: INSUFFICIENT WAGE (${check.cost} CR REQUIRED)`, "warn");
        } else {
          consoleLine("UPGRADE REFUSED: INVALID REQUEST", "warn");
        }
        playSfx("error");
        return;
      }

      const currentWage = availableWageCredits(g);
      const afterWage = currentWage - check.cost;

      pendingUpgrade = { type, cost: check.cost };

      const upgradeName = type === "REACTOR" ? "REACTOR UPGRADE" : "MAINTENANCE FACILITIES UPGRADE";
      const benefit = type === "REACTOR"
        ? "Reduces fuel consumption by 35% after upgrade completes"
        : "Reduces supply usage for decon, repairs, and work orders by 30% after upgrade completes";
      const duration = type === "REACTOR" ? UPGRADE_REACTOR_DURATION : UPGRADE_MAINTENANCE_DURATION;
      const drainWarning = type === "REACTOR"
        ? "FUEL will drain at 3x rate during upgrade"
        : "SUPPLY will drain at 3x rate during upgrade";

      ui.upgradeModalDetails.innerHTML = `
        <p>Initiate <strong>${upgradeName}</strong> for your gate?</p>
        <p style="margin-top: 8px; font-size: 12px; color: var(--muted);">${benefit}. ${drainWarning}.</p>
        <p style="margin-top: 8px; font-size: 12px; color: var(--alert);">Duration: ${formatMMSS(duration)}</p>
      `;

      ui.upgradeModalSummary.innerHTML = `
<div style="display: grid; grid-template-columns: auto 1fr auto; gap: 8px 12px; align-items: baseline;">
  <div>COST:</div>
  <div></div>
  <div style="text-align: right; color: var(--alert);">-${check.cost} CR</div>

  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px;">WAGE:</div>
  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px;">${currentWage} CR</div>
  <div style="margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px; text-align: right;">→ ${afterWage} CR</div>
</div>
      `;

      document.body.classList.add("upgrade-modal-open");
      if (ui.upgradeModalOverlay) {
        ui.upgradeModalOverlay.style.display = "flex";
        ui.upgradeModalOverlay.setAttribute("aria-hidden", "false");
      }

      playSfx("click");
    }

    function closeUpgradeModal() {
      pendingUpgrade = null;
      document.body.classList.remove("upgrade-modal-open");
      if (ui.upgradeModalOverlay) {
        ui.upgradeModalOverlay.style.display = "none";
        ui.upgradeModalOverlay.setAttribute("aria-hidden", "true");
      }
    }

    function confirmUpgrade() {
      if (!pendingUpgrade) return;

      const g = activeGate();
      const type = pendingUpgrade.type;
      const result = startUpgrade(g, type);

      if (result && result.allowed) {
        const upgradeName = type === "REACTOR" ? "REACTOR" : "MAINTENANCE FACILITIES";
        consoleLine(`${upgradeName} UPGRADE INITIATED (-${result.cost} CR)`, "good");
        playSfx("confirm");
        g.lastRefresh = Date.now();
        renderAll();
      } else {
        consoleLine("UPGRADE FAILED", "bad");
        playSfx("error");
      }

      closeUpgradeModal();
    }

    // Wire up upgrade button event listeners
    if (ui.btnUpgradeConfirm) {
      ui.btnUpgradeConfirm.addEventListener("click", confirmUpgrade);
    }
    if (ui.btnUpgradeCancel) {
      ui.btnUpgradeCancel.addEventListener("click", () => {
        playSfx("click");
        closeUpgradeModal();
      });
    }

    // Purge Modal Functions
    function openPurgeModal() {
      const g = activeGate();
      ensureResources(g);
      const fuel = g.resources.FUEL;

      if (fuel.level < 10) {
        consoleLine("PURGE REFUSED: INSUFFICIENT FUEL (10 REQUIRED)", "warn");
        playSfx("error");
        return;
      }

      document.body.classList.add("purge-modal-open");
      if (ui.purgeModalOverlay) {
        ui.purgeModalOverlay.style.display = "flex";
        ui.purgeModalOverlay.setAttribute("aria-hidden", "false");
      }

      playSfx("click");
    }

    function closePurgeModal() {
      document.body.classList.remove("purge-modal-open");
      if (ui.purgeModalOverlay) {
        ui.purgeModalOverlay.style.display = "none";
        ui.purgeModalOverlay.setAttribute("aria-hidden", "true");
      }
    }

    function confirmPurge() {
      closePurgeModal();
      queueMaintenance("purge", ui.btnPurge, { showConsole: true, skipFuelCheck: true });
    }

    // Wire up purge button event listeners
    if (ui.btnPurgeConfirm) {
      ui.btnPurgeConfirm.addEventListener("click", confirmPurge);
    }
    if (ui.btnPurgeCancel) {
      ui.btnPurgeCancel.addEventListener("click", () => {
        playSfx("click");
        closePurgeModal();
      });
    }

    // Stress Test Modal Functions
    function openStressTestModal() {
      document.body.classList.add("stresstest-modal-open");
      if (ui.stresstestModalOverlay) {
        ui.stresstestModalOverlay.style.display = "flex";
        ui.stresstestModalOverlay.setAttribute("aria-hidden", "false");
      }
      playSfx("click");
    }

    function closeStressTestModal() {
      document.body.classList.remove("stresstest-modal-open");
      if (ui.stresstestModalOverlay) {
        ui.stresstestModalOverlay.style.display = "none";
        ui.stresstestModalOverlay.setAttribute("aria-hidden", "true");
      }
    }

    function confirmStressTest() {
      closeStressTestModal();
      queueMaintenance("stresstest", ui.btnStresstest, { showConsole: true });
    }

    // Wire up stress test button event listeners
    if (ui.btnStresstestConfirm) {
      ui.btnStresstestConfirm.addEventListener("click", confirmStressTest);
    }
    if (ui.btnStresstestCancel) {
      ui.btnStresstestCancel.addEventListener("click", () => {
        playSfx("click");
        closeStressTestModal();
      });
    }

    function pauseGame() {
      // Store current shift time
      runtime.breakState.pausedShiftTime = Date.now() - runtime.shiftStart;

      // Pause game timers
      if (runtime.tickTimer) {
        runtime.breakState.pausedTickTimer = runtime.tickTimer;
        clearInterval(runtime.tickTimer);
        runtime.tickTimer = null;
      }
      if (runtime.uiTimer) {
        runtime.breakState.pausedUiTimer = runtime.uiTimer;
        clearInterval(runtime.uiTimer);
        runtime.uiTimer = null;
      }
      if (runtime.ambientSoundTimer) {
        clearInterval(runtime.ambientSoundTimer);
        runtime.ambientSoundTimer = null;
      }
    }

    function resumeGame() {
      // Adjust shift start time to account for break duration
      const breakDuration = Date.now() - (runtime.shiftStart + runtime.breakState.pausedShiftTime);
      runtime.shiftStart += breakDuration;
      saveShiftMsToStorage(); // Immediately save adjusted shift time to prevent loss on page close

      // Adjust all active ship and dock timestamps to account for break duration
      const g = activeGate();
      if (g) {
        // Adjust ship timers for all ships (inbound and outbound)
        const allShips = [...(g.inbound || []), ...(g.outbound || []), ...(g.waitingShips || [])];
        for (const ship of allShips) {
          if (ship.exposureDeadline && ship.exposureDeadline > 0) {
            ship.exposureDeadline += breakDuration;
          }
          if (ship.deconEndsAt && ship.deconEndsAt > 0) {
            ship.deconEndsAt += breakDuration;
            if (ship.deconPausedAt && ship.deconPausedAt > 0) {
              ship.deconPausedAt += breakDuration;
            }
          }
          if (ship.serviceEndsAt && ship.serviceEndsAt > 0) {
            ship.serviceEndsAt += breakDuration;
          }
          if (ship.servicePausedAt && ship.servicePausedAt > 0) {
            ship.servicePausedAt += breakDuration;
          }
          if (ship.clearingEndsAt && ship.clearingEndsAt > 0) {
            ship.clearingEndsAt += breakDuration;
          }
          if (ship.hazardDeadline && ship.hazardDeadline > 0) {
            ship.hazardDeadline += breakDuration;
          }
          if (ship.departureDeadline && ship.departureDeadline > 0) {
            ship.departureDeadline += breakDuration;
          }
          if (ship.deadlineWarningAt && ship.deadlineWarningAt > 0) {
            ship.deadlineWarningAt += breakDuration;
          }
          if (ship.doneAt && ship.doneAt > 0) {
            ship.doneAt += breakDuration;
          }
          if (ship.holdStartTime && ship.holdStartTime > 0) {
            ship.holdStartTime += breakDuration;
          }
        }

        // Adjust dock slot timers
        if (g.dockSlots) {
          for (const slot of g.dockSlots) {
            if (slot.phaseEndsAt && slot.phaseEndsAt > 0) {
              slot.phaseEndsAt += breakDuration;
            }
          }
        }

        // Adjust work order timers
        if (g.workOrders) {
          for (const wo of g.workOrders) {
            if (wo.phaseEndsAt && wo.phaseEndsAt > 0) {
              wo.phaseEndsAt += breakDuration;
            }
          }
        }

        // Adjust resource order timers
        if (g.resources) {
          for (const resKey of Object.keys(g.resources)) {
            const res = g.resources[resKey];
            if (res.order && res.order.stageEndsAt && res.order.stageEndsAt > 0) {
              res.order.stageEndsAt += breakDuration;
            }
          }
        }

        // Adjust facility timers
        if (g.facility) {
          for (const fac of g.facility) {
            if (fac.stableUntil && fac.stableUntil > 0) {
              fac.stableUntil += breakDuration;
            }
            if (fac.degradedTimeoutAt && fac.degradedTimeoutAt > 0) {
              fac.degradedTimeoutAt += breakDuration;
            }
          }
        }

        // Adjust relay timers
        if (g.relays) {
          for (const relay of g.relays) {
            if (relay.nextHeartbeatAt && relay.nextHeartbeatAt > 0) {
              relay.nextHeartbeatAt += breakDuration;
            }
            if (relay.ackDueAt && relay.ackDueAt > 0) {
              relay.ackDueAt += breakDuration;
            }
            if (relay.nextHealthPingCooldown && relay.nextHealthPingCooldown > 0) {
              relay.nextHealthPingCooldown += breakDuration;
            }
          }
        }
      }

      // Resume game timers
      if (!runtime.tickTimer) {
        runtime.tickTimer = setInterval(tickAllGates, 1000);
      }
      if (!runtime.uiTimer) {
        runtime.uiTimer = setInterval(() => {
          const shiftMs = Date.now() - runtime.shiftStart;
          const shiftDurationMs = loadShiftDuration();
          const shiftMode = loadShiftMode();

          // Check for shift completion (skip for unlimited/endurance modes)
          if (!runtime.shiftCompleteShown && !runtime.severed && shiftDurationMs !== -1 && shiftMs >= shiftDurationMs) {
            triggerShiftComplete();
          }

          ui.dataAge.textContent = formatClockHM(Date.now());
          if (runtime.severed) return;
          // Update display to show current / total format with percentage
          if (shiftMode === "unlimited" || shiftMode === "endurance" || shiftDurationMs === -1) {
            ui.shiftTime.textContent = `${formatHMS(shiftMs)} // ${shiftMode.toUpperCase()}`;
          } else {
            const percentage = Math.min(100, Math.floor((shiftMs / shiftDurationMs) * 100));
            ui.shiftTime.textContent = `${formatHMS(shiftMs)} // ${formatHMS(shiftDurationMs)} // ${percentage}%`;
          }
          const g = activeGate();
          const stats = ensureGateStats(g);
          if (ui.shiftWage) {
            ui.shiftWage.textContent = `${computeWage(stats, shiftMs)} CR`;
          }
          updateMaintenanceCooldownUI();
        }, 250);
      }
      if (!runtime.ambientSoundTimer) {
        runtime.ambientSoundTimer = setInterval(checkAmbientSound, 60000); // Check every 60 seconds
      }
			updateMusicState();
      // Clear break state
      runtime.breakState.pausedShiftTime = 0;
      runtime.breakState.pausedTickTimer = null;
      runtime.breakState.pausedUiTimer = null;
    }

    function updateBreakTimer() {
      const remaining = runtime.breakState.endTime - Date.now();

      if (remaining <= 0) {
        endBreak();
        return;
      }

      // Update timer display
      const totalSeconds = Math.ceil(remaining / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      const timeStr = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

      if (ui.breakTimerDisplay) {
        ui.breakTimerDisplay.textContent = timeStr;
      }

      // Play click sound for last 10 seconds
      if (totalSeconds <= 10 && totalSeconds > 0) {
        playSfx("click");
      }
    }

    function endBreak() {
      // Clear timer
      if (runtime.breakState.timer) {
        clearInterval(runtime.breakState.timer);
        runtime.breakState.timer = null;
      }

      // Hide break screen
      document.body.classList.remove('on-break');
      if (ui.breakScreenOverlay) {
        ui.breakScreenOverlay.setAttribute('aria-hidden', 'true');
      }

      // Resume game
      resumeGame();

      // Re-prime looped audio elements to ensure they can play after break
      // This is critical for audio to work properly after pausing/stopping
      primeLoopedAudio();

      // Clear break state
      runtime.breakState.active = false;
      runtime.breakState.endTime = null;

      playSfx("confirm");
    }

    function clearCurrentGateData() {
      try {
        for (let i = localStorage.length - 1; i >= 0; i--) {
          const key = localStorage.key(i);
          if (key && key.startsWith(LS.gateStatePrefix)) {
            localStorage.removeItem(key);
          }
        }
        localStorage.removeItem(LS.gateCurrent);
        localStorage.removeItem(LS.shiftMs);
        localStorage.removeItem(LS.shiftCompleteShown);
        localStorage.removeItem(LS.shiftDurationMs);
        localStorage.removeItem(LS.shiftMode);
        localStorage.removeItem(LS.severed);
        localStorage.removeItem(LS.lastSevered);
      } catch (_) {}
    }

    function clearAllSavedData() {
      try {
        // Clean up multiplayer connection if active (prevents auto-reconnect and marks player offline)
        if (runtime.multiplayer.ws) {
          sendGameStateChange(false, "reset");
          cleanupMultiplayer("reset");
        }

        // Clear current gate progress only (preserve profile, settings, milestones, themes, clearance)
        clearCurrentGateData();

        // Update start screen labels
        updateStartNameLabel();
        updateOperatorLabel();

        // Update button visibility
        updateDataResetButtonVisibility();
        updateShiftTimeButtonVisibility();
      } catch (e) {
        console.error("Failed to clear saved data:", e);
      }
    }

    function fullDataReset() {
      try {
        // Clean up multiplayer connection if active
        if (runtime.multiplayer.ws) {
          sendGameStateChange(false, "full-reset");
          cleanupMultiplayer("full-reset");
        }

        // Stop all sound effects and music
        stopMaintenanceSfx();
        runtime.processingCount = 0;
        updateProcessingSound();
        setAckAlarm(false);
        if (audio.music) {
          audio.music.pause();
          audio.music.currentTime = 0;
        }

        // Clear ALL localStorage (including audio/VFX preferences, themes, everything)
        localStorage.clear();

        // Reset runtime state
        runtime.gate = null;
        runtime.severed = false;
        runtime.lastSevered = null;
        runtime.shiftCompleteShown = false;
        runtime.lastShiftComplete = null;
        runtime.operatorCallsign = "";

        // Update start screen state
        updateStartNameLabel();
        updateDataResetButtonVisibility();
        updateShiftTimeButtonVisibility();

        // Randomize theme
        randomizeTheme(true, false);

        // Clear URL hash to prevent reload from hash
        try {
          const cleared = safeReplaceState(location.pathname + location.search);
          if (!cleared) location.hash = "";
        } catch (_) {}

        // Reset to start screen
        setTimeout(() => {
          try {
            document.body.classList.remove("started", "severed", "shiftcomplete");
            showStart();
          } finally {
            location.reload();
          }
        }, 100);
      } catch (e) {
        console.error("Failed to perform full data reset:", e);
        // Fallback: force reload
        location.reload();
      }
    }

    function setFullResetConfirmOpen(open) {
      if (!ui.fullResetOverlay) return;
      document.body.classList.toggle("full-resetting", open);
      ui.fullResetOverlay.setAttribute("aria-hidden", open ? "false" : "true");
      if (open) {
        ui.btnFullResetConfirm?.focus();
      } else {
        ui.btnFullDataReset?.focus();
      }
    }

    if (ui.btnHelp && ui.helpPanel) {
      ui.btnHelp.addEventListener("click", () => {
        setHelpOpen(!ui.helpPanel.classList.contains("open"));
      });
    }
    if (ui.btnStartHelp && ui.helpPanel) {
      ui.btnStartHelp.addEventListener("click", () => {
        setHelpOpen(!ui.helpPanel.classList.contains("open"));
      });
    }
    if (ui.helpDismiss) {
      ui.helpDismiss.addEventListener("click", () => setHelpOpen(false));
    }
    if (ui.btnOptions && ui.optionsPanel) {
      ui.btnOptions.addEventListener("click", () => {
        setOptionsOpen(!ui.optionsPanel.classList.contains("open"));
      });
    }
    if (ui.btnStartOptions && ui.optionsPanel) {
      ui.btnStartOptions.addEventListener("click", () => {
        setOptionsOpen(!ui.optionsPanel.classList.contains("open"));
      });
    }
    if (ui.optionsDismiss) {
      ui.optionsDismiss.addEventListener("click", () => setOptionsOpen(false));
    }
    if (ui.btnProfile && ui.profilePanel) {
      ui.btnProfile.addEventListener("click", () => {
        setProfileOpen(!ui.profilePanel.classList.contains("open"));
      });
    }
    if (ui.btnStartProfile && ui.profilePanel) {
      ui.btnStartProfile.addEventListener("click", () => {
        setProfileOpen(!ui.profilePanel.classList.contains("open"));
      });
    }
    if (ui.profileDismiss) {
      ui.profileDismiss.addEventListener("click", () => setProfileOpen(false));
    }

    // Menu panel event handlers
    if (ui.btnMenu && ui.menuPanel) {
      ui.btnMenu.addEventListener("click", () => {
        setMenuOpen(!ui.menuPanel.classList.contains("open"));
      });
    }
    if (ui.menuDismiss) {
      ui.menuDismiss.addEventListener("click", () => setMenuOpen(false));
    }
    // Menu button actions - LOAD FILE
    if (ui.menuBtnResume && ui.resumeInput) {
      ui.menuBtnResume.addEventListener("click", () => {
        setMenuOpen(false);
        ui.resumeInput.click();
      });
    }
    // Menu button actions - EXPORT
    if (ui.menuBtnExport) {
      ui.menuBtnExport.addEventListener("click", async () => {
        setMenuOpen(false);
        try {
          const filename = await exportSaveFile();
          consoleLine(`EXPORT READY: ${filename}`, "good");
        } catch (_) {
          consoleLine("EXPORT FAILED", "warn");
        }
      });
    }
    // Menu button actions - SCORE
    if (ui.menuBtnScore && ui.scorePanel) {
      ui.menuBtnScore.addEventListener("click", () => {
        setMenuOpen(false);
        setScorePanelOpen(true);
      });
    }
    // Menu button actions - PROFILE
    if (ui.menuBtnProfile && ui.profilePanel) {
      ui.menuBtnProfile.addEventListener("click", () => {
        setMenuOpen(false);
        setProfileOpen(true);
      });
    }
    // Menu button actions - OPTIONS
    if (ui.menuBtnOptions && ui.optionsPanel) {
      ui.menuBtnOptions.addEventListener("click", () => {
        setMenuOpen(false);
        setOptionsOpen(true);
      });
    }
    // Menu button actions - HELP
    if (ui.menuBtnHelp && ui.helpPanel) {
      ui.menuBtnHelp.addEventListener("click", () => {
        setMenuOpen(false);
        setHelpOpen(true);
      });
    }
    // Menu button actions - RESET
    if (ui.menuBtnHardReset) {
      ui.menuBtnHardReset.addEventListener("click", () => {
        setMenuOpen(false);
        setResetConfirmOpen(true);
      });
    }

    if (ui.profileDefaultCallsign) {
      ui.profileDefaultCallsign.addEventListener("change", (e) => {
        const previousDefault = getDefaultCallsign();
        const value = e.target.value.trim().toUpperCase();
        safeStorageSet(LS.defaultOperatorCallsign, value);
        const current = String(runtime.operatorCallsign || "").trim();
        if (!current || current === previousDefault) {
          setOperatorCallsign(value);
          updateStartNameLabel();
        }
        playSfx("click");
      });

      ui.profileDefaultCallsign.addEventListener("input", (e) => {
        e.target.value = e.target.value.toUpperCase();
      });
    }

    // Header collapse/expand functionality
    function setHeaderCollapsed(collapsed) {
      if (ui.header) {
        if (collapsed) {
          ui.header.classList.add("header-collapsed");
        } else {
          ui.header.classList.remove("header-collapsed");
        }
        safeStorageSet(LS.headerCollapsed, collapsed ? "1" : "0");

        // Update footer button text
        if (ui.headerExpandBtn) {
          ui.headerExpandBtn.innerHTML = collapsed ? "▼ SHOW" : "▲ HIDE";
          ui.headerExpandBtn.setAttribute("aria-label", collapsed ? "Show header" : "Hide header");
        }
      }
    }

    function toggleHeaderCollapsed() {
      const isCollapsed = ui.header && ui.header.classList.contains("header-collapsed");
      setHeaderCollapsed(!isCollapsed);
    }

    if (ui.headerCollapseBtn) {
      ui.headerCollapseBtn.addEventListener("click", () => setHeaderCollapsed(true));
    }

    if (ui.headerExpandBtn) {
      ui.headerExpandBtn.addEventListener("click", () => toggleHeaderCollapsed());
    }

    // Restore header collapsed state from localStorage
    const savedHeaderState = safeStorageGet(LS.headerCollapsed);
    if (savedHeaderState === "1") {
      setHeaderCollapsed(true);
    } else {
      // Initialize footer button text for expanded state
      if (ui.headerExpandBtn) {
        ui.headerExpandBtn.innerHTML = "▲ HIDE";
        ui.headerExpandBtn.setAttribute("aria-label", "Hide header");
      }
    }

    // Fullscreen mode support
    function setFullscreenEnabled(enabled) {
      if (!document.fullscreenEnabled && !document.webkitFullscreenEnabled &&
          !document.mozFullScreenEnabled && !document.msFullscreenEnabled) {
        consoleLine("FULLSCREEN NOT SUPPORTED ON THIS BROWSER", "warn");
        return;
      }

      if (enabled) {
        // Request fullscreen
        const elem = document.documentElement;
        const requestFullscreen = elem.requestFullscreen ||
                                 elem.webkitRequestFullscreen ||
                                 elem.mozRequestFullScreen ||
                                 elem.msRequestFullscreen;

        if (requestFullscreen) {
          requestFullscreen.call(elem).catch(err => {
            consoleLine(`FULLSCREEN REQUEST FAILED: ${err.message}`, "warn");
            fullscreenState.isEnabled = false;
            updateFullscreenButton();
          });
        }
      } else {
        // Exit fullscreen
        const exitFullscreen = document.exitFullscreen ||
                              document.webkitExitFullscreen ||
                              document.mozCancelFullScreen ||
                              document.msExitFullscreen;

        if (exitFullscreen) {
          exitFullscreen.call(document);
        }
      }

      fullscreenState.isEnabled = enabled;
      storeBool(LS.fullscreenEnabled, enabled);
      updateFullscreenButton();
    }

    function updateFullscreenButton() {
      if (ui.btnFullscreen) {
        ui.btnFullscreen.setAttribute("aria-pressed", fullscreenState.isEnabled ? "true" : "false");
      }
      if (ui.btnFullscreenFooter) {
        ui.btnFullscreenFooter.setAttribute("aria-pressed", fullscreenState.isEnabled ? "true" : "false");
      }
      if (ui.btnStartFullscreen) {
        ui.btnStartFullscreen.setAttribute("aria-pressed", fullscreenState.isEnabled ? "true" : "false");
      }
    }

    function toggleFullscreen() {
      setFullscreenEnabled(!fullscreenState.isEnabled);
    }

    // Listen for fullscreen changes (user pressing ESC or exiting via other means)
    document.addEventListener("fullscreenchange", () => {
      const isCurrentlyFullscreen = !!document.fullscreenElement;
      if (!isCurrentlyFullscreen && fullscreenState.isEnabled) {
        fullscreenState.isEnabled = false;
        storeBool(LS.fullscreenEnabled, false);
        updateFullscreenButton();
      }
    });

    // Handle webkit fullscreen change (Safari, older Chrome)
    document.addEventListener("webkitfullscreenchange", () => {
      const isCurrentlyFullscreen = !!document.webkitFullscreenElement;
      if (!isCurrentlyFullscreen && fullscreenState.isEnabled) {
        fullscreenState.isEnabled = false;
        storeBool(LS.fullscreenEnabled, false);
        updateFullscreenButton();
      }
    });

    // Handle moz fullscreen change (Firefox)
    document.addEventListener("mozfullscreenchange", () => {
      const isCurrentlyFullscreen = !!document.mozFullScreenElement;
      if (!isCurrentlyFullscreen && fullscreenState.isEnabled) {
        fullscreenState.isEnabled = false;
        storeBool(LS.fullscreenEnabled, false);
        updateFullscreenButton();
      }
    });

    // Handle ms fullscreen change (IE 11)
    document.addEventListener("MSFullscreenChange", () => {
      const isCurrentlyFullscreen = !!document.msFullscreenElement;
      if (!isCurrentlyFullscreen && fullscreenState.isEnabled) {
        fullscreenState.isEnabled = false;
        storeBool(LS.fullscreenEnabled, false);
        updateFullscreenButton();
      }
    });

    // Add fullscreen button click listener
    if (ui.btnFullscreen) {
      ui.btnFullscreen.addEventListener("click", () => toggleFullscreen());
    }
    if (ui.btnFullscreenFooter) {
      ui.btnFullscreenFooter.addEventListener("click", () => toggleFullscreen());
    }
    if (ui.btnStartFullscreen) {
      ui.btnStartFullscreen.addEventListener("click", () => toggleFullscreen());
    }

    // Initialize fullscreen button state
    updateFullscreenButton();

    // Score panel event handlers
    if (ui.btnScore && ui.scorePanel) {
      ui.btnScore.addEventListener("click", () => {
        setScorePanelOpen(!ui.scorePanel.classList.contains("open"));
      });
    }
    if (ui.scoreDismiss) {
      ui.scoreDismiss.addEventListener("click", () => setScorePanelOpen(false));
    }

    // Break system event handlers
    if (ui.btnBreak) {
      ui.btnBreak.addEventListener("click", () => {
        // BREAK is disabled in co-op mode
        if (runtime.multiplayer.coop.enabled) {
          consoleLine("BREAK IS DISABLED IN CO-OP MODE", "warn");
          playSfx("error");
          return;
        }
        openBreakModal();
      });
    }
    if (ui.btnBreakCancel) {
      ui.btnBreakCancel.addEventListener("click", () => {
        closeBreakModal();
      });
    }
    // Break duration buttons
    document.addEventListener("click", (e) => {
      const btn = e.target.closest('.break-duration-btn');
      if (!btn || btn.disabled) return;
      const minutes = parseInt(btn.getAttribute('data-minutes'));
      if (minutes) {
        startBreak(minutes);
      }
    });

    document.addEventListener("click", (e) => {
      if (!ui.helpPanel || !ui.btnHelp) return;
      if (!ui.helpPanel.classList.contains("open")) return;
      if (ui.helpPanel.contains(e.target) || ui.btnHelp.contains(e.target) || (ui.btnStartHelp && ui.btnStartHelp.contains(e.target))) return;
      setHelpOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!ui.optionsPanel || !ui.btnOptions) return;
      if (!ui.optionsPanel.classList.contains("open")) return;
      if (ui.optionsPanel.contains(e.target) || ui.btnOptions.contains(e.target) || (ui.btnStartOptions && ui.btnStartOptions.contains(e.target))) return;
      setOptionsOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!ui.scorePanel || !ui.btnScore) return;
      if (!ui.scorePanel.classList.contains("open")) return;
      if (ui.scorePanel.contains(e.target) || ui.btnScore.contains(e.target)) return;
      setScorePanelOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!ui.menuPanel || !ui.btnMenu) return;
      if (!ui.menuPanel.classList.contains("open")) return;
      if (ui.menuPanel.contains(e.target) || ui.btnMenu.contains(e.target)) return;
      setMenuOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      setHelpOpen(false);
      setOptionsOpen(false);
      setScorePanelOpen(false);
      setMenuOpen(false);
      setResetConfirmOpen(false);
      setDataResetConfirmOpen(false);
      closeBreakModal();
    });

    // Panel collapse event delegation
    document.addEventListener('click', (e) => {
      const header = e.target.closest('[data-panel]');
      if (!header) return;
      if (!header.classList.contains('panel-header') &&
          !header.classList.contains('subsection-header')) return;

      const panelId = header.getAttribute('data-panel');
      if (panelId) {
        e.stopPropagation();
        togglePanel(panelId);
      }
    });

    // Maximize button click handler
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-maximize');
      if (!btn) return;

      e.stopPropagation(); // Prevent triggering parent panel-header toggle

      const panelId = btn.getAttribute('data-maximize');
      if (panelId) {
        maximizePanel(panelId);
      }
    });

    // Keyboard support for maximize buttons
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;

      const btn = e.target.closest('.btn-maximize');
      if (btn) {
        e.preventDefault(); // Prevent space from scrolling
        e.stopPropagation();

        const panelId = btn.getAttribute('data-maximize');
        if (panelId) {
          maximizePanel(panelId);
        }
        return; // Exit early to prevent checking for panel headers below
      }

      // Keyboard support for collapse (existing functionality)
      const header = e.target.closest('[data-panel]');
      if (!header) return;
      if (!header.classList.contains('panel-header') &&
          !header.classList.contains('subsection-header')) return;

      const panelId = header.getAttribute('data-panel');
      if (panelId) {
        e.preventDefault();
        e.stopPropagation();
        togglePanel(panelId);
      }
    });

    // Resize handler to update layout on viewport changes
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (runtime.collapsedPanels) {
          updateInterfaceGridLayout();
        }
      }, 150);
    });

    if (ui.resetOverlay) {
      ui.resetOverlay.addEventListener("click", (e) => {
        if (e.target === ui.resetOverlay) setResetConfirmOpen(false);
      });
    }
    if (ui.btnResetCancel) {
      ui.btnResetCancel.addEventListener("click", () => setResetConfirmOpen(false));
    }
    if (ui.btnResetConfirm) {
      ui.btnResetConfirm.addEventListener("click", () => {
        setResetConfirmOpen(false);
        restartGate();
      });
    }

    // Data reset handlers
    if (ui.btnDataReset) {
      ui.btnDataReset.addEventListener("click", () => {
        playSfx("click");
        setDataResetConfirmOpen(true);
      });
    }
    if (ui.dataResetOverlay) {
      ui.dataResetOverlay.addEventListener("click", (e) => {
        if (e.target === ui.dataResetOverlay) setDataResetConfirmOpen(false);
      });
    }
    if (ui.btnDataResetCancel) {
      ui.btnDataResetCancel.addEventListener("click", () => {
        playSfx("click");
        setDataResetConfirmOpen(false);
      });
    }
    if (ui.btnDataResetConfirm) {
      ui.btnDataResetConfirm.addEventListener("click", () => {
        playSfx("click");
        setDataResetConfirmOpen(false);
        clearAllSavedData();
      });
    }

    // Full reset handlers
    if (ui.btnFullDataReset) {
      ui.btnFullDataReset.addEventListener("click", () => {
        playSfx("click");
        setFullResetConfirmOpen(true);
      });
    }
    if (ui.fullResetOverlay) {
      ui.fullResetOverlay.addEventListener("click", (e) => {
        if (e.target === ui.fullResetOverlay) setFullResetConfirmOpen(false);
      });
    }
    if (ui.btnFullResetCancel) {
      ui.btnFullResetCancel.addEventListener("click", () => {
        playSfx("click");
        setFullResetConfirmOpen(false);
      });
    }
    if (ui.btnFullResetConfirm) {
      ui.btnFullResetConfirm.addEventListener("click", () => {
        playSfx("click");
        setFullResetConfirmOpen(false);
        fullDataReset();
      });
    }

		const MODIFIER_ONLY = new Set(["Shift","Control","Alt","Meta","CapsLock"]);

		ui.cmd.addEventListener("keydown", (e) => {
			unlockAudio();

			// If you truly want *literally* every key, delete the modifier-only check.
			if (!MODIFIER_ONLY.has(e.key)) {
				// Keep Enter as your "click" (below), so clack everything else:
				if (e.key !== "Enter") playSfx("clack");
			}

			// Handle autocomplete navigation
			if (autocomplete.isActive && autocomplete.suggestions.length > 0) {
				if (e.key === "Tab") {
					e.preventDefault();
					// Cycle through suggestions
					autocomplete.selectedIndex = (autocomplete.selectedIndex + 1) % autocomplete.suggestions.length;
					renderAutocompleteDropdown(autocomplete.suggestions);
					renderInlinePreview(ui.cmd.value, autocomplete.suggestions);
					return;
				}

				if (e.key === "ArrowDown") {
					e.preventDefault();
					autocomplete.selectedIndex = Math.min(
						autocomplete.selectedIndex + 1,
						autocomplete.suggestions.length - 1
					);
					renderAutocompleteDropdown(autocomplete.suggestions);
					renderInlinePreview(ui.cmd.value, autocomplete.suggestions);
					return;
				}

				if (e.key === "ArrowUp" && autocomplete.selectedIndex > 0) {
					e.preventDefault();
					autocomplete.selectedIndex = Math.max(
						autocomplete.selectedIndex - 1,
						0
					);
					renderAutocompleteDropdown(autocomplete.suggestions);
					renderInlinePreview(ui.cmd.value, autocomplete.suggestions);
					return;
				}

				if (e.key === "Enter" && autocomplete.selectedIndex >= 0) {
					e.preventDefault();
					// Apply selected suggestion and execute
					const selected = autocomplete.suggestions[autocomplete.selectedIndex];
					const context = parseAutocompleteContext(ui.cmd.value);
					ui.cmd.value = context.command + " " + selected.id;
					hideAutocomplete();
					// Then execute command (existing Enter logic)
					playSfx("click");
					const v = ui.cmd.value;
					ui.cmd.value = "";
					runtime.cmdHistory.push(v);
					runtime.cmdPtr = runtime.cmdHistory.length;
					runCommand(v);
					return;
				}
			}

			if (e.key === "Enter") {
				playSfx("click");
				const v = ui.cmd.value;
				ui.cmd.value = "";
				runtime.cmdHistory.push(v);
				runtime.cmdPtr = runtime.cmdHistory.length;
				hideAutocomplete();
				runCommand(v);
			} else if (e.key === "ArrowUp" && !autocomplete.isActive) {
				// Only handle history when autocomplete is not active
				e.preventDefault();
				runtime.cmdPtr = clamp(runtime.cmdPtr - 1, 0, runtime.cmdHistory.length);
				ui.cmd.value = runtime.cmdHistory[runtime.cmdPtr] ?? "";
				updateAutocomplete(ui.cmd.value);
			} else if (e.key === "Escape") {
				if (autocomplete.isActive) {
					hideAutocomplete();
				} else {
					ui.cmd.value = "";
				}
			}
		});

		// Initialize autocomplete system
		if (ui.autocompleteContainer && ui.autocompleteDropdown && ui.autocompletePreview) {
			// Update on input
			ui.cmd.addEventListener("input", (e) => {
				updateAutocomplete(e.target.value);
			});

			// Hide on blur (with delay for click events)
			ui.cmd.addEventListener("blur", () => {
				setTimeout(() => hideAutocomplete(), 200);
			});

			// Restore on focus
			ui.cmd.addEventListener("focus", () => {
				if (ui.cmd.value) updateAutocomplete(ui.cmd.value);
			});

			// Click handler for dropdown items (event delegation)
			ui.autocompleteDropdown.addEventListener("click", (e) => {
				const item = e.target.closest(".autocomplete-item");
				if (!item) return;

				const shipId = item.getAttribute("data-ship-id");
				const context = parseAutocompleteContext(ui.cmd.value);

				ui.cmd.value = context.command + " " + shipId;
				ui.cmd.focus();
				hideAutocomplete();
				playSfx("click");
			});
		}

		// ---------------------------
		// Keyboard Navigation System
		// ---------------------------
		const keyboardNav = {
			isActive: false,
			isConsoleLocked: false,
			isSelectLocked: false,
			isHeaderMode: false,
			currentIndex: 0,
			currentLevel: 'root',
			currentElements: [],
			navigationStack: [],
			currentPanelContext: null,
			currentSubsectionContext: null
		};

		// ---------------------------
		// Ship ID Autocomplete System
		// ---------------------------
		const autocomplete = {
			isActive: false,
			suggestions: [],
			selectedIndex: -1,
			currentCommand: null,
			currentInput: "",
			lastShipIdStart: -1
		};

		function parseAutocompleteContext(inputValue) {
			const parts = inputValue.trim().split(/\s+/);
			const command = parts[0]?.toUpperCase() || "";
			const partialId = parts[1]?.toUpperCase() || "";

			return {
				command,
				partialId,
				needsShipId: isCommandThatNeedsShipId(command),
				isTypingShipId: parts.length >= 2
			};
		}

		function isCommandThatNeedsShipId(cmd) {
			const shipCommands = [
				"APPROVE", "APP", "DENY", "DNY", "HOLD", "HLD",
				"DECON", "DETAIL", "DTL", "QUERY", "QRY", "NOTE", "MANIFEST", "MFST"
			];
			return shipCommands.includes(cmd);
		}

		function getValidShipsForCommand(command) {
			const g = activeGate();
			if (!g) return [];

			const allShips = [...g.inbound, ...g.outbound];

			// DETAIL, QUERY, NOTE, MANIFEST: All ships
			if (["DETAIL", "DTL", "QUERY", "QRY", "NOTE", "MANIFEST", "MFST"].includes(command)) {
				return allShips;
			}

			// DECON: Only ships in WAITING DECON state
			if (command === "DECON") {
				return allShips.filter(s => {
					if (s.state !== "WAITING DECON") return false;

					const facility = getFacility(g, "DECON");
					if (!facility || facility.status !== "ONLINE") return false;

					if (shipHasEffect(s, "VACUUM BLOOM")) return false;

					return true;
				});
			}

			// APPROVE, DENY, HOLD: Ships not finalized, not docked
			if (["APPROVE", "APP", "DENY", "DNY", "HOLD", "HLD"].includes(command)) {
				if (["APPROVE", "APP"].includes(command) && g.alignment === "OUT OF TOLERANCE") {
					return [];
				}
				return allShips.filter(s => {
					// Exclude finalized ships
					if (s.state === "CLEARED" || s.state === "DENIED") return false;

					// Exclude departing/completed ships
					const st = String(s.state || "").toUpperCase();
					if (st.includes("DEPART") || st.includes("ARRIV") || st.includes("COMPLETE")) {
						return false;
					}

					// Exclude docked ships
					if (["WAITING TO DOCK", "WAITING DECON", "DECON", "SERVICING", "CLEARING"].includes(s.state)) {
						return false;
					}

					// For APPROVE: Check DOCK facility for inbound ships
					if (["APPROVE", "APP"].includes(command) && s.dir === "IN") {
						const dockClamp = getFacility(g, "DOCK");
						if (!dockClamp || dockClamp.status !== "ONLINE") return false;
					}

					// For HOLD: Check if already used
					if (["HOLD", "HLD"].includes(command) && s.holdUsed) {
						return false;
					}

					return true;
				});
			}

			return [];
		}

		function matchShipsByPartialId(ships, partialId) {
			if (!partialId) return ships;

			const matches = ships.filter(s =>
				s.id.toUpperCase().startsWith(partialId.toUpperCase())
			);

			// Sort by ID for consistent ordering
			return matches.sort((a, b) => a.id.localeCompare(b.id));
		}

		function generateAutocompleteSuggestions(inputValue) {
			const context = parseAutocompleteContext(inputValue);

			if (!context.needsShipId || !context.isTypingShipId) {
				return [];
			}

			const validShips = getValidShipsForCommand(context.command);
			const matches = matchShipsByPartialId(validShips, context.partialId);

			return matches.map(s => ({
				id: s.id,
				state: s.state,
				dir: s.dir,
				type: s.type,
				request: s.request || "TRANSIT"
			}));
		}

		function renderAutocompleteDropdown(suggestions) {
			if (!ui.autocompleteDropdown) return;

			if (suggestions.length === 0) {
				ui.autocompleteContainer.style.display = "none";
				autocomplete.isActive = false;
				return;
			}

			ui.autocompleteContainer.style.display = "block";
			autocomplete.isActive = true;

			ui.autocompleteDropdown.innerHTML = suggestions.map((ship, index) => {
				const stateClass = ship.state === "CLEARED" ? "good" :
					(ship.state === "DENIED" || ship.state === "HOLD") ? "warn" : "";
				const selected = index === autocomplete.selectedIndex ? "selected" : "";

				return `
					<div class="autocomplete-item ${selected}" data-index="${index}" data-ship-id="${ship.id}">
						<span class="autocomplete-item-id">${ship.id}</span>
						<span class="autocomplete-item-info">${ship.dir} // ${ship.type}</span>
						<span class="autocomplete-item-state ${stateClass}">${ship.state}</span>
					</div>
				`;
			}).join("");
		}

		function renderInlinePreview(inputValue, suggestions) {
			if (!ui.autocompletePreview) return;

			const context = parseAutocompleteContext(inputValue);

			if (suggestions.length === 0 || !context.partialId) {
				ui.autocompletePreview.textContent = "";
				return;
			}

			const topSuggestion = suggestions[autocomplete.selectedIndex >= 0
				? autocomplete.selectedIndex
				: 0];

			if (!topSuggestion) {
				ui.autocompletePreview.textContent = "";
				return;
			}

			// Build preview text: "COMMAND SHIP-ID"
			const commandPart = context.command + " ";
			const previewText = commandPart + topSuggestion.id;

			ui.autocompletePreview.textContent = previewText;
		}

		function updateAutocomplete(inputValue) {
			autocomplete.currentInput = inputValue;
			autocomplete.suggestions = generateAutocompleteSuggestions(inputValue);
			autocomplete.selectedIndex = -1; // Reset selection on new input

			renderAutocompleteDropdown(autocomplete.suggestions);
			renderInlinePreview(inputValue, autocomplete.suggestions);
		}

		function hideAutocomplete() {
			if (ui.autocompleteContainer) {
				ui.autocompleteContainer.style.display = "none";
			}
			if (ui.autocompletePreview) {
				ui.autocompletePreview.textContent = "";
			}
			autocomplete.isActive = false;
			autocomplete.suggestions = [];
			autocomplete.selectedIndex = -1;
		}

		function isElementVisible(element) {
			if (!element) return false;
			if (element.offsetParent === null) return false;
			const style = window.getComputedStyle(element);
			if (style.display === 'none' || style.visibility === 'hidden') return false;
			return true;
		}

		function buildRootElements() {
			const elements = [];

			// Detect which screen/mode is active
			const optionsPanel = document.getElementById('options-panel');
			const isOptionsOpen = optionsPanel && optionsPanel.getAttribute('aria-hidden') === 'false';

			const helpPanel = document.getElementById('help-panel');
			const isHelpOpen = helpPanel && helpPanel.getAttribute('aria-hidden') === 'false';

			const scorePanel = document.getElementById('score-panel');
			const isScoreOpen = scorePanel && scorePanel.getAttribute('aria-hidden') === 'false';

			const dataResetOverlay = document.getElementById('confirm-data-reset-overlay');
			const isDataResetOpen = dataResetOverlay && dataResetOverlay.getAttribute('aria-hidden') === 'false';

			const fullResetOverlay = document.getElementById('confirm-full-reset-overlay');
			const isFullResetOpen = fullResetOverlay && fullResetOverlay.getAttribute('aria-hidden') === 'false';

			const resetOverlay = document.getElementById('confirm-reset-overlay');
			const isResetOpen = resetOverlay && resetOverlay.getAttribute('aria-hidden') === 'false';

			const clearanceOverlay = document.getElementById('confirm-clearance-overlay');
			const isClearanceOpen = clearanceOverlay && clearanceOverlay.getAttribute('aria-hidden') === 'false';

			const shiftTimeModal = document.getElementById('shift-time-modal-overlay');
			const isShiftTimeOpen = shiftTimeModal && shiftTimeModal.getAttribute('aria-hidden') === 'false';

			const breakModal = document.getElementById('break-modal-overlay');
			const isBreakModalOpen = breakModal && breakModal.getAttribute('aria-hidden') === 'false';

			const startOverlay = document.getElementById('start-overlay');
			const isStartScreen = startOverlay && startOverlay.getAttribute('aria-hidden') === 'false';

			const isSevered = document.body.classList.contains('severed');
			const isShiftComplete = document.body.classList.contains('shiftcomplete');
			const isMainScreen = document.body.classList.contains('started');

			// Full reset confirmation modal (highest priority)
			if (isFullResetOpen) {
				const fullResetSelectors = ['#btn-full-reset-confirm', '#btn-full-reset-cancel'];
				fullResetSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});
				return elements;
			}

			// Data reset confirmation modal (highest priority)
			if (isDataResetOpen) {
				const dataResetSelectors = ['#btn-data-reset-confirm', '#btn-data-reset-cancel'];
				dataResetSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});
				return elements;
			}

			// Clearance upgrade confirmation modal
			if (isClearanceOpen) {
				const clearanceSelectors = ['#btn-clearance-confirm', '#btn-clearance-cancel'];
				clearanceSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});
				return elements;
			}

			// Reset confirmation modal (highest priority)
			if (isResetOpen) {
				const resetSelectors = ['#btn-reset-confirm', '#btn-reset-cancel'];
				resetSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});
				return elements;
			}

			// Shift time modal
			if (isShiftTimeOpen) {
				const presetButtons = document.querySelectorAll('.shift-time-preset-btn');
				presetButtons.forEach(el => {
					if (isElementVisible(el)) elements.push(el);
				});

				// Custom time inputs
				const customHours = document.querySelector('#shift-time-custom-hours');
				if (customHours && isElementVisible(customHours)) elements.push(customHours);

				const customMinutes = document.querySelector('#shift-time-custom-minutes');
				if (customMinutes && isElementVisible(customMinutes)) elements.push(customMinutes);

				// Confirm/Cancel buttons
				const confirmBtn = document.querySelector('#btn-shift-time-confirm');
				if (confirmBtn && isElementVisible(confirmBtn)) elements.push(confirmBtn);

				const cancelBtn = document.querySelector('#btn-shift-time-cancel');
				if (cancelBtn && isElementVisible(cancelBtn)) elements.push(cancelBtn);

				return elements;
			}

			// Break modal
			if (isBreakModalOpen) {
				const breakButtons = document.querySelectorAll('.break-duration-btn');
				breakButtons.forEach(el => {
					if (isElementVisible(el)) elements.push(el);
				});

				const cancelBtn = document.querySelector('#btn-break-cancel');
				if (cancelBtn && isElementVisible(cancelBtn)) elements.push(cancelBtn);

				return elements;
			}

			// Help panel (takes priority when open)
			if (isHelpOpen) {
				const dismissBtn = document.querySelector('#btn-help-dismiss');
				if (dismissBtn && isElementVisible(dismissBtn)) elements.push(dismissBtn);
				return elements;
			}

			// Score panel (takes priority when open)
			if (isScoreOpen) {
				const dismissBtn = document.querySelector('#btn-score-dismiss');
				if (dismissBtn && isElementVisible(dismissBtn)) elements.push(dismissBtn);
				return elements;
			}

			// Options panel (takes priority when open)
			if (isOptionsOpen) {
				const optionsSelectors = [
					'#btn-sfx', '#sfx-volume-slider', '#btn-sfx-volume-reset',
					'#btn-keyboard', '#keyboard-volume-slider', '#btn-keyboard-volume-reset',
					'#btn-music', '#music-volume-slider', '#btn-music-volume-reset',
					'#btn-vfx',
					'#btn-zoom-out', '#btn-zoom-in'
				];

				optionsSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});

				// Add theme selector (different ID depending on screen)
				const themeSelect = isStartScreen ?
					document.querySelector('#start-theme-select') :
					document.querySelector('#theme-select');
				if (themeSelect && isElementVisible(themeSelect)) elements.push(themeSelect);

				// Add full reset button
				const fullResetBtn = document.querySelector('#btn-full-data-reset');
				if (fullResetBtn && isElementVisible(fullResetBtn)) elements.push(fullResetBtn);

				// Add dismiss button
				const dismissBtn = document.querySelector('#btn-options-dismiss');
				if (dismissBtn && isElementVisible(dismissBtn)) elements.push(dismissBtn);

				return elements;
			}

			// Start screen
			if (isStartScreen) {
				const startSelectors = [
					'#btn-start-options', '#btn-start-help',
					'#start-name-label', '#start-name-input',
					'#btn-start', '#btn-shift-time', '#btn-start-resume', '#btn-data-reset'
				];

				startSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});

				return elements;
			}

			// Severed screen
			if (isSevered) {
				const restartBtn = document.querySelector('#btn-restart');
				if (restartBtn && isElementVisible(restartBtn)) elements.push(restartBtn);
				return elements;
			}

			// Shift complete screen
			if (isShiftComplete) {
				const shiftCompleteSelectors = [
					'#btn-shiftcomplete-continue',
					'#btn-shiftcomplete-reset'
				];

				shiftCompleteSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});

				return elements;
			}

			// Main game screen
			if (isMainScreen) {
				// Header controls (theme, buttons)
				const headerSelectors = [
					'#theme-select', '#btn-share', '#btn-export', '#btn-resume',
					'#btn-sfx', '#btn-music', '#btn-vfx', '#btn-break', '#btn-score',
					'#btn-options', '#btn-help', '#btn-hard-reset'
				];

				headerSelectors.forEach(sel => {
					const el = document.querySelector(sel);
					if (el && isElementVisible(el)) elements.push(el);
				});

				// Operator input
				const opInput = document.querySelector('#operator-input');
				if (opInput && isElementVisible(opInput)) elements.push(opInput);

				// Main panel headers
				const panelIds = ['traffic', 'systems', 'terminal'];
				panelIds.forEach(id => {
					const panel = document.getElementById(id);
					const header = panel?.querySelector('.panel-header');
					if (header && isElementVisible(header)) {
						header.setAttribute('data-kb-panel-id', id);
						elements.push(header);
					}
				});

				// Console input
				const cmd = document.querySelector('#cmd');
				if (cmd && isElementVisible(cmd)) elements.push(cmd);

				return elements;
			}

			// Fallback: try to find any visible interactive elements
			return elements;
		}

		function buildPanelElements(panelId) {
			const panel = document.getElementById(panelId);
			if (!panel) return [];

			const elements = [];

			// Get subsection headers within this panel
			const subsections = panel.querySelectorAll('.subsection-header[data-panel]');
			subsections.forEach(el => {
				if (isElementVisible(el)) elements.push(el);
			});

			// Get direct child buttons (not in subsections)
			const buttons = panel.querySelectorAll(':scope > .panel-content > button, :scope > button');
			buttons.forEach(el => {
				if (isElementVisible(el) && !el.disabled) elements.push(el);
			});

			// Get direct child selects (not in subsections)
			const selects = panel.querySelectorAll(':scope > .panel-content > select, :scope > select');
			selects.forEach(el => {
				if (isElementVisible(el) && !el.disabled) elements.push(el);
			});

			return elements;
		}

		function buildSubsectionElements(subsectionPanelId) {
			const subsectionHeader = document.querySelector(`.subsection-header[data-panel="${subsectionPanelId}"]`);
			if (!subsectionHeader) return [];

			const elements = [];

			// Find the parent element that contains both the header and content
			const parent = subsectionHeader.parentElement;
			if (!parent) return [];

			// Get the subsection content area
			const content = parent.querySelector('.subsection-content');
			if (!content) return [];

			// Get buttons within this subsection
			const buttons = content.querySelectorAll('button');
			buttons.forEach(el => {
				if (isElementVisible(el) && !el.disabled) elements.push(el);
			});

			// Get selects within this subsection
			const selects = content.querySelectorAll('select');
			selects.forEach(el => {
				if (isElementVisible(el) && !el.disabled) elements.push(el);
			});

			// Get inputs within this subsection
			const inputs = content.querySelectorAll('input[type="text"], input[type="number"]');
			inputs.forEach(el => {
				if (isElementVisible(el) && !el.disabled) elements.push(el);
			});

			return elements;
		}

		function buildKeyboardHeaderElements() {
			const elements = [];

			// Only include header controls
			const headerSelectors = [
				'#theme-select', '#btn-share', '#btn-export', '#btn-resume',
				'#btn-sfx', '#btn-music', '#btn-vfx', '#btn-break', '#btn-score',
				'#btn-options', '#btn-help', '#btn-hard-reset'
			];

			headerSelectors.forEach(sel => {
				const el = document.querySelector(sel);
				if (el && isElementVisible(el)) elements.push(el);
			});

			return elements;
		}

		function buildKeyboardMainElements() {
			const elements = [];

			// Only include panels and main interactive elements (not header buttons)
			// Operator input
			const opInput = document.querySelector('#operator-input');
			if (opInput && isElementVisible(opInput)) elements.push(opInput);

			// Main panel headers
			const panelIds = ['traffic', 'systems', 'terminal'];
			panelIds.forEach(id => {
				const panel = document.getElementById(id);
				const header = panel?.querySelector('.panel-header');
				if (header && isElementVisible(header)) {
					header.setAttribute('data-kb-panel-id', id);
					elements.push(header);
				}
			});

			// Console input
			const cmd = document.querySelector('#cmd');
			if (cmd && isElementVisible(cmd)) elements.push(cmd);

			return elements;
		}

		function updateElementRegistry() {
			if (keyboardNav.currentLevel === 'root') {
				// Check if we're on the main game screen
				const startOverlay = document.getElementById('start-overlay');
				const isStartScreen = startOverlay && startOverlay.getAttribute('aria-hidden') === 'false';
				const isMainScreen = document.body.classList.contains('started');

				// Use header mode only on main game screen
				if (isMainScreen && !isStartScreen && keyboardNav.isHeaderMode) {
					keyboardNav.currentElements = buildKeyboardHeaderElements();
				} else if (isMainScreen && !isStartScreen && !keyboardNav.isHeaderMode) {
					keyboardNav.currentElements = buildKeyboardMainElements();
				} else {
					// For other screens (start, options, help, etc.), use normal buildRootElements
					keyboardNav.currentElements = buildRootElements();
				}
			} else if (keyboardNav.currentLevel === 'panel') {
				keyboardNav.currentElements = buildPanelElements(keyboardNav.currentPanelContext);
			} else if (keyboardNav.currentLevel === 'subsection') {
				keyboardNav.currentElements = buildSubsectionElements(keyboardNav.currentSubsectionContext);
			}
		}

		// Refresh element registries after DOM updates (for dynamically rendered content)
		function refreshNavigationRegistries() {
			// Only refresh if we're actively navigating within a panel or subsection
			if (keyboardNav.isActive && (keyboardNav.currentLevel === 'panel' || keyboardNav.currentLevel === 'subsection')) {
				const prevLength = keyboardNav.currentElements.length;
				updateElementRegistry();
				// Ensure current index is still valid after refresh
				if (keyboardNav.currentIndex >= keyboardNav.currentElements.length) {
					keyboardNav.currentIndex = Math.max(0, keyboardNav.currentElements.length - 1);
				}
				// Reapply selection to maintain visual feedback
				applySelection();
			}
			if (gamepadNav.isActive && (gamepadNav.currentLevel === 'panel' || gamepadNav.currentLevel === 'subsection')) {
				const prevLength = gamepadNav.currentElements.length;
				updateGamepadElementRegistry();
				// Ensure current index is still valid after refresh
				if (gamepadNav.currentIndex >= gamepadNav.currentElements.length) {
					gamepadNav.currentIndex = Math.max(0, gamepadNav.currentElements.length - 1);
				}
				// Reapply selection to maintain visual feedback
				applyGamepadSelection();
			}
		}

		function clearSelection() {
			document.querySelectorAll('.kb-selected').forEach(el => {
				el.classList.remove('kb-selected');
			});
		}

		function applySelection() {
			clearSelection();
			const el = keyboardNav.currentElements[keyboardNav.currentIndex];
			if (el) {
				el.classList.add('kb-selected');
				el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}
		}

		function activateKeyboardMode() {
			if (keyboardNav.isActive) return;

			keyboardNav.isActive = true;
			keyboardNav.isConsoleLocked = false;
			keyboardNav.isHeaderMode = false;
			keyboardNav.currentLevel = 'root';
			keyboardNav.currentIndex = 0;
			keyboardNav.navigationStack = [];
			keyboardNav.currentPanelContext = null;
			keyboardNav.currentSubsectionContext = null;

			updateElementRegistry();

			// Start at the first panel header instead of header buttons for easier access
			const firstPanelIndex = keyboardNav.currentElements.findIndex(el =>
				el.classList.contains('panel-header')
			);
			if (firstPanelIndex !== -1) {
				keyboardNav.currentIndex = firstPanelIndex;
			}

			applySelection();
			playSfx("showhide");
		}

		function deactivateKeyboardMode() {
			if (!keyboardNav.isActive) return;

			keyboardNav.isActive = false;
			keyboardNav.isConsoleLocked = false;
			keyboardNav.isSelectLocked = false;
			keyboardNav.isHeaderMode = false;
			clearSelection();

			// Blur any focused element if not console
			if (document.activeElement !== ui.cmd) {
				document.activeElement?.blur();
			}
		}

		function updateSelection(direction) {
			if (keyboardNav.currentElements.length === 0) return;

			// Blur any focused element to prevent it from capturing subsequent key presses
			if (document.activeElement && document.activeElement !== document.body && document.activeElement !== ui.cmd) {
				document.activeElement.blur();
			}

			const newIndex = keyboardNav.currentIndex + direction;

			// Clamp to boundaries (don't wrap around)
			if (newIndex < 0 || newIndex >= keyboardNav.currentElements.length) {
				// At boundary, don't move or play sound
				return;
			}

			keyboardNav.currentIndex = newIndex;
			applySelection();
			playSfx("click");
		}

		function enterElement() {
			const el = keyboardNav.currentElements[keyboardNav.currentIndex];
			if (!el) return;

			// Panel header - enter panel
			if (el.classList.contains('panel-header')) {
				const panelId = el.getAttribute('data-kb-panel-id');
				if (panelId) {
					keyboardNav.navigationStack.push({
						level: keyboardNav.currentLevel,
						index: keyboardNav.currentIndex,
						panelContext: keyboardNav.currentPanelContext,
						subsectionContext: keyboardNav.currentSubsectionContext
					});

					keyboardNav.currentLevel = 'panel';
					keyboardNav.currentPanelContext = panelId;
					keyboardNav.currentSubsectionContext = null;
					keyboardNav.currentIndex = 0;

					updateElementRegistry();
					applySelection();
					playSfx("showhide");
				}
				return;
			}

			// Console input - lock to console
			if (el.id === 'cmd') {
				keyboardNav.isConsoleLocked = true;
				el.focus();
				playSfx("click");
				return;
			}

			// Regular input - focus
			if (el.tagName === 'INPUT') {
				el.focus();
				playSfx("click");
				return;
			}

			// Select element - lock to select
			if (el.tagName === 'SELECT') {
				keyboardNav.isSelectLocked = true;
				el.focus();
				playSfx("click");
				return;
			}

			// Button - click it
			if (el.tagName === 'BUTTON') {
				el.click();
				playSfx("click");
				return;
			}

			// Subsection header - enter subsection
			if (el.classList.contains('subsection-header')) {
				const subsectionPanelId = el.getAttribute('data-panel');
				if (subsectionPanelId) {
					keyboardNav.navigationStack.push({
						level: keyboardNav.currentLevel,
						index: keyboardNav.currentIndex,
						panelContext: keyboardNav.currentPanelContext,
						subsectionContext: keyboardNav.currentSubsectionContext
					});

					keyboardNav.currentLevel = 'subsection';
					keyboardNav.currentSubsectionContext = subsectionPanelId;
					keyboardNav.currentIndex = 0;

					updateElementRegistry();
					applySelection();
					playSfx("showhide");
				}
				return;
			}
		}

		function exitLevel() {
			if (keyboardNav.navigationStack.length === 0) {
				// Already at root, deactivate keyboard mode
				deactivateKeyboardMode();
				return;
			}

			const previous = keyboardNav.navigationStack.pop();
			keyboardNav.currentLevel = previous.level;
			keyboardNav.currentIndex = previous.index;
			keyboardNav.currentPanelContext = previous.panelContext;
			keyboardNav.currentSubsectionContext = previous.subsectionContext || null;

			updateElementRegistry();
			applySelection();
			playSfx("showhide");
		}

		function toggleSelectedPanel() {
			const el = keyboardNav.currentElements[keyboardNav.currentIndex];
			if (!el) return;

			if (el.classList.contains('panel-header') || el.classList.contains('subsection-header')) {
				const panelId = el.getAttribute('data-panel') || el.getAttribute('data-kb-panel-id');
				if (panelId) {
					togglePanel(panelId);
				}
			}
		}

		function toggleKeyboardHeaderMode() {
			if (keyboardNav.currentLevel !== 'root') return;

			// Check if we're on the main game screen
			const startOverlay = document.getElementById('start-overlay');
			const isStartScreen = startOverlay && startOverlay.getAttribute('aria-hidden') === 'false';
			const isMainScreen = document.body.classList.contains('started');

			// Only toggle on main game screen
			if (!isMainScreen || isStartScreen) return;

			keyboardNav.isHeaderMode = !keyboardNav.isHeaderMode;
			keyboardNav.currentIndex = 0;
			updateElementRegistry();
			applySelection();
			playSfx("showhide");
		}

		function jumpToNextSection(direction) {
			if (keyboardNav.currentLevel !== 'root' || keyboardNav.currentElements.length === 0) return;

			const currentEl = keyboardNav.currentElements[keyboardNav.currentIndex];
			if (!currentEl) return;

			// Define section boundaries
			const sections = [];
			let currentSection = [];
			let sectionType = null;

			// Build sections based on element types
			for (let i = 0; i < keyboardNav.currentElements.length; i++) {
				const el = keyboardNav.currentElements[i];
				let type;

				if (el.classList.contains('panel-header')) {
					type = 'panels';
				} else if (el.id === 'cmd') {
					type = 'console';
				} else if (el.id === 'operator-input') {
					type = 'operator';
				} else {
					type = 'header';
				}

				// Start new section if type changed
				if (type !== sectionType && currentSection.length > 0) {
					sections.push({ type: sectionType, startIndex: currentSection[0], endIndex: currentSection[currentSection.length - 1] });
					currentSection = [];
				}

				currentSection.push(i);
				sectionType = type;
			}

			// Add final section
			if (currentSection.length > 0) {
				sections.push({ type: sectionType, startIndex: currentSection[0], endIndex: currentSection[currentSection.length - 1] });
			}

			// Find current section
			let currentSectionIndex = -1;
			for (let i = 0; i < sections.length; i++) {
				if (keyboardNav.currentIndex >= sections[i].startIndex && keyboardNav.currentIndex <= sections[i].endIndex) {
					currentSectionIndex = i;
					break;
				}
			}

			if (currentSectionIndex === -1) return;

			// Calculate target section
			let targetSectionIndex = currentSectionIndex + direction;

			// Wrap around
			if (targetSectionIndex < 0) {
				targetSectionIndex = sections.length - 1;
			} else if (targetSectionIndex >= sections.length) {
				targetSectionIndex = 0;
			}

			// Jump to first element of target section
			keyboardNav.currentIndex = sections[targetSectionIndex].startIndex;
			applySelection();
			playSfx("click");
		}

		function unlockConsoleNav() {
			if (!keyboardNav.isConsoleLocked) return;

			keyboardNav.isConsoleLocked = false;
			applySelection();
		}

		function unlockSelectNav() {
			if (!keyboardNav.isSelectLocked) return;

			keyboardNav.isSelectLocked = false;
			document.activeElement?.blur();
			applySelection();
		}

		// Arrow key detector (always active)
		document.addEventListener('keydown', (e) => {
			// Check if arrow key pressed
			if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) return;

			// If already in keyboard mode, let the handler deal with it
			if (keyboardNav.isActive) return;

			// Don't activate if user is in an input (except for console when we're in keyboard mode)
			const activeTag = document.activeElement?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'SELECT' || activeTag === 'TEXTAREA') {
				return;
			}

			// Activate keyboard mode
			activateKeyboardMode();
			e.preventDefault();
		});

		// Global Tab handler to toggle header (normal mode)
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Tab') return;
			if (keyboardNav.isActive || gamepadNav.isActive) return;

			const activeEl = document.activeElement;
			const activeTag = activeEl?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'SELECT' || activeTag === 'TEXTAREA' || activeEl?.isContentEditable) {
				return;
			}

			toggleHeaderCollapsed();
			e.preventDefault();
			e.stopPropagation();
		}, true);

		// Keyboard navigation handler
		document.addEventListener('keydown', (e) => {
			if (!keyboardNav.isActive) return;

			// Console lock mode
			if (keyboardNav.isConsoleLocked) {
				if (e.key === 'Escape') {
					unlockConsoleNav();
					e.preventDefault();
					e.stopPropagation();
				}
				return; // All other keys go to console
			}

			// Select lock mode
			if (keyboardNav.isSelectLocked) {
				if (e.key === 'Escape') {
					unlockSelectNav();
					e.preventDefault();
					e.stopPropagation();
				}
				// Arrow keys work on the select element
				return;
			}

			switch(e.key) {
				case 'Tab':
					// Toggle header show/hide
					if (keyboardNav.currentLevel === 'root') {
						toggleHeaderCollapsed();
						e.preventDefault();
						e.stopPropagation();
					}
					break;

				case 'ArrowUp':
					updateSelection(-1);
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'ArrowDown':
					updateSelection(1);
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'ArrowLeft':
					exitLevel();
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'ArrowRight':
					enterElement();
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'Enter':
					enterElement();
					e.preventDefault();
					e.stopPropagation();
					break;

				case ' ':
					// Space to activate
					enterElement();
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'Escape':
				case 'Backspace':
					exitLevel();
					e.preventDefault();
					e.stopPropagation();
					break;

				case 'Shift':
					toggleSelectedPanel();
					e.preventDefault();
					e.stopPropagation();
					break;
			}
		}, true); // Use capture to handle before other listeners

		// Click deactivation handler
		document.addEventListener('click', () => {
			if (keyboardNav.isActive && !keyboardNav.isConsoleLocked) {
				deactivateKeyboardMode();
			}
			if (gamepadNav.isActive && !gamepadNav.isConsoleLocked) {
				deactivateGamepadMode();
			}
		});

		// Mouse movement deactivation handler for gamepad
		document.addEventListener('mousemove', () => {
			if (gamepadNav.isActive && !gamepadNav.isConsoleLocked) {
				deactivateGamepadMode();
			}
		});

    // ---------------------------
    // Gamepad Navigation System
    // ---------------------------

    // Gamepad button mapping constants
    const GAMEPAD_BUTTONS = {
      A: 0, B: 1, X: 2, Y: 3,
      LB: 4, RB: 5, LT: 6, RT: 7,
      SELECT: 8, START: 9,
      L_STICK: 10, R_STICK: 11,
      DPAD_UP: 12, DPAD_DOWN: 13,
      DPAD_LEFT: 14, DPAD_RIGHT: 15
    };

    const GAMEPAD_AXES = {
      LEFT_X: 0, LEFT_Y: 1,
      RIGHT_X: 2, RIGHT_Y: 3
    };

    const VIRTUAL_KEYBOARD_LAYOUT = [
      ['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P'],
      ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L'],
      ['Z', 'X', 'C', 'V', 'B', 'N', 'M'],
      ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0'],
      ['SPACE', '-', 'BKSP'],
      ['CLEAR', 'ENTER', 'CANCEL']
    ];

    // Gamepad API Integration
    function initGamepadSystem() {
      if (!('getGamepads' in navigator)) {
        console.warn('Gamepad API not supported');
        return;
      }

      window.addEventListener('gamepadconnected', (e) => {
        console.log('Gamepad connected:', e.gamepad.id);
        playSfx("beep");
      });

      window.addEventListener('gamepaddisconnected', (e) => {
        console.log('Gamepad disconnected:', e.gamepad.id);
        if (gamepadNav.isActive) {
          deactivateGamepadMode();
        }
      });

      gamepadPollLoop();
    }

    function gamepadPollLoop() {
      const gamepads = navigator.getGamepads();
      gamepadNav.connectedGamepads = Array.from(gamepads).filter(gp => gp !== null);

      if (gamepadNav.connectedGamepads.length > 0) {
        processGamepadInput(gamepadNav.connectedGamepads[0]);
      }

      requestAnimationFrame(gamepadPollLoop);
    }

    // Input Processing
    function processGamepadInput(gamepad) {
      const enabled = loadStoredBool(LS.gamepadEnabled, true);
      if (!enabled) return;

      const currentStates = gamepad.buttons.map(b => b.pressed);
      const previousStates = gamepadNav.buttonStates[gamepad.index] || [];

      for (let i = 0; i < currentStates.length; i++) {
        if (currentStates[i] && !previousStates[i]) {
          handleGamepadButtonPress(i);
        }
      }

      const now = Date.now();
      if (now - gamepadNav.lastPollTimestamp > 150) {
        handleGamepadSticks(gamepad.axes);
        gamepadNav.lastPollTimestamp = now;
      }

      gamepadNav.buttonStates[gamepad.index] = currentStates;
    }

    function handleGamepadButtonPress(buttonIndex) {
      if (!gamepadNav.isActive && !keyboardNav.isActive) {
        activateGamepadMode();
        // Don't return - process the button press that activated the mode
      }

      if (!gamepadNav.isActive) return;

      // Virtual keyboard mode
      if (gamepadNav.currentLevel === 'vkeyboard') {
        if (buttonIndex === GAMEPAD_BUTTONS.A) {
          const keys = VIRTUAL_KEYBOARD_LAYOUT.flat();
          const key = keys[gamepadNav.currentIndex];
          handleVirtualKeyPress(key);
        } else if (buttonIndex === GAMEPAD_BUTTONS.B) {
          hideVirtualKeyboard();
        } else if (buttonIndex === GAMEPAD_BUTTONS.DPAD_UP) {
          updateGamepadSelection(-3);
        } else if (buttonIndex === GAMEPAD_BUTTONS.DPAD_DOWN) {
          updateGamepadSelection(3);
        } else if (buttonIndex === GAMEPAD_BUTTONS.DPAD_LEFT) {
          updateGamepadSelection(-1);
        } else if (buttonIndex === GAMEPAD_BUTTONS.DPAD_RIGHT) {
          updateGamepadSelection(1);
        }
        return;
      }

      // Select lock mode
      if (gamepadNav.isSelectLocked) {
        if (buttonIndex === GAMEPAD_BUTTONS.B) {
          unlockGamepadSelect();
        }
        // D-pad buttons work on the select element
        return;
      }

      // Normal navigation
      switch(buttonIndex) {
        case GAMEPAD_BUTTONS.DPAD_UP:
          updateGamepadSelection(-1);
          break;
        case GAMEPAD_BUTTONS.DPAD_DOWN:
          updateGamepadSelection(1);
          break;
        case GAMEPAD_BUTTONS.DPAD_LEFT:
        case GAMEPAD_BUTTONS.B:
          exitGamepadLevel();
          break;
        case GAMEPAD_BUTTONS.DPAD_RIGHT:
        case GAMEPAD_BUTTONS.A:
          enterGamepadElement();
          break;
        case GAMEPAD_BUTTONS.Y:
          toggleSelectedGamepadPanel();
          break;
        case GAMEPAD_BUTTONS.START:
          toggleHeaderMode();
          break;
      }
    }

    function handleGamepadSticks(axes) {
      if (!gamepadNav.isActive) return;

      const leftY = axes[GAMEPAD_AXES.LEFT_Y];
      const rightY = axes[GAMEPAD_AXES.RIGHT_Y];

      // Left stick: navigate elements
      if (Math.abs(leftY) > gamepadNav.stickDeadzone) {
        updateGamepadSelection(leftY > 0 ? 1 : -1);
      }

      // Right stick: scroll containers
      if (Math.abs(rightY) > gamepadNav.stickDeadzone) {
        scrollGamepadPanel(rightY > 0 ? 1 : -1);
      }
    }

    // Navigation Functions
    function activateGamepadMode() {
      if (gamepadNav.isActive) return;
      if (keyboardNav.isActive) deactivateKeyboardMode();

      gamepadNav.isActive = true;
      gamepadNav.isConsoleLocked = false;
      gamepadNav.isHeaderMode = false;
      gamepadNav.currentLevel = 'root';
      gamepadNav.currentIndex = 0;
      gamepadNav.navigationStack = [];
      gamepadNav.currentPanelContext = null;
      gamepadNav.currentSubsectionContext = null;

      updateGamepadElementRegistry();

      // Start at the first panel header instead of header buttons for easier access
      const firstPanelIndex = gamepadNav.currentElements.findIndex(el =>
        el.classList.contains('panel-header')
      );
      if (firstPanelIndex !== -1) {
        gamepadNav.currentIndex = firstPanelIndex;
      }

      applyGamepadSelection();
      playSfx("showhide");
    }

    function deactivateGamepadMode() {
      if (!gamepadNav.isActive) return;

      gamepadNav.isActive = false;
      gamepadNav.isConsoleLocked = false;
      gamepadNav.isSelectLocked = false;
      gamepadNav.isHeaderMode = false;
      clearGamepadSelection();

      if (gamepadNav.isVirtualKeyboardVisible) {
        hideVirtualKeyboard();
      }

      if (document.activeElement !== ui.cmd) {
        document.activeElement?.blur();
      }
    }

    function updateGamepadElementRegistry() {
      if (gamepadNav.currentLevel === 'root') {
        gamepadNav.currentElements = gamepadNav.isHeaderMode
          ? buildHeaderElements()
          : buildRootElements();
      } else if (gamepadNav.currentLevel === 'panel') {
        gamepadNav.currentElements = buildPanelElements(gamepadNav.currentPanelContext);
      } else if (gamepadNav.currentLevel === 'subsection') {
        gamepadNav.currentElements = buildSubsectionElements(gamepadNav.currentSubsectionContext);
      } else if (gamepadNav.currentLevel === 'vkeyboard') {
        gamepadNav.currentElements = buildVirtualKeyboardElements();
      }
    }

    function clearGamepadSelection() {
      document.querySelectorAll('.gp-selected').forEach(el => {
        el.classList.remove('gp-selected');
      });
    }

    function applyGamepadSelection() {
      clearGamepadSelection();
      const el = gamepadNav.currentElements[gamepadNav.currentIndex];
      if (el) {
        el.classList.add('gp-selected');
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function updateGamepadSelection(direction) {
      if (gamepadNav.currentElements.length === 0) return;

      // Blur any focused element to prevent it from capturing subsequent key presses
      if (document.activeElement && document.activeElement !== document.body && document.activeElement !== ui.cmd) {
        document.activeElement.blur();
      }

      const newIndex = gamepadNav.currentIndex + direction;

      if (newIndex < 0 || newIndex >= gamepadNav.currentElements.length) {
        return;
      }

      gamepadNav.currentIndex = newIndex;
      applyGamepadSelection();
      playSfx("click");
    }

    function enterGamepadElement() {
      const el = gamepadNav.currentElements[gamepadNav.currentIndex];
      if (!el) return;

      // Panel header
      if (el.classList.contains('panel-header')) {
        const panelId = el.getAttribute('data-kb-panel-id');
        if (panelId) {
          gamepadNav.navigationStack.push({
            level: gamepadNav.currentLevel,
            index: gamepadNav.currentIndex,
            panelContext: gamepadNav.currentPanelContext,
            subsectionContext: gamepadNav.currentSubsectionContext
          });

          gamepadNav.currentLevel = 'panel';
          gamepadNav.currentPanelContext = panelId;
          gamepadNav.currentSubsectionContext = null;
          gamepadNav.currentIndex = 0;

          updateGamepadElementRegistry();
          applyGamepadSelection();
          playSfx("showhide");
        }
        return;
      }

      // Console input - show virtual keyboard
      if (el.id === 'cmd' || (el.tagName === 'INPUT' && el.type === 'text')) {
        showVirtualKeyboard();
        return;
      }

      // Select element - lock to select
      if (el.tagName === 'SELECT') {
        gamepadNav.isSelectLocked = true;
        el.focus();
        playSfx("click");
        return;
      }

      // Button - click it
      if (el.tagName === 'BUTTON') {
        el.click();
        playSfx("click");
        return;
      }

      // Subsection header - enter subsection
      if (el.classList.contains('subsection-header')) {
        const subsectionPanelId = el.getAttribute('data-panel');
        if (subsectionPanelId) {
          gamepadNav.navigationStack.push({
            level: gamepadNav.currentLevel,
            index: gamepadNav.currentIndex,
            panelContext: gamepadNav.currentPanelContext,
            subsectionContext: gamepadNav.currentSubsectionContext
          });

          gamepadNav.currentLevel = 'subsection';
          gamepadNav.currentSubsectionContext = subsectionPanelId;
          gamepadNav.currentIndex = 0;

          updateGamepadElementRegistry();
          applyGamepadSelection();
          playSfx("showhide");
        }
        return;
      }
    }

    function exitGamepadLevel() {
      if (gamepadNav.navigationStack.length === 0) {
        deactivateGamepadMode();
        return;
      }

      const previous = gamepadNav.navigationStack.pop();
      gamepadNav.currentLevel = previous.level;
      gamepadNav.currentIndex = previous.index;
      gamepadNav.currentPanelContext = previous.panelContext;
      gamepadNav.currentSubsectionContext = previous.subsectionContext || null;

      updateGamepadElementRegistry();
      applyGamepadSelection();
      playSfx("showhide");
    }

    function toggleSelectedGamepadPanel() {
      const el = gamepadNav.currentElements[gamepadNav.currentIndex];
      if (!el) return;

      let panelId = null;

      if (el.classList.contains('panel-header') || el.classList.contains('subsection-header')) {
        panelId = el.getAttribute('data-panel');
      }

      if (panelId) {
        togglePanel(panelId);
      }
    }

    function unlockGamepadSelect() {
      if (!gamepadNav.isSelectLocked) return;

      gamepadNav.isSelectLocked = false;
      document.activeElement?.blur();
      applyGamepadSelection();
    }

    function toggleHeaderMode() {
      gamepadNav.isHeaderMode = !gamepadNav.isHeaderMode;
      gamepadNav.currentIndex = 0;
      updateGamepadElementRegistry();
      applyGamepadSelection();
      playSfx("showhide");
    }

    function buildHeaderElements() {
      const headers = [];
      const headerButtons = [
        ui.btnTheme, ui.btnShare,
        ui.btnSfx, ui.btnMusic, ui.btnVfx, ui.btnKeyboard,
        ui.btnBreak, ui.btnMenu
      ];

      headerButtons.forEach(btn => {
        if (btn && isElementVisible(btn)) {
          headers.push(btn);
        }
      });

      return headers;
    }

    function scrollGamepadPanel(direction) {
      const currentEl = gamepadNav.currentElements[gamepadNav.currentIndex];
      if (!currentEl) return;

      let scrollContainer = null;

      // Try to find scroll container based on current navigation level
      if (gamepadNav.currentLevel === 'panel' && gamepadNav.currentPanelContext) {
        // In panel mode, scroll the panel's content
        const panel = document.getElementById(gamepadNav.currentPanelContext);
        scrollContainer = panel?.querySelector('.panel-content');
      } else if (gamepadNav.currentLevel === 'subsection' && gamepadNav.currentSubsectionContext) {
        // In subsection mode, scroll the subsection's content
        const subsectionHeader = document.querySelector(`.subsection-header[data-panel="${gamepadNav.currentSubsectionContext}"]`);
        const parent = subsectionHeader?.parentElement;
        scrollContainer = parent?.querySelector('.subsection-content');
      }

      // Fallback: try to find scroll container from current element
      if (!scrollContainer) {
        scrollContainer = currentEl.closest('.panel-content, .scroll, .subsection-content, .logbox');
      }

      if (scrollContainer) {
        const scrollAmount = 60;
        scrollContainer.scrollTop += direction * scrollAmount;
        playSfx("click");
      }
    }

    // Virtual Keyboard Functions
    function createVirtualKeyboard() {
      const vkGrid = document.getElementById('vk-grid');
      if (!vkGrid) {
        console.error('Virtual keyboard grid element not found');
        return;
      }

      vkGrid.innerHTML = '';

      VIRTUAL_KEYBOARD_LAYOUT.forEach(row => {
        row.forEach(key => {
          const btn = document.createElement('button');
          btn.className = 'vk-key';
          btn.textContent = key === 'SPACE' ? '___' : key;
          btn.setAttribute('data-vk-key', key);

          if (key === 'SPACE' || key === 'ENTER' || key === 'CANCEL' || key === 'CLEAR') {
            btn.classList.add('wide');
          }

          vkGrid.appendChild(btn);
        });
      });
    }

    function showVirtualKeyboard() {
      // Prevent showing if already visible
      if (gamepadNav.isVirtualKeyboardVisible) {
        return;
      }

      const vk = document.getElementById('virtual-keyboard');
      const terminal = document.getElementById('terminal');

      if (!vk) {
        console.error('Virtual keyboard element not found');
        return;
      }

      if (!terminal) {
        console.error('Terminal element not found');
        return;
      }

      // Always recreate keyboard elements to ensure they exist
      createVirtualKeyboard();

      // Verify keyboard was created
      if (!vk.querySelector('.vk-key')) {
        console.error('Virtual keyboard keys were not created');
        return;
      }

      vk.classList.add('visible');
      terminal.classList.add('has-virtual-keyboard');

      gamepadNav.isVirtualKeyboardVisible = true;
      gamepadNav.navigationStack.push({
        level: gamepadNav.currentLevel,
        index: gamepadNav.currentIndex,
        panelContext: gamepadNav.currentPanelContext
      });

      gamepadNav.currentLevel = 'vkeyboard';
      gamepadNav.currentIndex = 0;
      updateGamepadElementRegistry();
      applyGamepadSelection();
      playSfx("showhide");

      updateVirtualKeyboardDisplay();
    }

    function hideVirtualKeyboard() {
      const vk = document.getElementById('virtual-keyboard');
      const terminal = document.getElementById('terminal');

      if (vk) vk.classList.remove('visible');
      if (terminal) terminal.classList.remove('has-virtual-keyboard');

      gamepadNav.isVirtualKeyboardVisible = false;

      const previous = gamepadNav.navigationStack.pop();
      if (previous) {
        gamepadNav.currentLevel = previous.level;
        gamepadNav.currentIndex = previous.index;
        gamepadNav.currentPanelContext = previous.panelContext;
      }

      updateGamepadElementRegistry();
      applyGamepadSelection();
      playSfx("showhide");
    }

    function handleVirtualKeyPress(key) {
      const cmdInput = document.getElementById('cmd');

      if (key === 'ENTER') {
        const command = cmdInput.value;
        if (command) {
          runCommand(command);
          cmdInput.value = '';
        }
        hideVirtualKeyboard();
      } else if (key === 'CANCEL') {
        hideVirtualKeyboard();
      } else if (key === 'BKSP') {
        cmdInput.value = cmdInput.value.slice(0, -1);
      } else if (key === 'CLEAR') {
        cmdInput.value = '';
      } else if (key === 'SPACE') {
        cmdInput.value += ' ';
      } else {
        cmdInput.value += key;
      }

      updateVirtualKeyboardDisplay();
      playSfx("click");
    }

    function updateVirtualKeyboardDisplay() {
      const display = document.getElementById('vk-input-display');
      const cmdInput = document.getElementById('cmd');
      if (display && cmdInput) {
        display.textContent = cmdInput.value || '_';
      }
    }

    function buildVirtualKeyboardElements() {
      const keys = [];
      document.querySelectorAll('.vk-key').forEach(key => {
        keys.push(key);
      });
      return keys;
    }

    // Settings Functions
    function loadGamepadSettings() {
      const enabled = loadStoredBool(LS.gamepadEnabled, true);
      const deadzone = parseFloat(localStorage.getItem(LS.gamepadDeadzone) || '0.3');

      gamepadNav.stickDeadzone = deadzone;

      // Always initialize gamepad system to support gamepad-only devices
      // The enabled check happens in processGamepadInput()
      initGamepadSystem();

      // Update UI to reflect current state
      updateGamepadUI();
    }

    function setGamepadEnabled(enabled) {
      localStorage.setItem(LS.gamepadEnabled, enabled ? 'true' : 'false');

      // Deactivate gamepad mode if currently active and being disabled
      if (!enabled && gamepadNav.isActive) {
        deactivateGamepadMode();
      }

      // Update UI to reflect new state
      updateGamepadUI();
    }

    function updateGamepadUI() {
      const enabled = loadStoredBool(LS.gamepadEnabled, true);
      const statusEl = document.getElementById('gamepad-status');
      if (statusEl) {
        statusEl.textContent = enabled ? 'GAMEPAD: ENABLED' : 'GAMEPAD: DISABLED';
      }
    }

    // ---------------------------
    // Boot
    // ---------------------------
    async function boot() {
      loadTheme();
      populateThemeDropdown();
      loadFontScale();
      loadCollapsedPanels();
      runtime.shiftCompleteShown = loadStoredBool(LS.shiftCompleteShown, false);
      runtime.catalog = loadGateCatalog();
			const resumeBoot = typeof runtime.resumeShiftMs === "number";
			const storedShiftMs = loadShiftMsFromStorage();

			// If joining via invite code, don't initialize shift timing from local storage
			// The host will send the correct timing via state sync
			const isJoiningViaInvite = runtime.multiplayer.coop.pendingJoinCode || runtime.multiplayer.coop.role === "invited";

			runtime.shiftStart = resumeBoot
				? Date.now() - runtime.resumeShiftMs
				: isJoiningViaInvite
					? Date.now() // Placeholder, will be overwritten by host's state sync
					: Date.now() - storedShiftMs;

			runtime.resumeShiftMs = null;
      runtime.resumeShiftMs = null;
      const initialGate = runtime.catalog;
      if (ui.gateDisplay) ui.gateDisplay.textContent = initialGate;

      runtime.activeGateId = initialGate;
      runtime.operatorCallsign = loadOperatorCallsignForGate(initialGate);
      if (!applyDefaultCallsignIfNeeded(initialGate)) {
        updateOperatorLabel();
        updateStartNameLabel();
      }

      clearLog(ui.console);
      clearLog(ui.events);

      setGateById(initialGate, true);
      eventLine("EVENT LOG: ACTIVE", "dim");
      updateMusicState();

      // Re-prime looped audio elements to ensure they can play after SEVER/shift complete
      // This is critical for audio to work properly after pausing/stopping
      primeLoopedAudio();

      // Check for severed state in localStorage
      try {
        const severedFlag = localStorage.getItem(LS.severed);
        if (severedFlag === "true") {
          runtime.severed = true;
          const savedSummary = localStorage.getItem(LS.lastSevered);
          if (savedSummary) {
            runtime.lastSevered = JSON.parse(savedSummary);
          }
        }
      } catch (_) {}

      if (runtime.severed && runtime.lastSevered) {
        updateSeveredOverlay(runtime.lastSevered);
        document.body.classList.add("severed");
      } else {
        document.body.classList.remove("severed");
      }

      if (runtime.tickTimer) clearInterval(runtime.tickTimer);
      if (runtime.uiTimer) clearInterval(runtime.uiTimer);
      if (runtime.ambientSoundTimer) clearInterval(runtime.ambientSoundTimer);

      runtime.tickTimer = setInterval(tickAllGates, 1000);
      runtime.uiTimer = setInterval(() => {
        const shiftMs = Date.now() - runtime.shiftStart;
        const shiftDurationMs = loadShiftDuration();
        const shiftMode = loadShiftMode();

        // Check for shift completion (skip for unlimited/endurance modes)
        if (!runtime.shiftCompleteShown && !runtime.severed && shiftDurationMs !== -1 && shiftMs >= shiftDurationMs) {
          triggerShiftComplete();
        }

        ui.dataAge.textContent = formatClockHM(Date.now());
        if (runtime.severed) return;
        // Update display to show current / total format with percentage
        if (shiftMode === "unlimited" || shiftMode === "endurance" || shiftDurationMs === -1) {
          ui.shiftTime.textContent = `${formatHMS(shiftMs)} // ${shiftMode.toUpperCase()}`;
        } else {
          const percentage = Math.min(100, Math.floor((shiftMs / shiftDurationMs) * 100));
          ui.shiftTime.textContent = `${formatHMS(shiftMs)} // ${formatHMS(shiftDurationMs)} // ${percentage}%`;
        }
        const g = activeGate();
        const stats = ensureGateStats(g);
        if (ui.shiftWage) {
          ui.shiftWage.textContent = `${computeWage(stats, shiftMs)} CR`;
        }
        updateMaintenanceCooldownUI();
      }, 250);
      runtime.ambientSoundTimer = setInterval(checkAmbientSound, 60000); // Check every 60 seconds

      // Initialize multiplayer connection
      initMultiplayer();

      // Update endurance button states
      updateEnduranceButtons();

      // Initialize gamepad system
      loadGamepadSettings();

      // Register save handlers (once, not in tick loop)
      window.addEventListener("pagehide", saveShiftMsToStorage);
      window.addEventListener("beforeunload", () => {
        saveShiftMsToStorage();
        cleanupMultiplayer();
      });

      setTimeout(() => ui.cmd.focus(), 150);
    }

    // ---------------------------
    // Multiplayer: WebSocket Connection
    // ---------------------------

    function initMultiplayer() {
      // Allow auto-reconnect for normal disconnects
      runtime.multiplayer.shouldReconnect = true;
      // Skip if already connected or connecting
      if (runtime.multiplayer.ws &&
          (runtime.multiplayer.ws.readyState === WebSocket.OPEN ||
           runtime.multiplayer.ws.readyState === WebSocket.CONNECTING)) {
        return;
      }

      const serverUrl = safeStorageGet(LS.multiplayerServer) || "wss://thequietend.com/ws";
      runtime.multiplayer.serverUrl = serverUrl;

      try {
        const ws = new WebSocket(serverUrl);
        runtime.multiplayer.ws = ws;

        ws.addEventListener("open", onMultiplayerOpen);
        ws.addEventListener("message", onMultiplayerMessage);
        ws.addEventListener("close", onMultiplayerClose);
        ws.addEventListener("error", onMultiplayerError);

      } catch (err) {
        console.warn("Multiplayer connection failed:", err);
        runtime.multiplayer.enabled = false;
        updateConnectionIndicator();
      }
    }

    function onMultiplayerOpen() {
      const gateId = activeGate().id;
      const isReconnection = runtime.multiplayer.wasConnectedBefore;
      const msg = {
        type: "connect",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          operatorCallsign: runtime.operatorCallsign || "OPERATOR",
          shiftStart: runtime.shiftStart,
          isReconnection: isReconnection
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
      runtime.multiplayer.reconnectAttempts = 0;

      // Mark as connected before
      runtime.multiplayer.wasConnectedBefore = true;

      // Send heartbeat immediately to populate health state, then continue on interval
      sendHeartbeat();
      // Start heartbeat
      if (runtime.multiplayer.heartbeatTimer) clearInterval(runtime.multiplayer.heartbeatTimer);
      runtime.multiplayer.heartbeatTimer = setInterval(sendHeartbeat, 30000);

      eventLine("GATE NETWORK: CONNECTED", "good");
    }

    function onMultiplayerMessage(event) {
      try {
        const msg = JSON.parse(event.data);
        handleMultiplayerMessage(msg);
      } catch (err) {
        console.error("Failed to parse multiplayer message:", err);
      }
    }

    function onMultiplayerClose() {
      const wasCoopInvited = runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited";
      runtime.multiplayer.enabled = false;
      runtime.multiplayer.playerId = null;
      runtime.multiplayer.players = [];
      runtime.multiplayer.playerCount = 0;

      if (wasCoopInvited) {
        handleCoopSessionEnded({ reason: "disconnect" });
      }

      if (runtime.multiplayer.heartbeatTimer) {
        clearInterval(runtime.multiplayer.heartbeatTimer);
        runtime.multiplayer.heartbeatTimer = null;
      }

      // Clean up all gate states and ping audio timers
      const g = activeGate();
      if (g.pendingPlayerPings) {
        g.pendingPlayerPings.forEach(ping => {
          if (ping.audioTimer) {
            clearInterval(ping.audioTimer);
            ping.audioTimer = null;
          }
        });
        g.pendingPlayerPings = [];
      }

      // Clear all gate states
      runtime.multiplayer.gateStates.clear();

      updateConnectionIndicator();
      eventLine("GATE NETWORK: DISCONNECTED", "warn");

      // Auto-reconnect
      attemptReconnect();
    }

    function onMultiplayerError(err) {
      console.warn("Multiplayer error:", err);
    }

    function attemptReconnect() {
      // Don't reconnect if multiplayer was intentionally disabled (e.g., from reset/disconnect)
      if (runtime.multiplayer.shouldReconnect === false) return;
      if (runtime.multiplayer.reconnectAttempts >= 3) {
        eventLine("GATE NETWORK: RECONNECT FAILED", "bad");
        return;
      }

      runtime.multiplayer.reconnectAttempts++;
      const delay = Math.min(5000 * runtime.multiplayer.reconnectAttempts, 15000);

      eventLine(`GATE NETWORK: RECONNECTING IN ${delay/1000}s`, "dim");

      runtime.multiplayer.reconnectTimer = setTimeout(() => {
        initMultiplayer();
      }, delay);
    }

    function sendHeartbeat() {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) return;

      const g = activeGate();
      const msg = {
        type: "heartbeat",
        timestamp: Date.now(),
        data: {
          gateId: g.id,
          operatorCallsign: runtime.operatorCallsign || "OPERATOR",
          stats: g.stats || {},
          health: g.health || computeHealth(g),
          relayHealthState: computeRelayHealthState(g)?.state || "UNKNOWN",
          mode: loadShiftMode() || "normal",
          shiftDurationMs: loadShiftDuration() || (8 * 60 * 60 * 1000)
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
    }

    function sendGameStateChange(gameActive, reason = null) {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) return;

      const gateId = activeGate().id;
      const msg = {
        type: "game_state_change",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          gameActive: gameActive,
          reason: reason
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
    }

    function handleMultiplayerMessage(msg) {
      switch (msg.type) {
        case "welcome":
          handleWelcome(msg.data);
          break;
        case "player_list":
          handlePlayerList(msg.data);
          break;
        case "ping_received":
          handlePingReceived(msg.data);
          break;
        case "ack_received":
          handleAckReceived(msg.data);
          break;
        case "message_received":
          handleMessageReceived(msg.data);
          break;
        case "error":
          handleMultiplayerError(msg.data);
          break;
        case "coop_session_created":
          handleCoopSessionCreated(msg.data);
          break;
        case "coop_session_joined":
          handleCoopSessionJoined(msg.data);
          break;
        case "coop_player_joined":
          handleCoopPlayerJoined(msg.data);
          break;
        case "coop_player_left":
          handleCoopPlayerLeft(msg.data);
          break;
        case "coop_participants_update":
          handleCoopParticipantsUpdate(msg.data);
          break;
        case "coop_state_update":
          handleCoopStateUpdate(msg.data);
          break;
        case "coop_event":
          handleCoopEvent(msg.data);
          break;
        case "coop_action_received":
          handleCoopActionReceived(msg.data);
          break;
        case "coop_session_ended":
          handleCoopSessionEnded(msg.data);
          break;
        case "coop_kicked":
          handleCoopKicked(msg.data);
          break;
      }
    }

    function handleWelcome(data) {
      runtime.multiplayer.enabled = true;
      runtime.multiplayer.playerId = data.playerId;
      runtime.multiplayer.playerCount = data.playerCount;
      runtime.multiplayer.lastPlayerCount = data.playerCount;
      runtime.multiplayer.pingMatrix = data.pingMatrix || {};

      updateConnectionIndicator();
      eventLine(`GATE NETWORK: ACTIVE (${data.playerCount} NODES)`, "good");

      // Send game state: active if game is started and not severed/completed
      const isGameActive = document.body.classList.contains("started") &&
                          !runtime.severed &&
                          !runtime.shiftCompleteShown;
      sendGameStateChange(isGameActive);

      // Auto-join co-op session if there's a pending join code
      if (runtime.multiplayer.coop.pendingJoinCode) {
        const joinCode = runtime.multiplayer.coop.pendingJoinCode;
        runtime.multiplayer.coop.pendingJoinCode = null; // Clear it

        updateCoopStatus("JOINING SESSION...");

        // Join after a short delay to ensure everything is initialized
        setTimeout(() => {
          joinCoopSession(joinCode);
        }, 500);
      }
    }

    function handlePlayerList(data) {
      runtime.multiplayer.players = data.players || [];
      runtime.multiplayer.lastPlayerCount = runtime.multiplayer.playerCount;
      runtime.multiplayer.playerCount = data.playerCount;

      updateConnectionIndicator(data.changeType);

      // Skip logging events about ourselves (we already log these locally)
      const g = activeGate();
      const isOwnEvent = data.gateId === g.id;

      if (data.changeType === "join") {
        // Only log other players connecting
        if (!isOwnEvent) {
          if (data.isReconnection) {
            eventLine(`OPERATOR RECONNECTED (${data.playerCount} NODES)`, "dim");
          } else {
            eventLine(`OPERATOR CONNECTED (${data.playerCount} NODES)`, "dim");
          }
        }
      } else if (data.changeType === "leave") {
        // Update gate state for disconnecting player
        const now = Date.now();
        const gateState = runtime.multiplayer.gateStates.get(data.gateId);

        if (gateState && !isOwnEvent) {
          // Determine disconnection type
          if (data.reason === "severed") {
            gateState.status = "SEVERING";
            gateState.disconnectReason = "SEVERED";
          } else {
            gateState.status = "DISCONNECTING";
            gateState.disconnectReason = data.reason || "DISCONNECT";
          }

          gateState.disconnectStartedAt = now;
          // Schedule removal 5 seconds after the final message shows (which appears at 10 seconds)
          gateState.removeAt = now + 15000;

          // Display different messages based on disconnect reason
          let message;
          if (data.reason === "shift_complete") {
            message = `OPERATOR SHIFT COMPLETE: ${data.gateId}`;
          } else if (data.reason === "severed") {
            message = `OPERATOR CONNECTION LOST: ${data.gateId} SEVERED`;
          } else if (data.reason === "reset") {
            message = `OPERATOR DISCONNECTED: CONNECTION RESET`;
          } else {
            // Default message for normal disconnects (page close, refresh, timeout, etc.)
            message = `OPERATOR DISCONNECTED (${data.playerCount} NODES)`;
          }
          eventLine(message, "dim");
        }
      }
    }

    function handlePingReceived(data) {
      if (runtime.multiplayer.dnd.ping || runtime.multiplayer.dnd.all) return;

      const g = activeGate();
      eventLine(`PING RECEIVED: ${data.sourceGateId} (${data.sourceOperator})`, "warn");
      pushPacket(g, `PING FROM ${data.sourceGateId}`);
      playSfx("pingplayer");

      // Store pending ping for manual ACK
      if (!g.pendingPlayerPings) g.pendingPlayerPings = [];

      // Check if there's already a pending ping from this gate
      const existingPing = g.pendingPlayerPings.find(p =>
        p.sourceGateId === data.sourceGateId && !p.acked
      );

      if (existingPing) {
        // Update existing ping instead of creating duplicate
        existingPing.receivedAt = Date.now();
        existingPing.expectedLatency = data.expectedLatency;
        return;
      }

      const ping = {
        sourceGateId: data.sourceGateId,
        sourceOperator: data.sourceOperator,
        receivedAt: Date.now(),
        expectedLatency: data.expectedLatency,
        acked: false,
        audioTimer: null
      };

      g.pendingPlayerPings.push(ping);

      // Start repeating audio every 2 seconds
      ping.audioTimer = setInterval(() => {
        if (!ping.acked) {
          playSfx("pingplayer");
        } else {
          clearInterval(ping.audioTimer);
        }
      }, 2000);

      // Update gate state to show blinking indicator
      const gateState = runtime.multiplayer.gateStates.get(data.sourceGateId);
      if (gateState) {
        gateState.pendingPing = ping;
      }

      // 30-second timeout - show "PING IGNORED" if not ACKed
      setTimeout(() => {
        const stillPending = g.pendingPlayerPings.find(p =>
          p.sourceGateId === data.sourceGateId && !p.acked
        );
        if (stillPending) {
          stillPending.acked = true; // Mark as timed out
          if (stillPending.audioTimer) {
            clearInterval(stillPending.audioTimer);
            stillPending.audioTimer = null;
          }
          consoleLine(`PING IGNORED: ${data.sourceGateId}`, "warn");
          eventLine(`TIMEOUT: PING FROM ${data.sourceGateId}`, "warn");
        }
      }, 30000);
    }

    function handleAckReceived(data) {
      const pendingPing = runtime.multiplayer.pendingPings.get(data.sourceGateId);

      if (pendingPing && !pendingPing.acked) {
        clearTimeout(pendingPing.timeout);
        pendingPing.acked = true;

        const actualRTT = Date.now() - pendingPing.sentAt;
        consoleLine(`PING ACK: ${data.sourceGateId} (${actualRTT}ms)`, "good");

        const g = activeGate();
        pushPacket(g, `ACK ${data.sourceGateId} ${actualRTT}ms`);
        playSfx("pingplayer");

        runtime.multiplayer.pendingPings.delete(data.sourceGateId);
      }
    }
		// --- Multiplayer: deterministic per-pair "link ping" (1000–9000ms, symmetric) ---
		function getGatePairPingMs(gateA, gateB) {
			const a = String(gateA || "").toUpperCase();
			const b = String(gateB || "").toUpperCase();
			if (!a || !b || a === b) return 0;

			// 1) If your server provided a pingMatrix, try to use it first (stays consistent with server-side values)
			const pm = runtime.multiplayer?.pingMatrix || {};
			const g1 = a < b ? a : b;
			const g2 = a < b ? b : a;

			const candidates = [
				pm?.[a]?.[b],
				pm?.[b]?.[a],
				pm?.[`${g1}|${g2}`],
				pm?.[`${g1}-${g2}`],
				pm?.[`${g1}:${g2}`],
			];

			for (const v of candidates) {
				if (typeof v === "number" && Number.isFinite(v)) {
					const ms = Math.round(v);
					return Math.max(1000, Math.min(9000, ms));
				}
			}

			// 2) Fallback: deterministic hash of the unordered pair => same result on both ends
			const s = `${g1}|${g2}|TQE_LINKPING`;
			let h = 2166136261; // FNV-1a
			for (let i = 0; i < s.length; i++) {
				h ^= s.charCodeAt(i);
				h = Math.imul(h, 16777619);
			}
			const u = (h >>> 0);

			// 1000..9000 inclusive => 8001 values
			return 1000 + (u % 8001);
		}
    function handleMessageReceived(data) {
      if (runtime.multiplayer.dnd.msg || runtime.multiplayer.dnd.all) return;

      const g = activeGate();
      const myGateId = g?.id || runtime.activeGateId;

      // Get receiver's relay health score
      const receiverHealthState = computeRelayHealthState(g);
      const receiverScore = receiverHealthState.score;

      // Get sender's relay health score
      const senderScore = data.senderRelayScore || 0;

      // Calculate combined score and apply corruption
      const combinedScore = senderScore + receiverScore;
      const corruptedText = corruptMessageText(data.text, combinedScore);

      // Calculate base delay with jitter
      const baseMs = getGatePairPingMs(myGateId, data.gateId);
      const jitterMs = Math.round((Math.random() * 200) - 100);
      const basePingMs = Math.max(1000, Math.min(9000, baseMs + jitterMs));

      // Calculate degradation delay
      const delayMs = calculateMessageDelayMs(basePingMs, senderScore, receiverScore);

        setTimeout(() => {
          const isNetMsg = String(data.gateId || "").toUpperCase() === "GATE-NET";
          const displayText = isNetMsg
            ? `NET-MSG - ${corruptedText} (${delayMs}ms)`
            : `${data.gateId} - ${data.operatorCallsign} - ${corruptedText} (${delayMs}ms)`;
          consoleLine(displayText, "dim");
          if (!isNetMsg) {
            eventLine(`MSG FROM ${data.gateId} (${delayMs}ms)`, "dim");
          }
          playSfx("msg");
        }, delayMs);
      }

    function handleMultiplayerError(data) {
      consoleLine(`GATE NETWORK ERROR: ${data.message}`, "bad");
    }

    // Co-op session functions
    function createCoopSession() {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) {
        consoleLine("ERROR: NOT CONNECTED TO GATE NETWORK", "bad");
        updateCoopStatus("ERROR: NOT CONNECTED");
        return;
      }

      const gateId = activeGate().id;
      const msg = {
        type: "create_coop_session",
        timestamp: Date.now(),
        data: {
          gateId: gateId
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
      updateCoopStatus("CREATING SESSION...");
    }

    function joinCoopSession(sessionCode) {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) {
        consoleLine("ERROR: NOT CONNECTED TO GATE NETWORK", "bad");
        updateCoopStatus("ERROR: NOT CONNECTED");
        return;
      }

      if (!sessionCode || sessionCode.length !== 6) {
        updateCoopStatus("ERROR: INVALID SESSION CODE");
        return;
      }

      const gateId = activeGate().id;
      const msg = {
        type: "join_coop_session",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          sessionId: sessionCode.toUpperCase(),
          operatorCallsign: runtime.operatorCallsign || "OPERATOR"
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
      updateCoopStatus("JOINING SESSION...");
    }

    function leaveCoopSession(reason = "disconnect") {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) return;
      if (!runtime.multiplayer.coop.enabled) return;

      const gateId = activeGate().id;
      const msg = {
        type: "leave_coop_session",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          reason: reason
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));

      // Reset local co-op state
      runtime.multiplayer.coop.enabled = false;
      runtime.multiplayer.coop.role = null;
      runtime.multiplayer.coop.sessionId = null;
      runtime.multiplayer.coop.participants = [];
      updateCoopStatus("");
      updateCoopButtonVisibility();
    }

    function sendCoopAction(action, actionData) {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) return;
      if (!runtime.multiplayer.coop.enabled) return;

      const gateId = activeGate().id;
      const msg = {
        type: "coop_action",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          action: action,
          actionData: actionData
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
    }

    function sendCoopStateSync() {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) return;
      if (!runtime.multiplayer.coop.enabled) return;
      if (runtime.multiplayer.coop.role !== "host") return; // Only host sends state

      const g = activeGate();
      if (!g) return;

      const msg = {
        type: "coop_state_sync",
        timestamp: Date.now(),
        data: {
          gateId: g.id,
          gateState: g, // Send full gate state
          operators: runtime.multiplayer.coop.participants,
          shiftStart: runtime.shiftStart,
          shiftDurationMs: loadShiftDuration(),
          shiftMode: loadShiftMode(),
          severed: runtime.severed,
          shiftCompleteShown: runtime.shiftCompleteShown,
          shiftCompleteOpen: document.body.classList.contains("shiftcomplete"),
          lastSevered: runtime.lastSevered || null,
          lastShiftComplete: runtime.lastShiftComplete || null
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
    }

    function sendCoopEvent(eventType, eventData) {
      if (!runtime.multiplayer.ws || runtime.multiplayer.ws.readyState !== WebSocket.OPEN) {
        console.log("[COOP] sendCoopEvent failed - WebSocket not open:", eventType);
        return;
      }
      if (!runtime.multiplayer.coop.enabled) {
        console.log("[COOP] sendCoopEvent failed - Coop not enabled:", eventType);
        return;
      }
      if (runtime.multiplayer.coop.role !== "host") {
        console.log("[COOP] sendCoopEvent failed - Not host:", eventType, "role:", runtime.multiplayer.coop.role);
        return; // Only host broadcasts events
      }

      console.log("[COOP] Sending coop event:", eventType, eventData);

      const gateId = activeGate().id;
      const msg = {
        type: "coop_event",
        timestamp: Date.now(),
        data: {
          gateId: gateId,
          eventType: eventType,
          eventData: eventData
        }
      };

      runtime.multiplayer.ws.send(JSON.stringify(msg));
    }

    function updateCoopStatus(status) {
      const statusEl = document.getElementById("coop-status");
      if (statusEl) {
        statusEl.textContent = status;
      }
    }

    function updateCoopButtonVisibility() {
      const btnHostCoop = document.getElementById('btn-host-coop');
      const btnJoinCoop = document.getElementById('btn-join-coop');
      const coopSessionCodeInput = document.getElementById('coop-session-code');
      const btnDisableCoop = document.getElementById('btn-disable-coop');
      const coopJoinContainer = coopSessionCodeInput?.parentElement;

      if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "host") {
        // Host active: hide HOST/JOIN, show DISABLE
        if (btnHostCoop) btnHostCoop.style.display = 'none';
        if (coopJoinContainer) coopJoinContainer.style.display = 'none';
        if (btnDisableCoop) btnDisableCoop.style.display = 'block';
      } else if (runtime.multiplayer.coop.enabled && runtime.multiplayer.coop.role === "invited") {
        // Invited player: hide all controls (can't control session)
        if (btnHostCoop) btnHostCoop.style.display = 'none';
        if (coopJoinContainer) coopJoinContainer.style.display = 'none';
        if (btnDisableCoop) btnDisableCoop.style.display = 'none';
      } else {
        // No co-op: show HOST/JOIN, hide DISABLE
        if (btnHostCoop) btnHostCoop.style.display = 'block';
        if (coopJoinContainer) coopJoinContainer.style.display = 'flex';
        if (btnDisableCoop) btnDisableCoop.style.display = 'none';
      }
    }

    // Co-op message handlers
    function handleCoopSessionCreated(data) {
      runtime.multiplayer.coop.enabled = true;
      runtime.multiplayer.coop.role = "host";
      runtime.multiplayer.coop.sessionId = data.sessionId;
      runtime.multiplayer.coop.participants = [{
        gateId: data.hostGateId,
        operatorCallsign: runtime.operatorCallsign || "OPERATOR",
        role: "host"
      }];

      updateCoopStatus(`SESSION ACTIVE: ${data.sessionId}`);
      consoleLine(`CO-OP SESSION CREATED: ${data.sessionId}`, "good");
      eventLine(`CO-OP MODE ACTIVE - SESSION: ${data.sessionId}`, "good");
      renderAll();
      updateCoopButtonVisibility();
    }

    function handleCoopSessionJoined(data) {
      runtime.multiplayer.coop.enabled = true;
      runtime.multiplayer.coop.role = data.role;
      runtime.multiplayer.coop.sessionId = data.sessionId;

      // Store guest's original data for restoration when co-op ends
      if (runtime.multiplayer.coop.role === "invited" && !runtime.multiplayer.coop.hasStoredOriginalData) {
        runtime.multiplayer.coop.originalGateId = runtime.activeGateId;
        runtime.multiplayer.coop.originalShiftStart = runtime.shiftStart;
        runtime.multiplayer.coop.originalShiftDurationMs = loadShiftDuration();
        runtime.multiplayer.coop.originalShiftMode = loadShiftMode();
        runtime.multiplayer.coop.hasStoredOriginalData = true;

        consoleLine("CO-OP: Original session data stored for restoration", "dim");
      }

      // For invited players, immediately align to the host's gate node (runtime only).
      if (runtime.multiplayer.coop.role === "invited" && data.hostGateId) {
        runtime.activeGateId = data.hostGateId;
        runtime.gate = loadGateState(data.hostGateId) || makeGateState(data.hostGateId);
        if (ui.gateDisplay) {
          ui.gateDisplay.textContent = runtime.activeGateId;
        }
        if (ui.ps1) ui.ps1.textContent = `${runtime.activeGateId}>`;
      }

      updateCoopStatus(`JOINED SESSION: ${data.sessionId}`);
      consoleLine(`JOINED CO-OP SESSION: ${data.sessionId}`, "good");
      eventLine(`CO-OP MODE ACTIVE - ROLE: ${data.role.toUpperCase()}`, "good");
      renderAll();
      updateCoopButtonVisibility();
    }

    function handleCoopPlayerJoined(data) {
      if (runtime.multiplayer.coop.role === "host") {
        consoleLine(`PLAYER JOINED: ${data.operatorCallsign} (${data.gateId})`, "good");
        eventLine(`CO-OP: ${data.operatorCallsign} JOINED SESSION`, "good");

        // Send immediate state sync to the new player
        sendCoopStateSync();
      }
    }

    function handleCoopPlayerLeft(data) {
      if (runtime.multiplayer.coop.role === "host") {
        const reason = data.reason || "disconnect";
        consoleLine(`PLAYER LEFT: ${data.gateId} (${reason})`, "warn");
        eventLine(`CO-OP: PLAYER LEFT SESSION`, "warn");

        // If there's an active vote, remove the disconnected player's vote and recheck completion
        if (runtime.multiplayer.coop.activeVote && data.playerId) {
          const vote = runtime.multiplayer.coop.activeVote;
          vote.votes.delete(data.playerId);
          consoleLine(`VOTE: PLAYER ${data.gateId} REMOVED FROM VOTING`, "dim");
          checkVoteCompletion(vote);
        }
      }
    }

    function handleCoopParticipantsUpdate(data) {
      runtime.multiplayer.coop.participants = data.participants || [];
      runtime.multiplayer.coop.locked = data.locked || false;
      renderAll();
    }

    function stopCoopLoopingAudio() {
      audio.music.pause();
      audio.music.currentTime = 0;
      audio.processing.pause();
      audio.processing.currentTime = 0;
      audio.qrying.pause();
      audio.qrying.currentTime = 0;
      audio.ackalarm.pause();
      audio.ackalarm.currentTime = 0;
      audio.purge.pause();
      audio.purge.currentTime = 0;
      audio.reset.pause();
      audio.reset.currentTime = 0;
      audio.scan.pause();
      audio.scan.currentTime = 0;
      audio.klaxon.pause();
      audio.klaxon.currentTime = 0;
    }

    function applyCoopSeveredState(severed, summary) {
      if (!severed) {
        runtime.severed = false;
        runtime.lastSevered = null;
        document.body.classList.remove("severed");
        return;
      }

      stopCoopLoopingAudio();
      runtime.severed = true;
      if (summary) {
        runtime.lastSevered = summary;
        updateSeveredOverlay(summary);
      }
      document.body.classList.add("severed");
    }

    function applyCoopShiftCompleteState(shown, open, summary) {
      if (!shown) {
        runtime.shiftCompleteShown = false;
        runtime.lastShiftComplete = null;
        document.body.classList.remove("shiftcomplete");
        return;
      }

      runtime.shiftCompleteShown = true;
      if (summary) {
        runtime.lastShiftComplete = summary;
        updateShiftcompleteOverlay(summary);
      }
      if (open) {
        document.body.classList.add("shiftcomplete");
      } else {
        document.body.classList.remove("shiftcomplete");
      }
    }

    function handleCoopStateUpdate(data) {
      // Invited players receive full state updates from the host
      if (runtime.multiplayer.coop.role !== "invited") return;

      // Auto-switch guest to host's gate if different
      if (data.gateId && data.gateId !== runtime.activeGateId) {
        consoleLine(`CO-OP: Switching to host's gate ${data.gateId}`, "dim");
        runtime.activeGateId = data.gateId;

        // Update UI elements
        if (ui.gateDisplay) {
          ui.gateDisplay.textContent = runtime.activeGateId;
        }
        ui.ps1.textContent = `${runtime.activeGateId}>`;

        // Load host's gate from localStorage if it exists, otherwise use synced state
        const existingGateState = loadGateState(data.gateId);
        if (existingGateState) {
          runtime.gate = existingGateState;
        } else if (data.gateState) {
          // Create new gate object from host's state (will be overwritten by sync below)
          runtime.gate = data.gateState;
        }
      }

      // Sync gate state from host
      if (data.gateState) {
        const g = activeGate();
        const hostState = data.gateState;

        // Sync all gate state properties
        g.beacon = hostState.beacon;
        g.alignment = hostState.alignment;
        g.sync = hostState.sync;
        g.concourseLevel = hostState.concourseLevel;
        g.health = hostState.health;

        // Sync cooldowns
        g.lastScanAt = hostState.lastScanAt;
        g.lastRealignAt = hostState.lastRealignAt;
        g.lastResetAt = hostState.lastResetAt;
        g.lastPurgeAt = hostState.lastPurgeAt;
        g.relayFailureSince = hostState.relayFailureSince;
        g.gateSystemsFailureSince = hostState.gateSystemsFailureSince;

        // Sync relay health state
        if (hostState.relayHealth) {
          g.relayHealth = {
            ...g.relayHealth,
            ...hostState.relayHealth
          };
        }

        // Sync resources
        if (hostState.resources) {
          g.resources = { ...hostState.resources };
        }

        // Sync stats
        if (hostState.stats) {
          g.stats = { ...hostState.stats };
        }

        // Sync tech
        if (hostState.tech) {
          g.tech = { ...hostState.tech };
        }

        // Sync ships (inbound/outbound queues)
        if (hostState.inbound) {
          g.inbound = hostState.inbound.map(ship => ({ ...ship }));
        }
        if (hostState.outbound) {
          g.outbound = hostState.outbound.map(ship => ({ ...ship }));
        }

        // Sync dock slots
        if (hostState.dockSlots) {
          g.dockSlots = hostState.dockSlots.map(slot => ({ ...slot }));
        }

        // Sync facilities
        if (hostState.facility) {
          g.facility = hostState.facility.map(sys => ({ ...sys }));
        }

        // Sync relays - health is synced, heartbeat timing is local
        if (hostState.relays) {
          const now = Date.now();
          g.relays = hostState.relays.map((hostRelay, idx) => {
            const clientRelay = g.relays[idx] || {};
            const syncedRelay = {
              ...hostRelay,
              // Preserve client-local heartbeat timing to avoid network delay artifacts
              lastHeartbeatAt: clientRelay.lastHeartbeatAt,
              nextHeartbeatAt: clientRelay.nextHeartbeatAt,
              // Preserve UI-only client animation state
              pingPulseUntil: clientRelay.pingPulseUntil,
              healthBlinkUntil: clientRelay.healthBlinkUntil,
              healthBlinkType: clientRelay.healthBlinkType,
              healthBlinkCount: clientRelay.healthBlinkCount
            };

            // Initialize heartbeat timing if this is a new relay or reschedule if it's time
            if (!syncedRelay.lastHeartbeatAt || now >= (syncedRelay.nextHeartbeatAt || 0)) {
              scheduleRelayHeartbeat(syncedRelay, now);
            }

            return syncedRelay;
          });
        }

        // Sync work orders
        if (hostState.workOrders) {
          g.workOrders = hostState.workOrders.map(wo => ({ ...wo }));
        }

        // Sync corridors
        if (hostState.corridors) {
          g.corridors = hostState.corridors.map(c => ({ ...c }));
        }

        // Sync packets
        if (hostState.packets) {
          g.packets = hostState.packets.map(p => ({ ...p }));
        }

        if (hostState.repairAttempts) {
          g.repairAttempts = hostState.repairAttempts.map(r => ({ ...r }));
        }

        if (typeof hostState.relaysPurchased === "number") {
          g.relaysPurchased = hostState.relaysPurchased;
        }
        if (typeof hostState.docksPurchased === "number") {
          g.docksPurchased = hostState.docksPurchased;
        }

        if (hostState.alerts) {
          g.alerts = hostState.alerts.map(a => a);
        }
        if (hostState.reports) {
          g.reports = hostState.reports.map(r => r);
        }

        // Sync alert sounds based on host state (guest should not broadcast)
        const hasAck = (g.relays || []).some(r => r.awaitingAck && !r.offline);
        if (hasAck !== audioState.ackAlarmOn) {
          setAckAlarm(hasAck, false);
        }
        const now = Date.now();
        const hasCriticalExposure = (g.dockSlots || []).some(slot => {
          if (!slot.shipId) return false;
          const ship = findShipById(g, slot.shipId);
          if (!ship || ship.state !== "WAITING DECON" || !ship.exposureDeadline) return false;
          const left = Math.max(0, Math.ceil((ship.exposureDeadline - now) / 1000));
          return left <= 20 && left > 0;
        });
        if (hasCriticalExposure !== audioState.klaxonOn) {
          setKlaxon(hasCriticalExposure, false);
        }

        renderAll();
      }

      // Sync shift timing from host
      if (data.shiftStart !== undefined) {
        runtime.shiftStart = data.shiftStart;
      }
      if (data.shiftDurationMs !== undefined) {
        // Update runtime only, don't save to localStorage (guest protection)
        runtime.shiftDurationMs = data.shiftDurationMs;
      }
      if (data.shiftMode !== undefined) {
        // Update runtime only, don't save to localStorage (guest protection)
        runtime.shiftMode = data.shiftMode;
      }

      if (data.severed !== undefined) {
        applyCoopSeveredState(!!data.severed, data.lastSevered || null);
      }
      if (data.shiftCompleteShown !== undefined) {
        applyCoopShiftCompleteState(
          !!data.shiftCompleteShown,
          !!data.shiftCompleteOpen,
          data.lastShiftComplete || null
        );
      }
    }

    function handleCoopEvent(data) {
      const { eventType, eventData } = data;

      console.log("[COOP] Received coop event:", eventType, "role:", runtime.multiplayer.coop.role, "data:", eventData);

      // Vote events are handled by ALL participants (host and invited)
      if (eventType === "vote_started") {
        displayVotePrompt(eventData);
        return;
      } else if (eventType === "vote_updated") {
        displayVoteUpdate(eventData);
        return;
      } else if (eventType === "vote_ended") {
        displayVoteResult(eventData);
        return;
      } else if (eventType === "vote_rejected") {
        displayVoteRejection(eventData);
        return;
      }

      if (eventType === "sound") {
        // Play sound effect (without re-broadcasting to prevent loops)
        if (eventData.sfx) {
          console.log("[SOUND SYNC] Received sound event:", eventData.sfx, "role:", runtime.multiplayer.coop.role);
          playSfx(eventData.sfx, false);
        }
        return;
      } else if (eventType === "sound_stop") {
        if (eventData.sfx) {
          console.log("[SOUND SYNC] Received sound stop:", eventData.sfx, "role:", runtime.multiplayer.coop.role);
          stopSfx(eventData.sfx, false);
        }
        return;
      } else if (eventType === "ack_alarm") {
        // Set ACK alarm state (active/inactive)
        // Respect this player's sound settings, but don't re-broadcast
        if (eventData.active !== undefined) {
          console.log("[SOUND SYNC] Received ack_alarm event:", eventData.active);
          setAckAlarm(eventData.active, false);
        }
        return;
      } else if (eventType === "klaxon") {
        // Set KLAXON alarm state (active/inactive)
        // Respect this player's sound settings, but don't re-broadcast
        if (eventData.active !== undefined) {
          console.log("[SOUND SYNC] Received klaxon event:", eventData.active);
          setKlaxon(eventData.active, false);
        }
        return;
      }

      // Other events are only for invited players
      if (runtime.multiplayer.coop.role !== "invited") return;

      if (eventType === "maintenance_start") {
        if (eventData?.kind) {
          simulateMaintenanceCooldown(eventData.kind, eventData.durationSec, eventData.startedAt);
        }
        return;
      }

      if (eventType === "scan_result") {
        // Apply scan results (ship pulses, hazard detection)
        const g = activeGate();
        if (!g) return;

        // Find and update ships with scan results
        if (eventData.flaggedShips) {
          for (const shipId of eventData.flaggedShips) {
            const ship = [...g.inbound, ...g.outbound].find(s => s.id === shipId);
            if (ship) ship.justFlagged = true;
          }
        }

        if (eventData.hazardDetectedShips) {
          for (const shipId of eventData.hazardDetectedShips) {
            const ship = [...g.inbound, ...g.outbound].find(s => s.id === shipId);
            if (ship) ship.hazardDetected = true;
          }
        }

        // Play scan sound (without re-broadcasting to prevent loops)
        if (eventData.sound) {
          playSfx(eventData.sound, false);

          // If this is a scan sound, simulate the button cooldown
          if (eventData.sound === "scan") {
            simulateMaintenanceCooldown("scan");
          }
        }

        // Show event line
        if (eventData.message) eventLine(eventData.message, eventData.messageClass || "dim");

        renderAll();

        // Clear pulse flags after animation
        if (eventData.flaggedShips && eventData.flaggedShips.length) {
          setTimeout(() => {
            for (const shipId of eventData.flaggedShips) {
              const ship = [...g.inbound, ...g.outbound].find(s => s.id === shipId);
              if (ship) ship.justFlagged = false;
            }
            renderAll();
          }, 800);
        }

        if (eventData.hazardDetectedShips && eventData.hazardDetectedShips.length) {
          setTimeout(() => {
            for (const shipId of eventData.hazardDetectedShips) {
              const ship = [...g.inbound, ...g.outbound].find(s => s.id === shipId);
              if (ship) ship.hazardDetected = false;
            }
            renderAll();
          }, 1000);
        }
      } else if (eventType === "alert") {
        // Display alert
        if (eventData.message) eventLine(eventData.message, eventData.messageClass || "warn");
      } else if (eventType === "console_message") {
        // Display console message from host (avoid re-broadcasting)
        if (eventData.text) logLine(ui.console, eventData.text, eventData.cls || "dim");
      } else if (eventType === "action") {
        // Show action notification
        if (eventData.message) consoleLine(eventData.message, eventData.messageClass || "dim");
        if (eventData.sound) playSfx(eventData.sound, false);
      }
    }

    function handleCoopActionReceived(data) {
      // Host receives actions from invited players
      if (runtime.multiplayer.coop.role !== "host") return;

      if (data.action === "command") {
        // Execute command from invited player
        const command = data.actionData.command;
        consoleLine(`> ${command} (${data.operatorCallsign})`, "dim");
        runCommand(command);
      } else if (data.action === "maintenance") {
        // Execute maintenance action from invited player
        const { kind, options } = data.actionData;
        consoleLine(`> ${kind.toUpperCase()} (${data.operatorCallsign})`, "dim");
        queueMaintenance(kind, getMaintenanceButton(kind), options || {});
      } else if (data.action === "request_vote") {
        // Handle vote request from invited player
        handleVoteRequest(data);
      } else if (data.action === "submit_vote") {
        // Handle vote submission from invited player
        handleVoteSubmission(data);
      } else if (data.action === "sound") {
        // Play sound locally on host and broadcast to all other players
        if (data.actionData.sfx) {
          console.log("[SOUND SYNC] Host received sound action from invited player:", data.actionData.sfx, "from:", data.operatorCallsign);
          playSfx(data.actionData.sfx, false); // Play locally without re-broadcasting
          console.log("[SOUND SYNC] Host broadcasting sound to all invited players:", data.actionData.sfx);
          sendCoopEvent("sound", { sfx: data.actionData.sfx }); // Broadcast to all invited players
        }
      } else if (data.action === "sound_stop") {
        if (data.actionData.sfx) {
          console.log("[SOUND SYNC] Host received sound stop from invited player:", data.actionData.sfx, "from:", data.operatorCallsign);
          stopSfx(data.actionData.sfx, false);
          console.log("[SOUND SYNC] Host broadcasting sound stop to all invited players:", data.actionData.sfx);
          sendCoopEvent("sound_stop", { sfx: data.actionData.sfx });
        }
      } else if (data.action === "resource_order_amount") {
        const { resourceId, amount } = data.actionData || {};
        const g = activeGate();
        if (!g || !resourceId) return;
        ensureResources(g);
        const res = g.resources[resourceId];
        if (!res || res.order) return;
        res.orderAmount = normalizeOrderAmount(amount);
        g.lastRefresh = Date.now();
        renderAll();
      }
    }

    function handleCoopSessionEnded(data) {
      const reason = data.reason || "ended";

      // Clear co-op state
      runtime.multiplayer.coop.enabled = false;
      runtime.multiplayer.coop.role = null;
      runtime.multiplayer.coop.sessionId = null;
      runtime.multiplayer.coop.participants = [];

      // Clear any active vote
      if (runtime.multiplayer.coop.activeVote) {
        if (runtime.multiplayer.coop.activeVote.timeoutHandle) {
          clearTimeout(runtime.multiplayer.coop.activeVote.timeoutHandle);
        }
        consoleLine("VOTE CANCELLED: SESSION ENDED", "warn");
        runtime.multiplayer.coop.activeVote = null;
      }

      // Restore guest's original gate and shift settings
      if (runtime.multiplayer.coop.hasStoredOriginalData) {
        consoleLine("CO-OP: Restoring original session data", "dim");

        // Switch back to original gate
        runtime.activeGateId = runtime.multiplayer.coop.originalGateId;

        // Restore shift settings to runtime
        runtime.shiftStart = runtime.multiplayer.coop.originalShiftStart;
        runtime.shiftDurationMs = runtime.multiplayer.coop.originalShiftDurationMs;
        runtime.shiftMode = runtime.multiplayer.coop.originalShiftMode;

        // Save restored shift settings to localStorage
        saveShiftDuration(runtime.multiplayer.coop.originalShiftDurationMs);
        saveShiftMode(runtime.multiplayer.coop.originalShiftMode);

        // Load original gate state from localStorage
        const originalGate = loadGateState(runtime.multiplayer.coop.originalGateId);
        if (originalGate) {
          runtime.gate = originalGate;
        }

        // Update UI to reflect restored state
        if (ui.gateDisplay) {
          ui.gateDisplay.textContent = runtime.activeGateId;
        }
        ui.ps1.textContent = `${runtime.activeGateId}>`;

        // Clear stored original data
        delete runtime.multiplayer.coop.originalGateId;
        delete runtime.multiplayer.coop.originalShiftStart;
        delete runtime.multiplayer.coop.originalShiftDurationMs;
        delete runtime.multiplayer.coop.originalShiftMode;
        delete runtime.multiplayer.coop.hasStoredOriginalData;
      }

      // If host disconnected, show special screen
      if (reason === "host_disconnect" || reason === "disconnect" || reason === "host_disabled" || reason === "timeout") {
        const disconnectLabel = reason === "host_disabled"
          ? "HOST DISABLED CO-OP"
          : (reason === "timeout" ? "CONNECTION TIMEOUT" : "HOST DISCONNECTED");
        consoleLine(`CO-OP SESSION ENDED: ${disconnectLabel}`, "warn");

        // Stop all looping audio (similar to severGate)
        audio.music.pause();
        audio.music.currentTime = 0;
        audio.processing.pause();
        audio.processing.currentTime = 0;
        audio.qrying.pause();
        audio.qrying.currentTime = 0;
        audio.ackalarm.pause();
        audio.ackalarm.currentTime = 0;
        audio.purge.pause();
        audio.purge.currentTime = 0;
        audio.reset.pause();
        audio.reset.currentTime = 0;
        audio.scan.pause();
        audio.scan.currentTime = 0;
        audio.klaxon.pause();
        audio.klaxon.currentTime = 0;

        // Play severed sound effect
        playSfx("severed");

        // Show host disconnect overlay (keep current theme, don't randomize)
        document.body.classList.add("host-disconnected");
      } else {
        // For other reasons, just show console messages
        consoleLine(`CO-OP SESSION ENDED: ${reason}`, "warn");
        eventLine(`CO-OP MODE DISABLED`, "warn");
        updateCoopStatus("SESSION ENDED");
        setTimeout(() => updateCoopStatus(""), 3000);
      }

      renderAll();
      updateCoopButtonVisibility();
    }

    function handleCoopKicked(data) {
      consoleLine("YOU WERE KICKED FROM THE CO-OP SESSION", "bad");
      eventLine("CO-OP: KICKED BY HOST", "bad");

      runtime.multiplayer.coop.enabled = false;
      runtime.multiplayer.coop.role = null;
      runtime.multiplayer.coop.sessionId = null;
      runtime.multiplayer.coop.participants = [];
      updateCoopStatus("KICKED FROM SESSION");

      setTimeout(() => updateCoopStatus(""), 3000);
      renderAll();
      updateCoopButtonVisibility();
    }

    // ====================
    // CO-OP VOTING SYSTEM
    // ====================

    function createVote(purchaseType, initiatorGateId, initiatorCallsign, cost) {
      const voteId = "VOTE-" + Date.now();
      const g = activeGate();

      const vote = {
        voteId: voteId,
        purchaseType: purchaseType,
        initiatorGateId: initiatorGateId,
        initiatorCallsign: initiatorCallsign,
        cost: cost,
        startedAt: Date.now(),
        expiresAt: Date.now() + 45000, // 45 second timeout
        votes: new Map(),
        status: "active",
        timeoutHandle: null
      };

      // Set timeout to auto-resolve after 45 seconds
      vote.timeoutHandle = setTimeout(() => {
        handleVoteTimeout(voteId);
      }, 45000);

      runtime.multiplayer.coop.activeVote = vote;

      // Broadcast vote initiation to all participants
      const participants = runtime.multiplayer.coop.participants;
      const votingPlayerCount = participants.length;

      sendCoopEvent("vote_started", {
        voteId: voteId,
        purchaseType: purchaseType,
        initiatorGateId: initiatorGateId,
        initiatorCallsign: initiatorCallsign,
        cost: cost,
        expiresAt: vote.expiresAt,
        votingPlayerCount: votingPlayerCount
      });

      consoleLine(`VOTE INITIATED: PURCHASE ${purchaseType}`, "warn");
      playSfx("warn");

      return voteId;
    }

    function submitVote(voteChoice) {
      const g = activeGate();

      if (runtime.multiplayer.coop.role === "host") {
        // Host submits vote directly
        if (!runtime.multiplayer.coop.activeVote) {
          consoleLine("NO ACTIVE VOTE", "warn");
          playSfx("error");
          return;
        }

        const vote = runtime.multiplayer.coop.activeVote;
        vote.votes.set(runtime.multiplayer.playerId, voteChoice);

        consoleLine(`VOTE RECORDED: ${voteChoice}`, "info");
        playSfx("click");

        checkVoteCompletion(vote);
      } else if (runtime.multiplayer.coop.role === "invited") {
        // Invited player sends vote to host
        sendCoopAction("submit_vote", {
          vote: voteChoice
        });

        consoleLine(`VOTE SUBMITTED: ${voteChoice}`, "info");
        playSfx("click");
      }
    }

    function checkVoteCompletion(vote) {
      if (!vote || vote.status !== "active") return;

      const participants = runtime.multiplayer.coop.participants;
      const totalPlayers = participants.length;

      // Count how many players have voted (excluding abstains from completion check)
      let votedCount = 0;
      for (const participant of participants) {
        if (vote.votes.has(participant.playerId)) {
          votedCount++;
        }
      }

      // If all players have voted, resolve immediately
      if (votedCount === totalPlayers) {
        resolveVote(vote);
      } else {
        // Otherwise broadcast update
        broadcastVoteUpdate(vote);
      }
    }

    function resolveVote(vote) {
      if (!vote || vote.status !== "active") return;

      const participants = runtime.multiplayer.coop.participants;
      let yesCount = 0;
      let noCount = 0;
      let abstainCount = 0;

      // Count votes
      for (const participant of participants) {
        const playerVote = vote.votes.get(participant.playerId);
        if (playerVote === "YES") yesCount++;
        else if (playerVote === "NO") noCount++;
        else if (playerVote === "ABSTAIN") abstainCount++;
      }

      const totalVotes = yesCount + noCount; // Exclude abstains from total
      const passed = totalVotes > 0 && (yesCount / totalVotes) >= 0.5;

      vote.status = passed ? "passed" : "failed";

      // Clear timeout
      if (vote.timeoutHandle) {
        clearTimeout(vote.timeoutHandle);
        vote.timeoutHandle = null;
      }

      // Execute purchase if passed
      if (passed) {
        executePurchaseFromVote(vote);
      }

      // Broadcast result
      sendCoopEvent("vote_ended", {
        voteId: vote.voteId,
        purchaseType: vote.purchaseType,
        status: vote.status,
        yesCount: yesCount,
        noCount: noCount,
        abstainCount: abstainCount,
        passed: passed
      });

      // Display result locally
      if (passed) {
        consoleLine(`VOTE PASSED: PURCHASE ${vote.purchaseType} (${yesCount} YES, ${noCount} NO, ${abstainCount} ABSTAIN)`, "good");
        playSfx("confirm");
      } else {
        consoleLine(`VOTE FAILED: PURCHASE ${vote.purchaseType} (${yesCount} YES, ${noCount} NO, ${abstainCount} ABSTAIN)`, "bad");
        consoleLine("PURCHASE CANCELLED", "warn");
        playSfx("error");
      }

      // Clear active vote
      runtime.multiplayer.coop.activeVote = null;
    }

    function executePurchaseFromVote(vote) {
      const g = activeGate();

      switch (vote.purchaseType) {
        case "RELAY":
          purchaseRelay(g);
          break;
        case "DOCK":
          purchaseDock(g);
          break;
        case "REACTOR":
          startUpgrade(g, "REACTOR");
          break;
        case "MAINTENANCE":
          startUpgrade(g, "MAINTENANCE");
          break;
      }
    }

    function cancelVote(voteId, reason) {
      const vote = runtime.multiplayer.coop.activeVote;
      if (!vote || vote.voteId !== voteId) return;

      vote.status = "cancelled";

      // Clear timeout
      if (vote.timeoutHandle) {
        clearTimeout(vote.timeoutHandle);
        vote.timeoutHandle = null;
      }

      // Broadcast cancellation
      sendCoopEvent("vote_ended", {
        voteId: vote.voteId,
        purchaseType: vote.purchaseType,
        status: "cancelled",
        reason: reason
      });

      consoleLine(`VOTE CANCELLED: ${reason.toUpperCase().replace(/_/g, " ")}`, "warn");
      playSfx("error");

      // Clear active vote
      runtime.multiplayer.coop.activeVote = null;
    }

    function handleVoteTimeout(voteId) {
      const vote = runtime.multiplayer.coop.activeVote;
      if (!vote || vote.voteId !== voteId || vote.status !== "active") return;

      const participants = runtime.multiplayer.coop.participants;
      let yesCount = 0;
      let noCount = 0;
      let abstainCount = 0;
      let noResponseCount = 0;

      // Count votes
      for (const participant of participants) {
        const playerVote = vote.votes.get(participant.playerId);
        if (playerVote === "YES") yesCount++;
        else if (playerVote === "NO") noCount++;
        else if (playerVote === "ABSTAIN") abstainCount++;
        else noResponseCount++;
      }

      const totalVotes = yesCount + noCount; // Exclude abstains and no-response
      const passed = totalVotes > 0 && (yesCount / totalVotes) >= 0.5;

      vote.status = passed ? "timeout-passed" : "timeout-failed";

      // Execute purchase if passed
      if (passed) {
        executePurchaseFromVote(vote);
      }

      // Broadcast result
      sendCoopEvent("vote_ended", {
        voteId: vote.voteId,
        purchaseType: vote.purchaseType,
        status: vote.status,
        yesCount: yesCount,
        noCount: noCount,
        abstainCount: abstainCount,
        noResponseCount: noResponseCount,
        passed: passed
      });

      // Display result locally
      if (passed) {
        consoleLine(`VOTE TIMEOUT: PURCHASE ${vote.purchaseType} (${yesCount} YES, ${noCount} NO, ${noResponseCount} NO RESPONSE)`, "warn");
        consoleLine(`VOTE PASSED WITH AVAILABLE VOTES`, "good");
        playSfx("confirm");
      } else {
        consoleLine(`VOTE TIMEOUT: PURCHASE ${vote.purchaseType} (${yesCount} YES, ${noCount} NO, ${noResponseCount} NO RESPONSE)`, "warn");
        consoleLine("INSUFFICIENT VOTES - PURCHASE CANCELLED", "bad");
        playSfx("error");
      }

      // Clear active vote
      runtime.multiplayer.coop.activeVote = null;
    }

    function broadcastVoteUpdate(vote) {
      if (!vote || vote.status !== "active") return;

      const participants = runtime.multiplayer.coop.participants;
      let yesCount = 0;
      let noCount = 0;
      let abstainCount = 0;
      let pendingCount = 0;

      for (const participant of participants) {
        const playerVote = vote.votes.get(participant.playerId);
        if (playerVote === "YES") yesCount++;
        else if (playerVote === "NO") noCount++;
        else if (playerVote === "ABSTAIN") abstainCount++;
        else pendingCount++;
      }

      const timeLeft = Math.max(0, Math.floor((vote.expiresAt - Date.now()) / 1000));

      sendCoopEvent("vote_updated", {
        voteId: vote.voteId,
        purchaseType: vote.purchaseType,
        yesCount: yesCount,
        noCount: noCount,
        abstainCount: abstainCount,
        pendingCount: pendingCount,
        timeLeft: timeLeft
      });
    }

    function displayVotePrompt(data) {
      const { purchaseType, initiatorGateId, initiatorCallsign, cost, expiresAt, votingPlayerCount } = data;
      const timeLeft = Math.max(0, Math.floor((expiresAt - Date.now()) / 1000));
      const votesNeeded = Math.ceil(votingPlayerCount * 0.5);

      consoleLine(`VOTE REQUESTED: PURCHASE ${purchaseType} (-${cost.credits} CR, -${cost.supply}% SUPPLY)`, "warn");
      consoleLine(`INITIATOR: ${initiatorGateId} (${initiatorCallsign})`, "info");
      consoleLine(`VOTES NEEDED: ≥50% (${votesNeeded}/${votingPlayerCount} PLAYERS)`, "info");
      consoleLine(`EXPIRES IN: ${timeLeft}s`, "info");
      consoleLine(`TYPE: VOTE YES | VOTE NO | VOTE ABSTAIN`, "info");
      playSfx("warn");
    }

    function displayVoteUpdate(data) {
      const { purchaseType, yesCount, noCount, abstainCount, pendingCount, timeLeft } = data;

      consoleLine(`VOTE UPDATE: PURCHASE ${purchaseType}`, "info");
      consoleLine(`YES: ${yesCount} | NO: ${noCount} | ABSTAIN: ${abstainCount} | PENDING: ${pendingCount}`, "info");
      consoleLine(`TIME REMAINING: ${timeLeft}s`, "info");
    }

    function displayVoteResult(data) {
      const { purchaseType, status, yesCount, noCount, abstainCount, noResponseCount, passed } = data;

      if (status === "cancelled") {
        consoleLine(`VOTE CANCELLED: PURCHASE ${purchaseType}`, "warn");
        consoleLine(`PURCHASE CANCELLED`, "warn");
        playSfx("error");
      } else if (status === "timeout-passed" || status === "timeout-failed") {
        if (passed) {
          consoleLine(`VOTE TIMEOUT: PURCHASE ${purchaseType} (${yesCount} YES, ${noCount} NO, ${noResponseCount || 0} NO RESPONSE)`, "warn");
          consoleLine(`VOTE PASSED WITH AVAILABLE VOTES`, "good");
          playSfx("confirm");
        } else {
          consoleLine(`VOTE TIMEOUT: PURCHASE ${purchaseType} (${yesCount} YES, ${noCount} NO, ${noResponseCount || 0} NO RESPONSE)`, "warn");
          consoleLine("INSUFFICIENT VOTES - PURCHASE CANCELLED", "bad");
          playSfx("error");
        }
      } else if (passed) {
        consoleLine(`VOTE PASSED: PURCHASE ${purchaseType} (${yesCount} YES, ${noCount} NO, ${abstainCount} ABSTAIN)`, "good");
        playSfx("confirm");
      } else {
        consoleLine(`VOTE FAILED: PURCHASE ${purchaseType} (${yesCount} YES, ${noCount} NO, ${abstainCount} ABSTAIN)`, "bad");
        consoleLine("PURCHASE CANCELLED", "warn");
        playSfx("error");
      }
    }

    function displayVoteRejection(data) {
      const { reason, initiatorGateId } = data;

      if (reason === "VOTE_IN_PROGRESS") {
        consoleLine("VOTE REJECTED: VOTE IN PROGRESS", "warn");
        consoleLine("WAIT FOR CURRENT VOTE TO COMPLETE", "info");
      } else {
        consoleLine(`VOTE REJECTED: ${reason}`, "warn");
      }
      playSfx("error");
    }

    function handleVoteRequest(data) {
      // Check if vote already active
      if (runtime.multiplayer.coop.activeVote) {
        sendCoopEvent("vote_rejected", {
          reason: "VOTE_IN_PROGRESS",
          initiatorGateId: data.gateId
        });
        return;
      }

      // Create the vote
      createVote(
        data.actionData.purchaseType,
        data.gateId,
        data.operatorCallsign,
        data.actionData.cost
      );
    }

    function handleVoteSubmission(data) {
      const vote = runtime.multiplayer.coop.activeVote;

      if (!vote) {
        consoleLine("NO ACTIVE VOTE", "warn");
        return;
      }

      // Record the vote
      vote.votes.set(data.playerId, data.actionData.vote);

      consoleLine(`VOTE RECEIVED: ${data.operatorCallsign} - ${data.actionData.vote}`, "info");

      // Check if voting is complete
      checkVoteCompletion(vote);
    }

    function requestUpgradeVote(upgradeType) {
      const g = activeGate();
      const check = canUpgrade(g, upgradeType);

      if (!check.allowed) {
        consoleLine(check.reason, "warn");
        playSfx("error");
        return;
      }

      // Map upgrade type to purchase costs
      const costKey = upgradeType === "REACTOR" ? "FUEL" : "SUPPLY";
      const upgradeCost = PURCHASE_COSTS[costKey];

      sendCoopAction("request_vote", {
        purchaseType: upgradeType,
        cost: { credits: upgradeCost, supply: 0 }
      });

      consoleLine(`VOTE REQUESTED: PURCHASE ${upgradeType} UPGRADE`, "info");
      playSfx("click");
    }

    function cleanupMultiplayer(reason = "disconnect") {
      // Leave co-op session if active
      if (runtime.multiplayer.coop.enabled) {
        leaveCoopSession(reason);
      }

      // Prevent auto-reconnect for intentional disconnects
      runtime.multiplayer.shouldReconnect = false;
      if (runtime.multiplayer.ws && runtime.multiplayer.ws.readyState === WebSocket.OPEN) {
        const gateId = activeGate().id;
        const msg = {
          type: "disconnect",
          timestamp: Date.now(),
          data: {
            gateId: gateId,
            reason: reason
          }
        };
        runtime.multiplayer.ws.send(JSON.stringify(msg));
        runtime.multiplayer.ws.close();
      }

      if (runtime.multiplayer.heartbeatTimer) clearInterval(runtime.multiplayer.heartbeatTimer);
      if (runtime.multiplayer.reconnectTimer) clearTimeout(runtime.multiplayer.reconnectTimer);

      runtime.multiplayer.enabled = false;
      runtime.multiplayer.ws = null;
      runtime.multiplayer.players = [];
      runtime.multiplayer.playerCount = 0;

      // Reset co-op state
      runtime.multiplayer.coop.enabled = false;
      runtime.multiplayer.coop.role = null;
      runtime.multiplayer.coop.sessionId = null;
      runtime.multiplayer.coop.participants = [];
    }

    // Boot is deferred until the operator presses START.

    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        // Cache-bust the service worker file itself with version parameter
        const SW_VERSION = "10.1"; // Increment this when you need to force updates
        navigator.serviceWorker.register(`./sw.js?v=${SW_VERSION}`).then(reg => {
          // Check for updates every 60 seconds
          setInterval(() => {
            reg.update();
          }, 60000);

          // Listen for new service worker waiting to activate
          reg.addEventListener('updatefound', () => {
            const newWorker = reg.installing;
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                // New service worker is ready, reload to activate it
                console.log('New version available! Reloading...');
                window.location.reload();
              }
            });
          });
        }).catch(() => {});
      });
    }
  </script>
</body>
</html>

