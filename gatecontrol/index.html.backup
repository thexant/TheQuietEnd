    function getOperatorCallsignKey(gateId) {
      const id = String(gateId || "").trim();
      return id ? `${LS.operatorCallsignPrefix}${id}` : "";
    }

    function getStoredGateId() {
      const current = safeStorageGet(LS.gateCurrent);
      return current || "";
    }

    function loadOperatorCallsignForGate(gateId) {
      const key = getOperatorCallsignKey(gateId);
      if (key) {
        const stored = safeStorageGet(key);
        if (stored !== null && stored !== undefined) return stored;
      }
      const legacy = safeStorageGet(LS.operatorCallsign) || "";
      if (legacy && key) safeStorageSet(key, legacy);
      return legacy;
    }

    function getDefaultCallsign() {
      return String(safeStorageGet(LS.defaultOperatorCallsign) || "").trim().toUpperCase().slice(0, 24);
    }

    function applyDefaultCallsignIfNeeded(gateId) {
      const current = String(runtime.operatorCallsign || "").trim();
      if (current) return false;
      const defaultCallsign = getDefaultCallsign();
      if (!defaultCallsign) return false;
      runtime.operatorCallsign = defaultCallsign;
      saveOperatorCallsignForGate(gateId || runtime.activeGateId || getStoredGateId(), runtime.operatorCallsign);
      safeStorageSet(LS.operatorCallsign, runtime.operatorCallsign);
      updateOperatorLabel();
      updateStartNameLabel();
      return true;
    }

    function saveOperatorCallsignForGate(gateId, callsign) {
      const key = getOperatorCallsignKey(gateId);
      if (!key) return;
      if (callsign) {
        safeStorageSet(key, callsign);
      } else {
        try { localStorage.removeItem(key); } catch (_) {}
      }
    }

    function clearOperatorCallsignForGate(gateId) {
      const key = getOperatorCallsignKey(gateId);
      if (!key) return;
      try { localStorage.removeItem(key); } catch (_) {}
    }

	function buildGateList(count = 1) {
	  const rng = mulberry32((crypto.getRandomValues(new Uint32Array(1))[0]) >>> 0);
	  const set = new Set();

	  while (set.size < count) {
		const num = String(1 + Math.floor(rng() * 9999)).padStart(4, "0");
		const suffix = rng() < 0.35 ? "-" + pick(rng, ["A","B","C","D","E","F","H","I","J","K","L","M","N","O","P","Q","R","S","T","U","V","W","X","Y","Z","ALPHA","BETA","GR","AL","CPLX","CPLR","RING","TRM","VTS","TEM","UC"]) : "";
		set.add(`GATE-${num}${suffix}`); // <-- removed the letter
	  }

	  return Array.from(set).sort();
	}

    function loadGateCatalog() {
      // Load existing gate ID or generate a new one
      let gateId = null;
      try {
        gateId = localStorage.getItem(LS.gateCurrent);
      } catch (_) {}

      if (!gateId) {
        // Generate a single new gate ID
        const gateList = buildGateList(1);
        gateId = gateList[0];
        try {
          localStorage.setItem(LS.gateCurrent, gateId);
        } catch (_) {}
      }

      return gateId;
    }

