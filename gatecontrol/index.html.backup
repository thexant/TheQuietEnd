      --good: var(--signal);
      --line: rgba(255, 184, 77, 0.18); --grid: rgba(255, 184, 77, 0.05);
      --glow: rgba(255, 184, 77, 0.35); --bg-hi: #1a130d;
      --shadowText: rgba(255, 184, 77, 0.18); --shadowText2: rgba(255, 184, 77, 0.10);
      --stat: #ffe9c2;
    }
		:root[data-theme="cyan"] {
      --ink: #ccfbff; --muted: #6fa7ad; --signal: #38f6ff;
      --good: var(--signal);
      --line: rgba(56, 246, 255, 0.18); --grid: rgba(56, 246, 255, 0.05);
      --glow: rgba(56, 246, 255, 0.35); --bg-hi: #0d1a1a;
      --shadowText: rgba(56, 246, 255, 0.18); --shadowText2: rgba(56, 246, 255, 0.10);
      --stat: #d2a95a;
    }
		:root[data-theme="orange"] {
      --ink: #ffd9b3; --muted: #b3804d; --signal: #ff8533;
      --good: var(--signal);
      --line: rgba(255, 133, 51, 0.18); --grid: rgba(255, 133, 51, 0.05);
      --glow: rgba(255, 133, 51, 0.35); --bg-hi: #1a110d;
      --shadowText: rgba(255, 133, 51, 0.18); --shadowText2: rgba(255, 133, 51, 0.10);
      --stat: #d2a95a;
    }
    :root[data-theme="black"] {
      --deep: #000; --bg-hi: #000;
      --ink: #eaeaea; --muted: #9a9a9a; --signal: #f2f2f2; --good: #4dff9a;
      --line: rgba(255, 255, 255, 0.18); --grid: rgba(255, 255, 255, 0.05);
      --glow: rgba(255, 255, 255, 0.22);
