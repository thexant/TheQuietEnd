			background: rgba(255, 255, 255, 0.92);
			border: 1px solid rgba(0,0,0,0.12);
			box-shadow: 0 0 30px rgba(0,0,0,0.15), inset 0 0 0 1px rgba(0,0,0,0.04);
		}

		/* Light-theme severed overlay and card */
		:root[data-theme="lightblue"] #severed-overlay,
		:root[data-theme="lightred"] #severed-overlay,
