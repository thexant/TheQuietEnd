  <!-- Load crew names dictionary -->
  <script src="names.js"></script>

  <script>
    // ---------------------------
    // Version & Cache Busting
    // ---------------------------
    const APP_VERSION = "v10";
    console.log(`%cGATE CONTROL ${APP_VERSION}`, "color: #00ff00; font-weight: bold; font-size: 14px;");

    // ---------------------------
    // Utilities
    // ---------------------------
    const pad2 = (n) => String(n).padStart(2, "0");

    function formatHMS(ms) {
      const s = Math.floor(ms / 1000);
      const hh = Math.floor(s / 3600);
      const mm = Math.floor((s % 3600) / 60);
      const ss = s % 60;
      return `${pad2(hh)}:${pad2(mm)}:${pad2(ss)}`;
    }

    function formatMMSS(sec) {
      sec = Math.max(0, Math.floor(sec));
      const mm = Math.floor(sec / 60);
      const ss = sec % 60;
      return `${pad2(mm)}:${pad2(ss)}`; // allows > 59 minutes (e.g. 120:00)
    }

    function strHash(s) {
      // Deterministic 32-bit hash
      let h = 2166136261 >>> 0;
      for (let i = 0; i < s.length; i++) {
        h ^= s.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }

    function mulberry32(seed) {
      let a = seed >>> 0;
      return function() {
        a |= 0; a = (a + 0x6D2B79F5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function pick(rng, arr) { return arr[Math.floor(rng() * arr.length)]; }
    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
    function randRange(min, max) { return min + Math.floor(Math.random() * (max - min + 1)); }
    function escapeText(s) { return String(s).replace(/[&<>]/g, (c) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;" }[c])); }

    function formatClock(ts) {
      const d = new Date(ts);
      return `${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
    }

    function formatClockHM(ts) {
      const d = new Date(ts);
      return `${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
    }

    const SAVE_VERSION = "v2";
    const SAVE_HASH_KEY = "save";
    const CLEAR_HASH_AFTER_LOAD = true;

		function getShiftMs() {
			return Math.max(0, Date.now() - runtime.shiftStart);
		}

		function loadShiftMsFromStorage() {
			const raw = safeStorageGet(LS.shiftMs);
			const n = raw ? parseInt(raw, 10) : 0;
			return Number.isFinite(n) && n >= 0 ? n : 0;
		}

		function saveShiftMsToStorage() {
			if (!runtime.gate || !document.body.classList.contains("started")) return;
			// Skip saving in endurance mode - progress is lost on close
			if (loadShiftMode() === "endurance") return;
			saveGateState(runtime.gate);
			safeStorageSet(LS.shiftMs, String(getShiftMs()));
		}

    function safeStorageGet(key) {
      try { return localStorage.getItem(key); } catch (_) { return null; }
    }
    function safeStorageSet(key, value) {
      try { localStorage.setItem(key, value); return true; } catch (_) { return false; }
    }

    function safeReplaceState(url) {
      try {
        history.replaceState(null, "", url);
        return true;
      } catch (_) {
        return false;
      }
    }

    function bytesToBase64Url(bytes) {
      let binary = "";
      for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
      return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
    }

    function base64UrlToBytes(str) {
      const base64 = str.replace(/-/g, "+").replace(/_/g, "/");
      const pad = base64.length % 4 ? "=".repeat(4 - (base64.length % 4)) : "";
      const binary = atob(base64 + pad);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return bytes;
    }

    const BASE91_ALPHABET = (() => {
      let chars = "";
      for (let i = 33; i <= 126; i++) {
        const ch = String.fromCharCode(i);
        if (ch === "#" || ch === "%" || ch === "\"") continue;
        chars += ch;
      }
      return chars;
    })();

    const BASE91_TABLE = (() => {
      const table = new Int16Array(128).fill(-1);
      for (let i = 0; i < BASE91_ALPHABET.length; i++) {
        table[BASE91_ALPHABET.charCodeAt(i)] = i;
      }
      return table;
    })();

    function bytesToBase91(bytes) {
      let b = 0;
      let n = 0;
      let out = "";
      for (let i = 0; i < bytes.length; i++) {
        b |= bytes[i] << n;
        n += 8;
        if (n > 13) {
          let v = b & 8191;
          if (v > 88) {
            b >>= 13;
            n -= 13;
          } else {
            v = b & 16383;
            b >>= 14;
            n -= 14;
          }
          out += BASE91_ALPHABET[v % 91] + BASE91_ALPHABET[Math.floor(v / 91)];
        }
      }
      if (n) {
        out += BASE91_ALPHABET[b % 91];
        if (n > 7 || b > 90) out += BASE91_ALPHABET[Math.floor(b / 91)];
      }
      return out;
    }

    function base91ToBytes(str) {
      let b = 0;
      let n = 0;
      let v = -1;
      const out = [];
      for (let i = 0; i < str.length; i++) {
        const code = str.charCodeAt(i);
        if (code >= BASE91_TABLE.length) return null;
        const val = BASE91_TABLE[code];
        if (val === -1) return null;
        if (v < 0) {
          v = val;
        } else {
          v += val * 91;
          b |= v << n;
          n += (v & 8191) > 88 ? 13 : 14;
          while (n >= 8) {
            out.push(b & 255);
            b >>= 8;
            n -= 8;
          }
          v = -1;
        }
      }
      if (v > -1) {
        out.push((b | (v << n)) & 255);
      }
      return new Uint8Array(out);
    }

    async function compressBytes(bytes) {
      if (typeof CompressionStream !== "function") {
        return bytes;
      }
      const stream = new Blob([bytes]).stream().pipeThrough(new CompressionStream("deflate"));
      const buffer = await new Response(stream).arrayBuffer();
      return new Uint8Array(buffer);
    }

    async function decompressBytes(bytes) {
      if (typeof DecompressionStream !== "function") {
        return bytes;
      }
      const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("deflate"));
      const buffer = await new Response(stream).arrayBuffer();
      return new Uint8Array(buffer);
    }

    async function compressJsonToUrl(data, version = SAVE_VERSION) {
      const json = JSON.stringify(data);
      const bytes = new TextEncoder().encode(json);
      const compressed = await compressBytes(bytes);
      return version === "v2" ? bytesToBase91(compressed) : bytesToBase64Url(compressed);
    }

    async function decompressJsonFromUrl(str, version = SAVE_VERSION) {
      const bytes = version === "v2" ? base91ToBytes(str) : base64UrlToBytes(str);
      if (!bytes) throw new Error("Invalid share payload");
      const decompressed = await decompressBytes(bytes);
      const json = new TextDecoder().decode(decompressed);
      return JSON.parse(json);
    }

