	/* Fireworks Theme - New Year shimmer (charcoal, teal, gold) */
	:root[data-theme="fireworks"] {
		--deep: #050607;
		--bg-hi: #121418;

		--ink: #fff2d6;
		--muted: #c7ad82;
		--signal: #ffd45b;
		--good: #7fe8ff;

		--line: rgba(255, 212, 91, 0.26);
		--grid: rgba(127, 232, 255, 0.08);
		--glow: rgba(255, 212, 91, 0.45);

		--shadowText: rgba(255, 212, 91, 0.2);
		--shadowText2: rgba(127, 232, 255, 0.16);

		--stat: #ffe3a3;
	}

	/* Verdant Theme - St. Patrick (forest, cream, brass) */
	:root[data-theme="verdant"] {
		--deep: #0b120d;
		--bg-hi: #161f18;

		--ink: #f7f2de;
		--muted: #b7a780;
		--signal: #3aa06d;
		--good: #d2b35a;

		--line: rgba(58, 160, 109, 0.22);
		--grid: rgba(210, 179, 90, 0.08);
		--glow: rgba(58, 160, 109, 0.35);

		--shadowText: rgba(58, 160, 109, 0.18);
		--shadowText2: rgba(210, 179, 90, 0.16);

		--stat: #d2b35a;
	}

	/* Pastel Signal Theme - Easter (mint, peach, sky) */
	:root[data-theme="easter"] {
		--deep: #0e0a12;
		--bg-hi: #1a1322;

		--ink: #ffe8f1;
		--muted: #d9a9be;
		--signal: #ff9cc3;
		--good: #ffd29a;

		--line: rgba(255, 156, 195, 0.24);
		--grid: rgba(255, 210, 154, 0.1);
		--glow: rgba(255, 156, 195, 0.45);

		--shadowText: rgba(255, 156, 195, 0.22);
		--shadowText2: rgba(255, 210, 154, 0.16);

		--stat: #ffd29a;
	}

	/* Herbal Theme - Lavender and green */
	:root[data-theme="herbal"] {
		--deep: #0b1011;
		--bg-hi: #17201f;

		--ink: #efe6ff;
		--muted: #9fb5a4;
		--signal: #c7a5ff;
		--good: #8fd3a6;

		--line: rgba(199, 165, 255, 0.22);
		--grid: rgba(143, 211, 166, 0.1);
		--glow: rgba(199, 165, 255, 0.4);

		--shadowText: rgba(199, 165, 255, 0.2);
		--shadowText2: rgba(143, 211, 166, 0.16);

		--stat: #bfe6c9;
	}

	/* Aurora Theme - Indigo with teal/lime glow */
	:root[data-theme="aurora"] {
		--deep: #06080f;
		--bg-hi: #101427;

		--ink: #dfe9ff;
		--muted: #8a97c4;
		--signal: #42f5c6;
		--good: #a6ff6a;

		--line: rgba(66, 245, 198, 0.22);
		--grid: rgba(166, 255, 106, 0.08);
		--glow: rgba(66, 245, 198, 0.45);

		--shadowText: rgba(66, 245, 198, 0.2);
		--shadowText2: rgba(166, 255, 106, 0.14);

		--stat: #7bd1ff;
	}

	/* Rustbelt Theme - Oxidized copper and slate */
	:root[data-theme="rustbelt"] {
		--deep: #0c1012;
		--bg-hi: #161c20;

		--ink: #e4edf0;
		--muted: #9aa7b0;
		--signal: #c56a3a;
		--good: #7fb7a5;

		--line: rgba(197, 106, 58, 0.24);
		--grid: rgba(127, 183, 165, 0.08);
		--glow: rgba(197, 106, 58, 0.4);

		--shadowText: rgba(197, 106, 58, 0.2);
		--shadowText2: rgba(127, 183, 165, 0.14);

		--stat: #c2d7de;
	}

	/* Oceanic Theme - Stormglass/ash with pale cyan */
	:root[data-theme="oceanic"] {
		--deep: #0a0f12;
		--bg-hi: #151b22;

		--ink: #e6f1f6;
		--muted: #9aa8b4;
		--signal: #9fd9e8;
		--good: #cbd6e2;

		--line: rgba(159, 217, 232, 0.22);
		--grid: rgba(203, 214, 226, 0.08);
		--glow: rgba(159, 217, 232, 0.35);

		--shadowText: rgba(159, 217, 232, 0.2);
		--shadowText2: rgba(203, 214, 226, 0.14);

		--stat: #cbd6e2;
	}

	/* Obsidian Theme - Near-black with muted ember accents */
	:root[data-theme="obsidian"] {
		--deep: #020202;
		--bg-hi: #0a0b10;

		--ink: #e6e1f2;
		--muted: #a6a1b6;
		--signal: #b9c4d6;
		--good: #9fc5a5;

		--line: rgba(185, 196, 214, 0.22);
		--grid: rgba(159, 197, 165, 0.06);
		--glow: rgba(185, 196, 214, 0.35);

		--shadowText: rgba(185, 196, 214, 0.2);
		--shadowText2: rgba(159, 197, 165, 0.12);

		--stat: #d0c7e6;
	}

	/* Desert Radar Theme - Sand, olive, dark brown */
	:root[data-theme="desertradar"] {
		--deep: #0f0d09;
		--bg-hi: #1a1610;

		--ink: #f3e6d0;
		--muted: #b59d7f;
		--signal: #b5c46a;
		--good: #e2c36b;

		--line: rgba(181, 196, 106, 0.22);
		--grid: rgba(226, 195, 107, 0.08);
		--glow: rgba(181, 196, 106, 0.38);

		--shadowText: rgba(181, 196, 106, 0.2);
		--shadowText2: rgba(226, 195, 107, 0.12);

		--stat: #e2c36b;
	}
		/* RGB shift animation keyframes */
		@keyframes rgb-shift {
			0% {
				filter: hue-rotate(0deg) saturate(1.4);
			}
			33% {
				filter: hue-rotate(120deg) saturate(1.4);
			}
			66% {
				filter: hue-rotate(240deg) saturate(1.4);
			}
			100% {
				filter: hue-rotate(360deg) saturate(1.4);
			}
		}

		/* Apply RGB shift to UI elements in gamer theme */
		:root[data-theme="gamer"] .panel,
		:root[data-theme="gamer"] .gate-display,
		:root[data-theme="gamer"] .operator-callsign,
		:root[data-theme="gamer"] .relay,
		:root[data-theme="gamer"] button,
		:root[data-theme="gamer"] select,
		:root[data-theme="gamer"] input,
		:root[data-theme="gamer"] .status-bar,
		:root[data-theme="gamer"] .logbox,
		:root[data-theme="gamer"] .breadcrumbs {
			animation: rgb-shift 3s linear infinite;
		}

		/* Ensure text remains readable during RGB shift */
		:root[data-theme="gamer"] .console-line,
		:root[data-theme="gamer"] .event-line,
		:root[data-theme="gamer"] .stat-value,
		:root[data-theme="gamer"] .gate-id {
			filter: none;
			animation: none;
		}

		/* Light-theme surface fixes (because many backgrounds are hard-coded dark rgba) */
		:root[data-theme="lightblue"] #game-container,
		:root[data-theme="lightred"] #game-container,
		:root[data-theme="lightgreen"] #game-container,
		:root[data-theme="paper"] #game-container,
		:root[data-theme="aperture"] #game-container {
			background: rgba(255,255,255,0.86);
			box-shadow: 0 0 24px rgba(0,0,0,0.18), inset 0 0 0 1px rgba(0,0,0,0.06);
		}

		:root[data-theme="lightblue"] .panel,
		:root[data-theme="lightred"] .panel,
		:root[data-theme="lightgreen"] .panel,
		:root[data-theme="paper"] .panel,
		:root[data-theme="aperture"] .panel {
			background: rgba(255,255,255,0.72);
			box-shadow: inset 0 0 12px rgba(0,0,0,0.08);
		}

		:root[data-theme="lightblue"] .panel::before,
		:root[data-theme="lightred"] .panel::before,
		:root[data-theme="lightgreen"] .panel::before,
		:root[data-theme="paper"] .panel::before,
		:root[data-theme="aperture"] .panel::before {
			background:
				linear-gradient(transparent 70%, rgba(0,0,0,0.03) 70%),
				radial-gradient(circle at 20% 0%, var(--grid) 0%, transparent 55%);
		}

		:root[data-theme="lightblue"] .queue-section,
		:root[data-theme="lightblue"] .sys-block,
		:root[data-theme="lightred"] .queue-section,
		:root[data-theme="lightred"] .sys-block,
		:root[data-theme="lightgreen"] .queue-section,
		:root[data-theme="lightgreen"] .sys-block,
		:root[data-theme="paper"] .queue-section,
		:root[data-theme="paper"] .sys-block,
		:root[data-theme="aperture"] .queue-section,
		:root[data-theme="aperture"] .sys-block {
			background: rgba(255,255,255,0.58);
		}

		:root[data-theme="lightblue"] select,
		:root[data-theme="lightblue"] button,
		:root[data-theme="lightblue"] input,
		:root[data-theme="lightblue"] .gate-display,
		:root[data-theme="lightblue"] .breadcrumbs,
		:root[data-theme="lightblue"] .operator-callsign,
		:root[data-theme="lightred"] select,
		:root[data-theme="lightred"] button,
		:root[data-theme="lightred"] input,
		:root[data-theme="lightred"] .gate-display,
		:root[data-theme="lightred"] .breadcrumbs,
		:root[data-theme="lightred"] .operator-callsign,
		:root[data-theme="lightgreen"] select,
		:root[data-theme="lightgreen"] button,
		:root[data-theme="lightgreen"] input,
		:root[data-theme="lightgreen"] .gate-display,
		:root[data-theme="lightgreen"] .breadcrumbs,
		:root[data-theme="lightgreen"] .operator-callsign,
		:root[data-theme="paper"] select,
		:root[data-theme="paper"] button,
		:root[data-theme="paper"] input,
		:root[data-theme="paper"] .gate-display,
		:root[data-theme="paper"] .breadcrumbs,
		:root[data-theme="paper"] .operator-callsign,
		:root[data-theme="aperture"] select,
		:root[data-theme="aperture"] button,
		:root[data-theme="aperture"] input,
		:root[data-theme="aperture"] .gate-display,
		:root[data-theme="aperture"] .breadcrumbs,
		:root[data-theme="aperture"] .operator-callsign {
			background: rgba(255,255,255,0.78);
			box-shadow: inset 0 0 12px rgba(0,0,0,0.06);
		}

		:root[data-theme="lightblue"] button:hover,
		:root[data-theme="lightred"] button:hover,
		:root[data-theme="lightgreen"] button:hover,
		:root[data-theme="paper"] button:hover,
		:root[data-theme="aperture"] button:hover,
		:root[data-theme="lightblue"] button:active,
		:root[data-theme="lightred"] button:active,
		:root[data-theme="lightgreen"] button:active,
		:root[data-theme="paper"] button:active,
		:root[data-theme="aperture"] button:active {
		}

		/* Light theme dropdown option styling for readability */
		:root[data-theme="lightblue"] select option,
		:root[data-theme="lightred"] select option,
		:root[data-theme="lightgreen"] select option,
		:root[data-theme="paper"] select option,
		:root[data-theme="aperture"] select option {
			background: #ffffff;
			color: #1a1a1a;
		}
		:root[data-theme="lightblue"] select option:checked,
		:root[data-theme="lightred"] select option:checked,
		:root[data-theme="lightgreen"] select option:checked,
		:root[data-theme="paper"] select option:checked,
		:root[data-theme="aperture"] select option:checked {
			background: var(--signal);
			color: #ffffff;
			font-weight: bold;
		}

		:root[data-theme="lightblue"] th,
		:root[data-theme="lightblue"] td,
		:root[data-theme="lightred"] th,
		:root[data-theme="lightred"] td,
		:root[data-theme="lightgreen"] th,
		:root[data-theme="lightgreen"] td,
		:root[data-theme="paper"] th,
		:root[data-theme="paper"] td,
		:root[data-theme="aperture"] th,
		:root[data-theme="aperture"] td {
			border-bottom: 1px solid rgba(0,0,0,0.06);
		}

		:root[data-theme="lightblue"] .help-panel,
		:root[data-theme="lightred"] .help-panel,
		:root[data-theme="lightgreen"] .help-panel,
		:root[data-theme="paper"] .help-panel,
		:root[data-theme="aperture"] .help-panel {
			background: rgba(255,255,255,0.95);
			box-shadow: 0 0 32px rgba(0,0,0,0.18), inset 0 0 0 1px rgba(0,0,0,0.05);
		}

		:root[data-theme="lightblue"] .help-section,
		:root[data-theme="lightred"] .help-section,
		:root[data-theme="lightgreen"] .help-section,
		:root[data-theme="paper"] .help-section,
		:root[data-theme="aperture"] .help-section {
			background: rgba(0,0,0,0.03);
		}

		/* Light-theme modal overlay fixes */
		:root[data-theme="lightblue"] #break-modal-overlay,
		:root[data-theme="lightblue"] #shift-time-modal-overlay,
		:root[data-theme="lightblue"] #confirm-reset-overlay,
		:root[data-theme="lightblue"] #confirm-data-reset-overlay,
		:root[data-theme="lightblue"] #confirm-full-reset-overlay,
		:root[data-theme="lightblue"] #confirm-clearance-overlay,
		:root[data-theme="lightred"] #break-modal-overlay,
		:root[data-theme="lightred"] #shift-time-modal-overlay,
		:root[data-theme="lightred"] #confirm-reset-overlay,
		:root[data-theme="lightred"] #confirm-data-reset-overlay,
		:root[data-theme="lightred"] #confirm-full-reset-overlay,
		:root[data-theme="lightred"] #confirm-clearance-overlay,
		:root[data-theme="lightgreen"] #break-modal-overlay,
		:root[data-theme="lightgreen"] #shift-time-modal-overlay,
		:root[data-theme="lightgreen"] #confirm-reset-overlay,
		:root[data-theme="lightgreen"] #confirm-data-reset-overlay,
		:root[data-theme="lightgreen"] #confirm-full-reset-overlay,
		:root[data-theme="lightgreen"] #confirm-clearance-overlay,
		:root[data-theme="paper"] #break-modal-overlay,
		:root[data-theme="paper"] #shift-time-modal-overlay,
		:root[data-theme="paper"] #confirm-reset-overlay,
		:root[data-theme="paper"] #confirm-data-reset-overlay,
		:root[data-theme="paper"] #confirm-full-reset-overlay,
		:root[data-theme="paper"] #confirm-clearance-overlay,
		:root[data-theme="aperture"] #break-modal-overlay,
		:root[data-theme="aperture"] #shift-time-modal-overlay,
		:root[data-theme="aperture"] #confirm-reset-overlay,
		:root[data-theme="aperture"] #confirm-data-reset-overlay,
		:root[data-theme="aperture"] #confirm-full-reset-overlay,
		:root[data-theme="aperture"] #confirm-clearance-overlay {
			background: radial-gradient(circle at center, rgba(245, 246, 248, 0.94) 0%, rgba(230,232,235,0.98) 70%);
		}

		/* Light-theme modal card fixes */
		:root[data-theme="lightblue"] .confirm-card,
		:root[data-theme="lightred"] .confirm-card,
		:root[data-theme="lightgreen"] .confirm-card,
		:root[data-theme="paper"] .confirm-card,
		:root[data-theme="aperture"] .confirm-card {
			background: rgba(255, 255, 255, 0.96);
			border: 1px solid rgba(0,0,0,0.12);
			box-shadow: 0 0 30px rgba(0,0,0,0.15), inset 0 0 0 1px rgba(0,0,0,0.05);
		}

		/* Light-theme shift time custom section */
		:root[data-theme="lightblue"] .shift-time-custom,
		:root[data-theme="lightred"] .shift-time-custom,
		:root[data-theme="lightgreen"] .shift-time-custom,
		:root[data-theme="paper"] .shift-time-custom,
		:root[data-theme="aperture"] .shift-time-custom {
			background: rgba(0, 0, 0, 0.04);
			border: 1px solid rgba(0, 0, 0, 0.1);
		}

		/* Light-theme shift time custom inputs */
		:root[data-theme="lightblue"] .shift-time-custom-input,
		:root[data-theme="lightred"] .shift-time-custom-input,
		:root[data-theme="lightgreen"] .shift-time-custom-input,
		:root[data-theme="paper"] .shift-time-custom-input,
		:root[data-theme="aperture"] .shift-time-custom-input {
			background: rgba(255, 255, 255, 0.85);
			border: 1px solid rgba(var(--signal-rgb, 100, 180, 255), 0.3);
			color: var(--signal);
		}

		:root[data-theme="lightblue"] .shift-time-custom-input:focus,
		:root[data-theme="lightred"] .shift-time-custom-input:focus,
		:root[data-theme="lightgreen"] .shift-time-custom-input:focus,
		:root[data-theme="paper"] .shift-time-custom-input:focus,
		:root[data-theme="aperture"] .shift-time-custom-input:focus {
			background: rgba(255, 255, 255, 0.95);
			border-color: var(--signal);
		}

		/* Light-theme preset and break duration buttons */
		:root[data-theme="lightblue"] .shift-time-preset-btn,
		:root[data-theme="lightblue"] .break-duration-btn,
		:root[data-theme="lightred"] .shift-time-preset-btn,
		:root[data-theme="lightred"] .break-duration-btn,
		:root[data-theme="lightgreen"] .shift-time-preset-btn,
		:root[data-theme="lightgreen"] .break-duration-btn,
		:root[data-theme="paper"] .shift-time-preset-btn,
		:root[data-theme="paper"] .break-duration-btn,
		:root[data-theme="aperture"] .shift-time-preset-btn,
		:root[data-theme="aperture"] .break-duration-btn {
			background: rgba(var(--signal-rgb, 100, 180, 255), 0.08);
			border: 1px solid rgba(var(--signal-rgb, 100, 180, 255), 0.25);
		}

		:root[data-theme="lightblue"] .shift-time-preset-btn:hover,
		:root[data-theme="lightblue"] .break-duration-btn:hover,
		:root[data-theme="lightred"] .shift-time-preset-btn:hover,
		:root[data-theme="lightred"] .break-duration-btn:hover,
		:root[data-theme="lightgreen"] .shift-time-preset-btn:hover,
		:root[data-theme="lightgreen"] .break-duration-btn:hover,
		:root[data-theme="paper"] .shift-time-preset-btn:hover,
		:root[data-theme="paper"] .break-duration-btn:hover,
		:root[data-theme="aperture"] .shift-time-preset-btn:hover,
		:root[data-theme="aperture"] .break-duration-btn:hover {
			background: rgba(var(--signal-rgb, 100, 180, 255), 0.15);
			border-color: var(--signal);
		}

		:root[data-theme="lightblue"] .shift-time-preset-btn.selected,
		:root[data-theme="lightred"] .shift-time-preset-btn.selected,
		:root[data-theme="lightgreen"] .shift-time-preset-btn.selected,
		:root[data-theme="paper"] .shift-time-preset-btn.selected,
		:root[data-theme="aperture"] .shift-time-preset-btn.selected {
			background: rgba(var(--signal-rgb, 100, 180, 255), 0.25);
			border-color: var(--signal);
		}

		/* Light-theme disabled break buttons */
		:root[data-theme="lightblue"] .break-duration-btn:disabled,
		:root[data-theme="lightred"] .break-duration-btn:disabled,
		:root[data-theme="lightgreen"] .break-duration-btn:disabled,
		:root[data-theme="paper"] .break-duration-btn:disabled,
