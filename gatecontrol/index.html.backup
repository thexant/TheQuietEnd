      DOCK: { baseCredits: 250, creditIncrease: 150, supply: 40 }
    };
    const MAX_RELAYS = 8;
    const MAX_DOCK_SLOTS = 12;
    const RESOURCE_ORDER_PHASES = [
      { key: "PROCESSING ORDER", min: 30, max: 90 },
      { key: "PREPARING ORDER", min: 60, max: 120 },
      { key: "SHIPPING", min: 30, max: 60 }
    ];

    // Sparse rates (per second tick)
    const RATES = {
      maxIn: 6,
      maxOut: 6,
      spawnInChance: 0.0052,   // ~1 every 2.7 min
      spawnOutChance: 0.0050,  // ~1 every 3.3 min
      reportChance: 0.018,    // sparse ambient chatter
      flavorChance: 0.0025,   // rare ambient flavor text
      driftChance: 0.015,     // alignment drift
      syncDriftChance: 0.008, // sync slips to ASYNC/FAULT
      syncRecoverChance: 0.06, // sync recovers to SYNC (with healthy relays)
      wobbleChance: 0.010,    // corridor wobble
      facilityFaultChance: 0.00085, // rare subsystem faults
      facilityWorsenChance: 0.00015,
      relayPacketChance: 0.0045,
      relayShiftChance: 0.0016,  // Increased slightly for more dynamic relay health
      relayPingChance: 0.0020,
      relayDropChance: 0.00015,  // Reduced from 0.00020 (halved frequency)
      concourseFade: 0.08,
      fuelDrain: 0.015,
      supplyDrainWorkOrder: 0.045,
      supplyDrainDecon: 0.015
    };

    // Upgrade system configuration
    const UPGRADE_REACTOR_COST = 250; // CR cost
    const UPGRADE_MAINTENANCE_COST = 200; // CR cost
    const UPGRADE_DRAIN_MULTIPLIER = 3.0; // 3x drain during upgrade
    const UPGRADE_FUEL_BENEFIT = 0.65; // 35% reduction in fuel drain (multiply base rate by 0.65)
    const UPGRADE_SUPPLY_BENEFIT = 0.70; // 30% reduction in supply usage (multiply supply costs by 0.70)

    // Calculate upgrade duration to drain 30-40% of resource
    // Fuel drains at 0.015 per tick normally, 0.045 during upgrade
    // To drain 35% at 0.045/tick: 35 / 0.045 = ~778 ticks
    // At ~60 ticks/sec = ~19.4 seconds, let's make it 60 seconds for better gameplay
    const UPGRADE_REACTOR_DURATION = 60; // seconds
    const UPGRADE_MAINTENANCE_DURATION = 60; // seconds

    // Repair system configuration
    const REPAIR_DELAY_MIN = 15; // seconds
    const REPAIR_DELAY_MAX = 30; // seconds
    const REPAIR_FAILURE_CHANCE = 0.30; // 30% overall failure rate
    const REPAIR_FAILURE_OFFLINE_CHANCE = 0.25; // Chance a failed repair knocks system offline
    const REPAIR_COOLDOWN_MS = 5000; // 5 seconds
    const REPAIR_SUPPLY_COST = 3; // Supply cost per REPAIR attempt (percent)
    const DEGRADED_TIMEOUT_MIN_MS = 1 * 60 * 1000; // 2 min
    const DEGRADED_TIMEOUT_MAX_MS = 3 * 60 * 1000; // 5 min

    const CORRIDOR_TRAFFIC_WEIGHTS = {
      STABLE: 1,
      DEGRADED: 0.75,
      INTERMITTENT: 0.35,
      OFFLINE: 0.05
    };

    const SYNC_TRAFFIC_WEIGHTS = {
      SYNC: 1,
      ASYNC: 0.75,
      FAULT: 0.50
    };

    const GATE_ALIGNMENT_RANK = {
      "WITHIN TOLERANCE": 0,
      "DRIFTING": 1,
      "OUT OF TOLERANCE": 2
    };

    const GATE_SYNC_RANK = {
      SYNC: 0,
      ASYNC: 1,
      FAULT: 2
    };

    const GATE_BEACON_RANK = {
      ONLINE: 0,
      FAULT: 1,
      OFFLINE: 2
    };

    function didWorsen(prev, next, ranks) {
      return (ranks[next] ?? 0) > (ranks[prev] ?? 0);
    }

    // ETA ranges in seconds (slow but not ridiculous)
    const ETA = { min: 30, max: 180 }; // 0:30-3:00 minutes
    const URGENT_DEADLINE_MIN_SEC = 10; // Minimum response window for urgent timers - very tight!
    const URGENT_DEADLINE_MAX_SEC = 30; // 30 seconds max for urgent timers - truly urgent!

    // Adaptive timer cap helpers - ensures timers make sense for shift duration
    // For unlimited shifts (-1), use original max values
    function getAdaptiveShipETAMax() {
      const shiftDurationMs = loadShiftDuration();
      if (shiftDurationMs === -1 || shiftDurationMs >= 30 * 60 * 1000) {
        return ETA.max; // 30+ minute shifts: use original 3 minute max
      }
      // Cap at 60% of shift duration (allows ship to arrive, service, and depart)
      const cappedMax = Math.floor(shiftDurationMs * 0.6 / 1000);
      return Math.max(ETA.min, Math.min(ETA.max, cappedMax));
    }

    function getAdaptiveWorkOrderMax(phaseMin, phaseMax) {
      const shiftDurationMs = loadShiftDuration();
      if (shiftDurationMs === -1 || shiftDurationMs >= 30 * 60 * 1000) {
        return phaseMax; // 30+ minute shifts: use original max
      }
      // Cap repair phase at 40% of shift duration
      if (phaseMax >= 240) { // This is the REPAIRING phase (90-300s)
        const cappedMax = Math.floor(shiftDurationMs * 0.4 / 1000);
        return Math.max(phaseMin, Math.min(phaseMax, cappedMax));
      }
      return phaseMax; // Other phases unchanged
    }

    function getAdaptiveResourceOrderMax(phaseMin, phaseMax) {
      const shiftDurationMs = loadShiftDuration();
      if (shiftDurationMs === -1 || shiftDurationMs >= 30 * 60 * 1000) {
        return phaseMax; // 30+ minute shifts: use original max
      }
      // Cap shipping phase at 50% of shift duration
      if (phaseMax >= 300) { // This is the SHIPPING phase (120-360s)
        const cappedMax = Math.floor(shiftDurationMs * 0.5 / 1000);
        return Math.max(phaseMin, Math.min(phaseMax, cappedMax));
      }
      return phaseMax; // Other phases unchanged
    }

    const SHIFT_BALANCE_BASE_MS = 2 * 60 * 60 * 1000; // 2 hours = baseline pacing
    const SHIFT_PACE_MAX = 2.25;
    const SHIFT_COST_MIN = 0.45;

    function getShiftPaceScale() {
      const shiftDurationMs = loadShiftDuration();
      const mode = loadShiftMode();
      if (mode === "unlimited" || mode === "endurance" || shiftDurationMs === -1) return 1;
      if (!shiftDurationMs || shiftDurationMs <= 0) return 1;
      if (shiftDurationMs >= SHIFT_BALANCE_BASE_MS) return 1;
      const ratio = SHIFT_BALANCE_BASE_MS / shiftDurationMs;
      const pace = Math.sqrt(ratio);
      return clamp(pace, 1, SHIFT_PACE_MAX);
    }

    function getShiftCostScale() {
        return 1;
    }

    function scaleShiftSeconds(seconds) {
      const pace = getShiftPaceScale();
      if (pace <= 1) return seconds;
      return Math.max(5, Math.round(seconds / pace));
    }

    const RELAY_ACK_WINDOW_MS = 5_000;  // 5 seconds - tighter window balances gradual penalty

    // Health-based heartbeat intervals (ms) - EARLY WARNING: slows down in 70-100 range
    const RELAY_HEARTBEAT_ONLINE_MIN_MS = 0;        // 93-100% health
    const RELAY_HEARTBEAT_ONLINE_MAX_MS = 2000;     // 0-2s
    const RELAY_HEARTBEAT_WEAK_MIN_MS = 2000;       // 85-92% health
    const RELAY_HEARTBEAT_WEAK_MAX_MS = 4000;       // 2-4s
    const RELAY_HEARTBEAT_FAULT_MIN_MS = 4000;      // 75-84% health
    const RELAY_HEARTBEAT_FAULT_MAX_MS = 6000;      // 4-6s
    const RELAY_HEARTBEAT_CRITICAL_MIN_MS = 6000;   // <75% health (max slowness)
    const RELAY_HEARTBEAT_CRITICAL_MAX_MS = 8000;   // 6-8s

    // Fallback heartbeat intervals for edge cases
    const RELAY_HEARTBEAT_MIN_MS = 1_200;
    const RELAY_HEARTBEAT_MAX_MS = 3_200;

    // Stale heartbeat thresholds (seconds) - when to warn/alert per health tier
    const RELAY_HEARTBEAT_ONLINE_WARN_SEC = 2;      // 93-100% health
    const RELAY_HEARTBEAT_ONLINE_CRIT_SEC = 4;
    const RELAY_HEARTBEAT_WEAK_WARN_SEC = 4;        // 85-92% health
    const RELAY_HEARTBEAT_WEAK_CRIT_SEC = 6;
    const RELAY_HEARTBEAT_FAULT_WARN_SEC = 6;       // 75-84% health
    const RELAY_HEARTBEAT_FAULT_CRIT_SEC = 8;
    const RELAY_HEARTBEAT_CRITICAL_WARN_SEC = 8;    // <75% health
    const RELAY_HEARTBEAT_CRITICAL_CRIT_SEC = 10;

    // Fallback stale thresholds
    const RELAY_HEARTBEAT_STALE_WARN_SEC = 6;
    const RELAY_HEARTBEAT_STALE_CRIT_SEC = 12;

    const RELAY_HICCUP_RECOVERABLE_CHANCE = 0.55;
    const RELAY_HICCUP_JOSTLE_DECAY_SEC = 18;
    const RELAY_SEVER_GRACE_MS = 10_000;  // 10 seconds - spam BROADCAST to extend
    const GATE_SYSTEMS_SEVER_GRACE_MS = 60_000;
    const GATE_SYSTEMS_KLAXON_MS = 30_000;
    const RELAY_BROADCAST_EXTENSION_MS = 1_500;  // Each BROADCAST click adds 1.5 seconds
    const RELAY_CRITICAL_GRACE_MS = 45_000;

    // ---------------------------
    // Crew Generation Functions
    // ---------------------------
    function generateCrewName(rng) {
      const firstName = pick(rng, CREW_NAMES.firstNames);
      let surname = pick(rng, CREW_NAMES.surnames);

      // 15% chance of hyphenated surname
      if (rng() < 0.15) {
        const surname2 = pick(rng, CREW_NAMES.surnames);
        surname = `${surname}-${surname2}`;
      }

      return `${firstName} ${surname}`;
    }

    function getCrewCountForShipType(type) {
      // Different ship types have different crew sizes (3-8)
      const crewCounts = {
        "CARGO": [4, 5, 6],
        "CIVILIAN": [3, 4, 5],
        "MAINT": [4, 5],
        "ESCORT": [5, 6, 7],
        "MED": [4, 5, 6],
        "SHIPMENT": [3, 4, 5],
        "UNKNOWN": [3, 4, 5, 6],
        "INFESTED": [4, 5, 6],
        "PIRATE": [5, 6, 7, 8],
        "RAIDER": [5, 6, 7, 8],
        "IRRADIATED": [4, 5, 6]
      };

      const counts = crewCounts[type] || [4, 5];
      return counts[Math.floor(Math.random() * counts.length)];
    }

    function corruptCrewName(name, corruptionRate) {
      // Similar to corruptMessageText but for crew names
      const symbols = ['#', '$', '!', '@', '%', '^', '&', '*', '?'];
      const chars = name.split('');

      for (let i = 0; i < chars.length; i++) {
        if (chars[i] === ' ') continue; // Don't corrupt spaces
        if (Math.random() < corruptionRate) {
          if (Math.random() < 0.70) {
            // 70% replace with symbol
            chars[i] = symbols[Math.floor(Math.random() * symbols.length)];
          } else {
            // 30% delete
            chars[i] = '';
          }
        }
      }

      return chars.join('');
    }

    function maskCrewName(name) {
      // Fully obfuscate names with symbol noise while preserving spacing
      const symbols = ['#', '$', '!', '@', '%', '^', '&', '*', '?'];
      return name.split("").map(ch => {
        if (ch === " ") return " ";
        return symbols[Math.floor(Math.random() * symbols.length)];
      }).join("");
    }

    function assignCrewRole(shipType, crewIndex, totalCrew, rng) {
      // First crew member is usually the Captain/Commander
      if (crewIndex === 0) {
        return "Captain";
      }

      // Define role pools based on ship type
      const rolesByType = {
        "CARGO": ["Quartermaster", "Engineer", "Navigator", "Mechanic", "Data Officer", "Assistant"],
        "CIVILIAN": ["Passenger", "Assistant", "Navigator", "Engineer", "Medic", "Data Officer"],
        "MAINT": ["Engineer", "Mechanic", "Mechanic", "Engineer", "Assistant", "Data Officer"],
        "ESCORT": ["Security", "Security", "Tactical Officer", "Navigator", "Engineer", "Data Officer"],
        "MED": ["Medic", "Medic", "Medical Officer", "Nurse", "Assistant", "Data Officer"],
        "SHIPMENT": ["Quartermaster", "Engineer", "Navigator", "Assistant", "Data Officer"],
        "UNKNOWN": ["Navigator", "Engineer", "Assistant", "Data Officer", "Security"],
        "INFESTED": ["Engineer", "Medic", "Navigator", "Assistant", "Security"],
        "PIRATE": ["Enforcer", "Raider", "Gunner", "Security", "Mechanic"],
        "RAIDER": ["Raider", "Security", "Gunner", "Navigator", "Mechanic"],
        "IRRADIATED": ["Engineer", "Medic", "Navigator", "Radiation Tech", "Assistant"]
      };

      const roles = rolesByType[shipType] || ["Navigator", "Engineer", "Assistant", "Data Officer", "Security"];

      // Pick a weighted random role
      const roleIndex = Math.floor(rng() * roles.length);
      return roles[roleIndex];
    }

    function dailySalt() {
      const d = new Date();
      const y = d.getUTCFullYear();
      const m = pad2(d.getUTCMonth() + 1);
      const day = pad2(d.getUTCDate());
      return `${y}-${m}-${day}`;
    }

    function makeShipId(rng) {
      const prefix = pick(rng, ["V","A","M","R","K","S","T","H"]);
      const num = 1000 + Math.floor(rng() * 8999);
      return `${prefix}-${num}`;
    }

    function pickCargoForType(rng, type) {
      const list = CARGO_BY_TYPE[type] || CARGO_BY_TYPE.UNKNOWN || [CARGO_NONE];
      return pick(rng, list);
    }

    function assignCargoToShip(s, rng, opts = {}) {
      const cargoType = opts.cargoType || s.type || "UNKNOWN";
      const allowIllegal = !opts.forceLegal && !opts.disallowIllegal &&
        !s.priority && !s.hazardType && !s.obscured;

      let cargo = pickCargoForType(rng, cargoType);
      let cargoIllegal = false;
      if (allowIllegal && rng() < CONTRABAND_CARGO_CHANCE) {
        cargo = pick(rng, CONTRABAND_CARGO);
        cargoIllegal = true;
      }

      let cargoUnknown = false;
      if (cargoIllegal) {
        cargoUnknown = true;
      } else if (s.obscured || s.hazardType) {
        cargoUnknown = true;
      } else if (s.infoMasked || s.transponder !== "VALID") {
        cargoUnknown = rng() < 0.35;
      } else if (s.typeUnknown || cargoType === "UNKNOWN") {
        cargoUnknown = true;
      } else if (rng() < 0.12) {
        cargoUnknown = true;
      }

      s.cargo = cargo || CARGO_NONE;
      s.cargoUnknown = cargoUnknown;
      s.cargoIllegal = cargoIllegal;
    }

    function makeShip(rng, dir) {
      let type = dir === "IN" ? pick(rng, TYPES_IN) : pick(rng, TYPES_OUT);
      const baseType = type;
      const priority = rng() < 0.12; // reduced from 0.25 (25%) to 0.12 (12%) for better balance
      let transponder = rng() < 0.90 ? "VALID" : (rng() < 0.60 ? "MISMATCH" : "UNKNOWN");
      const obscured = rng() < 0.05;
      if (obscured) {
        type = "UNKNOWN";
        transponder = "UNKNOWN";
      }

      const req = dir === "IN" ? pick(rng, REQUESTS_IN) : pick(rng, REQUESTS_OUT);

      const state = "PENDING";

      // Generate effects first
      const effects = [];
      // CORRIDOR RADIATION only applies to OUTGOING ships
      if (dir === "OUT" && rng() < 0.04) effects.push({ name: "CORRIDOR RADIATION", hidden: rng() < 0.5, revealed: false });
      if (rng() < 0.03) effects.push({ name: "VACUUM BLOOM", hidden: rng() < 0.6, revealed: false });
      if (rng() < 0.015) effects.push({ name: rng() < 0.5 ? "RAIDER" : "PIRATE", hidden: rng() < 0.65, revealed: false });
      const hiddenThreat = obscured && rng() < 0.35;
      if (hiddenThreat) effects.push({ name: rng() < 0.5 ? "RAIDER" : "PIRATE", hidden: true, revealed: false });

      // Determine if ship should be marked as UNKNOWN based on hazards
      let infoMasked = false;
      let isHazardous = false;

      // Check for hazardous effects and determine hazard type
      // CRITICAL: Ships with hazards MUST spawn as UNKNOWN and only reveal after SCAN
      let hazardType = null;

      if (effects.some(e => e.name === "VACUUM BLOOM")) {
        hazardType = "INFESTED";
        isHazardous = true;
      } else if (effects.some(e => e.name === "RAIDER")) {
        hazardType = "RAIDER";
        isHazardous = true;
      } else if (effects.some(e => e.name === "PIRATE")) {
        hazardType = "PIRATE";
        isHazardous = true;
      } else if (effects.some(e => e.name === "CORRIDOR RADIATION") && dir === "OUT") {
        // Only mark OUTGOING ships with CORRIDOR RADIATION as hazardous
        // INCOMING ships with CORRIDOR RADIATION can dock safely after DECON
        hazardType = "IRRADIATED";
        isHazardous = true;
      }

      // If ship has a hazard, it MUST spawn as UNKNOWN (not the hazard type)
      if (hazardType) {
        type = "UNKNOWN";  // Force to UNKNOWN - will change to hazardType on SCAN
        infoMasked = true;

        // Ensure the gameplay effect exists for the chosen hazard type
        const ensureEffect = (name) => {
          if (!effects.some(e => e.name === name)) effects.push({ name, hidden: true, revealed: false });
        };
        if (hazardType === "INFESTED") ensureEffect("VACUUM BLOOM");
        if (hazardType === "IRRADIATED") ensureEffect("CORRIDOR RADIATION");
        if (hazardType === "PIRATE") ensureEffect("PIRATE");
        if (hazardType === "RAIDER") ensureEffect("RAIDER");

        // Hide ALL effects until SCAN reveals them (100%)
        for (const ef of effects) {
          ef.hidden = true;
          ef.revealed = false;
        }

        // Very small chance (2%) for hazard ships to spawn with all info revealed
        if (rng() < 0.02) {
          type = hazardType;  // Show the actual hazard type immediately
          infoMasked = false;
          // Reveal all effects
          for (const ef of effects) {
            ef.revealed = true;
          }
        }
      }
      // For non-hazardous ships, keep existing random UNKNOWN spawning
      if (!isHazardous && !obscured) {
        infoMasked = rng() < 0.04;
      }

      // Determine which fields should be unknown/masked
      // Ships can have any combination of unknown type, priority, ETA, and/or crew
      let typeUnknown = false;
      let priorityUnknown = false;
      let etaUnknown = false;
      let crewUnknown = false;

      // Hazard ships always have type UNKNOWN, but might have visible priority/ETA/crew
      if (hazardType) {
        typeUnknown = true;
        priorityUnknown = rng() < 0.25; // 25% chance priority is also unknown
        etaUnknown = rng() < 0.25; // 25% chance ETA is also unknown
        crewUnknown = rng() < 0.35; // 35% chance crew is also unknown
      }
      // Non-hazard ships can also have masked fields
      else if (infoMasked || obscured || transponder !== "VALID") {
        // Ships with transponder issues or masking can have unknown fields
        typeUnknown = rng() < 0.35; // 35% chance type is unknown
        priorityUnknown = rng() < 0.25; // 25% chance priority is unknown
        etaUnknown = rng() < 0.25; // 25% chance ETA is unknown
        crewUnknown = rng() < 0.30; // 30% chance crew is unknown
      }
      // Occasionally even "normal" ships have missing info
      else if (rng() < 0.04) {
        typeUnknown = rng() < 0.40;
        priorityUnknown = rng() < 0.25;
        etaUnknown = rng() < 0.25;
        crewUnknown = rng() < 0.15; // 15% chance crew is unknown on normal ships
      }

      // Generate crew
      const actualType = hazardType || type; // Use actual type for crew generation
      const crewCount = getCrewCountForShipType(actualType);
      const crew = [];

      // crewUnknown is determined above with other unknown fields
      let crewRevealed = false;

      // PIRATE/RAIDER ships always have unknown crew that cannot be revealed
      const isPirateRaider = hazardType === "PIRATE" || hazardType === "RAIDER" ||
                             effects.some(e => e.name === "PIRATE" || e.name === "RAIDER");

      if (isPirateRaider) {
        crewUnknown = true; // Force unknown for pirates/raiders
        crewRevealed = false; // Cannot be revealed
        // Fill with placeholder
        for (let i = 0; i < crewCount; i++) {
          const role = assignCrewRole(actualType, i, crewCount, rng);
          crew.push({ name: "UNKNOWN", deceased: false, role });
        }
      } else {
        // Generate actual crew names and roles
        for (let i = 0; i < crewCount; i++) {
          const name = generateCrewName(rng);
          const role = assignCrewRole(actualType, i, crewCount, rng);
          crew.push({ name, deceased: false, role });
        }

        // Vacuum Bloom ships have some deceased crew (but at least one alive)
        const hasVacuumBloom = effects.some(e => e.name === "VACUUM BLOOM");
        if (hasVacuumBloom && crew.length > 1) {
          // Mark random crew as deceased, but ensure at least one survivor
          const maxDeceased = crew.length - 1;
          const deceasedCount = Math.floor(rng() * maxDeceased) + 1; // At least 1 deceased

          // Randomly select crew members to mark as deceased
          const indices = Array.from({ length: crew.length }, (_, i) => i);
          for (let i = 0; i < deceasedCount; i++) {
            const idx = Math.floor(rng() * indices.length);
            const crewIdx = indices[idx];
            crew[crewIdx].deceased = true;
            indices.splice(idx, 1); // Remove from available indices
          }
        }
      }

      const cargoProfileType = baseType || type;
      const cargoState = { type: cargoProfileType, priority, hazardType, obscured, infoMasked, transponder, typeUnknown };
      assignCargoToShip(cargoState, rng);
      const { cargo, cargoUnknown, cargoIllegal } = cargoState;

      const etaMax = getAdaptiveShipETAMax();
      const transponderMatch = transponder === "MISMATCH" ? 0 : (transponder === "VALID" ? 1 : 0);
      return {
        id: makeShipId(rng),
        dir,
        eta: ETA.min + Math.floor(rng() * (etaMax - ETA.min + 1)),
        type,
        request: req,
        state,
        transponder,
        transponderMatch,
        priority,
        reason: null,
        notes: "",
        doneAt: 0,
        slotId: null,
        dockState: null,
        deconEndsAt: 0,
        serviceEndsAt: 0,
        servicePausedAt: 0,
        clearingEndsAt: 0,
        wasCleared: false,
        queryPending: false,
        servicingBlocked: false,
        serviceFacilityStatus: "ONLINE",
        effects,
        hazardDeadline: 0,
        obscured,
        infoMasked,
        hazardType,  // Stores actual hazard type (PIRATE/RAIDER/INFESTED/IRRADIATED) for UNKNOWN ships
        hiddenThreat,
        // Unknown field flags for QUERY expansion
        typeUnknown,
        priorityUnknown,
        etaUnknown,
        lastQueryTime: 0,
        // Deadline properties for outgoing ships
        departureDeadline: 0,
        deadlineType: null,
        deadlineUrgent: false,
        deadlineWarningAt: 0,
        missedDeadline: false,
        penaltyApplied: false,
        urgencyLevel: 0,
        deadlineWarning: false,
        criticalAudioPlayed: false,
        finalWarningPlayed: false,
        // HOLD tracking properties
        holdUsed: false,
        holdStartTime: 0,
        holdDuration: 0,
        // Crew properties
        cargo,
        cargoUnknown,
        cargoIllegal,
        crew,
        crewUnknown,
        crewRevealed
      };
    }

    function enforceLegalCargoForCritical(s, rng) {
      if (!s || !s.cargoIllegal) return;
      if (!shipIsPriorityOrCritical(s)) return;
      assignCargoToShip(s, rng, { forceLegal: true, cargoType: s.type });
      s.cargoIllegal = false;
    }

    function calculateDepartureDeadline(s, rng) {
      if (s.dir !== "OUT") return;

      const baseDeadline = s.eta; // Start from ETA in seconds
      let deadlineType, multiplier;
      let deadlineUrgent = false;

      switch(s.request) {
        case "TOW": {
          // Emergency rescues - VERY tight deadlines
          const towCritical = rng() < 0.6;
          deadlineType = towCritical ? "CRITICAL" : "URGENT";
          deadlineUrgent = deadlineType === "URGENT" ? true : (rng() < 0.4);
          multiplier = towCritical ? 0.40 : 0.60;
          break;
        }

        case "DEPART":
          // VIP/scheduled departures - tight windows
          if (s.priority) {
            deadlineType = "CRITICAL";
            deadlineUrgent = rng() < 0.3;
            multiplier = 0.40;
          } else {
            deadlineUrgent = rng() < 0.3;
            deadlineType = deadlineUrgent ? "URGENT" : "STANDARD";
            multiplier = deadlineUrgent ? 0.60 : 0.80;
          }
          break;

        case "CREW TRANSFER":
          // Personnel critical for operations
          deadlineType = rng() < 0.35 ? "URGENT" : "STANDARD";
          deadlineUrgent = deadlineType === "URGENT";
          multiplier = deadlineType === "URGENT" ? 0.60 : 0.80;
          break;

        case "REFUEL":
          // Fuel transfers - moderate pressure
          deadlineType = rng() < 0.2 ? "URGENT" : "STANDARD";
          deadlineUrgent = deadlineType === "URGENT";
          multiplier = deadlineType === "URGENT" ? 0.60 : 0.80;
          break;

        case "CARGO LOAD":
          // Time-sensitive cargo, perishables
          deadlineType = rng() < 0.25 ? "URGENT" : (rng() < 0.5 ? "STANDARD" : "RELAXED");
          deadlineUrgent = deadlineType === "URGENT";
          multiplier = deadlineType === "URGENT" ? 0.60 : (deadlineType === "STANDARD" ? 0.80 : 0.95);
          break;

        default:
          deadlineType = "STANDARD";
          deadlineUrgent = false;
          multiplier = 0.80;
          break;
      }

      // Apply percentage of ETA as the deadline offset
      let departureDeadlineOffset = Math.floor(baseDeadline * multiplier);
      if (deadlineUrgent) {
        departureDeadlineOffset = Math.max(
          URGENT_DEADLINE_MIN_SEC,
          Math.min(URGENT_DEADLINE_MAX_SEC, departureDeadlineOffset)
        );
      }
      s.departureDeadline = Date.now() + (departureDeadlineOffset * 1000);
      s.deadlineType = deadlineType;
      s.deadlineUrgent = deadlineUrgent;

      // Warning at 75% of deadline time
      s.deadlineWarningAt = Date.now() + Math.floor(departureDeadlineOffset * 1000 * 0.75);

      // Set urgency level for visual feedback
      s.urgencyLevel = deadlineType === "CRITICAL" ? 3 :
                       (deadlineUrgent || deadlineType === "URGENT") ? 2 :
                       deadlineType === "STANDARD" ? 1 : 0;

      // URGENT ships should never spawn as UNKNOWN priority - they need immediate attention!
      // Clear priorityUnknown flag so players can see urgency immediately without needing QRY
      if (deadlineUrgent || deadlineType === "URGENT" || deadlineType === "CRITICAL") {
        s.priorityUnknown = false;
      }
    }

    function initialCount(rng) {
      // mostly 0 or 1; sometimes 2
      let n = (rng() < 0.58) ? 0 : 1;
      if (rng() < 0.10) n += 1;
      return n;
    }

    function makeResources(rng) {
      const resources = {};
      for (const r of RESOURCE_TYPES) {
        resources[r.id] = {
          level: randRange(r.startMin, r.startMax),
          order: null,
          orderAmount: RESOURCE_ORDER_MIN
        };
      }
      return resources;
    }

    function makeGateState(gateId) {
      const seed = strHash(`${gateId}::${dailySalt()}`);
      const rng = mulberry32(seed);

      const beacon = "ONLINE";
      const alignment = "WITHIN TOLERANCE";
      const sync = "SYNC";

      const links = ["A","B","C"];
      if (rng() < 0.25) links.push("D");

      const corridors = links.map(link => {
        const st = CORRIDOR_STATES[0];
        return { link, status: st.key, cls: st.cls, lastChange: Date.now() };
      });

      const inbound = Array.from({length: initialCount(rng)}, () => makeShip(rng, "IN"));
      const outbound = Array.from({length: initialCount(rng)}, () => {
        const ship = makeShip(rng, "OUT");
        calculateDepartureDeadline(ship, rng);
        enforceLegalCargoForCritical(ship, rng);
        return ship;
      });

      const facility = FACILITY_SYSTEMS.map(sys => ({
        id: sys.id,
        name: sys.name,
        status: "ONLINE",
        lastChange: Date.now(),
        stableUntil: Date.now() + randRange(5 * 60_000, 12 * 60_000),
        lastRepairAttemptAt: 0,
        degradedSince: 0,
        degradedTimeoutAt: 0
      }));

      const dockSlots = ["SLOT-1", "SLOT-2", "SLOT-3", "SLOT-4"].map(id => ({
        id,
        state: "EMPTY",
        shipId: null,
        phaseEndsAt: 0
      }));


			// Small chance (20%) to have 3 relays instead of 2
			const relayCount = (rng() < 0.20) ? 3 : 2;
			
			const relays = Array.from({ length: relayCount }, (_, i) => ({
				id: `RELAY-${i + 1}`,
        status: "ONLINE",
        health: randRange(95, 100), // Start with good health
        lastChange: Date.now(),
        lastPacketAt: 0,
        lastRelayPingAt: 0,
        lastHeartbeatAt: Date.now(),
        nextHeartbeatAt: Date.now() + randRange(RELAY_HEARTBEAT_ONLINE_MIN_MS, RELAY_HEARTBEAT_ONLINE_MAX_MS),
        lastAckAt: 0,
        awaitingAck: false,
        ackDueAt: 0,
        offline: false,
        hiddenOffline: false,
        hiccupRecoverable: false,
        offlineReason: null,
        offlineSince: 0,
        lastHealthPingAt: 0,
        nextHealthPingCooldown: Date.now(),
        shiftChance: RATES.relayShiftChance * (0.9 + Math.random() * 0.2) // Per-relay variance: 90-110% of base rate
      }));

      const gate = {
        id: gateId,
        createdAt: Date.now(),
        lastRefresh: Date.now(),
        lastScanAt: 0,
        lastRealignAt: 0,
        lastResetAt: 0,
        lastPurgeAt: 0,
        lastStressTestAt: 0,
        relayFailureSince: 0,
        gateSystemsFailureSince: 0,
        gateSystemsAlerted: false,
        relayHealth: {
          degradedSince: 0,
          criticalSince: 0,
          lastHealthState: "HEALTHY",
          unackedPings: 0,
          lastWarningAt: 0,
          totalRelayCount: relayCount
        },
        beacon,
        alignment,
        sync,
        corridors,
        inbound,
        outbound,
        facility,
        workOrders: [],
        repairAttempts: [],
        concourseLevel: randRange(6, 26),
        dockSlots,
        relays,
        packets: [],
        resources: makeResources(rng),
        alerts: [],
        reports: [],
        relaysPurchased: 0,
        docksPurchased: 0,
          stats: {
            approved: 0,
            denied: 0,
            deniedCorrect: 0,
            deniedIncorrect: 0,
            deconStarts: 0,
            workOrdersIssued: 0,
            workOrdersCompleted: 0,
            relayRepairs: 0,
            relayAcks: 0,
          maintenanceOps: 0,
          resourceOrders: 0,
          resourceOrderSpend: 0,
          purchaseSpend: 0,
          breakSpend: 0,
          inboundTimeouts: 0
        },
        tech: {
          driftSuppressedUntil: 0,
          wobbleSuppressedUntil: 0
        }
      };
      gate.health = computeHealth(gate);
      return gate;
    }

    function reviveGateState(raw, exportedAt) {
      const g = raw && typeof raw === "object" ? raw : null;
      if (!g || !g.id) return null;

      // Calculate time delta for timestamp adjustment
      const timeDelta = (typeof exportedAt === "number" && exportedAt > 0)
        ? Date.now() - exportedAt
        : 0;

      // Helper to adjust timestamps
      const adjustTimestamp = (ts) => {
        if (typeof ts !== "number" || ts <= 0) return ts;
        return ts + timeDelta;
      };

      g.createdAt = adjustTimestamp(g.createdAt) || Date.now();
      g.lastRefresh = adjustTimestamp(g.lastRefresh) || Date.now();
      g.lastScanAt = adjustTimestamp(g.lastScanAt) || 0;
      g.lastRealignAt = adjustTimestamp(g.lastRealignAt) || 0;
      g.lastResetAt = adjustTimestamp(g.lastResetAt) || 0;
      g.lastPurgeAt = adjustTimestamp(g.lastPurgeAt) || 0;
      g.lastStressTestAt = adjustTimestamp(g.lastStressTestAt) || 0;
      g.relayFailureSince = adjustTimestamp(typeof g.relayFailureSince === "number" ? g.relayFailureSince : 0);
      g.gateSystemsFailureSince = adjustTimestamp(typeof g.gateSystemsFailureSince === "number" ? g.gateSystemsFailureSince : 0);
      g.gateSystemsAlerted = typeof g.gateSystemsAlerted === "boolean" ? g.gateSystemsAlerted : !!g.gateSystemsFailureSince;
      g.alerts ||= [];
      g.reports ||= [];
      g.relaysPurchased = typeof g.relaysPurchased === "number" ? g.relaysPurchased : 0;
      g.docksPurchased = typeof g.docksPurchased === "number" ? g.docksPurchased : 0;
        g.stats ||= {
          approved: 0,
          denied: 0,
          deniedCorrect: 0,
          deniedIncorrect: 0,
          deconStarts: 0,
          workOrdersIssued: 0,
          workOrdersCompleted: 0,
          relayRepairs: 0,
          relayAcks: 0,
        maintenanceOps: 0,
        resourceOrders: 0,
        resourceOrderSpend: 0,
        purchaseSpend: 0,
        breakSpend: 0,
        repairAttempts: 0,
        repairSuccesses: 0,
        repairFailures: 0,
        inboundTimeouts: 0
      };
        g.stats.approved = typeof g.stats.approved === "number" ? g.stats.approved : 0;
        g.stats.denied = typeof g.stats.denied === "number" ? g.stats.denied : 0;
        g.stats.deniedCorrect = typeof g.stats.deniedCorrect === "number" ? g.stats.deniedCorrect : 0;
        g.stats.deniedIncorrect = typeof g.stats.deniedIncorrect === "number" ? g.stats.deniedIncorrect : 0;
        g.stats.deconStarts = typeof g.stats.deconStarts === "number" ? g.stats.deconStarts : 0;
      g.stats.workOrdersIssued = typeof g.stats.workOrdersIssued === "number" ? g.stats.workOrdersIssued : 0;
      g.stats.workOrdersCompleted = typeof g.stats.workOrdersCompleted === "number" ? g.stats.workOrdersCompleted : 0;
      g.stats.relayRepairs = typeof g.stats.relayRepairs === "number" ? g.stats.relayRepairs : 0;
      g.stats.relayAcks = typeof g.stats.relayAcks === "number" ? g.stats.relayAcks : 0;
      g.stats.maintenanceOps = typeof g.stats.maintenanceOps === "number" ? g.stats.maintenanceOps : 0;
      g.stats.resourceOrders = typeof g.stats.resourceOrders === "number" ? g.stats.resourceOrders : 0;
      g.stats.resourceOrderSpend = typeof g.stats.resourceOrderSpend === "number" ? g.stats.resourceOrderSpend : 0;
      g.stats.purchaseSpend = typeof g.stats.purchaseSpend === "number" ? g.stats.purchaseSpend : 0;
      g.stats.breakSpend = typeof g.stats.breakSpend === "number" ? g.stats.breakSpend : 0;
      g.stats.repairAttempts = typeof g.stats.repairAttempts === "number" ? g.stats.repairAttempts : 0;
      g.stats.repairSuccesses = typeof g.stats.repairSuccesses === "number" ? g.stats.repairSuccesses : 0;
      g.stats.repairFailures = typeof g.stats.repairFailures === "number" ? g.stats.repairFailures : 0;
      g.tech ||= { driftSuppressedUntil: 0, wobbleSuppressedUntil: 0 };
      g.workOrders ||= [];
      g.repairAttempts ||= [];
      g.concourseLevel = typeof g.concourseLevel === "number" ? g.concourseLevel : randRange(6, 26);
      for (const w of g.workOrders) {
        w.systemId ||= resolveFacility(w.systemName || "") || "DECON";
        w.systemName ||= (FACILITY_SYSTEMS.find(x => x.id === w.systemId)?.name || "UNKNOWN");
        w.state ||= "QUEUED";
        w.phaseIndex = typeof w.phaseIndex === "number" ? w.phaseIndex : 0;
        if (typeof w.phaseEndsAt === "number" && w.phaseEndsAt > 0) {
          w.phaseEndsAt = adjustTimestamp(w.phaseEndsAt);
        } else {
          const phase = WORKORDER_PHASES[w.phaseIndex] || WORKORDER_PHASES[0];
          const phaseMax = getAdaptiveWorkOrderMax(phase.min, phase.max);
          w.phaseEndsAt = Date.now() + randRange(phase.min, phaseMax) * 1000;
        }
        w.createdAt = adjustTimestamp(w.createdAt) || Date.now();
      }

      g.resources ||= {};
      for (const r of RESOURCE_TYPES) {
        const res = g.resources[r.id] ||= { level: randRange(r.startMin, r.startMax), order: null, orderAmount: RESOURCE_ORDER_MIN };
        const levelValue = Number(res.level);
        res.level = Number.isFinite(levelValue) ? levelValue : randRange(r.startMin, r.startMax);
        res.level = clamp(res.level, 0, 100);
        if (typeof res.orderAmount !== "number") res.orderAmount = RESOURCE_ORDER_MIN;
        res.orderAmount = normalizeOrderAmount(res.orderAmount);
        if (res.order) {
          res.order.resourceId ||= r.id;
          res.order.stage ||= RESOURCE_ORDER_PHASES[0].key;
          res.order.stageIndex = typeof res.order.stageIndex === "number" ? res.order.stageIndex : 0;
          res.order.amount = normalizeOrderAmount(res.order.amount ?? res.orderAmount);
          if (res.order.stageEndsAt && res.order.stageEndsAt > 0) {
            res.order.stageEndsAt = adjustTimestamp(res.order.stageEndsAt);
          } else {
            const phase = RESOURCE_ORDER_PHASES[res.order.stageIndex] || RESOURCE_ORDER_PHASES[0];
            const phaseMax = getAdaptiveResourceOrderMax(phase.min, phase.max);
            res.order.stageEndsAt = Date.now() + randRange(phase.min, phaseMax) * 1000;
          }
          if (res.order.stage === "INBOUND" && !res.order.shipmentId) {
            res.order.stage = "SHIPPING";
            res.order.stageIndex = RESOURCE_ORDER_PHASES.length - 1;
            res.order.stageEndsAt = Date.now() + randRange(60, 120) * 1000;
          }
          if (res.order.stage === "DELIVERED") {
            res.order.completedAt = adjustTimestamp(res.order.completedAt) || Date.now();
          }
        } else {
          res.order = null;
        }
      }

      g.corridors ||= [];
      for (const c of g.corridors) {
        c.lastChange = adjustTimestamp(c.lastChange) || Date.now();
        c.cls ||= (CORRIDOR_STATES.find(x => x.key === c.status)?.cls || "warn");
      }

      g.facility ||= FACILITY_SYSTEMS.map(sys => ({
        id: sys.id,
        name: sys.name,
        status: "ONLINE",
        lastChange: Date.now(),
        stableUntil: Date.now() + randRange(18 * 60_000, 40 * 60_000)
      }));
      for (const f of g.facility) {
        f.name ||= (FACILITY_SYSTEMS.find(x => x.id === f.id)?.name || f.id);
        f.status ||= "ONLINE";
        f.lastChange = adjustTimestamp(f.lastChange) || Date.now();
        if (typeof f.stableUntil === "number" && f.stableUntil > 0) {
          f.stableUntil = adjustTimestamp(f.stableUntil);
        } else {
          f.stableUntil = Date.now() + randRange(18 * 60_000, 40 * 60_000);
        }
        f.lastRepairAttemptAt = adjustTimestamp(f.lastRepairAttemptAt) || 0;
        f.degradedSince = adjustTimestamp(f.degradedSince) || 0;
        f.degradedTimeoutAt = adjustTimestamp(f.degradedTimeoutAt) || 0;
      }

      g.dockSlots ||= ["SLOT-1", "SLOT-2", "SLOT-3", "SLOT-4"].map(id => ({
        id,
        state: "EMPTY",
        shipId: null,
        phaseEndsAt: 0
      }));
      if (g.dockSlots.length < 4) {
        const existing = new Set(g.dockSlots.map(slot => slot.id));
        for (const id of ["SLOT-1", "SLOT-2", "SLOT-3", "SLOT-4"]) {
          if (existing.has(id)) continue;
          g.dockSlots.push({ id, state: "EMPTY", shipId: null, phaseEndsAt: 0 });
        }
      }
      for (const slot of g.dockSlots) {
        slot.state ||= "EMPTY";
        slot.shipId ??= null;
        slot.phaseEndsAt = adjustTimestamp(slot.phaseEndsAt) || 0;
      }

      g.relays ||= [];
			const currentCount = g.relays.length;
			const desiredRelays = (currentCount >= 3) ? 3 : 2;

			if (g.relays.length > desiredRelays) g.relays = g.relays.slice(0, desiredRelays);
			while (g.relays.length < 2) { // Ensure at least 2 exist
        g.relays.push({
          id: `RELAY-${g.relays.length + 1}`,
          status: "ONLINE",
          health: randRange(95, 100),
          lastChange: Date.now(),
          lastPacketAt: 0,
          lastRelayPingAt: 0,
          lastHeartbeatAt: Date.now(),
          nextHeartbeatAt: Date.now() + randRange(RELAY_HEARTBEAT_ONLINE_MIN_MS, RELAY_HEARTBEAT_ONLINE_MAX_MS),
          lastAckAt: 0,
          awaitingAck: false,
          ackDueAt: 0,
          offline: false,
          hiddenOffline: false,
          hiccupRecoverable: false,
          offlineReason: null,
          offlineSince: 0,
          lastHealthPingAt: 0,
          nextHealthPingCooldown: Date.now(),
          shiftChance: RATES.relayShiftChance * (0.9 + Math.random() * 0.2) // Per-relay variance: 90-110% of base rate
        });
      }
      for (const r of g.relays) {
        r.status ||= "ONLINE";

        // Migrate old relays to health-based system
        if (typeof r.health !== "number") {
          // Convert old status to health percentage
          if (r.offline || r.status === "OFFLINE") {
            r.health = 0;
          } else if (r.status === "FAULT") {
            r.health = randRange(25, 49);
          } else if (r.status === "WEAK") {
            r.health = randRange(50, 74);
          } else { // ONLINE
            r.health = randRange(75, 100);
          }
        }

        r.lastChange = adjustTimestamp(r.lastChange) || Date.now();
        r.lastPacketAt = adjustTimestamp(r.lastPacketAt) || 0;
        r.lastRelayPingAt = adjustTimestamp(r.lastRelayPingAt) || 0;
        r.lastHeartbeatAt = adjustTimestamp((typeof r.lastHeartbeatAt === "number" && r.lastHeartbeatAt > 0) ? r.lastHeartbeatAt : 0) || Date.now();
        r.nextHeartbeatAt = (typeof r.nextHeartbeatAt === "number" && r.nextHeartbeatAt > 0)
          ? adjustTimestamp(r.nextHeartbeatAt)
          : (Date.now() + randRange(RELAY_HEARTBEAT_MIN_MS, RELAY_HEARTBEAT_MAX_MS));
        r.lastAckAt = adjustTimestamp(r.lastAckAt) || 0;
        r.awaitingAck = typeof r.awaitingAck === "boolean" ? r.awaitingAck : false;
        r.ackDueAt = adjustTimestamp(typeof r.ackDueAt === "number" ? r.ackDueAt : 0);
        r.offline = typeof r.offline === "boolean" ? r.offline : (r.health === 0);
        r.hiddenOffline = typeof r.hiddenOffline === "boolean" ? r.hiddenOffline : (r.offline && r.health > 0);
        r.hiccupRecoverable = typeof r.hiccupRecoverable === "boolean" ? r.hiccupRecoverable : false;
        r.offlineReason = r.offlineReason || null;
        r.offlineSince = adjustTimestamp(typeof r.offlineSince === "number" ? r.offlineSince : 0);
        r.lastHealthPingAt = adjustTimestamp(r.lastHealthPingAt) || 0;
        r.nextHealthPingCooldown = adjustTimestamp(r.nextHealthPingCooldown) || Date.now();
        // Initialize per-relay shift chance for existing relays
        if (typeof r.shiftChance !== "number") {
          r.shiftChance = RATES.relayShiftChance * (0.9 + Math.random() * 0.2); // 90-110% of base rate
        }
        if (r.offline && !r.hiddenOffline) r.health = 0;
      }

      // Initialize relayHealth for existing gates
      g.relayHealth ||= {
        degradedSince: 0,
        criticalSince: 0,
        lastHealthState: "HEALTHY",
        unackedPings: 0,
        lastWarningAt: 0,
        totalRelayCount: g.relays.length
      };
      g.relayHealth.totalRelayCount = g.relays.length;
      g.relayHealth.degradedSince = adjustTimestamp(typeof g.relayHealth.degradedSince === "number" ? g.relayHealth.degradedSince : 0);
      g.relayHealth.criticalSince = adjustTimestamp(typeof g.relayHealth.criticalSince === "number" ? g.relayHealth.criticalSince : 0);
      g.relayHealth.lastHealthState ||= "HEALTHY";
      g.relayHealth.unackedPings = typeof g.relayHealth.unackedPings === "number" ? g.relayHealth.unackedPings : 0;
      g.relayHealth.lastWarningAt = adjustTimestamp(typeof g.relayHealth.lastWarningAt === "number" ? g.relayHealth.lastWarningAt : 0);

      g.packets ||= [];

      g.inbound ||= [];
      g.outbound ||= [];
      for (const s of [...g.inbound, ...g.outbound]) {
        s.request ||= (s.dir === "IN" ? "DOCK" : "DEPART");
        s.transponder ||= "VALID";
        s.priority ||= false;
        s.reason ||= null;
        s.notes ||= "";
        s.doneAt = adjustTimestamp(s.doneAt) || 0;
        s.slotId ??= null;
        s.dockState ??= null;
        s.deconEndsAt = adjustTimestamp(s.deconEndsAt) || 0;
        s.deconPausedAt = adjustTimestamp(s.deconPausedAt) || 0;
        s.deconAccumulatedPause = s.deconAccumulatedPause || 0;
        s.deconFacilityStatus = s.deconFacilityStatus || "ONLINE";
        s.serviceEndsAt = adjustTimestamp(s.serviceEndsAt) || 0;
        s.servicePausedAt = adjustTimestamp(s.servicePausedAt) || 0;
        s.serviceFacilityStatus = s.serviceFacilityStatus || "ONLINE";
        s.clearingEndsAt = adjustTimestamp(s.clearingEndsAt) || 0;
        s.exposureDeadline = adjustTimestamp(s.exposureDeadline) || 0;
        s.departureDeadline = adjustTimestamp(s.departureDeadline) || 0;
        s.deadlineWarningAt = adjustTimestamp(s.deadlineWarningAt) || 0;
        s.deadlineType ||= null;
        s.deadlineUrgent = typeof s.deadlineUrgent === "boolean" ? s.deadlineUrgent : (s.deadlineType === "URGENT");
        s.urgencyLevel = typeof s.urgencyLevel === "number" ? s.urgencyLevel : 0;
        s.missedDeadline = typeof s.missedDeadline === "boolean" ? s.missedDeadline : false;
        s.penaltyApplied = typeof s.penaltyApplied === "boolean" ? s.penaltyApplied : false;
        s.deadlineWarning = typeof s.deadlineWarning === "boolean" ? s.deadlineWarning : false;
        s.criticalAudioPlayed = typeof s.criticalAudioPlayed === "boolean" ? s.criticalAudioPlayed : false;
        s.finalWarningPlayed = typeof s.finalWarningPlayed === "boolean" ? s.finalWarningPlayed : false;
        s.holdUsed = typeof s.holdUsed === "boolean" ? s.holdUsed : false;
        s.holdStartTime = adjustTimestamp(typeof s.holdStartTime === "number" ? s.holdStartTime : 0);
        s.holdDuration = typeof s.holdDuration === "number" ? s.holdDuration : 0;
        s.holdDeadlinePausedAt = adjustTimestamp(typeof s.holdDeadlinePausedAt === "number" ? s.holdDeadlinePausedAt : 0);
        s.wasCleared ||= false;
        s.queryPending ||= false;
        s.servicingBlocked ||= false;
        s.effects ||= [];
        for (const ef of s.effects) {
          ef.hidden = typeof ef.hidden === "boolean" ? ef.hidden : false;
          ef.revealed ||= false;
        }
        if (!s.cargo) {
          if (s.type === "SHIPMENT" && s.shipmentType) {
            const cargoOptions = SHIPMENT_CARGO_BY_RESOURCE[s.shipmentType] || CARGO_BY_TYPE.SHIPMENT || [CARGO_NONE];
            s.cargo = pick(Math.random, cargoOptions);
          } else {
            s.cargo = CARGO_NONE;
          }
        }
        s.cargoUnknown = typeof s.cargoUnknown === "boolean" ? s.cargoUnknown : false;
        if (s.typeUnknown) s.cargoUnknown = true;
        s.cargoIllegal = typeof s.cargoIllegal === "boolean" ? s.cargoIllegal : false;
        s.shipmentType ||= null;
        s.shipmentDelivered = typeof s.shipmentDelivered === "boolean" ? s.shipmentDelivered : false;
        s.hazardDeadline = adjustTimestamp(s.hazardDeadline) || 0;
        s.obscured = typeof s.obscured === "boolean" ? s.obscured : false;
        s.infoMasked = typeof s.infoMasked === "boolean" ? s.infoMasked : false;
        s.hazardType = s.hazardType || null;  // Preserve hazard type for UNKNOWN ships
        s.hiddenThreat = typeof s.hiddenThreat === "boolean" ? s.hiddenThreat : false;
        if (typeof s.transponderMatch !== "number") {
          s.transponderMatch = s.transponder === "MISMATCH" ? 0 : (s.transponder === "VALID" ? 1 : 0);
        } else {
          s.transponderMatch = clamp(s.transponderMatch, 0, 1);
        }
        // CRITICAL: Ensure ships with hazardType always have infoMasked = true
        if (s.hazardType && !s.infoMasked) {
          s.infoMasked = true;
        }
        // QUERY expansion fields
        s.typeUnknown = typeof s.typeUnknown === "boolean" ? s.typeUnknown : false;
        s.priorityUnknown = typeof s.priorityUnknown === "boolean" ? s.priorityUnknown : false;
        s.etaUnknown = typeof s.etaUnknown === "boolean" ? s.etaUnknown : false;
        s.lastQueryTime = typeof s.lastQueryTime === "number" ? s.lastQueryTime : 0;
        if (typeof s.eta !== "number") s.eta = ETA.min + Math.floor(Math.random() * 400);
      }
      recomputeHealth(g);
      return g;
    }

    function loadGateState(gateId) {
      try {
        const raw = localStorage.getItem(LS.gateStatePrefix + gateId);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        const lastSavedAt = typeof parsed.lastSavedAt === "number" ? parsed.lastSavedAt : null;
        return reviveGateState(parsed, lastSavedAt);
      } catch (_) { return null; }
    }

    function saveGateState(g) {
      // Skip saving in endurance mode - progress is lost on close
      if (loadShiftMode() === "endurance") return;

      try {
        const copy = JSON.parse(JSON.stringify(g));
        copy.reports = (copy.reports || []).slice(-40);
        copy.packets = (copy.packets || []).slice(-20);
        copy.lastSavedAt = Date.now();
        localStorage.setItem(LS.gateStatePrefix + g.id, JSON.stringify(copy));
      } catch (_) {}
    }

    function serializeGateForSave(g) {
      const copy = JSON.parse(JSON.stringify(g));
      copy.reports = (copy.reports || []).slice(-40);
      copy.packets = (copy.packets || []).slice(-20);
      return copy;
    }

    function buildSaveState() {
      const activeGateId = runtime.activeGateId || runtime.catalog || "";
      const gate = runtime.gate || loadGateState(activeGateId) || makeGateState(activeGateId);
      const shiftMs = Math.max(0, Date.now() - runtime.shiftStart);
      const shiftDurationMs = loadShiftDuration();
      const shiftMode = loadShiftMode();
      return {
        v: 1,
        exportedAt: Date.now(),
        theme: document.documentElement.dataset.theme || localStorage.getItem(LS.theme) || "green",
        unlockedThemes: getUnlockedThemes(),
        holidayUnlockedThemes: getHolidayUnlockedThemes(),
        activeGateId,
        shiftMs,
        shiftDurationMs,
        shiftMode,
        operatorCallsign: runtime.operatorCallsign || "",
        gate: serializeGateForSave(gate),
        severed: !!runtime.severed,
        lastSevered: runtime.lastSevered || null,
        lifetimeStats: loadLifetimeStats(),
        achievements: loadAchievements(),
        defaultOperatorCallsign: safeStorageGet(LS.defaultOperatorCallsign) || ""
      };
    }

    function applySaveState(save) {
      if (!save || !save.activeGateId) return false;
      if (save.activeGateId) localStorage.setItem(LS.gateCurrent, save.activeGateId);
      if (save.theme) localStorage.setItem(LS.theme, save.theme);
      if (Array.isArray(save.unlockedThemes)) {
        safeStorageSet(LS.unlockedThemes, JSON.stringify(save.unlockedThemes));
      }
      if (Array.isArray(save.holidayUnlockedThemes)) {
        safeStorageSet(LS.holidayUnlockedThemes, JSON.stringify(save.holidayUnlockedThemes));
      }
      const exportedAt = typeof save.exportedAt === "number" ? save.exportedAt : null;
      if (save.gate) {
        const revived = reviveGateState(save.gate, exportedAt);
        if (revived) saveGateState(revived);
      }
      runtime.gate = null;
      runtime.severed = !!save.severed;
      runtime.lastSevered = save.lastSevered || null;
      runtime.resumeShiftMs = typeof save.shiftMs === "number" ? save.shiftMs : 0;
			safeStorageSet(LS.shiftMs, String(runtime.resumeShiftMs || 0));
      if (typeof save.shiftDurationMs === "number" && (save.shiftDurationMs > 0 || save.shiftDurationMs === -1)) {
        safeStorageSet(LS.shiftDurationMs, String(save.shiftDurationMs));
      }
      if (typeof save.shiftMode === "string" && save.shiftMode) {
        safeStorageSet(LS.shiftMode, save.shiftMode);
      }
      runtime.operatorCallsign = typeof save.operatorCallsign === "string" ? save.operatorCallsign : "";
      const callsignGateId = save.activeGateId || runtime.activeGateId || getStoredGateId();
      saveOperatorCallsignForGate(callsignGateId, runtime.operatorCallsign);
      if (runtime.operatorCallsign) {
        safeStorageSet(LS.operatorCallsign, runtime.operatorCallsign);
      } else {
        try { localStorage.removeItem(LS.operatorCallsign); } catch (_) {}
      }
      updateOperatorLabel();
      updateEnduranceButtons();

      // Restore profile data
      if (save.lifetimeStats) {
        saveLifetimeStats(save.lifetimeStats);
      }
      if (save.achievements) {
        saveAchievements(save.achievements);
      }
      if (save.defaultOperatorCallsign) {
        safeStorageSet(LS.defaultOperatorCallsign, save.defaultOperatorCallsign);
      }
      applyDefaultCallsignIfNeeded(callsignGateId);

      return true;
    }

    function makeProfileExportFilename() {
      const callsign = getDefaultCallsign();
      const base = callsign || "OPERATOR";
      const safe = base.toUpperCase().replace(/[^A-Z0-9-]/g, "");
      return `${safe || "OPERATOR"}-PROFILE.tqeprofile`;
    }

    function makeExportFilename(gateId) {
      const safe = String(gateId || "").toUpperCase().replace(/[^A-Z0-9-]/g, "");
      return `${safe || "GATE"}.tqegate`;
    }

    function downloadTextFile(filename, text) {
      const blob = new Blob([text], { type: "application/octet-stream" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    async function exportSaveFile() {
      const save = buildSaveState();
      const gateId = runtime.activeGateId || save.activeGateId || "";
      const filename = makeExportFilename(gateId);
      const json = JSON.stringify(save, null, 2);
      downloadTextFile(filename, json);
      return filename;
    }

    function readCollapsedPanelsSnapshot() {
      const raw = safeStorageGet(LS.collapsedPanels);
      if (!raw) return { ...(runtime.collapsedPanels || {}) };
      try {
        const parsed = JSON.parse(raw);
        if (typeof parsed === "object" && parsed !== null) return parsed;
      } catch (_) {}
      return { ...(runtime.collapsedPanels || {}) };
    }

    function buildProfileState() {
      const deadzoneRaw = safeStorageGet(LS.gamepadDeadzone);
      const deadzone = deadzoneRaw ? parseFloat(deadzoneRaw) : 0.3;
      return {
        v: 1,
        kind: "tqeprofile",
        exportedAt: Date.now(),
        defaultOperatorCallsign: safeStorageGet(LS.defaultOperatorCallsign) || "",
        lifetimeStats: loadLifetimeStats(),
        achievements: loadAchievements(),
        clearanceLevel: getClearanceLevel(),
        unlockedThemes: getUnlockedThemes(),
        holidayUnlockedThemes: getHolidayUnlockedThemes(),
        theme: document.documentElement.dataset.theme || safeStorageGet(LS.theme) || "green",
        settings: {
          sfxEnabled: audioState.sfxEnabled,
          sfxVolume: audioState.sfxVolume,
          keyboardEnabled: audioState.keyboardEnabled,
          keyboardVolume: audioState.keyboardVolume,
          musicEnabled: audioState.musicEnabled,
          musicVolume: audioState.musicVolume,
          vfxEnabled: vfxState.enabled,
          fontScale: runtime.fontScale,
          headerCollapsed: safeStorageGet(LS.headerCollapsed) === "1",
          collapsedPanels: readCollapsedPanelsSnapshot(),
          fullscreenEnabled: fullscreenState.isEnabled,
          shiftDurationMs: loadShiftDuration(),
          shiftMode: loadShiftMode(),
          multiplayerEnabled: loadStoredBool(LS.multiplayerEnabled, false),
          multiplayerServer: safeStorageGet(LS.multiplayerServer) || "",
          gamepadEnabled: loadStoredBool(LS.gamepadEnabled, true),
          gamepadDeadzone: Number.isFinite(deadzone) ? deadzone : 0.3
        }
      };
    }

    function applyProfileState(profile) {
      if (!profile || typeof profile !== "object") return false;
      if (profile.kind && profile.kind !== "tqeprofile" && profile.kind !== "profile") return false;

      if (profile.lifetimeStats) saveLifetimeStats(profile.lifetimeStats);
      if (profile.achievements) saveAchievements(profile.achievements);
      if (profile.clearanceLevel !== undefined) {
        const parsed = parseInt(profile.clearanceLevel, 10);
        setClearanceLevel(Number.isFinite(parsed) ? parsed : 0);
      }
      if (Array.isArray(profile.unlockedThemes)) {
        safeStorageSet(LS.unlockedThemes, JSON.stringify(profile.unlockedThemes));
      }
      if (Array.isArray(profile.holidayUnlockedThemes)) {
        safeStorageSet(LS.holidayUnlockedThemes, JSON.stringify(profile.holidayUnlockedThemes));
      }

      if (typeof profile.defaultOperatorCallsign === "string") {
        const normalized = profile.defaultOperatorCallsign.trim().toUpperCase().slice(0, 24);
        if (normalized) {
          safeStorageSet(LS.defaultOperatorCallsign, normalized);
        } else {
          try { localStorage.removeItem(LS.defaultOperatorCallsign); } catch (_) {}
        }
      }

      populateThemeDropdown();
      if (typeof profile.theme === "string" && profile.theme) {
        setTheme(profile.theme, true, true);
      }

      const settings = profile.settings || {};

      if (typeof settings.sfxEnabled === "boolean") setSfxEnabled(settings.sfxEnabled);
      if (typeof settings.sfxVolume === "number") setSfxVolume(settings.sfxVolume);
      if (typeof settings.keyboardEnabled === "boolean") setKeyboardEnabled(settings.keyboardEnabled);
      if (typeof settings.keyboardVolume === "number") setKeyboardVolume(settings.keyboardVolume);
      if (typeof settings.musicEnabled === "boolean") setMusicEnabled(settings.musicEnabled);
      if (typeof settings.musicVolume === "number") setMusicVolume(settings.musicVolume);
      if (typeof settings.vfxEnabled === "boolean") setVfxEnabled(settings.vfxEnabled);

      if (typeof settings.fontScale === "number") {
        applyFontScale(settings.fontScale, true);
      }

      if (typeof settings.shiftDurationMs === "number") {
        saveShiftDuration(settings.shiftDurationMs);
      }
      if (typeof settings.shiftMode === "string" && settings.shiftMode) {
        saveShiftMode(settings.shiftMode);
      }
      updateShiftTimeButtonText();
      updateEnduranceButtons();

      if (typeof settings.multiplayerEnabled === "boolean") {
        storeBool(LS.multiplayerEnabled, settings.multiplayerEnabled);
      }
      if (typeof settings.multiplayerServer === "string") {
        if (settings.multiplayerServer) {
          safeStorageSet(LS.multiplayerServer, settings.multiplayerServer);
        } else {
          try { localStorage.removeItem(LS.multiplayerServer); } catch (_) {}
        }
      }

      if (typeof settings.gamepadEnabled === "boolean") {
        setGamepadEnabled(settings.gamepadEnabled);
      }
      if (typeof settings.gamepadDeadzone === "number" && !Number.isNaN(settings.gamepadDeadzone)) {
        const dz = clamp(settings.gamepadDeadzone, 0, 1);
        localStorage.setItem(LS.gamepadDeadzone, String(dz));
        if (gamepadNav) gamepadNav.stickDeadzone = dz;
        updateGamepadUI();
      }

      if (typeof settings.headerCollapsed === "boolean") {
        setHeaderCollapsed(settings.headerCollapsed);
      }
      if (settings.collapsedPanels && typeof settings.collapsedPanels === "object") {
        runtime.collapsedPanels = { ...settings.collapsedPanels };
        saveCollapsedPanels();
        applyCollapsedStates();
        propagateAlertsToHeaders();
      }

      if (typeof settings.fullscreenEnabled === "boolean") {
        fullscreenState.isEnabled = settings.fullscreenEnabled;
        storeBool(LS.fullscreenEnabled, settings.fullscreenEnabled);
        updateFullscreenButton();
      }

      const gateId = runtime.activeGateId || getStoredGateId();
      applyDefaultCallsignIfNeeded(gateId);
      updateStartNameLabel();
      updateClearanceDisplays();
      updateProfilePanel();
      return true;
    }

    async function exportProfileFile() {
      const profile = buildProfileState();
      const filename = makeProfileExportFilename();
      const json = JSON.stringify(profile, null, 2);
      downloadTextFile(filename, json);
      return filename;
    }

    async function importProfileFile(file) {
      const text = await file.text();
      const profile = JSON.parse(text);
      return applyProfileState(profile);
    }

    async function resumeFromFile(file) {
      const text = await file.text();
      const save = JSON.parse(text);
      const applied = applySaveState(save);
      if (!applied) return false;
      safeReplaceState(location.pathname + location.search);
      await boot();
      return true;
    }

    async function resumeFromFileToStartScreen(file) {
      const text = await file.text();
      const save = JSON.parse(text);
      const applied = applySaveState(save);
      if (!applied) return false;
      safeReplaceState(location.pathname + location.search);
      updateStartNameLabel();

      // Apply the loaded theme to the UI (both selectors and document)
      const loadedTheme = safeStorageGet(LS.theme);
      if (loadedTheme) {
        document.documentElement.dataset.theme = loadedTheme;
        if (ui.startThemeSelect) ui.startThemeSelect.value = loadedTheme;
        if (ui.themeSelect) ui.themeSelect.value = loadedTheme;
        populateThemeDropdown();
      }

      return true;
    }

    async function copyToClipboard(text) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
      const el = document.createElement("textarea");
      el.value = text;
      el.setAttribute("readonly", "true");
      el.style.position = "absolute";
      el.style.left = "-9999px";
      document.body.appendChild(el);
      el.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(el);
      return ok;
    }

