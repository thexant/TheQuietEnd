<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <base href="/gatecontrol/">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
  <!-- Cache-busting headers to ensure users get latest updates -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <title>Gate Control Terminal // The Quiet End</title>
  <meta property="og:title" content=">GATE_CONTROL" />
  <meta
    property="og:description"
    content="A Web-Browser based Gate Control Terminal simulation game set in the setting of The Quiet End. Monitor traffic, maintain gate systems, and survive a full shift. Now supports ambient multiplayer."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://thequietend.com/gatecontrol/" />
  <meta property="og:image" content="http://thequietend.com/gatecontrol/embed.png" />
  <meta property="og:image:alt" content="Gate Control Terminal" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content=">GATE_CONTROL // The Quiet End" />
  <meta
    name="twitter:description"
    content="Simulated gate control terminal for reviewing traffic, managing systems, and logging events."
  />
  <meta name="twitter:image" content="https://thequietend.com/gatecontrol/embed.png" />
  <link rel="manifest" href="manifest.json" />
  <meta name="theme-color" content="#050406" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="apple-mobile-web-app-title" content="Gate Control" />
  <link rel="apple-touch-icon" href="icon-192.png" />
  <link rel="icon" href="icon-192.png" sizes="192x192" />
  <link rel="icon" href="icon-512.png" sizes="512x512" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=B612+Mono:wght@400;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;

      /* Base */
      --deep: #050406;
      --alert: #e16464;
      --radius: 3px;
      --font-title: "B612 Mono", "Courier New", monospace;
      --font-body: "Share Tech Mono", "Courier New", monospace;
			--accent: var(--signal);
      --interface-gap: clamp(8px, 2vmin, 14px);
      --frame-pad: clamp(10px, 2.6vmin, 18px);
      --terminal-h: clamp(220px, 30vh, 360px);

      /* Scrollbar colors that automatically match the active theme */
      --sb-track: rgba(0,0,0,0.22);
      --sb-border: var(--line);
      --sb-glow: var(--glow);

      /* Sensible fallback if color-mix isn't supported */
      --sb-thumb: rgba(255,255,255,0.10);
      --sb-thumb-hover: rgba(255,255,255,0.16);
      --sb-thumb-active: rgba(255,255,255,0.22);

      /* Theme defaults (green) */
      --ink: #b6ffd9;
      --muted: #6aa98d;
      --signal: #4dff9a;
      --good: var(--signal);
      --line: rgba(77, 255, 154, 0.18);
      --grid: rgba(77, 255, 154, 0.05);
      --glow: rgba(77, 255, 154, 0.35);
      --bg-hi: #0d1a14;
      --shadowText: rgba(77, 255, 154, 0.20);
      --shadowText2: rgba(77, 255, 154, 0.12);
      --stat: #d2a95a;
    }

    /* Prefer theme-colored thumbs when supported */
    @supports (color: color-mix(in srgb, red, transparent)) {
      :root {
        --sb-thumb: color-mix(in srgb, var(--signal) 28%, transparent);
        --sb-thumb-hover: color-mix(in srgb, var(--signal) 42%, transparent);
        --sb-thumb-active: color-mix(in srgb, var(--signal) 62%, transparent);
      }
    }

    /* Firefox scrollbars */
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--sb-thumb) var(--sb-track);
    }

    /* Chromium / Edge / Safari scrollbars */
    *::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    *::-webkit-scrollbar-track {
      background: var(--sb-track);
      border: 1px solid var(--sb-border);
      border-radius: 999px;
      box-shadow: inset 0 0 10px rgba(0,0,0,0.45);
    }

    *::-webkit-scrollbar-thumb {
      border-radius: 999px;
      border: 1px solid var(--sb-border);
      background: var(--sb-thumb);
      box-shadow: 0 0 12px var(--sb-glow);
    }

    *::-webkit-scrollbar-thumb:hover {
      background: var(--sb-thumb-hover);
    }

    *::-webkit-scrollbar-thumb:active {
      background: var(--sb-thumb-active);
      box-shadow: 0 0 16px var(--signal);
    }

    *::-webkit-scrollbar-corner {
      background: var(--sb-track);
    }

    :root[data-theme="green"] {
      --ink: #b6ffd9; --muted: #6aa98d; --signal: #4dff9a;
      --good: var(--signal);
      --line: rgba(77, 255, 154, 0.18); --grid: rgba(77, 255, 154, 0.05);
      --glow: rgba(77, 255, 154, 0.35); --bg-hi: #0d1a14;
      --shadowText: rgba(77, 255, 154, 0.20); --shadowText2: rgba(77, 255, 154, 0.12);
      --stat: #d2a95a;
    }
    :root[data-theme="red"] {
      --ink: #ffd0d0; --muted: #b27a7a; --signal: #ff5454;
      --good: var(--signal);
      --line: rgba(255, 84, 84, 0.18); --grid: rgba(255, 84, 84, 0.05);
      --glow: rgba(255, 84, 84, 0.35); --bg-hi: #1a0d10;
      --shadowText: rgba(255, 84, 84, 0.18); --shadowText2: rgba(255, 84, 84, 0.10);
      --stat: #d2a95a;
    }
    :root[data-theme="blue"] {
      --ink: #cfe5ff; --muted: #7f97b3; --signal: #4fb3ff;
      --good: var(--signal);
      --line: rgba(79, 179, 255, 0.18); --grid: rgba(79, 179, 255, 0.05);
      --glow: rgba(79, 179, 255, 0.35); --bg-hi: #0d141a;
      --shadowText: rgba(79, 179, 255, 0.18); --shadowText2: rgba(79, 179, 255, 0.10);
      --stat: #d2a95a;
    }
		:root[data-theme="purple"] {
			--ink: #eadcff;
			--muted: #a88bc7;
			--signal: #b56bff;
			--good: var(--signal);

			--line: rgba(181, 107, 255, 0.18);
			--grid: rgba(181, 107, 255, 0.05);
